1]\">Formato de archivo incorrecto. Debe ser un archivo PDF</span>\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresSize_rl[1]\">Tamaño máximo de archivo superado</span>\r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n            <div class=\"margin-row-button\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"50\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"100\">\r\n                        <p class=\"color-60\">Constancia de Alta en SAT*</p>\r\n                    </div>\r\n                    <div class=\"\" fxFlex=\"100\" fxLayout=\"row\">\r\n                        <input class=\"boton__input\" style=\"display: none\" type=\"file\" (change)=\"fileChange($event, 2,'rl')\" #hiddenfile9input accept=\".pdf, application/pdf\">\r\n                        <button type=\"button\" class=\"cargar__button | color-white\" [ngClass]=\"{'boton--alert': arregloErrores_rl[2] }\" routerLinkActive=\"active\" (click)=\"hiddenfile9input.click()\">\r\n                            <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                            <b>Cargar Archivo*</b>\r\n                        </button>\r\n                        <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                            <span fxFlex=\"100\" class=\"color-third mt-2 ml-3\">{{ documents_representante_legal.controls[2].get('nombre').value }}</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"arregloErrores_rl[2]\">\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresVacio_rl[2]\">Por favor carga la Constancia de Alta en SAT del Representante Legal</span>\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresFormat_rl[2]\">Formato de archivo incorrecto. Debe ser un archivo PDF</span>\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresSize_rl[2]\">Tamaño máximo de archivo superado</span>\r\n                    </div>\r\n\r\n                </div>\r\n                <div fxFlex=\"50\" fxLayout=\"row wrap\">\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"hr\"></div>\r\n\r\n            <div *ngIf=\"personales()\" class=\"\" fxFlex=\"100\">\r\n                <p class=\"Subtitle color-accent remove-fondo\" translate>Documentos del Personal Administrativo</p>\r\n            </div>\r\n            <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div class=\"ngFor mt-3\" *ngFor=\"let item of arregloArchivos_admin; let i = index\" fxFlex=\"50\" fxLayout=\"row wrap\">\r\n                        <div fxFlex=\"100\">\r\n                            <p class=\"color-60\">INE/Pasaporte/DNI del\r\n                                <span>{{ i + 1 }}</span>\r\n                                <span *ngIf=\"terminacion(i+1,'ER')\" translate>er</span>\r\n                                <span *ngIf=\"terminacion(i+1,'DO')\" translate>do</span>\r\n                                <span *ngIf=\"terminacion(i+1,'TO')\" translate>to</span> Administrativo*\r\n                            </p>\r\n                        </div>\r\n                        <div class=\"\" fxFlex=\"100\" fxLayout=\"row\">\r\n                            <input class=\"boton__input\" [attr.id]=\"'documento'+i\" style=\"display: none\" type=\"file\" (change)=\"fileChange($event, i,'admin')\" #hiddenInput accept=\".pdf, application/pdf\">\r\n                            <button type=\"button\" class=\"cargar__button | color-white\" [ngClass]=\"{'boton--alert': arregloErrores_admin[i] }\" routerLinkActive=\"active\" (click)=\"hiddenInput.click()\">\r\n                                <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                                <b>Cargar Archivo*</b>\r\n                            </button>\r\n                            <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                                <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ documents_admin.controls[i].get('nombre').value  }}</span>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div fxFlex=\"100\" class=\"alertTransfer\" *ngIf=\"arregloErrores_admin[i]\">\r\n                            <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresVacio_admin[i]\">Por favor carga la idetificación del 1er Administrativo</span>\r\n                            <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresFormat_admin[i]\">Formato de archivo incorrecto. Debe ser un archivo PDF</span>\r\n                            <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresSize_admin[i]\">Tamaño máximo de archivo superado</span>\r\n                        </div>\r\n\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n\r\n            <div class=\"mt-4\" fxFlex=\"100\">\r\n                <button class=\"confirmar__button button-margin | color-white\" id=\"submit\" type=\"button\" (click)=\"submit()\" translate>Finalizar</button>\r\n            </div>\r\n\r\n\r\n        </div>\r\n\r\n    </form>\r\n\r\n\r\n</div>\r\n<!-- Loading -->\r\n\r\n<app-loading *ngIf=\"showLoad\"></app-loading>\r\n");

