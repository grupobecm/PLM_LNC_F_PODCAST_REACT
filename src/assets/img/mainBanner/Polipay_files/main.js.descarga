b-4\" fxFlex=\"45\" fxLayout=\"row wrap\">\r\n                    <div class=\"fecha\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                        <p class=\"form__date label_fecha pass | font-roboto\" translate>Fin</p>\r\n                        <mat-form-field class=\"valor campo_fecha disabled\" fxFlex=\"100\">\r\n                            <input matInput class=\"date\" [satDatepicker]=\"picker8\" autocomplete=\"off\" name=\"date_dispersion2\" id=\"date_dispersion2\" formControlName=\"date_dispersion2\" readonly [max]=\"datenow\" [(ngModel)]=\"date_dispersion2\" required>\r\n                            <sat-datepicker #picker8 [rangeMode]=\"false\" [selectFirstDateOnClose]=\"true\" [rangeHoverEffect]=\"false\">\r\n                            </sat-datepicker>\r\n                            <sat-datepicker-toggle matSuffix [for]=\"picker8\"></sat-datepicker-toggle>\r\n                        </mat-form-field>\r\n                    </div>\r\n                </div>\r\n\r\n            </div>\r\n\r\n            <div fxFlex=\"50\" fxLayout=\"row wrap\" fxLayoutAlign=\"end none\">\r\n                <div fxFlex=\"100\">\r\n                    <span class=\"text ml-5\">Hora de Operación</span>\r\n                </div>\r\n                <!-- hora -->\r\n                <div (click)=\"EscogerHora()\" class=\"form_space form form--margin-left manito\" fxFlex=\"45\">\r\n                    <span class=\"form__text user referencia \">Inicio</span>\r\n                    <input class=\"form__input user manito \" type=\"text\" autocomplete=\"off\" name=\"horaoper\" readonly formControlName=\"hora_operacion\" required [(ngModel)]=\"hora_operacion\">\r\n                </div>\r\n                <!-- hora -->\r\n                <div (click)=\"EscogerHora2()\" class=\"form_space form form--margin-left manito\" fxFlex=\"45\">\r\n                    <span class=\"form__text user referencia \">Fin</span>\r\n                    <input class=\"form__input user manito \" type=\"text\" autocomplete=\"off\" name=\"horaoper\" readonly formControlName=\"hora_operacion2\" required [(ngModel)]=\"hora_operacion2\">\r\n                </div>\r\n\r\n            </div>\r\n\r\n\r\n\r\n        </div>\r\n        <div fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"end end\">\r\n            <button class=\"| color-white confirmar__button\" type=\"submit\">Buscar</button>\r\n        </div>\r\n\r\n    </div>\r\n    <div class=\"content\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\" *ngIf=\"!firstStep\">\r\n\r\n        <div fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between center\">\r\n\r\n            <div fxFlex=\"20\">\r\n                <button class=\"button-verification-code | color-third background-grey-dark \" type=\"button\" (click)=\"openFilter()\">\r\n                    FILTRO\r\n                </button>\r\n            </div>\r\n            <div fxFlex=\"35\" fxLayoutAlign=\"center center\">\r\n                <p>Movimientos del <br> {{date_dispersion| date: 'd/M/yyyy'}} al {{date_dispersion2| date: 'd/M/yyyy'}}\r\n                </p>\r\n            </div>\r\n            <div fxFlex=\"30\" fxLayout=\"column\">\r\n                <div>\r\n                    <p>Ingresos Totales: <span class=\"num color-main\">{{total_ingresos | currency:'MXN':'symbol'}}</span></p>\r\n                </div>\r\n                <div>\r\n                    <p>Egresos Totales: <span class=\" num color-red\">{{total_egresos | currency:'MXN':'symbol'}}</span></p>\r\n                </div>\r\n            </div>\r\n            <div class=\"descargas \" fxFlex=\"15\" fxLayoutAlign=\"space-evenly center\">\r\n                <img src=\"../../../../assets/img/icons/exp-xlsx.svg\" alt=\"Exportar XLSX\" (click)=\"exportExcel('xls')\">\r\n                <div class=\"label-container\">\r\n                    <label class=\"label__copy | color-white\">Exportar Excel</label>\r\n                </div>\r\n                <img src=\"../../../../assets/img/icons/exp-csv.svg\" alt=\"Exportar CSV\" (click)=\"exportExcel('csv')\">\r\n                <div class=\"label-container\">\r\n                    <label class=\"label__copy | color-white\">Exportar CSV</label>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"mat-elevation-z8 margin-cont\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n            <table mat-table [dataSource]=\"listStaffExternal\" fxFlex=\"100\" matSort [attr.align]=\"'center'\">\r\n                <!-- Columna No se encontraron registros -->\r\n                <ng-container matColumnDef=\"noData\">\r\n                    <td mat-footer-cell *matFooterCellDef [attr.colspan]=\"displayedColumns.length\" [attr.align]=\"'center'\">\r\n                        <span *ngIf=\"noData===true\">No se encontraron registros.</span>\r\n                    </td>\r\n                </ng-container>\r\n                <!-- Columna Cliente -->\r\n                <ng-container matColumnDef=\"NumEmisor\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Núm. Cta. Emisor</th>\r\n                    <td mat-cell *matCellDef=\"let element\" align=\"center\">{{ element.cuenta_emisor }}</td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"ClabeEmisor\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Clabe Emisor</th>\r\n                    <td mat-cell *matCellDef=\"let element\" align=\"center\">{{ element.clabe_emisor }}</td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"NumReceptor\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Núm. Cta. Receptor</th>\r\n                    <td mat-cell *matCellDef=\"let element\" align=\"center\"> {{ element.cta_beneficiario }} </td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"ClabeReceptor\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Clabe Receptor</th>\r\n                    <td mat-cell *matCellDef=\"let element\" align=\"center\"> {{ element.clabe_receptor }} </td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"FeOperacion\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Fecha de Operación</th>\r\n                    <td mat-cell *matCellDef=\"let element\" align=\"center\">{{ element.fecha_creacion | date: 'dd/MM/yyyy HH:mm'}} Hrs.</td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"Monto\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Monto</th>\r\n                    <td mat-cell *matCellDef=\"let element\" [ngStyle]=\"element.monto < 0 ? {'color':'#ff0000'}: {'color':'#3a555b'}\"> {{ element.monto | currency :'MXN':'symbol' }} </td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"NumRef\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Núm. Ref.</th>\r\n                    <td mat-cell *matCellDef=\"let element\" align=\"center\">{{ element.referencia_numerica }}</td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"ClaveRas\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Clave de Rastreo</th>\r\n                    <td mat-cell *matCellDef=\"let element\" align=\"center\">{{ element.clave_rastreo }}</td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"FolioTrans\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Folio Transf.</th>\r\n                    <td mat-cell *matCellDef=\"let element\" align=\"center\"> {{ element.id }}</td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"Concepto\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Concepto</th>\r\n                    <td mat-cell *matCellDef=\"let element\"> {{ element.concepto_pago }} </td>\r\n                </ng-container>\r\n                <tr mat-header-row *matHeaderRowDef=\"displayedColumns\"></tr>\r\n                <tr mat-row *matRowDef=\"let row; columns: displayedColumns\"></tr>\r\n                <tr mat-footer-row *matFooterRowDef=\"['noData']\" [hidden]=\"numRegister > 0\"></tr>\r\n            </table>\r\n            <mat-paginator fxFlex=\"100\" [pageSizeOptions]=\"[100]\" showFirstLastButtons></mat-paginator>\r\n        </div>\r\n\r\n    </div>\r\n\r\n</form>\r\n\r\n<!-- Loader -->\r\n<app-loading *ngIf=\"showLoad\"></app-loading>\r\n");

