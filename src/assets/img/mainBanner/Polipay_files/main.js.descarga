    redireccionar() {
    }
    deskopt() {
        this.router.navigate(['/usuario/company']);
        this.dialogRef.close();
    }
    redireccionar2() {
        if (this.url == '/usuario/editUser/profile') {
            this.router.navigate([this.url])
                .then(() => {
                window.location.reload();
            });
        }
        else {
            this.router.navigate([this.url]);
        }
        this.dialogRef.close();
    }
    /* ADMIN */
    individualPendienyeAdmin() {
        this.dialogRef.close();
    }
    redifrequent() {
        this.router.navigate(['/usuario/transaccion/cuentasfrecuentes/tercerosFrequent/seefrecuentesterceros']);
        this.dialogRef.close();
    }
};
