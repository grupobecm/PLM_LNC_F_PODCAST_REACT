let DetailsCanceledUMassivaComponent = class DetailsCanceledUMassivaComponent {
    constructor(dialog, router, serviceClient, storageClient) {
        this.dialog = dialog;
        this.router = router;
        this.serviceClient = serviceClient;
        this.storageClient = storageClient;
        this.cuenta = "";
        this.displayedColumns = ['id', 'nombre_beneficiario', 'monto', 'fecha_creacion', 'button'];
        this.listLiquidate = [];
        this.noData = false;
        this.numRegister = 0;
        this.showLoad = false;
        //fechas - boton cancelar
        this.today = new Date();
        this.fechacancelacion = true;
        this.fechaCancel = new Date();
        this.transfersAux = [];
        const navigation = this.router.getCurrentNavigation();
        const state = navigation.extras.state;
        if (!this.storageClient.INFO_CENTERCOST) {
            //console.log("bye");
        }
        else {
            this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
            //console.log(this.dato)
            //console.log(this.dato.persona_cuenta_id);
        }
        if (state == undefined) {
            this.router.navigate(['/usuario/transactions/polipay-third/transfer-status/status-massives-transfer/pending-transactions/pending-massives']);
        }
        this.example = state.example;
        //console.log(this.example);
        this.listTransferSlopes();
        this.detailsTransferSlopes();
        let fechas;
        fechas = new Date(this.example.fechaliberacion);
        fechas.setDate(fechas.getDate() - 1);
        //console.log(fechas);
        if (this.today > fechas) {
            this.fechacancelacion = false;
        }
        else {
            this.fechacancelacion = true;
        }
    }
    listTransferSlopes(size = 9999, idMassive = this.example.id) {
        this.showLoad = true;
        this.serviceClient.listTransferSlopesIndividual(size, idMassive).subscribe(res => {
            for (let i = 0; i < res.results.length; i++) {
                this.transfersAux.push({ id: res.results[i].id });
            }
            ;
            this.listLiquidate = new _angular_material_table__WEBPACK_IMPORTED_MODULE_9__["MatTableDataSource"](res.results);
            this.showLoad = false;
            this.listLiquidate.sort = this.sort;
            this.listLiquidate.paginator = this.paginator;
            //this.paginator._intl.itemsPerPageLabel = 'Filas por página';
            this.listLiquidate.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listLiquidate.data.length;
        }, error => {
            //console.log(error);
        });
    }
    sumarDias(fecha, dias) {
        fecha.setDate(fecha.getDate() + dias);
        return fecha;
    }
    detailsTransferSlopes() {
        let idCC = '1077';
        //console.log(this.sumarDias(this.fechaCancel, -1));
        let idMassive = this.example.id;
        this.showLoad = true;
        this.serviceClient.dataTransferSlopesIndividual(idMassive, this.dato.persona_cuenta_id).subscribe(res => {
            //console.log(res);
            this.costCenter = res.cost_center;
