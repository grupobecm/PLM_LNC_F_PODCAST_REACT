el__numeroRegistros {\r\n    margin-right: 37px;\r\n}\r\n\r\n.boton {\r\n    border: none;\r\n    margin: 0px 16px;\r\n}\r\n\r\n.descargas img {\r\n    cursor: pointer;\r\n}\r\n\r\n.descargar img {\r\n    margin-right: 8px;\r\n}\r\n\r\n.descargar {\r\n    border: none;\r\n    text-transform: uppercase;\r\n    font-size: 14px;\r\n    padding: 8px 8px 7px 10px;\r\n    border-radius: 24px;\r\n    outline: none;\r\n}\r\n\r\n.cancelar img {\r\n    margin-right: 10px;\r\n}\r\n\r\n.cancelar {\r\n    border: none;\r\n    text-transform: uppercase;\r\n    font-size: 14px;\r\n    padding: 8px 14px 7px 16px;\r\n    border-radius: 24px;\r\n    outline: none;\r\n}\r\n\r\n.liquidar img {\r\n    margin-right: 10px;\r\n}\r\n\r\n.liquidar {\r\n    border: none;\r\n    text-transform: uppercase;\r\n    font-size: 14px;\r\n    padding: 8px 14px 7px 16px;\r\n    border-radius: 24px;\r\n    outline: none;\r\n}\r\n\r\n@media(max-width: 1492px) {\r\n    table {\r\n        font-size: 15px;\r\n    }\r\n    th,\r\n    td {\r\n        padding: 15px 10px;\r\n    }\r\n}\r\n/*# sourceMappingURL=data:application/json;base64, */");

