           </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div *ngIf=\"paso2\" class=\"mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between start\">\r\n            <div fxFlex=\"48\" class=\"mr-3\" fxLayout=\"row wrap\">\r\n                <div fxLayout=\"column\" fxFlex=\"100\">\r\n                    <span class=\"text color-60\">Colaborador</span>\r\n                    <p class=\"subtitle | color-74\"><b>{{ name }}</b></p>\r\n                </div>\r\n                <div fxFlex=\"100\">\r\n                    <div class=\"tabla__una\" fxFlex=\"100\">\r\n                        <table class=\"tabla tabla-ordenes-enviadas | background-white\">\r\n                            <thead>\r\n                                <tr class=\"tr | color-main\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                                    <th class=\"th th--ml | color-accent\" fxFlex=\"100\">Documentos del Centro de Costos</th>\r\n                                </tr>\r\n                            </thead>\r\n\r\n                            <tbody class=\"tablas__tbody\">\r\n                                <tr class=\"tr | color-third\" fxLayout=\"row wrap\" fxLayoutAlign=\"none center\">\r\n                                    <td class=\"th th--ml  th--content | color-third bold\" fxFlex=\"60\">CARTA RESPONSIVA</td>\r\n                                    <td class=\"th th--align-right th--content| color-third\" fxFlex=\"15\">Estado:</td>\r\n                                    <td class=\"th th--align th--content | status--correct bold\" fxFlex=\"15\" *ngIf=\"form.value.radioBoton1=='C'\">CORRECTO</td>\r\n                                    <td class=\"th th--align th--content | status bold\" fxFlex=\"15\" *ngIf=\"form.value.radioBoton1=='P'\">PENDIENTE</td>\r\n                                    <td class=\"th th--align th--content | status--fail bold\" fxFlex=\"15\" *ngIf=\"form.value.radioBoton1=='D'\">DEVUELTO</td>\r\n                                    <td class=\"th th--ml  th--content | color-third bold\" fxFlex=\"100\" *ngIf=\"form.value.radioBoton1=='D'\">Motivo de la devolución: <br> {{form.value.motivoDevolucion1}}\r\n                                    </td>\r\n                                </tr>\r\n                                <tr class=\"tr | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\">&nbsp;</td>\r\n                                </tr>\r\n                            </tbody>\r\n\r\n                        </table>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n            </div>\r\n            <div class=\"mt-4\" fxFlex=\"48\">\r\n                <div class=\"tabla__una\" fxFlex=\"100\">\r\n                    <table class=\"tabla tabla-ordenes-enviadas | background-white\">\r\n                        <thead>\r\n                            <tr class=\"tr | color-main\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                                <th class=\"th th--ml | color-accent\" fxFlex=\"100\">Resultado de verificación de documentos</th>\r\n                            </tr>\r\n                        </thead>\r\n\r\n                        <tbody class=\"tablas__tbody\">\r\n\r\n                            <tr class=\"tr th th--ml | color-third\" fxLayout=\"column\" fxLayoutAlign=\"none start\" *ngIf=\"validate==true\">\r\n                                <p class=\"th text\">La documentación del colaborador <span class=\"color-grey bold text\">puede ser actualizada</span>, los documentos son correctos.</p>\r\n                            </tr>\r\n                            <tr class=\"tr th th--ml | color-third\" fxLayout=\"column\" fxLayoutAlign=\"none start\" *ngIf=\"validate==false\">\r\n                                <p class=\"th text\">La documentación del colaborador <span class=\"color-red b