let EditGroupsPermissionUComponent = class EditGroupsPermissionUComponent {
    constructor(router, formBuilder, servicePermission, storage, dialog) {
        this.router = router;
        this.formBuilder = formBuilder;
        this.servicePermission = servicePermission;
        this.storage = storage;
        this.dialog = dialog;
        this.client = [];
        this.client2 = [];
        this.showLoad = false;
        this.validaNameGroup = false;
        this.showLoad = true;
        this.nombreCoModel = localStorage.getItem('name');
        this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
    }
    ngOnInit() {
        /**Obtiene toda la lista de permisos */
        this.servicePermission.getListPermission().subscribe((res1) => {
            this.client = res1[0].permisos;
            //console.log(this.client);
            /**Obtiene solo los permisos del grupo */
            this.servicePermission.getListGroupPermission(this.id + '*' + this.nombreCoModel).subscribe((res2) => {
                this.idPermission = res2.id;
                this.client2 = res2.permisos;
                for (let i = 0; i < this.client.length; i++) {
                    this.client[i].isSelected = false;
                    for (let j = 0; j < this.client2.length; j++) {
                        if (this.client[i].id === this.client2[j].id) {
                            this.client[i].isSelected = true;
                            break;
                        }
                    }
                }
                if (this.client.length == this.client2.length) {
                    this.CheckGPModel = true;
                }
                else {
                    this.CheckGPModel = false;
                }
                this.getCheckedItemList();
            });
        });
    }
    checkUncheckAll() {
        for (var i = 0; i < this.client.length; i++) {
            this.client[i].isSelected = this.CheckGPModel;
        }
        this.getCheckedItemList();
    }
    isAllSelected() {
        this.CheckGPModel = this.client.every(function (item) {
            return item.isSelected == true;
        });
        this.getCheckedItemList();
    }
    getCheckedItemList() {
        this.checkedCategoryList = [];
        for (var i = 0; i < this.client.length; i++) {
            if (this.client[i].isSelected)
                this.checkedCategoryList.push(this.client[i]);
        }
        this.checkedCategoryList = this.checkedCategoryList;
        this.showLoad = false;
    }
    //Variables que faltan
    submit() {
        this.validaNameGroup = false;
        if (this.nombreCoModel.length == 0) {
            this.validaNameGroup = true;
            this.showLoad = false;
            return;
        }
        this.getCheckedItemList();
        const namePermiso = this.id + "*" + this.nombreCoModel;
        const groupPermiso = [];
        for (let i = 0; i < this.checkedCategoryList.length; i++) {
            groupPermiso.push(this.checkedCategoryList[i].id);
        }
        let updateNamePermisos = {
            'nameGroup': namePermiso,
            'aPermissions': groupPermiso
        };
        this.showLoad = true;
        this.servicePermission.editGroupPermission(updateNamePermisos, this.idPermission).subscribe((res) => {
            let message = this.dialog.open(_messageUser_success_user_success_user_component__WEBPACK_IMPORTED_MODULE_13__["SuccessUserComponent"], {
                data: {
                    success: 'GP-001',
                    messageNormal: 'Tu operación se realizó satisfactoriamente.'
                },
                disableClose: true,
            });
            message.afterClosed().subscribe(res => {
                if (res == 'Aceptar') {
                    this.showLoad = false;
                    this.router.navigateByUrl('/usuario/administration/grouppermission/listgroupspermission');
                }
            });
        }, (error) => {
            //console.log('Error');
            //console.log(error.error.detail[0][0].message);
            this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_12__["ErrorUserComponent"], {
                data: {
                    error: 'D-005',
                    messageNormal: error.error.detail[0][0].message
                },
                disableClose: true,
            });
            this.showLoad = false;
        });
    }
};
