let CardRequestCollaboratorComponent = class CardRequestCollaboratorComponent {
    constructor(dialog, serviceCards, storageHome, storageClient, router) {
        this.dialog = dialog;
        this.serviceCards = serviceCards;
        this.storageHome = storageHome;
        this.storageClient = storageClient;
        this.router = router;
        this.cuenta = "";
        this.clasica = 0;
        this.platino = 0;
        this.dorada = 0;
        this.showLoad = false;
        this.cards = [];
        this.clasicaSolicitud = 0;
        this.platinoSolicitud = 0;
        this.doradaSolicitud = 0;
        this.cardsDisponibles = {
            Clasicas: [],
            Platino: [],
            Doradas: []
        };
        if (JSON.parse(this.storageHome.infoUserValue).data_empresa.commissions.length >= 3) {
            //console.log('tp y t');
            this.idAccount = JSON.parse(this.storageHome.infoUserValue).cuenta_id;
            // this.idAccount = this.dataAccountt.persona_cuenta_id;
            // //console.log(this.idAccount);
            if (this.storageClient.InfoCostCenterExist == false) {
                //console.log("bye");
                // this.dataAccountt = JSON.parse(this.storage.infoUserValue);
                //Aqui va dialog para crear centros de costos     
            }
            else {
                //console.log('si hay centros de costos');
                this.dataAccountt = JSON.parse(this.storageClient.InfoCostCenterValue);
                this.idCC = this.dataAccountt.persona_cuenta_id;
                //console.log(this.dataAccountt)
                //console.log(this.dataAccountt.persona_cuenta_id);
            }
        }
        else {
            if (JSON.parse(this.storageHome.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storageHome.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    //console.log('tp');
                    this.dataAccountt = JSON.parse(this.storageHome.infoUserValue);
                    this.idCC = this.dataAccountt.data_empresa.cuenta_eje.id;
                }
                else {
                    if (JSON.parse(this.storageHome.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        //console.log('t');
                        //console.log(this.storageClient.InfoCostCenterExist );
                        if (this.storageClient.InfoCostCenterExist == false) {
                            //console.log("bye");
                            //  this.dataAccountt = JSON.parse(this.storage.infoUserValue);
                            //  this.idAccount = this.dataAccountt.data_empresa.cuenta_eje.name;
                            //Aqui va el dialog para llevar a crear centros de costos
                        }
                        else {
                            //console.log("si hay servicios ");
                            this.idCC = this.dataAccountt.persona_cuenta_id;
                            //  //console.log(this.dataAccountt)
                            //  //console.log(this.dataAccountt.persona_cuenta_id);
                            //  this.empresa = this.dataAccountt.persona_cuenta__name;
                        }
                    }
                }
            }
        }
        this.getCardsA();
        this.getListCards();
        //console.log(this.idCC);
    }
    ngOnInit() {
    }
    clasicaSolicitudMas() {
        this.clasicaSolicitud++;
    }
    clasicaSolicitudMenos() {
        if (this.clasicaSolicitud != 0) {
            this.clasicaSolicitud--;
        }
    }
    platinoSolicitudMas() {
        this.platinoSolicitud++;
    }
    platinoSolicitudMenos() {
        if (this.platinoSolicitud != 0) {
            this.platinoSolicitud--;
        }
    }
    doradaSolicitudMas() {
        this.doradaSolicitud++;
    }
    doradaSolicitudMenos() {
        if (this.doradaSolicitud != 0) {
            this.doradaSolicitud--;
        }
    }
    regresar() {
        // this.router.navigate(['/usuario/dispersiones/tarjetas']);
        this.router.navigate(['/usuario/dispersiones/tarjetas/solicitudes-tarjetas-centros-costos']);
    }
    cancelar() {
        this.clasicaSolicitud = 0;
        this.platinoSolicitud = 0;
        this.doradaSolicitud = 0;
        // this.router.navigate(['/usuario/dispersiones/tarjetas']);
        this.router.navigate(['/usuario/dispersiones/tarjetas/solicitudes-tarjetas-centros-costos']);
    }
    confirmar() {
        const data = {
            // Clasica: this.clasicaSolicitud,
            Clasica: this.checkedCategoryList,
            Platino: this.platinoSolicitud,
            Dorada: this.doradaSolicitud
        };
        //console.log(data);
        this.showLoad = true;
        this.serviceCards.SolCardsCenterCost(this.idAccount, this.idCC, data).subscribe(res => {
            this.showLoad = false;
            //console.log(res);
            let dialog = this.dialog.open(_messageUser_success_user_success_user_component__WEBPACK_IMPORTED_MODULE_11__["SuccessUserComponent"], {
                data: {
                    success: 'ST-001'
                },
                disableClose: true
            });
            dialog.afterClosed().subscribe(res => {
                this.router.navigate(['/usuario/dispersiones/tarjetas/solicitudes-tarjetas-centros-costos']);
                this.dialog.closeAll();
            });
        }, error => {
            this.showLoad = false;
            //console.log(error);
            let dialog = this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_10__["ErrorUserComponent"], {
                data: {
                    error: 'TCC-001',
                    messageNormal: error.error.Clasica[0]
                },
                disableClose: true
            });
            dialog.afterClosed().subscribe(res => {
                this.router.navigate(['/usuario/dispersiones/tarjetas/solicitudes-tarjetas-centros-costos']);
                this.dialog.closeAll();
            });
        });
    }
    getCardsA() {
        this.showLoad = true;
        this.serviceCards.getAllCardsAv(this.idAccount).subscribe(res => {
            //console.log(res);
            this.showLoad = false;
            this.cardsDisponibles = res;
        }, error => {
            this.showLoad = false;
            //console.log(error);
        });
    }
    getListCards() {
        this.showLoad = true;
        this.serviceCards.getAllCards(this.idAccount).subscribe(res => {
            this.showLoad = false;
            //console.log(res);
            this.cards = res.Clasicas;
        }, error => {
            this.showLoad = false;
            //console.log(error);
        });
    }
    isAllSelected() {
        this.CheckGPModel = this.cards.every(function (item) {
            return item.isSelected == true;
        });
        this.getCheckedItemList();
    }
    getCheckedItemList() {
        this.checkedCategoryList = [];
        for (var i = 0; i < this.cards.length; i++) {
            if (this.cards[i].isSelected)
                this.checkedCategoryList.push(this.cards[i].id);
        }
        this.checkedCategoryList = this.checkedCategoryList;
        //console.log(this.checkedCategoryList);
        this.showLoad = false;
    }
};
