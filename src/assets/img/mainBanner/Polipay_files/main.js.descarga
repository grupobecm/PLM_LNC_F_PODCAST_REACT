let ExpensesComponent = class ExpensesComponent {
    constructor(dialog, serviceClient, storageClient, storageClient2, serviceAdmin) {
        this.dialog = dialog;
        this.serviceClient = serviceClient;
        this.storageClient = storageClient;
        this.storageClient2 = storageClient2;
        this.serviceAdmin = serviceAdmin;
        this.displayedColumns = ['nombre_beneficiario', 'concepto', 'numCuenta', 'monto', 'saldo_remanente', 'fecha_creacion'];
        this.listPending = [];
        this.showLoad = false;
        this.noData = false;
        this.numRegister = 0;
        this.cuenta = "";
        let numAccountAA;
        if (JSON.parse(this.storageClient.infoUserValue).data_empresa.commissions.length >= 3) {
            //console.log('tp y t');
            //this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
            ////console.log(this.id);
            if (this.storageClient2.InfoCostCenterExist == false) {
                //console.log("bye");
                this.dataService = JSON.parse(this.storageClient.infoUserValue);
                //Aqui va dialog para crear centros de costos
            }
            else {
                //console.log('si hay centros de costos');
                this.dataService = JSON.parse(this.storageClient2.InfoCostCenterValue);
                this.id = this.dataService.persona_cuenta_id;
            }
        }
        else {
            if (JSON.parse(this.storageClient.infoUserValue).data_empresa.commissions.length == 2) {
