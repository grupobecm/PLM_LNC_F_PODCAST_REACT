    }
    openDialog() {
        this.dialog.closeAll();
        let mensaje = this.dialog.open(_Views_general_messages_general_messages_component__WEBPACK_IMPORTED_MODULE_6__["GeneralMessagesComponent"], {
            data: {
                success: 1,
            },
            disableClose: true,
        });
        mensaje.afterClosed().subscribe(res => {
            sessionStorage.removeItem("session");
            sessionStorage.removeItem("rol");
            sessionStorage.removeItem("data_user");
            sessionStorage.removeItem("email");
            sessionStorage.removeItem("id");
            location.reload();
        });
    }
};
