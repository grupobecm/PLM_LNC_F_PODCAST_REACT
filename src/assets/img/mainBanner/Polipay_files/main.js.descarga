/* harmony default export */ __webpack_exports__["default"] = ("<div class=\"padding-content\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n    <div fxFlex=\"100\" fxLayoutAlign=\"space-between center\">\r\n        <button class=\"button-verification-code | color-third background-grey-dark \" type=\"button\"\r\n            (click)=\"openFilter()\">\r\n            FILTRO\r\n        </button>\r\n\r\n        <div class=\"descargas\" fxFlex=\"20\" fxLayoutAlign=\"space-evenly center\">\r\n            <img src=\"../../../../assets/img/icons/exp-xlsx.svg\" class=\"ocultarT\" (click)=\"exportarXlsx()\"\r\n                alt=\"Exportar XLSX\">\r\n            <div class=\"label-container\">\r\n                <label class=\"label__copy | color-white\" translate>User.Tooltip.ExportXLSX</label>\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"mat-elevation-z8 mt-3 table\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n        <table mat-table [dataSource]=\"listLiquidate\" fxFlex=\"100\" matSort>\r\n            <!-- Columna No se encontraron registros -->\r\n            <ng-container matColumnDef=\"noData\">\r\n                <td mat-footer-cell *matFooterCellDef [attr.colspan]=\"displayedColumns.length\" [attr.align]=\"'center'\">\r\n                    <span *ngIf=\"noData===true\">No se encontraron registros.</span>\r\n                </td>\r\n            </ng-container>\r\n            <!-- Data Cliente -->\r\n            <ng-container matColumnDef=\"observaciones\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Observaciones</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{ element.observations }}</td>\r\n            </ng-container>\r\n            <ng-container matColumnDef=\"fecha_creacion\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Fecha de dispersion</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{ element.date_created | date:'dd/MM/yyyy HH:mm' }} Hrs.</td>\r\n            </ng-container>\r\n            <ng-container matColumnDef=\"creadaPor\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Creada por</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{ element.usuarioRel__last_name }} {{ element.usuarioRel__name}}\r\n                </td>\r\n            </ng-container>\r\n\r\n            <ng-container matColumnDef=\"button\">\r\n                <th mat-header-cell *matHeaderCellDef></th>\r\n                <td mat-cell *matCellDef=\"let element\">\r\n                    <div>\r\n                        <button class=\"verdetalles_button quitmrg  | background-opacity-main color-white\"\r\n                            (click)=\"seeDetails(element)\" fxLayoutAlign=\"center center\" fxFlex.xl=\"60\">\r\n                            <span class=\"\"><img src=\"../../../../../../../../assets/img/icons/eye-icon_blue.svg\"\r\n                                    alt=\"\"></span>\r\n                        </button>\r\n                    </div>\r\n                </td>\r\n            </ng-container>\r\n            <tr mat-header-row *matHeaderRowDef=\"displayedColumns\"></tr>\r\n            <tr mat-row *matRowDef=\"let row; columns: displayedColumns\"></tr>\r\n            <tr mat-footer-row *matFooterRowDef=\"['noData']\" [hidden]=\"numRegister > 0\"></tr>\r\n\r\n        </table>\r\n        <mat-paginator fxFlex=\"100\" [pageSizeOptions]=\"[100]\" showFirstLastButtons></mat-paginator>\r\n    </div>\r\n\r\n</div>\r\n\r\n<!-- Loading -->\r\n<app-loading *ngIf=\"showLoad\"></app-loading>");

