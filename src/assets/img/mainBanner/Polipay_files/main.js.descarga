        this.imageFav = '../../../../../../../assets/img/icons/favoriteB.svg';
        this.imageFav != '../../../../../../../assets/img/icons/favoriteG.svg';
        this.favorite = !this.favorite;
    }
    NoFavorite(event) {
        this.imageFav != '../../../../../../../assets/img/icons/favoriteB.svg';
        this.imageFav = '../../../../../../../assets/img/icons/favoriteG.svg';
        this.favorite = !this.favorite;
    }
    ListTransfer() {
        this.showLoad = true;
        this.pagina_actual = 1;
