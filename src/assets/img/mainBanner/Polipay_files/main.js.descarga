    getAddressFormat(data) {
        return data.calle +
            " " +
            data.no_exterior +
            " " +
            (data.no_interior == null ? "" : data.no_interior) +
            ", Col. " +
            data.colonia +
            ", " +
            data.alcaldia_mpio +
            ", " +
            data.estado +
            ", C.P. " +
            data.codigopostal +
            ", " +
            data.pais;
    }
    getDocumentsId(data) {
        //console.log(data.RazonSocial.Documentos);
        for (let i = 0; i < data.RazonSocial.Documentos.length; i++) {
            let doc = data.RazonSocial.Documentos;
            if (String(this.typeDev) == "19") {
                if (doc[i].tipo_documento[0].id == 5) {
                    if (doc[i].status == "D") {
                        this.fileurl1 = doc[i].documento;
                        this.fileurl2 = doc[i + 1].documento;
                        this.fileid1 = doc[i].id;
                        this.fileid2 = doc[i + 1].id;
                        this.status1 = doc[i].status;
                        this.status2 = doc[i + 1].status;
                        this.comment1 = doc[i].comentario == null ? '' : doc[i].comentario;
                        this.comment2 = doc[i + 1].comentario == null ? '' : doc[i + 1].comentario;
                        //console.log("SAT", this.fileid1);
                        //console.log("DOC", this.fileid2);
                    }
                }
                if (doc[i].tipo_documento[0].id == 8) {
                    if (doc[i].status == "D") {
                        this.fileurl2 = doc[i].documento;
                        this.fileurl1 = doc[i - 1].documento;
                        this.fileid2 = doc[i].id;
                        this.fileid1 = doc[i - 1].id;
                        this.status2 = doc[i].status;
                        this.status1 = doc[i - 1].status;
                        this.comment2 = doc[i].comentario == null ? '' : doc[i].comentario;
                        this.comment1 = doc[i - 1].comentario == null ? '' : doc[i - 1].comentario;
                        //console.log("SAT", this.fileid2);
                        //console.log("DOC", this.fileid1);
                    }
                }
            }
            if (String(this.typeDev) == "21") {
                if (doc[i].tipo_documento[0].id == 6) {
                    if (doc[i].status == "D") {
                        this.fileurl3 = doc[i].documento;
                        this.fileid3 = doc[i].id;
                        this.status3 = doc[i].status;
