Align=\"center center\">\r\n                    <p fxFlex=\"75\" class=\"texto\" fxLayoutAlign=\"end center\">{{ (balance * percentageTP)/100 + balance | currency}} MXN</p>\r\n                    <p fxFlex=\"25\" class=\"relleno\" fxLayoutAlign=\"center center\"></p>\r\n                </div>\r\n\r\n            </div>\r\n\r\n            <div class=\"data__iva\" fxFlex=\"100\">\r\n                <div class=\"relleno\" fxFlex=\"100\"></div>\r\n                <div fxFlex=\"100\">\r\n                    <div fxFlex=\"100\"></div>\r\n                    <p fxFlex=\"100\" class=\"cabecera__texto | color-main\" fxLayoutAlign=\"end center\">I.V.A. (Comisión)</p>\r\n                </div>\r\n\r\n                <div class=\"subtotal subtotal--notBorder\" fxFlex=\"100\" fxLayoutAlign=\"center center\">\r\n                    <p fxFlex=\"75\" class=\"texto\" fxLayoutAlign=\"end center\">{{ (((balance * percentageTP)/100)*iva)/100 | currency }} MXN</p>\r\n                    <p fxFlex=\"25\" class=\"relleno\" fxLayoutAlign=\"center center\"></p>\r\n                </div>\r\n            </div>\r\n            <div class=\"data__iva\" fxFlex=\"100\">\r\n                <div class=\"relleno\" fxFlex=\"100\"></div>\r\n                <div fxFlex=\"100\">\r\n                    <div fxFlex=\"100\"></div>\r\n                    <p fxFlex=\"100\" class=\"cabecera__texto cabecera__texto--hasBorder total total--notPadding | color-main\" fxLayoutAlign=\"end center\">TOTAL</p>\r\n                </div>\r\n\r\n                <div class=\"subtotal total\" fxFlex=\"100\" fxLayoutAlign=\"center center\">\r\n                    <p fxFlex=\"75\" class=\"texto\" fxLayoutAlign=\"end center\"><b>{{  ((balance * percentageTP)/100 + balance) + ((((balance * percentageTP)/100)*iva)/100) | currency}} MXN</b></p>\r\n                    <p fxFlex=\"25\" class=\"relleno\" fxLayoutAlign=\"center center\"></p>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"saldo__botones\" fxFlex=\"25\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\">\r\n            <button class=\"cancelar__button | color-white \" (click)=\"cancelar()\">Cancelar</button>\r\n            <button class=\"confirmar__button | color-white \" type=\"submit\">Confirmar</button>\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n</form> -->\r\n<!-- Loading -->\r\n<app-loading *ngIf=\"showLoad\"></app-loading>");

