let CanceledAdminFiltroIndividualComponent = class CanceledAdminFiltroIndividualComponent {
    constructor(data, dialogRef, formBuilder, router, dateAdapter) {
        this.data = data;
        this.dialogRef = dialogRef;
        this.formBuilder = formBuilder;
        this.router = router;
        this.dateAdapter = dateAdapter;
        /* Mostrar y cultar el select */
        this.flg = true;
        this.index = 9999;
        this.arrayindividual = ["Beneficiario", "Fecha de Operación", "Clave de Rastreo", "Folio1"];
        this.arrayMasiva = ["Observaciones", "Fecha de Dispersión", "Folio2"];
        this.Cuenta_Beneficiario = "";
        this.fecha1 = "null";
        this.fecha2 = "null";
        this.clave = "";
        this.folio = "";
        this.observaciones = "";
        this.datenow = new Date();
        this.form = this.formBuilder.group({
            filtro: new _angular_forms__WEBPACK_IMPORTED_MODULE_5__["FormArray"]([]),
        });
        this.dateAdapter.setLocale('es');
        // this.size = data.numeroRegistrosMostrar;
        //this.empresa = this.storage.CurrentInfo.nombre;
    }
    get f() { return this.form.controls; }
    get t() { return this.f.filtro; }
    ngOnInit() {
        this.addOption();
    }
    removeOption(i) {
        let val = document.getElementsByClassName("input_select")[i].innerHTML;
        //console.log("->", val);
        switch (val) {
            case 'Beneficiario':
                this.arrayindividual[0] = val;
                break;
            case 'Clave de Rastreo':
                this.arrayindividual[1] = val;
                break;
            case 'Fecha de Operación':
                this.arrayindividual[2] = val;
                break;
            case 'Observaciones':
                this.arrayMasiva[0] = val;
                break;
            case 'Fecha de Dispersión':
                this.arrayMasiva[1] = val;
                break;
            case 'Folio':
                if (this.router.url.includes("invidualStatusTransferT")) {
                    this.arrayindividual[3] = "Folio1";
                }
                else {
                    this.arrayMasiva[2] = "Folio2";
                }
                break;
            default:
                break;
        }
        //console.log(this.arrayindividual);
        this.t.removeAt(i);
    }
    addOption() {
        if (this.t.length < 4) {
            this.t.push(this.formBuilder.group({
                campo: [''],
                valor: ['', _angular_forms__WEBPACK_IMPORTED_MODULE_5__["Validators"].required]
            }));
            let refresh = setInterval(function () {
                let input = document.getElementsByClassName("input_select");
                let select = document.getElementsByClassName("select");
                let arr_input = Array.prototype.slice.call(input);
                let arr_select = Array.prototype.slice.call(select);
                for (let i = 0; i < arr_input.length; i++) {
                    arr_select[i].style.width = (arr_input[i].offsetWidth) + "px";
                    arr_select[i].style.cssText += 'z-index: 999 !important';
                }
                clearInterval(refresh);
            }, 10);
        }
    }
    // Select selecciona un elemento
    select(val, i) {
        // Obtiene el "campo" seleccionado (Por "campo" quiero decir select e input) todo ese bloque
        let campos = (document.getElementsByClassName("filtro")[i]).getElementsByClassName("valor");
        // Obtiene unicamente el input select (donde se muetra la opcion seleccionada del select) 
        let input_actual = document.getElementsByClassName("input_select")[i].innerHTML;
        if (input_actual != "") {
            switch (input_actual) {
                case 'Beneficiario':
                    this.arrayindividual[0] = input_actual;
                    break;
                case 'Clave de Rastreo':
                    this.arrayindividual[1] = input_actual;
                    break;
                case 'Fecha de Operación':
                    this.arrayindividual[2] = input_actual;
                    break;
                case 'Observaciones':
                    this.arrayMasiva[0] = input_actual;
                    break;
                case 'Fecha de Dispersión':
                    this.arrayMasiva[1] = input_actual;
                    break;
                case 'Folio':
                    if (this.router.url.includes("individual")) {
                        this.arrayindividual[3] = "Folio1";
                    }
                    else {
                        this.arrayMasiva[2] = "Folio2";
                    }
                    break;
            }
        }
        // Habilita y muestra los campos seleccionados
        switch (val) {
            case 'Beneficiario':
                campos[0].style.display = "block";
                campos[1].style.display = "none";
                campos[2].style.display = "none";
                campos[3].style.display = "none";
                campos[0].disabled = false;
                this.arrayindividual[0] = null;
                document.getElementsByClassName("input_select")[i].innerHTML = "Beneficiario";
                break;
            case 'Clave de Rastreo':
                campos[0].style.display = "none";
                campos[1].style.display = "block";
                campos[2].style.display = "none";
                campos[3].style.display = "none";
                campos[1].disabled = false;
                this.arrayindividual[1] = null;
                document.getElementsByClassName("input_select")[i].innerHTML = 'Clave de Rastreo';
                break;
            case 'Fecha de Operación':
                campos[0].style.display = "none";
                campos[1].style.display = "none";
                campos[2].style.display = "block";
                campos[3].style.display = "none";
                campos[2].classList.remove("disabled");
                this.arrayindividual[2] = null;
                document.getElementsByClassName("input_select")[i].innerHTML = 'Fecha de Operación';
                break;
            case 'Folio1':
                campos[0].style.display = "none";
                campos[1].style.display = "none";
                campos[2].style.display = "none";
                campos[3].style.display = "block";
                campos[3].disabled = false;
                this.arrayindividual[3] = null;
                document.getElementsByClassName("input_select")[i].innerHTML = 'Folio';
                break;
            case 'Observaciones':
                campos[0].style.display = "block";
                campos[1].style.display = "none";
                campos[2].style.display = "none";
                campos[0].disabled = false;
                this.arrayMasiva[0] = null;
                document.getElementsByClassName("input_select")[i].innerHTML = 'Observaciones';
                break;
            case 'Folio2':
                campos[0].style.display = "none";
                campos[1].style.display = "block";
                campos[2].style.display = "none";
                campos[1].disabled = false;
                this.arrayMasiva[2] = null;
                document.getElementsByClassName("input_select")[i].innerHTML = 'Folio';
                break;
            case 'Fecha de Dispersión':
                campos[0].style.display = "none";
                campos[1].style.display = "none";
                campos[2].style.display = "block";
                campos[2].classList.remove("disabled");
                this.arrayMasiva[1] = null;
                document.getElementsByClassName("input_select")[i].innerHTML = 'Fecha de Dispersión';
                break;
        }
        input_actual = val;
        this.ocultar(i);
    }
    // Boton de Aceptar
    onSubmit() {
        let campos = document.getElementsByClassName("input_select");
        for (let i = 0; i < campos.length; i++) {
            this.form.value.filtro[i].campo = document.getElementsByClassName("input_select")[i].innerHTML;
        }
        //console.log("->",this.form.value);
        this.dialogRef.close({ data: this.form.value });
    }
    // Boton de Aceptar
    onSubmit2() {
        let campos = document.getElementsByClassName("input_select");
        for (let i = 0; i < campos.length; i++) {
            this.form.value.filtro[i].campo = document.getElementsByClassName("input_select")[i].innerHTML;
        }
        //console.log("->",this.form.value);
        if (this.mostrarIndividualMasiva()) {
            //console.log("individual");
            this.showLoad = true;
            let filtro = this.form.value.filtro;
            for (let i = 0; i < filtro.length; i++) {
                switch (filtro[i].campo) {
                    case "Beneficiario":
                        this.Cuenta_Beneficiario = filtro[i].valor;
                        break;
                    case "Clave de Rastreo":
                        this.clave = filtro[i].valor;
                        break;
                    case "Folio":
                        this.folio = filtro[i].valor;
                        break;
                    case "Fecha de Operación":
                        this.fecha1 = (new Date(filtro[i].valor.begin).toISOString());
                        this.fecha2 = (new Date(filtro[i].valor.end).toISOString());
                        let aux = this.fecha2.split('');
                        ////console.log("-------");
                        ////console.log(aux);
                        ////console.log("-------");
                        aux[10] = " ";
                        aux[11] = "2";
                        aux[12] = "3";
                        aux[14] = "5";
                        aux[15] = "9";
                        aux[17] = "0";
                        aux[18] = "0";
                        aux[aux.length - 1] = "";
                        this.fecha2 = aux.join('');
                        //console.log(this.fecha2);
                        aux = this.fecha1.split('');
                        ////console.log("-------");
                        ////console.log(aux);
                        ////console.log("-------");
                        aux[10] = " ";
                        aux[11] = "0";
                        aux[12] = "0";
                        aux[14] = "0";
                        aux[15] = "1";
                        aux[17] = "0";
                        aux[18] = "0";
                        aux[aux.length - 1] = "";
                        this.fecha1 = aux.join('');
                        //console.log(this.fecha1);
                        break;
                    case "Observaciones":
                        this.observaciones = filtro[i].valor;
                        break;
                }
            }
            if (this.router.url.includes('/administrador/pendientes/individual') || this.router.url.includes('/administrador/canceladas/individual')
                || this.router.url.includes('administrador/sent/individual') || this.router.url.includes('/administrador/devueltas')) {
                if (this.fecha1 == 'null') {
                    this.fecha1 = '';
                }
                if (this.fecha2 == 'null') {
                    this.fecha2 = '';
                }
                //console.log("Filtro");
            }
            else {
                //console.log(this.fecha1);
                //console.log(this.fecha2);
            }
        }
        else {
            //console.log("masivas");
            this.showLoad = true;
            let filtro = this.form.value.filtro;
            for (let i = 0; i < filtro.length; i++) {
                switch (filtro[i].campo) {
                    case "Fecha de Dispersión":
                        this.fecha1 = (new Date(filtro[i].valor.begin).toISOString());
                        this.fecha2 = (new Date(filtro[i].valor.end).toISOString());
                        let aux = this.fecha2.split('');
                        aux[10] = " ";
                        aux[11] = "2";
                        aux[12] = "3";
                        aux[14] = "5";
                        aux[15] = "9";
                        aux[17] = "0";
                        aux[18] = "0";
                        aux[aux.length - 1] = "";
                        this.fecha2 = aux.join('');
                        ////console.log(this.fecha2);
                        aux = this.fecha1.split('');
                        aux[10] = " ";
                        aux[11] = "0";
                        aux[12] = "0";
                        aux[14] = "0";
                        aux[15] = "0";
                        aux[17] = "0";
                        aux[18] = "0";
                        aux[aux.length - 1] = "";
                        this.fecha1 = aux.join('');
                        ////console.log(this.fecha1);
                        break;
                    case "Observaciones":
                        this.observaciones = filtro[i].valor;
                        break;
                }
            }
            if (this.fecha1 == 'null') {
                this.fecha1 = '';
            }
            if (this.fecha2 == 'null') {
                this.fecha2 = '';
            }
        }
    }
    // Muetra los campos dependiendo si es individual o masiva
    mostrarIndividualMasiva() {
        return this.router.url.includes("invidualStatusTransferT") || this.router.url.includes("/individual") || this.router.url.includes("/devueltas");
    }
    // Muestra el icono de + dependiendo si es individual o masiva
    aparecer(i) {
        if (this.router.url.includes("invidualStatusTransferT")) {
            // Para individual
            // Si es el ultimo elemento muestra el + pero si es el ultimo elemento de los 4
            // permitidos no lo muetra
            if (i == this.t.length - 1 && i < 3) {
                return true;
            }
            return false;
        }
        else {
            // Para masivas
            // Si es el ultimo elemento muestra el + pero si es el ultimo elemento de los 3
            // permitidos no lo muetra
            if (i == this.t.length - 1 && i < 2) {
                return true;
            }
            return false;
        }
    }
    // Si el elemento del select se encuentra dentro del arreglo arrayindividual lo muestra,
    // si no, no lo muestra. Esto es para no mostrar campos ya usados/repetidos
    usadoIndividual(item) {
        if (this.arrayindividual.includes(item)) {
            return true;
        }
        return false;
    }
    // Si el elemento del select se encuentra dentro del arreglo arrayMasiva lo muestra,
    // si no, no lo muestra. Esto es para no mostrar campos ya usados/repetidos
    usadoMasivo(item) {
