let SeegroupsFtComponent = class SeegroupsFtComponent {
    constructor(serviceClient, storage, router, storageClient) {
        this.serviceClient = serviceClient;
        this.storage = storage;
        this.router = router;
        this.storageClient = storageClient;
        this.cuenta = "";
        this.showLoad = false;
        // this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
        if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length >= 3) {
            //console.log('tp y t');
            // this.idAccount = this.dataAccountt.persona_cuenta_id;
            // //console.log(this.idAccount);
            if (this.storageClient.InfoCostCenterExist == false) {
                //console.log("bye");
                // this.dataAccountt = JSON.parse(this.storage.infoUserValue);
                //Aqui va dialog para crear centros de costos     
            }
            else {
                //console.log('si hay centros de costos');
                this.dataAccountt = JSON.parse(this.storageClient.InfoCostCenterValue);
                this.id = this.dataAccountt.persona_cuenta_id;
                //console.log(this.dataAccountt)
                //console.log(this.dataAccountt.persona_cuenta_id);
            }
        }
        else {
            if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    //console.log('tp');
                    this.dataAccountt = JSON.parse(this.storage.infoUserValue);
                    this.id = this.dataAccountt.data_empresa.cuenta_eje.id;
                }
                else {
                    if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        //console.log('t');
                        //console.log(this.storageClient.InfoCostCenterExist );
                        if (this.storageClient.InfoCostCenterExist == false) {
                            //console.log("bye");
                            //  this.dataAccountt = JSON.parse(this.storage.infoUserValue);
                            //  this.idAccount = this.dataAccountt.data_empresa.cuenta_eje.name;
                            //Aqui va el dialog para llevar a crear centros de costos
                        }
                        else {
                            //console.log("si hay servicios ");
                            this.id = this.dataAccountt.persona_cuenta_id;
                            //  //console.log(this.dataAccountt)
                            //  //console.log(this.dataAccountt.persona_cuenta_id);
                            //  this.empresa = this.dataAccountt.persona_cuenta__name;
                        }
                    }
                }
            }
        }
        //console.log(this.id);
        //console.log(this.id)
        this.getListaGrupoFreq();
    }
    ngOnInit() {
    }
    getListaGrupoFreq() {
        this.showLoad = true;
        this.serviceClient.seeFrecuentContact(this.id).subscribe((res) => {
            this.showLoad = false;
            this.groupFrec = res;
            //console.log(this.groupFrec);
        });
    }
    adminGroup(dato) {
        this.storageClient.setInfoFrequentT(dato);
        this.router.navigate(['/usuario/transactions/frequent-accounts/frequent-third/groupsfrecuentesterceros/editgroupsterceros']);
        //console.log(dato);
    }
};
SeegroupsFtComponent.ctorParameters = () => [
    { type: src_app_services_servicesClient_transactions_frecuentServices__WEBPACK_IMPORTED_MODULE_5__["FrecuentService"] },
    { type: src_app_services_storageHome_storage_home_service__WEBPACK_IMPORTED_MODULE_7__["StorageHomeService"] },
    { type: _angular_router__WEBPACK_IMPORTED_MODULE_4__["Router"] },
    { type: src_app_services_storageClient_storage_client_service__WEBPACK_IMPORTED_MODULE_6__["StorageClientService"] }
];
