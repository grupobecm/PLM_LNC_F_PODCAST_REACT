    aparecer(i) {
        return i == 0 ? true : false;
    }
    max() {
        return this.t.length == this.auxMax ? false : true;
    }
    terminacion(i, ter) {
        switch (ter) {
            case "ER":
                return i == 1 || i == 3 ? true : false;
            case "DO":
                return i == 2 ? true : false;
            case "TO":
                return i >= 4 && i <= 7 ? true : false;
            case "VO":
                return i == 8 ? true : false;
            case "NO":
                return i == 9 ? true : false;
            case "MO":
                return i % 10 == 0 ? true : false;
            case "AVO":
                return i % 10 != 0 && i > 10 ? true : false;
            default:
                return false;
        }
    }
    ValidarCheck1() {
        if (this.is_admin && this.addworker) {
            this.auxMax = 4;
        }
        if (!this.is_admin && this.addworker) {
            this.auxMax = 5;
        }
        if (!this.is_admin && !this.addworker) {
            this.addworker = true;
            this.showPersonal = true;
        }
        if (!this.addworker) {
            this.showPersonal = false;
        }
        if (this.is_admin) {
            if (this.t.length == 5) {
                this.removeOption(4);
            }
        }
    }
    ValidarCheck2() {
        this.showPersonal = true;
        if (this.is_admin && this.addworker) {
            this.auxMax = 4;
        }
        if (!this.is_admin && this.addworker) {
            this.auxMax = 5;
        }
        if (!this.is_admin && !this.addworker) {
            this.is_admin = true;
        }
        if (!this.addworker) {
            this.showPersonal = false;
        }
    }
    requeridoEspecificaciones() {
        this.form.get("Especificaciones").errors == null ? false : true;
    }
    /* AVANZAR ENTRE LOS PASOS */
    alPaso1() {
        this.paso1 = true;
        this.paso2 = false;
        this.paso3 = false;
    }
    alPaso2() {
        this.t.controls = [];
        this.addOption();
        this.documents_razon_social.controls = [];
        for (let i = 0; i < 7; i++) {
            this.addDocument_rs();
        }
        this.documents_representante_legal.controls = [];
        for (let i = 0; i < 3; i++) {
            this.addDocument_rl();
        }
        if (this.vacios_rs()) {
            for (let i = 0; i < this.campos_rs.length; i++) {
                document.getElementById(this.campos_rs[i]).focus();
            }
            this.auxFlgBanco = 1;
            this.auxFlgColonia1 = 1;
        }
        else if (this.requerido_rs()) {
            // console.log("Algo anda mal");
            // console.log(this.form.get("calle").value);
            // console.log(this.form.get("no_exterior").value);
            // console.log(this.form.value);
        }
        else {
            this.form
                .get("fecha_nacimiento_rs")
                .setValue(new Date(this.form.get("fecha_nacimiento_rs").value)
                .toISOString()
                .split("T")[0]);
            this.paso1 = false;
            this.paso2 = true;
            this.paso3 = false;
        }
    }
    alPaso3() {
        this.paso1 = false;
        this.paso2 = false;
        this.paso3 = true;
    }
    /* FIN AVANZAR ENTRE LOS PASOS */
    codigoPostal(postal_code, numeroFormulario) {
        this.showLoad = true;
        if (numeroFormulario == 1) {
            this.colonia = "\u00a0";
            this.form.get("colonia").setValue("");
        }
        else {
            this.colonia_legal = "\u00a0";
            this.form.get("colonia_rl").setValue("");
        }
        this.serviceBank.codigoPostal(postal_code).subscribe((res) => {
            this.direccion = res;
            // console.log("R=", this.direccion);
            if (this.direccion.status == "REQUEST_DENIED") {
                // console.log("DESHABILITAR CAMPO");
                this.flagColonia1 = true;
                this.flagColonia2 = true;
            }
            if (!(this.direccion.status == "ZERO_RESULTS")) {
                /* OBTENER COLONIAS */
                if (numeroFormulario == 1) {
                    this.colonias = this.direccion.results[0].postcode_localities;
                    if (this.colonias == undefined) {
                        this.colonias = [];
                        this.colonias.push(this.direccion.results[0].address_components[1].long_name);
                    }
                }
                else {
                    this.colonias_legal = this.direccion.results[0].postcode_localities;
                    if (this.colonias_legal == undefined) {
                        this.colonias_legal = [];
                        this.colonias_legal.push(this.direccion.results[0].address_components[1].long_name);
                    }
                }
                /* OBTENER ESTADO */
                this.estadoMunicipio =
                    this.direccion.results[0].address_components[3].long_name;
                /* OBTENER ALCALDIA/MUNICIPIO */
                this.alcaldia =
                    this.direccion.results[0].address_components[2].long_name;
                if (numeroFormulario == 1) {
                    this.EstadoE = this.estadoMunicipio;
                    this.AlcaldiaE = this.alcaldia;
                }
                else {
                    this.estado_legalModel = this.estadoMunicipio;
                    this.municipio_legalModel = this.alcaldia;
                }
                this.flagColonia1 = false;
                this.flagColonia2 = false;
            }
            else {
                // console.log("DESHABILITAR CAMPO");
                this.flagColonia1 = true;
                this.flagColonia2 = true;
            }
        }, (error) => {
            //Error del service codigo postal
            // console.log(error);
        });
        this.showLoad = false;
    }
    buscar(e) {
        if (this.CPE.length == 5) {
            // console.log("Buscar");
            this.codigoPostal(this.CPE, 1);
        }
    }
    buscar2(e) {
        if (this.CP_legalModel.length == 5) {
            // console.log("Buscar");
            this.codigoPostal(this.CP_legalModel, 2);
        }
    }
    requeridoRFC_SR_Requerido() {
        // console.log(this.form.errors);
    }
    submit() {
        let documentErros = 0;
        for (let i = 0; i < this.documents_razon_social.length; i++) {
            if (this.documents_razon_social.controls[i].get("documento").value ==
                "formato") {
                this.arregloErrores_rs[i] = true;
                this.arregloErroresFormat_rs[i] = true;
                documentErros++;
            }
            else if (this.documents_razon_social.controls[i].get("documento").value ==
                "tamano") {
                this.arregloErrores_rs[i] = true;
                this.arregloErroresSize_rs[i] = true;
                documentErros++;
            }
            else if (this.documents_razon_social.controls[i].get("documento").value == "" &&
                i != 6) {
                this.documents_razon_social.controls[i]
                    .get("nombre")
                    .setValue("Ningún archivo seleccionado");
                this.arregloErrores_rs[i] = true;
                this.arregloErroresVacio_rs[i] = true;
                documentErros++;
            }
            else {
                this.arregloErrores_rs[i] = false;
            }
        }
        if (this.documents_razon_social.controls[6].get("documento").value != "" &&
            this.form.get("Especificaciones").value == "") {
            document.querySelector("#especificacionesId").focus();
            document.querySelector("#submit").focus();
            documentErros++;
        }
        for (let i = 0; i < this.documents_representante_legal.length; i++) {
            if (this.documents_representante_legal.controls[i].get("documento").value ==
                "formato") {
                this.arregloErrores_rl[i] = true;
                this.arregloErroresFormat_rl[i] = true;
                documentErros++;
            }
            else if (this.documents_representante_legal.controls[i].get("documento").value ==
                "tamano") {
                this.arregloErrores_rl[i] = true;
                this.arregloErroresSize_rl[i] = true;
                documentErros++;
            }
            else if (this.documents_representante_legal.controls[i].get("documento").value ==
