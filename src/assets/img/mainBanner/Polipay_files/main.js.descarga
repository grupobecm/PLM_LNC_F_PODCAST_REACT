                success: 12
            },
            disableClose: true,
        });
    }
    detalles() {
        this.service.detailsExternalClientFisico(this.id).subscribe(res => {
            //console.log(res);
            this.personaFisica = res;
            const address = res.domicilio[0];
            this.getAddressFormat(address);
            this.personaFisica.cliente_externo_fisico[0].person__fecha_nacimiento = this.personaFisica.cliente_externo_fisico[0].person__fecha_nacimiento.replace("-", "/");
            this.personaFisica.cliente_externo_fisico[0].person__fecha_nacimiento = this.personaFisica.cliente_externo_fisico[0].person__fecha_nacimiento.replace("-", "/");
        }, error => {
            //console.log(error);
        });
    }
    ;
    getAddressFormat(data) {
