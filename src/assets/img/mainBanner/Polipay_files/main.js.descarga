rds\"\r\n            fxLayoutAlign=\"start center\">\r\n            <mat-checkbox fxFlex=\"100\" class=\"mr-2 check\" color=\"primary\" value=\"{{permi.id}}\"\r\n                [(ngModel)]=\"permi.isSelected\" (change)=\"isAllSelected()\"><span class=\"checkname\"\r\n                    fxLayoutAlign=\"start center\">{{permi.tarjeta}}</span></mat-checkbox>\r\n        </div>\r\n        <!--<div class=\"cards\" fxFlex=\"100\" fxLayoutAlign=\"space-between center\">\r\n            <div class=\"card\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\" fxFlex=\"30\">\r\n                <p class=\"card__text | color-third\" fxFlex=\"100\">Clásica</p>\r\n                <div class=\"card__solicitar\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                    <button class=\"card__boton card__boton--left | background-main\" type=\"button\" (click)=\"clasicaSolicitudMenos()\">\r\n                        <img src=\"./../../../../../../assets/img/icons/less-icon.svg\" alt=\"Disminuir\">\r\n                    </button>\r\n                    <label for=\"card__input1\" class=\"card__label | background-white\">Piezas solicitadas*</label>\r\n                    <input id=\"card__input1\" class=\"card__input\" [(ngModel)]=\"clasicaSolicitud\" type=\"text\">\r\n                    <button class=\"card__boton card__boton--rigth | background-main\" type=\"button\" (click)=\"clasicaSolicitudMas()\">\r\n                        <img src=\"./../../../../../../assets/img/icons/plus-icon.svg\" alt=\"Ingrementar\">\r\n                    </button>\r\n                </div>\r\n            </div>\r\n             <div class=\"card\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\" fxFlex=\"30\">\r\n                <p class=\"card__text | color-third\" fxFlex=\"100\">Platino</p>\r\n                <div class=\"card__solicitar\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                    <button class=\"card__boton card__boton--left | background-main\" type=\