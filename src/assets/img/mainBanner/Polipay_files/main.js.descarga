let CollaboratorAdministrationComponent = class CollaboratorAdministrationComponent {
    constructor(formBuilder, router, storage) {
        this.formBuilder = formBuilder;
        this.router = router;
        this.storage = storage;
        this.showLoad = false;
        // Activo = true
        // Devuelto = false
        this.estado = true;
        if (this.storage.CenterCostExist || this.storage.CollaboratorExist) {
            //console.log(this.storage.Collaborator)
            this.collaborator = this.storage.Collaborator;
            this.center_cost = this.storage.CenterCost;
            this.estado = this.storage.Collaborator.estado;
        }
        else {
            this.router.navigate(['/administrador/cuentaeje/collaborator/lista-colaborador']);
        }
    }
    regresar() {
        this.router.navigate(['/administrador/cuentaeje/collaborator/lista-colaborador']);
    }
};
