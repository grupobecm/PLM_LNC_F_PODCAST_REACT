                                            ((creation_date2.getMonth() + 1).toString().length > 1 ? (creation_date2.getMonth() + 1) : '0' + (creation_date2.getMonth() + 1))
                                            + '-' + (creation_date2.getDate().toString().length > 1 ? creation_date2.getDate() : '0' + creation_date2.getDate());
                                    break;
                            }
                        }
                    }
                }
                this.showLoad = true;
                this.serviceClient.listGroupsBeneficiary(9999, name, this.date01, this.date02, this.idAccount).subscribe(res => {
                    this.ningunDato = false;
                    this.listGroupsBeneficiary = new _angular_material_table__WEBPACK_IMPORTED_MODULE_11__["MatTableDataSource"](res.results);
