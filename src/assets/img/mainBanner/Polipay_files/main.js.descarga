>{{ destino.anio }} - {{ destino.mes }}</span>\r\n                        </li>\r\n                    </ul>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <!-- AQUI van los mensjaes de error -->\r\n    </div>\r\n\r\n    <div class=\"date-rank \" fxFlex=\"100\" fxLayout=\"row wrap\" *ngIf=\"datePikers\">\r\n        <span fxFlex=\"100\" class=\"rank \" fxLayoutAlign=\"start start\">Rango de fechas</span>\r\n        <mat-form-field class=\" back \">\r\n            <mat-date-range-input class=\" back\" [formGroup]=\"range\" [rangePicker]=\"picker\" [max]=\"datenow\">\r\n                <input class=\"back \" matStartDate formControlName=\"start\" [max]=\"datenow\" (dateChange)=\"DatePiker($event, 'date1')\" placeholder=\"Fecha inicial\">\r\n                <input class=\" back \" matEndDate formControlName=\"end\" [max]=\"datenow\" (dateChange)=\"DatePiker2($event, 'date2')\" placeholder=\"Fecha final\">\r\n            </mat-date-range-input>\r\n            <mat-datepicker-toggle class=\"back \" matSuffix [for]=\"picker\"></mat-datepicker-toggle>\r\n            <mat-date-range-picker #picker class=\"\"></mat-date-range-picker>\r\n\r\n            <mat-error *ngIf=\"range.controls.start.hasError('matStartDateInvalid')\">Invalid start date</mat-error>\r\n            <mat-error *ngIf=\"range.controls.end.hasError('matEndDateInvalid')\">Invalid end date</mat-error>\r\n        </mat-form-field>\r\n    </div>\r\n    <div class=\"contenedor-botones padding--botones\" fxFlex=\"100\" fxLayout=\"row\" fxLayoutAlign=\"end center\">\r\n        <button type=\"button\" class=\"cancelar__button\" (click)=\"cerrar()\"><b>Cancelar</b></button>\r\n        <button class=\"confirmar__button | color-white\" (click)=\"submit()\"><b>Aceptar</b></button>\r\n    </div>\r\n</div>");

