let PdfUserComponent = class PdfUserComponent {
    constructor(router, data, dialog, dialogRef, formBuilder, sercieCleint) {
        this.router = router;
        this.data = data;
        this.dialog = dialog;
        this.dialogRef = dialogRef;
        this.formBuilder = formBuilder;
        this.sercieCleint = sercieCleint;
        this.showLoad = false;
        //Atributos para recibir datos o relacionar mensajes con otros componentes
        this.pdf = '';
        this.message = 0;
        this.messageNormal = "";
        this.errores = null;
        this.unico = false;
        this.username = ""; //nombres de personas
        this.name = ""; // nombres de grupos, etc
        this.cuenta = "";
        this.tarjeta = "";
        this.monto = "";
        this.reference = "";
        this.observacion = "";
        this.email = "";
        this.form = formBuilder.group({
            motivo: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_5__["Validators"].required]],
        });
        this.pdf = data.pdf;
        this.message = data.message;
        this.messageNormal = data.messageNormal;
        this.errores = data.errores;
        this.unico = data.unico;
        this.username = data.username;
        this.name = data.name;
        this.cuenta = data.cuenta;
        this.tarjeta = data.tarjeta;
        this.monto = data.monto;
        this.reference = data.reference;
        this.observacion = data.observacion;
        this.email = data.email;
        this.id = data.id;
        this.cards = data.cards;
        this.any = data.any;
        this.downloadBalance();
    }
    downloadBalance() {
        // //console.log(this.id);
        this.sercieCleint.documentPdf(this.id).subscribe(res => {
            console.log('id en downloadBalance', this.id);
            // this.showLoad = false;
            //console.log(res);
            this.document = res.documento;
        });
    }
    download() {
        this.document;
        this.dialog.closeAll();
    }
    closeAll() {
        this.dialog.closeAll();
    }
    cardRequest() {
        this.dialog.closeAll();
        this.router.navigate(['/usuario/dispersiones/tarjetas/solicitudes-tarjetas-centros-costos']);
    }
};
