                                break;
                            case "rl":
                                // console.log("rl");
                                this.arregloErrores_rl[archivoId] = true;
                                this.arregloErroresSize_rl[archivoId] = true;
                                this.documents_representante_legal.controls[archivoId]
                                    .get("documento")
                                    .setValue("tamano");
                                break;
                            case "admin":
                                // console.log("admin");
                                this.arregloErrores_admin[archivoId] = true;
                                this.arregloErroresSize_admin[archivoId] = true;
                                this.documents_admin.controls[archivoId]
                                    .get("documento")
                                    .setValue("tamano");
                                break;
                        }
                        // console.log("tamaño");
                        this.file = "Ningún archivo seleccionado";
                    }
                }
                else {
                    //Errores de formato de archivo
                    this.showLoad = false;
                    switch (type) {
                        case "rs":
                            // console.log("rs");
                            this.arregloErrores_rs[archivoId] = true;
                            this.arregloErroresFormat_rs[archivoId] = true;
                            this.documents_razon_social.controls[archivoId]
                                .get("documento")
                                .setValue("formato");
                            this.documents_razon_social.controls[archivoId]
                                .get("nombre")
                                .setValue("Ningún archivo seleccionado");
                            break;
                        case "rl":
                            // console.log("rl");
                            this.arregloErrores_rl[archivoId] = true;
                            this.arregloErroresFormat_rl[archivoId] = true;
                            this.documents_representante_legal.controls[archivoId]
                                .get("documento")
                                .setValue("formato");
                            this.documents_representante_legal.controls[archivoId]
                                .get("nombre")
                                .setValue("Ningún archivo seleccionado");
                            break;
                        case "admin":
                            // console.log("admin");
                            this.arregloErrores_admin[archivoId] = true;
                            this.arregloErroresFormat_admin[archivoId] = true;
                            this.documents_admin.controls[archivoId]
                                .get("documento")
                                .setValue("formato");
                            this.documents_admin.controls[archivoId]
                                .get("nombre")
                                .setValue("Ningún archivo seleccionado");
                            break;
                    }
                    // console.log("formato");
                    this.file = "Ningún archivo seleccionado";
                }
            }
            else {
                this.showLoad = false;
                switch (type) {
                    case "rs":
                        // console.log("rs");
                        this.arregloErrores_rs[archivoId] = true;
                        this.arregloErroresVacio_rs[archivoId] = true;
                        this.documents_razon_social.controls[archivoId]
                            .get("documento")
                            .setValue("vacio");
                        break;
                    case "rl":
                        // console.log("rl");
                        this.arregloErrores_rl[archivoId] = true;
                        this.arregloErroresVacio_rl[archivoId] = true;
                        this.documents_representante_legal.controls[archivoId]
                            .get("documento")
                            .setValue("vacio");
                        break;
                    case "admin":
                        //console.log("admin");
                        this.arregloErrores_admin[archivoId] = true;
                        this.arregloErroresVacio_admin[archivoId] = true;
                        this.documents_admin.controls[archivoId]
                            .get("documento")
                            .setValue("vacio");
                        break;
                }
                //console.log("vacio");
                this.file = "Ningún archivo seleccionado";
            }
        });
    }
    cambios(ind) {
        //console.log("<---->");
        this.ListMailRepeat = [];
        this.ListMailRepeat.push(this.emailModel);
        for (let i = 0; i < this.t.length; i++) {
            ////console.log(this.t.controls[i].value.correoAdd);
            this.ListMailRepeat.push(this.t.controls[i].value.correoAdd);
        }
        //console.log("<---->");
        //console.log(this.ListMailRepeat);
        let duplicados = [];
        const tempArray = [...this.ListMailRepeat].sort();
        for (let i = 0; i < tempArray.length; i++) {
            if (tempArray[i + 1] === tempArray[i]) {
                if (tempArray[i] != "") {
                    duplicados.push(tempArray[i]);
                }
            }
        }
        //console.log(duplicados);
        for (let i = 0; i < this.t.length; i++) {
            if (duplicados.includes(this.t.controls[i].value.correoAdd)) {
                this.errorCorreoReperito[ind] = true;
            }
            else {
                this.errorCorreoReperito[i] = false;
            }
        }
        //console.log(this.errorCorreoReperito);
    }
    cambios2(ind) {
        //console.log("<---->");
        this.ListPhoneRepeat = [];
        this.ListPhoneRepeat.push(this.telefonoModel);
        for (let i = 0; i < this.t.length; i++) {
            ////console.log(this.t.controls[i].value.correoAdd);
            this.ListPhoneRepeat.push(this.t.controls[i].value.telefonoAdd);
        }
        //console.log("<---->");
        //console.log(this.ListPhoneRepeat);
        let duplicados = [];
        const tempArray = [...this.ListPhoneRepeat].sort();
        for (let i = 0; i < tempArray.length; i++) {
            if (tempArray[i + 1] === tempArray[i]) {
                if (tempArray[i] != "") {
                    duplicados.push(tempArray[i]);
                }
            }
        }
        //console.log(duplicados);
        for (let i = 0; i < this.t.length; i++) {
            if (duplicados.includes(this.t.controls[i].value.telefonoAdd)) {
                this.errorTelefonoRepetidoo[ind] = true;
            }
            else {
                this.errorTelefonoRepetidoo[i] = false;
            }
        }
        //console.log(this.errorTelefonoRepetidoo);
    }
    //CAMPOS ROJOS
    requerido(dato) {
        if (this.form.get(dato).errors == null) {
            return false;
        }
        else {
            return true;
        }
    }
    requeridoColoniaSelect1() {
        if (this.form.get("colonia").errors == null || this.auxFlgColonia1 == 0) {
            return false;
        }
        else {
            return true;
        }
    }
    requeridoColoniaSelect2() {
        if (this.form.get("colonia_rl").errors == null ||
            this.auxFlgColonia2 == 0) {
            return false;
        }
        else {
            return true;
        }
    }
    //PARA BANCO
    mostrar2() {
        if (this.flg) {
            if (this.guardar) {
                document.getElementById("fondo2").style.display = "block";
                document.getElementById("lista2").classList.add("mostrar2");
                document.getElementById("fondo2").style.zIndex = "13";
                document.getElementById("select1").style.zIndex = "13";
                document.getElementById("fondoColonia1").style.zIndex = "12";
                document.getElementById("selectColonia1").style.zIndex = "12";
                this.flg = false;
            }
        }
        else {
            this.ocultar2();
        }
    }
    ocultar2() {
        document.getElementById("fondo2").style.display = "none";
        document.getElementById("lista2").classList.remove("mostrar2");
        this.flg = true;
        if (this.banco == "\u00a0") {
            this.rojobanco = true;
            this.auxFlgBanco = 1;
        }
    }
    actualizar2(value) {
        this.banco = value.institucion;
        this.form.get("banco_clabe").setValue(value.clabe);
        this.auxFlgBanco = 0;
        if (this.rojobanco) {
            this.rojobanco = false;
        }
    }
    // PARA COLONIA 1
    mostrarColonia1() {
        if (this.flg) {
            if (this.guardar) {
                document.getElementById("fondoColonia1").style.display = "block";
                document.getElementById("listaColonia1").classList.add("mostrar2");
                document.getElementById("fondoColonia1").style.zIndex = "13";
                document.getElementById("selectColonia1").style.zIndex = "13";
                document.getElementById("fondo2").style.zIndex = "12";
                document.getElementById("select1").style.zIndex = "12";
                this.flg = false;
            }
        }
        else {
            this.ocultarColonia1();
        }
    }
    ocultarColonia1() {
        document.getElementById("fondoColonia1").style.display = "none";
        document.getElementById("listaColonia1").classList.remove("mostrar2");
        this.flg = true;
        if (this.colonia == "\u00a0") {
            this.rojoColonia1 = true;
            this.auxFlgColonia1 = 1;
        }
    }
    actualizarColonia1(value) {
        this.colonia = value;
        this.form.get("colonia").setValue(this.colonia);
        this.form.get("calle").setValue("");
        this.form.get("no_exterior").setValue("");
        this.auxFlgColonia1 = 0;
        if (this.rojoColonia1) {
            this.rojoColonia1 = false;
        }
    }
    // PARA COLONIA 2
    mostrarColonia2() {
        if (this.flg) {
            if (this.guardar) {
                document.getElementById("fondoColonia2").style.display = "block";
                document.getElementById("listaColonia2").classList.add("mostrar2");
                document.getElementById("selectColonia2").style.zIndex = "11";
                this.flg = false;
            }
        }
        else {
            this.ocultarColonia2();
        }
    }
    ocultarColonia2() {
        document.getElementById("fondoColonia2").style.display = "none";
        document.getElementById("listaColonia2").classList.remove("mostrar2");
        this.flg = true;
        if (this.colonia_legal == "\u00a0") {
            this.rojoColonia2 = true;
            this.auxFlgColonia2 = 1;
        }
    }
    actualizarColonia2(value) {
        this.colonia_legal = value;
        this.form.get("colonia_rl").setValue(this.colonia_legal);
        this.auxFlgColonia2 = 0;
        if (this.rojoColonia2) {
            this.rojoColonia2 = false;
        }
    }
    keyPressNumbers(event) {
        var charCode = event.which ? event.which : event.keyCode;
        // Only Numbers 0-9
        if (charCode < 48 || charCode > 57) {
            event.preventDefault();
            return false;
        }
        else {
            return true;
        }
    }
    mayusculas(event) {
        event.target.value = event.target.value.toUpperCase();
        event.target.value = event.target.value.replace(/\s/g, "_");
    }
};
