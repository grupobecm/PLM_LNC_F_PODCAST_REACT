\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoEstado() && form.get('estado').touched) }\" autocomplete=\"off\" type=\"text\" name=\"Estado\" id=\"Estado\" formControlName=\"estado\" [(ngModel)]=\"EstadoE\" required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoEstado() && form.get('estado').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Estado</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div class=\"form_space  form--password-mt\" fxFlex=\"60\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoCalle() && form.get('calle').touched) }\" translate>Calle*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoCalle() && form.get('calle').touched) }\" autocomplete=\"off\" type=\"text\" name=\"Calle\" id=\"Calle\" formControlName=\"calle\" [(ngModel)]=\"CalleE\" required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoCalle() && form.get('calle').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura la Calle</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space form--password-mt\" fxFlex=\"20\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridonoExterior() && form.get('noExterior').touched) }\" translate>No. Exterior*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridonoExterior() && form.get('noExterior').touched) }\" autocomplete=\"off\" type=\"text\" name=\"noexterior\" id=\"noexterior\" formControlName=\"noExterior\" [(ngModel)]=\"noExteriorE\"\r\n                        required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridonoExterior() && form.get('noExterior').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Número Exterior</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space form--password-mt margin--rigth\" fxFlex=\"20\">\r\n                    <span class=\"form__text  pass | font-roboto\" translate>No. Interior</span>\r\n                    <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"noInterior\" id=\"noInterior\" formControlName=\"noInterior\" [(ngModel)]=\"noInteriorE\">\r\n\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"mt-5\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"35\" fxLayout=\"row wrap\" fxLayoutAlign=\"start end\">\r\n                    <!-- <div fxFlex=\"100\" *ngIf=\"cartaresponsiva\">\r\n                        <button class=\"cartarespon__button | \" type=\"button\"><img src=\"../../../assets/img/icons/descargar.svg\"><b class=\"ml-2\">Descargar Carta responsiva</b></button>\r\n                    </div>\r\n                    <div fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start end\">\r\n                        <div fxFlex=\"100\" fxLayoutAlign=\"center center\">\r\n                            <p class=\"color-red msj-confirmar\" translate>User.EditUser.NewToken.NewToken</p>\r\n                        </div>\r\n                        <div class=\"form__code code\" fxFlex=\"100\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                            <input class=\"code__input input--ax | font-roboto color-second\" type=\"password\" placeholder=\"*\" formControlName=\"code5\" maxlength=\"1\" id=\"code5\" (keyup)=\"jump2($event, 'code6')\" autocomplete=\"off\">\r\n                            <input class=\"code__input input--ml | font-roboto color-second\" type=\"password\" placeholder=\"*\" formControlName=\"code6\" maxlength=\"1\" id=\"code6\" (keyup)=\"jump2($event, 'code7')\" autocomplete=\"off\">\r\n                            <input class=\"code__input input--ml | font-roboto color-second\" type=\"password\" placeholder=\"*\" formControlName=\"code7\" maxlength=\"1\" id=\"code7\" (keyup)=\"jump2($event, 'code8')\" autocomplete=\"off\">\r\n                            <input class=\"code__input input--ml | font-roboto color-second\" type=\"password\" placeholder=\"*\" formControlName=\"code8\" maxlength=\"1\" id=\"code8\" (keyup)=\"jump2($event, 'submit')\" autocomplete=\"off\">\r\n                        </div>\r\n                    </div> -->\r\n                </div>\r\n                <div fxFlex=\"35\" fxFlexOffset=\"30\" fxLayoutAlign=\"end end\">\r\n                    <button class=\"cancelar__button | color-third mr-3\" id=\"btn\" type=\"button\" [routerLink]=\"['/usuario/administration/clientsuser/listclients']\" translate>Cancelar</button>\r\n                    <button class=\"confirmar__button  | color-white\" id=\"submit1\" type=\"button\" (click)=\"alPaso2()\" translate>Continuar</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n\r\n\r\n        <div *ngIf=\"paso2\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n            <div class=\"mt-3\" fxFlex=\"100\">\r\n                <p class=\"mensajeObl\" translate>User.Messages.RequiredFields</p>\r\n            </div>\r\n            <div class=\"mt-5\" fxFlex=\"100\">\r\n                <p class=\"Subtitle color-accent remove-fondo\" translate>Documentos de la Razón Social</p>\r\n            </div>\r\n            <div class=\"mt-5\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"100\">\r\n                        <p class=\"color-third\">Constancia de Alta en SAT*</p>\r\n                    </div>\r\n                    <div class=\"\" fxFlex=\"100\" fxLayout=\"row\">\r\n                        <input class=\"boton__input\" name=\"file_\" formControlName=\"file_\" id=\"file_\" style=\"display: none\" type=\"file\" (change)=\"fileChange($event)\" #hiddenfileinput accept=\".pdf, application/pdf\">\r\n                        <button type=\"button\" class=\"cargar__button | color-white quitmrg\" [ngClass]=\"{'boton--alert': form.get('file_').hasError('required') && auxAlert }\" routerLinkActive=\"active\" (click)=\"hiddenfileinput.click()\">\r\n                      <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                      <b>Cargar Layout*</b></button>\r\n                        <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                            <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ file }}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\" alertTransfer\" *ngIf=\"form.get('file_').hasError('required') && auxAlert\">\r\n                        <span class=\"alert__text | color-red\">Por favor carga el Acta Constitutiva</span>\r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n            <div class=\"mt-5\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"100\">\r\n                        <p class=\"color-third\">Comprobante cambio de Domicilio Fiscal - SAT*</p>\r\n                    </div>\r\n                    <div class=\"\" fxFlex=\"100\" fxLayout=\"row\">\r\n                        <input class=\"boton__input\" name=\"file1_\" formControlName=\"file1_\" id=\"file1_\" style=\"display: none\" type=\"file\" (change)=\"fileChange1($event)\" #hiddenfile1input accept=\".pdf, application/pdf\">\r\n                        <button type=\"button\" class=\"cargar__button | color-white quitmrg\" [ngClass]=\"{'boton--alert': form.get('file1_').hasError('required') && auxAlert }\" routerLinkActive=\"active\" (click)=\"hiddenfile1input.click()\">\r\n                    <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                    <b>Cargar Layout*</b></button>\r\n                        <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                            <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ file1 }}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\" alertTransfer\" *ngIf=\"form.get('file1_').hasError('required') && auxAlert\">\r\n                        <span class=\"alert__text | color-red\">Por favor carga la Constancia de Alta en SAT</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n\r\n            <div fxFlex=\"35\" fxFlexOffset=\"65\" fxLayoutAlign=\"end end\">\r\n                <button class=\"confirmar__button  | color-white abajobtn\" id=\"submit1\" type=\"submit\" (click)=\"editclientexternoM()\" translate>Finalizar</button>\r\n            </div>\r\n\r\n        </div>\r\n\r\n    </form>\r\n</div>\r\n<!-- Cliente físico -->\r\n<div class=\"dashboard-transaction mrg\" fxFlex=\"83.33\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\" *ngIf=\"moral==false\">\r\n    <div fxFlex=\"100\">\r\n        <p class=\"Title color-accent\"><b>Editar Cliente</b></p>\r\n    </div>\r\n\r\n    <div fxFlex=\"75\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n        <nav class=\"nav-barA | background-grey-dark\" fxFlex=\"100\" fxLayoutAlign=\"start center\">\r\n            <ul class=\"navbar__menuA\" fxFlex=\"100\" fxLayoutAlign=\"center center\">\r\n                <li fxFlex=\"100\" class=\"navbar__itemsA\" (click)=\"alPaso1()\" [ngClass]=\"{'active': paso1}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                    <a class=\"navbar__textA | \">Paso 1: Razón Social</a>\r\n                </li>\r\n                <li fxFlex=\"100\" class=\"navbar__itemsA\" (click)=\"alPaso2()\" [ngClass]=\"{'active': paso2}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                    <a class=\"navbar__textA | \">Paso 2: Carga de comprobantes</a>\r\n                </li>\r\n            </ul>\r\n        </nav>\r\n    </div>\r\n\r\n    <form [formGroup]=\"form2\" fxLayout=\"row wrap\">\r\n        <div *ngIf=\"paso1\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n            <div class=\"cointainer-white\" fxFlex=\"100\" fxLayout=\"column\" fxLayoutAlign=\"center start\">\r\n                <div class=\"mt-3\" fxFlex=\"100\">\r\n                    <p class=\"mensajeObl\" translate>User.Messages.RequiredFields</p>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                        <div class=\"form_space  form--password-mt\" fxFlex=\"40\">\r\n                            <span class=\"form__text  pass | font-roboto\" translate>Nombre(s)*</span>\r\n                            <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"nombre\" id=\"nombre\" formControlName=\"nombre\" [(ngModel)]=\"clienteFisicoModel.person__name\" readonly>\r\n                        </div>\r\n                        <div class=\"form_space form--password-mt\" fxFlex=\"30\">\r\n                            <span class=\"form__text  pass | font-roboto\" translate>Apellido(s)*</span>\r\n                            <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"apellidos\" id=\"apellidos\" formControlName=\"apellidos\" [(ngModel)]=\"clienteFisicoModel.person__last_name\" readonly>\r\n                        </div>\r\n                        <div class=\"form_space form--password-mt\" fxFlex=\"30\">\r\n                            <span class=\"form__text  pass | font-roboto\" translate>Fecha de Nacimiento </span>\r\n                            <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"fecha_nacimiento\" id=\"fecha_nacimiento\" formControlName=\"fecha_nacimiento\" [(ngModel)]=\"clienteFisicoModel.person__fecha_nacimiento\" readonly>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                        <div class=\"form_space  form--password-mt\" fxFlex=\"30\">\r\n                            <span class=\"form__text  pass | font-roboto\" translate>R.F.C.</span>\r\n                            <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"RFC\" id=\"rfc\" formControlName=\"RFC\"  [(ngModel)]=\"clienteFisicoModel.person__rfc\" readonly>\r\n                        </div>\r\n                        <div class=\"form_space  form--password-mt\" fxFlex=\"10\">\r\n                            <span class=\"form__text  pass | font-roboto\" translate>Homoclave</span>\r\n                            <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"text\" id=\"homoclave\" formControlName=\"homoclave\"  [(ngModel)]=\"clienteFisicoModel.person__homoclave\" readonly>\r\n                        </div>\r\n                        <div class=\"form_space form--password-mt\" fxFlex=\"30\">\r\n                            <span class=\"form__text  pass | font-roboto\" translate>Teléfono</span>\r\n                            <input class=\"form__input password | font-roboto\"  autocomplete=\"off\" type=\"text\" name=\"phone\" id=\"phone\" formControlName=\"phone\" [(ngModel)]=\"clienteFisicoModel.person__phone\" readonly>\r\n                        </div>\r\n                        <div class=\"form_space form--password-mt\" fxFlex=\"30\">\r\n                            <span class=\"form__text  pass | font-roboto\" translate>Correo Electrónico</span>\r\n                            <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"email\" id=\"email\" formControlName=\"email\" [(ngModel)]=\"clienteFisicoModel.person__email\" readonly>\r\n                        </div>\r\n\r\n\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n\r\n\r\n            <div class=\"mt-2\" fxFlex=\"100\">\r\n                <p class=\"Subtitle color-accent remove-fondo\" translate>Domicilio</p>\r\n            </div>\r\n            <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div class=\"form_space  form--password-mt\" fxFlex=\"20\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoCPF() && form2.get('CP').touched) }\" translate>Código Postal*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoCPF() && form2.get('CP').touched) }\" autocomplete=\"off\" type=\"text\" (keyup)=\"buscar($event);\" name=\"cp\" id=\"cp\" formControlName=\"CP\" [(ngModel)]=\"CPE\" required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoCPF() && form2.get('CP').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Código Postal</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space  form--password-mt\" fxFlex=\"30\"  *ngIf=\"coloniaSelect2==true\">\r\n                    <div class=\"fondo-cerrar-select \" id=\"fondoColonia1\" (click)=\"ocultarColonia1F()\"></div>\r\n                    <div class=\"select-container \" id=\"selectColonia1\">\r\n                        <span class=\"form__text user\" [ngClass]=\"{ 'form__text_alert': requeridoColoniaSelect1F() || rojoColonia1 }\">Colonia*</span>\r\n                        <div class=\"form__input select | font-roboto \" [ngClass]=\"{ 'form__input_alert': requeridoColoniaSelect1F() || rojoColonia1 }\" id=\"colo\" type=\"text\" name=\"frecuent\" (click)=\"mostrarColonia1()\">\r\n                            {{ colonia }}\r\n                            <div class=\"flecha\" id=\"flecha\" [ngClass]=\"{ 'flecha--alert': requeridoColoniaSelect1F() || rojoColonia1 }\"></div>\r\n                            <ul class=\"ul-select all zIndex-10 maxAlturaYScroll elscroll\" id=\"listaColonia1\">\r\n\r\n                                <li *ngIf=\"colonias.length == 0\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                                    <span class=\"texto__select\" fxFlex=\"95\">No se encontrarón direcciones</span>\r\n                                </li>\r\n\r\n                                <li *ngFor=\"let col of colonias\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\" (click)=\"actualizarColonia1F(col)\">\r\n                                    <span class=\"texto__select\" fxFlex=\"95\">{{col}}</span>\r\n                                </li>\r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"alertTransfer\" *ngIf=\"requeridoColoniaSelect1F()\">\r\n                        <span class=\"alert__text | color-red\">Por favor ingresa la Colonia</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space form--password-mt\" fxFlex=\"30\" *ngIf=\"coloniaSelect2==false\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoColoniaF() && form2.get('colonia').touched) }\" translate>Colonia*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoColoniaF() && form2.get('colonia').touched) }\" autocomplete=\"off\" type=\"text\" name=\"colonia\" formControlName=\"colonia\" [(ngModel)]=\"colonia\"\r\n                        required>\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoColoniaF() && form2.get('colonia').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura la Colonia</span>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"form_space form--password-mt\" fxFlex=\"30\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoAlcaldiaF() && form2.get('alcaldia').touched) }\" translate>Municipio/Alcaldía*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoAlcaldiaF() && form2.get('alcaldia').touched) }\" autocomplete=\"off\" type=\"text\" name=\"alcaldia\" id=\"alcaldia\" formControlName=\"alcaldia\" [(ngModel)]=\"AlcaldiaE\"\r\n                        required>\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoAlcaldiaF() && form2.get('alcaldia').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Municipio/Alcaldía</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space  form--password-mt margin--rigth\" fxFlex=\"20\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoEstadoF() && form2.get('estado').touched) }\" translate>Estado*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoEstadoF() && form2.get('estado').touched) }\" autocomplete=\"off\" type=\"text\" name=\"Estado\" id=\"Estado\" formControlName=\"estado\" [(ngModel)]=\"EstadoE\" required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoEstadoF() && form2.get('estado')