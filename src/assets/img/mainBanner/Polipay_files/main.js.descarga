        // this.cuentaordenante = '******' + aux[aux.length-4] + aux[aux.length-3] + aux[aux.length-2] + aux[aux.length-1];
    }
    listSendTransferPtoP() {
        this.showLoad = true;
        this.serviceClient.listDetailsReceivedPtoP(this.dato.id).subscribe((res) => {
            this.dataT = res[0];
            this.dataT.cta_beneficiario = String(this.dataT.cta_beneficiario).substr(7, 11);
            this.dataT.cuenta_emisor = String(this.dataT.cuenta_emisor).substr(7, 11);
            //console.log(this.dataT);
            this.showLoad = false;
        }, error => {
            this.showLoad = false;
        });
    }
};
