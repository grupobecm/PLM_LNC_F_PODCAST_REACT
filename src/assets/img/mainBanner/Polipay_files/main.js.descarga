/* harmony default export */ __webpack_exports__["default"] = ("<div fxFlex=\"100\">\r\n\r\n    <!--Crear centros de costo si no existen -->\r\n    <div *ngIf=\"warning == 'cCC-001'\" class=\"message\">\r\n        <p class=\"text | color-red\">¡Aviso!</p>\r\n        <p class=\"text\">Por favor crea un Centro de Costos.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"createCenterCost()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--cliente desactivado -->\r\n    <div *ngIf=\"warning == 'desactiv-001'\" class=\"message\">\r\n        <p class=\"text\">Estimado cliente, su cuenta ha sido desactivada, por favor contacte a su ejecutivo Polipay</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"createCenterCost()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--cliente desactivado -->\r\n    <div *ngIf=\"warning == 'desactiv-002'\" class=\"message\">\r\n        <p class=\"text1 | color-main\" fxLayoutAlign=\"center center\">Aviso importante</p>\r\n        <p class=\"text2 | color-third\">Estimado usuario:</p>\r\n        <p class=\"text3 | color-third\"> No podemos iniciar sesion con su cuenta en Banca Polipay, este servicio no\r\n            esta disponible. Para un mejor manejo de su cuenta por favor acceda a su aplicación móvil Polipay.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"createCenterCost()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--cliente no acepto notificaciones-->\r\n    <div *ngIf=\"warning == 'firebase-001'\" class=\"message\">\r\n        <p class=\"text1 | color-main\" fxLayoutAlign=\"center center\">Aviso importante</p>\r\n        <p class=\"text2 | color-third\">Estimado usuario:</p>\r\n        <p class=\"text3 | color-third\"> No podemos iniciar sesion con su cuenta hasta que acepte los permisos de las notificaciones del sitio.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--escoger un  centro de costos -->\r\n    <div *ngIf=\"warning == 'centcost-001'\" class=\"message\">\r\n        <p class=\"text\">Por favor seleccione por lo menos un Centro de Costos</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <div *ngIf=\"warning == 'notices'\" class=\"message pdn-aviso\">\r\n        <p class=\"text1 | color-main\" fxLayoutAlign=\"center center\">Aviso importante</p>\r\n        <p class=\"text2 | color-third\">Estimado cliente:</p>\r\n        <p class=\"text3 | color-third\">Te informamos que el servicio del portal Polipay suspende actividades el día\r\n            <b>Sabado 09 de Abril del 2022,</b> por lo que las operaciones se ven <b>afectadas.</b>\r\n        </p>\r\n        <p class=\"text4 | color-third\">Los servicios se reanudarán con normalidad el día Domingo 10 de Abril del 2022.\r\n        </p>\r\n        <p class=\"text4 | color-third\"><b>Agradecemos anticipar sus operaciones.</b></p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <div *ngIf=\"warning == 'notices02'\" class=\"message pdn-aviso\">\r\n        <p class=\"text1 aligCenter | color-main \" fxLayoutAlign=\"center center\">Banca Polipay se encuentra en proceso de\r\n            mantenimiento...</p>\r\n        <div class=\"mt-5 mb-5\" fxLayoutAlign=\"center center\">\r\n            <img src=\"../../../../../assets/img/icons/engrane.svg\">\r\n\r\n        </div>\r\n        <p class=\"text2 | color-third\" fxLayoutAlign=\"center center\">Estimado cliente:</p>\r\n        <p class=\"text3 aligCenter | color-third\" fxLayoutAlign=\"center center\">Estamos realizando tareas de\r\n            mantenimiento, disculpa las molestias. Estaremos de vuelta pronto.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <div *ngIf=\"warning == 'notices03'\" class=\"message pdn-aviso\">\r\n        <p class=\"text1 | color-main\" fxLayoutAlign=\"center center\">Aviso importante</p>\r\n        <p class=\"text2 | color-third\">Estimado cliente:</p>\r\n        <p class=\"text3 | color-third\">Estamos realizando una actualización importante , <b>gracias por ser parte de\r\n                nuestro crecimiento.</b> Estaremos pronto de vuelta.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n</div>");

