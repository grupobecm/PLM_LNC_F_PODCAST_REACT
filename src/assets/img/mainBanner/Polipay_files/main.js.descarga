cepto -->\r\n                <div class=\"form\" fxFlex=\"33\">\r\n                    <span class=\"form__text user | font-roboto\"\r\n                        [ngClass]=\"{ 'form__text_alert': (requerido('concepto_pago') && form.get('concepto_pago').touched) }\">Concepto*</span>\r\n                    <input class=\"form__input user | font-roboto\" id=\"concepto_pago\"\r\n                        [ngClass]=\"{ 'form__input_alert': (requerido('concepto_pago') && form.get('concepto_pago').touched) }\"\r\n                        autocomplete=\"off\" type=\"text\" name=\"concepto_pago\" formControlName=\"concepto_pago\" required\r\n                        [ngModel]=\"conceptoR\" maxlength=\"40\">\r\n\r\n                    <div class=\" alertTransfer\"\r\n                        *ngIf=\"requerido('concepto_pago') && form.get('concepto_pago').touched \">\r\n                        <span class=\"alert__text | color-red\">\r\n                            Por favor captura el concepto del pago\r\n                        </span>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"\" fxFlex=\"33\" fxLayout=\"row wrap\">\r\n\r\n                    <!-- Input referencia -->\r\n                    <!-- <div class=\"form--sinPadding\" fxFlex=\"100\">\r\n                        <span class=\"form__text user referencia | font-roboto\"\r\n                            [ngClass]=\"{ 'form__text_alert': (requerido('referencia_numerica') && form.get('referencia_numerica').touched) }\">Referencia\r\n                            numérica*</span>\r\n                        <input class=\"form__input user | font-roboto\"\r\n                            [ngClass]=\"{ 'form__input_alert': (requerido('referencia_numerica') && form.get('referencia_numerica').touched) }\"\r\n                            id=\"referencia_numerica\" type=\"text\" name=\"referencia_numerica\" autocomplete=\"off\"\r\n                            maxlength=\"7\" (keypress)=\"keyPressN