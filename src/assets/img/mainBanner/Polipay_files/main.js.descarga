    addDate() {
        if (this.form.get("is_schedule").value) {
            this.form.addControl("fechaProgramada", new _angular_forms__WEBPACK_IMPORTED_MODULE_10__["FormControl"](["", _angular_forms__WEBPACK_IMPORTED_MODULE_10__["Validators"].required]));
            this.form.addControl("hora_operacion", new _angular_forms__WEBPACK_IMPORTED_MODULE_10__["FormControl"](["", _angular_forms__WEBPACK_IMPORTED_MODULE_10__["Validators"].required]));
