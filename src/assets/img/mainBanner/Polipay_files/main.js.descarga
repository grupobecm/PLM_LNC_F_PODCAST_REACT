        this.numRegister = 0;
        this.paso1 = true;
        this.paso2 = false;
        this.cero = false;
        this.empresaName = this.storageAdmin.CenterCost.name;
        this.empresa_id = this.storageAdmin.CenterCost.id;
        //console.log(this.empresa_id);
