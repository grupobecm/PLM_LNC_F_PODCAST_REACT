let AdministrationPhysicalClientComponent = class AdministrationPhysicalClientComponent {
    constructor(formBuilder, router, dialog, service, storageClient) {
        this.formBuilder = formBuilder;
        this.router = router;
        this.dialog = dialog;
        this.service = service;
        this.storageClient = storageClient;
        this.pendiente = false;
        this.desactivado = false;
        this.activado = true;
        this.devuelto = false;
        this.color = 'primary';
        this.file = "Ningun archivo seleccionado";
        this.file64 = null;
        this.auxAlert = false;
        this.showLoad = false;
        this.error = false;
        this.valor0 = "Hola";
        this.iseditable = true;
        this.personaFisica = {
            "cliente_externo_fisico": [
                {
                    "person__name": "",
                    "person__last_name": "",
                    "person__rfc": "",
                    "person__fecha_nacimiento": "",
                    "person__email": "",
                    "person__phone": "",
                    "person__homoclave": ""
                }
            ],
            "domicilio": ""
        };
        this.showLoad = true;
        const data = JSON.parse(sessionStorage.getItem("clienteExterno"));
        if (data.estado == 1) {
            this.iseditable = false;
        }
        this.id = JSON.parse(sessionStorage.getItem("clienteExterno")).id;
        this.moral = JSON.parse(sessionStorage.getItem("clienteExterno")).moral;
