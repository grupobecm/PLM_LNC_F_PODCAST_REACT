let DetailSendPTPComponent = class DetailSendPTPComponent {
    constructor(data, router, dialog, serviceClient, serviceTrans) {
        this.data = data;
        this.router = router;
        this.dialog = dialog;
        this.serviceClient = serviceClient;
        this.serviceTrans = serviceTrans;
        this.showLoad = false;
        this.dato = data.dato;
        //console.log(this.dato);
        this.listSendTransferPtoP();
        // let aux = this.dato.cta_beneficiario.toString().split('');
        // this.cuentaBeneficiario = '******' + aux[aux.length-4] + aux[aux.length-3] + aux[aux.length-2] + aux[aux.length-1];
        //  aux = this.dato.cuenta_emisor.toString().split('');
        // this.cuentaordenante = '******' + aux[aux.length-4] + aux[aux.length-3] + aux[aux.length-2] + aux[aux.length-1];
    }
    listSendTransferPtoP() {
        this.showLoad = true;
        this.serviceClient.listDetailsReceivedPtoP(this.dato.id).subscribe((res) => {
            this.dataT = res[0];
            this.dataT.cta_beneficiario = String(this.dataT.cta_beneficiario).substr(7, 11);
            this.dataT.cuenta_emisor = String(this.dataT.cuenta_emisor).substr(7, 11);
            //console.log(this.dataT);
            this.showLoad = false;
        }, error => {
            this.showLoad = false;
        });
    }
    downloadPdf() {
        //console.log(this.dato);
        let data = {
            id: this.dato.id
        };
        //console.log(data);
        this.serviceTrans.voucherTransacction(data).subscribe(res => {
            this.document = res.documento;
            const download = document.createElement('a');
            download.href = this.document;
            download.setAttribute('download', 'Comprobante_' + data.id);
            download.target = "_blank";
            document.body.appendChild(download);
            download.click();
        });
    }
};
