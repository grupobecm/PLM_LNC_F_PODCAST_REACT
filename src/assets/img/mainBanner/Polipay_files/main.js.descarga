        // }
    }
    mostrar() {
        if (this.flg) {
            document.getElementById("fondo").style.display = 'block';
            document.getElementById("lista").classList.add("mostrar");
            this.buscar = "";
            this.copyCompany = this.company;
            this.total = this.copyCompany.length;
            this.flg = false;
        }
        else {
            this.ocultar();
        }
    }
    ocultar() {
        document.getElementById("fondo").style.display = 'none';
        document.getElementById("lista").classList.remove("mostrar");
        this.flg = true;
    }
    mostrar2() {
        if (this.flg) {
            if (this.guardar) {
                document.getElementById("fondo2").style.display = 'block';
                document.getElementById("lista2").classList.add("mostrar2");
                /* / */
                this.flg = false;
            }
        }
        else {
            this.ocultar2();
        }
    }
    ocultar2() {
        document.getElementById("fondo2").style.display = 'none';
        document.getElementById("lista2").classList.remove("mostrar2");
        this.flg = true;
        if (this.banco == '\u00a0') {
            this.rojobanco = true;
            this.auxFlgBanco = 1;
        }
    }
    actualizar2(value) {
        this.banco = value.institucion;
        this.form.get('banco').setValue(value.id);
        //console.log(value.id)
        this.auxFlgBanco = 0;
        if (this.rojobanco) {
            this.rojobanco = false;
        }
    }
    validacion(event) {
        let theEvent = event || window.event;
        let key;
        if (theEvent.type === 'paste') {
            key = event.clipboardData.getData('text/plain');
        }
        else {
            let reg = /^([0-9])*$/;
            if (!reg.test(this.clabeR)) {
                this.clabeR = this.clabeR.replace(/\D/g, '');
            }
            // if(this.clabeR.length == 18 || this.clabeR.length == 16){
            //   for(let i = 0;i < this.company.length;i++){
            //     if(this.company[i].cuenta == this.clabeR){
            //       this.actualizar(this.company[i],true);
            //     }
            //   }
            // }
        }
    }
    onPaste(event) {
        let clipboardData = event.clipboardData;
        let pastedText = clipboardData.getData('text');
        if (pastedText.length == 18) {
            //console.log('copiar', pastedText);
            this.autocomplete(pastedText);
        }
    }
    autocomplete(data) {
        let accountP;
        if (data != '') {
            accountP = data;
            this.ServicesAxisAccountService.BanksAxisAccounts().subscribe((res) => {
                this.showLoad = false;
                var accounts = accountP.split("", 3);
                var accountsThird = accounts[0] + accounts[1] + accounts[2];
                for (let i = 0; i < res.length; i++) {
                    const element = res[i].clabe;
                    if (element == accountsThird) {
                        this.banco = res[i].institucion;
                        this.form.get('banco').setValue(res[i].id);
                        this.form.patchValue({
                            banco: res[i].id
                        });
                        this.form.controls.banco.disable();
                        document.getElementById("banco").style.cursor = "default";
                        document.getElementById("banco").style.background = "#FAFAFA";
                        document.getElementById("flecha").style.cursor = "default";
                        document.getElementById("flecha").style.borderTop = "8px solid #D9D9D9";
                        // this.flg = false;
                        // this.guardar = true;
                        break;
                    }
                }
            }, error => {
                this.showLoad = false;
                //console.log(error);
            });
        }
        else {
            accountP = this.form.get("cuentabeneficiario").value;
        }
    }
    BankList() {
        this.ServicesAxisAccountService.BanksAxisAccounts().subscribe((res) => {
            this.Bancos = res;
        }, error => {
        });
    }
    getListaGrupoFreq() {
        this.serviceClient.seeFrecuentContact(this.id).subscribe((res) => {
            this.groupFrec = res;
        });
    }
    addGroup(evento, group) {
        if (evento.target.checked) {
            const data = {
                group_id: group.id
            };
            this.frecuente_groups.push(data);
        }
        else {
            for (let i = 0; i < this.frecuente_groups.length; i++) {
                if (group.id == this.frecuente_groups[i].group_id) {
                    this.frecuente_groups.splice(i, 1);
                }
            }
        }
    }
};
