    /* AVANZAR ENTRE LOS PASOS */
    alPaso1() {
        this.paso1 = true;
        this.paso2 = false;
        this.paso3 = false;
    }
    alPaso2() {
        this.paso1 = false;
        this.paso2 = true;
        this.paso3 = false;
    }
    alPaso3() {
        this.paso1 = false;
        this.paso2 = false;
        this.paso3 = true;
        if (this.moral == true) {
            this.validateAsignacion();
        }
        else {
            this.validateAsignacionF();
        }
    }
