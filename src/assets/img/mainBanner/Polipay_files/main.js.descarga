let SeeFrequetsAccountsPComponent = class SeeFrequetsAccountsPComponent {
    constructor(dialog) {
        this.dialog = dialog;
        this.cuenta = "";
        this.showLoad = false;
        this.numeroRegistros = 0;
        this.cero = false;
        this.numeroRegistrosaMostrar = 5;
        this.pagina_actual = 1;
        this.next_page = 0;
        this.prev_page = 0;
        this.total = 0;
