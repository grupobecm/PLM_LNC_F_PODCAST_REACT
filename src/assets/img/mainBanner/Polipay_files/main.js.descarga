gth2\" fxFlex=\"25\">\r\n                    <div class=\"form\">\r\n                        <div class=\"fondo-cerrar-select zIndex10 color2\" id=\"fondo2\" (click)=\"ocultar2()\"></div>\r\n                        <div class=\"form select-container zIndex10\" fxFlex=\"100\">\r\n                            <span class=\"form__text user | font-roboto\"\r\n                                [ngClass]=\"{ 'form__text_alert': requeridoPeriodo() || rojobancoD }\" translate>Escoge el\r\n                                mes a visualizar</span>\r\n                            <div class=\"form__input select | font-roboto\"\r\n                                [ngClass]=\"{ 'form__input_alert': requeridoPeriodo() || rojobancoD }\"\r\n                                id=\"cuentaBeneficiario\" type=\"text\" name=\"frecuent\" (click)=\"mostrar2()\">\r\n                                {{ cuentaD }}\r\n                                <div class=\"flecha\" [ngClass]=\"{ 'flecha--alert': requeridoPeriodo() || rojobancoD }\">\r\n                                </div>\r\n                                <ul class=\"ul-select all maxAlturaYScroll alturaSelect elscroll\" id=\"lista2\">\r\n                                    <li fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                                        <span class=\"texto__select\" fxFlex=\"90\">Seleccione</span>\r\n                                    </li>\r\n                                    <!-- <li fxLayout=\"row wrap\" fxLayoutAlign=\"center center\" (click)=\"actualizar2('Últimos 12 meses', 1)\">\r\n                                        <span class=\"texto__select\" fxFlex=\"90\">Últimos 12 meses</span>\r\n                                    </li> -->\r\n                                    <li *ngFor=\"let destino of periodo\" fxLayout=\"row wrap\"\r\n                                        fxLayoutAlign=\"center center\"\r\n                                        (click)=\"actualizar2(destino.anio + ' - ' + destino.mes, destino)\">\r\n                                        <span class=\"texto__select\" fxFlex=\"90\">{{ destino.anio }} - {{ destino.mes\r\n                                            }}</span>\r\n                                    </li>\r\n                                </ul>\r\n                            </div>\r\n                            <div class=\"alertTransfer\" *ngIf=\"requeridoPeriodo()\">\r\n                                <span class=\"alert__text | color-red\" translate>\r\n                                    User.Alerts.RequiredPeriod\r\n                                </span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <!-- AQUI van los mensjaes de error -->\r\n                </div>\r\n\r\n                <div *appPermission=\"['327']\" class=\"date-rank background-grey-light9\" fxFlex=\"40\" fxLayout=\"row wrap\">\r\n                    <span fxFlex=\"100\" class=\"rank background-grey-light9\" fxLayoutAlign=\"start start\">Rango de\r\n                        fechas</span>\r\n                    <mat-form-field class=\" back background-grey-light9\">\r\n                        <mat-date-range-input class=\" backbackground-grey-light9\" [formGroup]=\"range\"\r\n                            [rangePicker]=\"picker\" [max]=\"datenow\">\r\n                            <input class=\"back background-grey-light9\" matStartDate formControlName=\"start\"\r\n                                [max]=\"datenow\" (dateChange)=\"DatePiker($event, 'date1')\" placeholder=\"Fecha inicial\">\r\n                            <input class=\" back background-grey-light9\" matEndDate formControlName=\"end\" [max]=\"datenow\"\r\n                                (dateChange)=\"DatePiker2($event, 'date2')\" placeholder=\"Fecha final\">\r\n                        </mat-date-range-input>\r\n                        <mat-datepicker-toggle class=\"back background-grey-light9\" matSuffix [for]=\"picker\">\r\n                        </mat-datepicker-toggle>\r\n                        <mat-date-range-picker #picker class=\"background-grey-light9\"></mat-date-range-picker>\r\n\r\n                        <mat-error *ngIf=\"range.controls.start.hasError('matStartDateInvalid')\">Invalid start date\r\n                        </mat-error>\r\n                        <mat-error *ngIf=\"range.controls.end.hasError('matEndDateInvalid')\">Invalid end date</mat-error>\r\n                    </mat-form-field>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"cont-blanco cont-datos\" fxFlex=\"25\" fxLayout=\"row wrap\">\r\n            <span fxFlex=\"100\" class=\"texto3 | color-grey-dark3\">Nombre Completo</span>\r\n            <p fxFlex=\"100\" class=\"texto4 | color-74 \">{{ name }} {{ lastName }}</p>\r\n            <!-- Falta agregar apellidos -->\r\n            <span fxFlex=\"100\" class=\"texto3 | color-grey-dark3\">R.F.C.</span>\r\n            <p fxFlex=\"100\" class=\"texto4 | color-74 \"> {{ rfc | uppercase }}</p>\r\n            <span fxFlex=\"100\" class=\"texto3 | color-grey-dark3\">Correo Electrónico</span>\r\n            <p fxFlex=\"100\" class=\"texto4 | color-74 \">{{ mail }}</p>\r\n            <span fxFlex=\"100\" class=\"texto3 | color-grey-dark3\">Descripción de Actividades</span>\r\n            <p fxFlex=\"100\" class=\"texto4 | color-74 \">{{ description }}</p>\r\n        </div>\r\n        <!--Inicia tabla de operacion-->\r\n        <div *appPermission=\"['327']\" class=\"box mat-elevation-z8  margin-cont--left\" fxFlex=\"73\" fxLayout=\"row wrap\">\r\n            <div class=\"\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                <table mat-table [dataSource]=\"listStaffExternal\" fxFlex=\"100\" matSort [attr.align]=\"'center'\">\r\n                    <!-- Columna No se encontraron registros -->\r\n                    <ng-container matColumnDef=\"noData\">\r\n             