    onSubmit() {
        let campos = document.getElementsByClassName("input_select");
        for (let i = 0; i < campos.length; i++) {
            this.form.value.filtro[i].campo = document.getElementsByClassName("input_select")[i].innerHTML;
        }
        //console.log("->",this.form.value);
        this.dialogRef.close({ data: this.form.value });
    }
