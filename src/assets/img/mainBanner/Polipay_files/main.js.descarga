        //console.log(this.id)
        this.alPaso1();
    }
    seedetailsReceived(element) { }
    listExternalCustomerActive() {
        this.showLoad = true;
        this.serviceAccount.getExternalClientListActive(this.id).subscribe((res) => {
            //console.log(res);
            this.ningunDato = false;
            this.ningunDato = false;
            this.moralSol = [];
            this.fisSol = [];
            let variable = [...res.results];
            for (let i = 0; i < variable.length; i++) {
                if (variable[i].tipo_cliente == 1) {
                    this.moralSol.push(variable[i]);
                }
                else {
                    this.fisSol.push(variable[i]);
                }
            }
            this.filtroActivos();
        }, error => {
            this.ningunDato = true;
            //console.log(error.error)
        });
        this.showLoad = false;
    }
    filtroActivos() {
        let varAux = [];
        if (this.moral == true) {
