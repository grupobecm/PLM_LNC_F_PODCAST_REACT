            // Imprime el error
            if (error.status == 401) {
                if (error.error.detail == "El token ha expirado" || error.error.detail == "Usuario no esta activo"
                    || error.error.detail == "Token invalido" || error.error.status == "El token fue eliminado o no es valido."
                    || error.error.status[0] == "El token fue eliminado o no es valido." || error.error.status[0] == "Usuario no esta activo") {
                    if (this.flg) {
                        switch (this.router.url) {
                            case "/":
                            case "/codigo":
                            case "/recuperar":
                            case "/confirmacion":
                            case "/nueva-contrasena":
                            case "/contrasena-cambiada":
                            case "/primera-contrasena":
                            case "/pass-guardado":
                            case "/token":
                            case "/resolucion":
                            case "/token-guardado":
                            case "/investment":
                            case "/404":
                                break;
                            default:
                                this.openDialog();
                                this.flg = false;
                        }
                    }
                }
            }
            return Object(rxjs__WEBPACK_IMPORTED_MODULE_3__["throwError"])(error);
