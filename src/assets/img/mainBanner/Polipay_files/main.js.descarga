            },
            disableClose: true,
        });
        dataDialog.afterClosed().subscribe((res) => {
            if (res !== 'cancelar') {
                const data = {
                    "transfers": [
                        {
                            "transferid": Number(this.datos.id),
                            "statusid": 1
                        },
                    ]
                };
                this.showLoad = true;
                this.serviceAdmin.changeStatusAdmin(data).subscribe(res => {
                    console.log(res);
                    this.showLoad = false;
                    const successDialog = this.dialog.open(_auth_notice_auth_notice_component__WEBPACK_IMPORTED_MODULE_9__["AuthNoticeComponent"], {
                        width: '800px',
                        panelClass: 'custom-dialog-container',
                        data: {
                            type: 'success',
                            info: res.status,
                        },
                        disableClose: true,
                    });
                    successDialog.afterClosed().subscribe((res) => {
                        this.dialog.closeAll();
                        this.router.navigate(['/administrador/pending/individual']);
                    });
                }, error => {
                    this.showLoad = false;
                    console.log(error);
                    this.showLoad = false;
