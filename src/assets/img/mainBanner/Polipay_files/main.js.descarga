                document.getElementsByClassName("input_select")[i].innerHTML = 'Fecha de Dispersión';
                break;
        }
        input_actual = val;
        this.ocultar(i);
    }
    // Boton de Aceptar
    onSubmit() {
        let campos = document.getElementsByClassName("input_select");
        for (let i = 0; i < campos.length; i++) {
            this.form.value.filtro[i].campo = document.getElementsByClassName("input_select")[i].innerHTML;
        }
        //console.log("->",this.form.value);
        if (this.mostrarIndividualMasiva()) {
            //console.log("individual");
            this.showLoad = true;
            let filtro = this.form.value.filtro;
            for (let i = 0; i < filtro.length; i++) {
                switch (filtro[i].campo) {
                    case "Cuenta Beneficiario":
                        this.Cuenta_Beneficiario = filtro[i].valor;
                        break;
                    case "Clave de Rastreo":
                        this.clave = filtro[i].valor;
                        break;
                    case "Folio":
                        this.folio = filtro[i].valor;
                        break;
                    case "Fecha de Operación":
                        this.fecha1 = (new Date(filtro[i].valor.begin).toISOString());
                        this.fecha2 = (new Date(filtro[i].valor.end).toISOString());
                        let aux = this.fecha2.split('');
                        ////console.log("-------");
                        ////console.log(aux);
                        ////console.log("-------");
                        aux[10] = " ";
                        aux[11] = "2";
                        aux[12] = "3";
                        aux[14] = "5";
                        aux[15] = "9";
                        aux[17] = "0";
                        aux[18] = "0";
                        aux[aux.length - 1] = "";
                        this.fecha2 = aux.join('');
                        //console.log(this.fecha2);
                        aux = this.fecha1.split('');
                        ////console.log("-------");
                        ////console.log(aux);
                        ////console.log("-------");
                        aux[10] = " ";
                        aux[11] = "0";
                        aux[12] = "0";
                        aux[14] = "0";
                        aux[15] = "1";
                        aux[17] = "0";
                        aux[18] = "0";
                        aux[aux.length - 1] = "";
                        this.fecha1 = aux.join('');
                        //console.log(this.fecha1);
                        break;
                    case "Observaciones":
                        this.observaciones = filtro[i].valor;
                        break;
                }
            }
            if (this.router.url.includes('/administrador/pendientes/individual') || this.router.url.includes('/administrador/canceladas/individual')
                || this.router.url.includes('/administrador/enviadas/individual') || this.router.url.includes('/administrador/devueltas')) {
                if (this.fecha1 == 'null') {
                    this.fecha1 = '';
                }
                if (this.fecha2 == 'null') {
                    this.fecha2 = '';
                }
                //console.log("Filtro");
            }
            else {
                //console.log(this.fecha1);
                //console.log(this.fecha2);
            }
        }
        else {
            //console.log("masivas");
            this.showLoad = true;
            let filtro = this.form.value.filtro;
            for (let i = 0; i < filtro.length; i++) {
                switch (filtro[i].campo) {
                    case "Fecha de Dispersión":
                        this.fecha1 = (new Date(filtro[i].valor.begin).toISOString());
                        this.fecha2 = (new Date(filtro[i].valor.end).toISOString());
                        let aux = this.fecha2.split('');
                        aux[10] = " ";
                        aux[11] = "2";
                        aux[12] = "3";
                        aux[14] = "5";
                        aux[15] = "9";
                        aux[17] = "0";
                        aux[18] = "0";
                        aux[aux.length - 1] = "";
                        this.fecha2 = aux.join('');
                        ////console.log(this.fecha2);
                        aux = this.fecha1.split('');
                        aux[10] = " ";
                        aux[11] = "0";
                        aux[12] = "0";
                        aux[14] = "0";
                        aux[15] = "0";
                        aux[17] = "0";
                        aux[18] = "0";
                        aux[aux.length - 1] = "";
                        this.fecha1 = aux.join('');
                        ////console.log(this.fecha1);
                        break;
                    case "Observaciones":
                        this.observaciones = filtro[i].valor;
                        break;
                    case "Folio":
                        this.folio = filtro[i].valor;
                        break;
                }
            }
            if (this.fecha1 == 'null') {
                this.fecha1 = '';
            }
            if (this.fecha2 == 'null') {
                this.fecha2 = '';
            }
        }
    }
    // Muetra los campos dependiendo si es individual o masiva
    mostrarIndividualMasiva() {
        return this.router.url.includes("invidualStatusTransferT") || this.router.url.includes("/massiveStatusTransferT/pendientesM/detailsslopesMU") || this.router.url.includes("/individual") || this.router.url.includes("/devueltas");
    }
    // Muestra el icono de + dependiendo si es individual o masiva
    aparecer(i) {
        if (this.router.url.includes("invidualStatusTransferT") || this.router.url.includes('/massiveStatusTransferT/pendientesM/detailsslopesMU')) {
            // Para individual
            // Si es el ultimo elemento muestra el + pero si es el ultimo elemento de los 4
            // permitidos no lo muetra
            if (i == this.t.length - 1 && i < 3) {
                return true;
            }
            return false;
        }
        else {
            // Para masivas
            // Si es el ultimo elemento muestra el + pero si es el ultimo elemento de los 3
            // permitidos no lo muetra
            if (i == this.t.length - 1 && i < 2) {
                return true;
            }
            return false;
        }
    }
    // Si el elemento del select se encuentra dentro del arreglo arrayindividual lo muestra,
    // si no, no lo muestra. Esto es para no mostrar campos ya usados/repetidos
    usadoIndividual(item) {
        if (this.arrayindividual.includes(item)) {
            return true;
        }
        return false;
    }
    // Si el elemento del select se encuentra dentro del arreglo arrayMasiva lo muestra,
    // si no, no lo muestra. Esto es para no mostrar campos ya usados/repetidos
    usadoMasivo(item) {
        if (this.arrayMasiva.includes(item)) {
            return true;
        }
        return false;
    }
    // Logica del select
    //Muestra el select
    mostrar(i) {
        let aux = this.arrayindividual.every(element => element == null);
        let aux2 = this.arrayMasiva.every(element => element == null);
        if (!(aux || aux2)) {
            document.getElementsByClassName("fondo")[i].style.visibility = "visible";
            document.getElementsByClassName("select")[i].style.display = "block";
            document.getElementsByClassName("select")[i].style.visibility = "visible";
            document.getElementsByClassName("select")[i].style.opacity = "1";
        }
    }
    //Oculta el select
    ocultar(i) {
        document.getElementsByClassName("fondo")[i].style.visibility = "hidden";
        document.getElementsByClassName("select")[i].style.display = "none";
        document.getElementsByClassName("select")[i].style.visibility = "hidden";
        document.getElementsByClassName("select")[i].style.opacity = "0";
    }
    // Cierra el dialog y regresa una cadena "Reset Filtro"
    cerrar() {
        this.dialogRef.close('Reset filtro');
    }
};
