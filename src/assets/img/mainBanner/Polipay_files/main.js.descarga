                        this.percentage_transferC = this.datalist[1].Percent;
                        this.check_transferencia = this.datalist[1].TypeId;
                        this.commission_transferC = this.datalist[1].CommissionId;
                    }
                    else {
                        if (this.datalist[1].ServiceId == 3) {
                            this.percentage_paycash = this.datalist[1].Amount;
                            this.check_paycash = this.datalist[1].TypeId;
                            this.commission_paycash = this.datalist[1].CommissionId;
                        }
