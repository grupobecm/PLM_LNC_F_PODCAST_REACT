/* harmony default export */ __webpack_exports__["default"] = (".dispersions {\r\n    margin-top: 5%;\r\n}\r\n\r\n\r\n/* CARDS */\r\n\r\n\r\n.cards {\r\n    width: 100%;\r\n    /*height: calc(100vh - 245px);*/\r\n    padding: 40px 19.5px 0px 19.5px;\r\n    /*overflow-y: scroll;*/\r\n}\r\n\r\n\r\n.card {\r\n    min-width: 190px;\r\n    padding: 27.5px 5px 27.5px 5px;\r\n    box-shadow: 0 3px 13px 0 var(--opacity-48);\r\n    min-height: 285px;\r\n    margin: 0px 7px 0px 7px;\r\n}\r\n\r\n\r\n.card__title {\r\n    font-size: 20px;\r\n    font-weight: bold;\r\n    line-height: 1.33;\r\n    text-align: center;\r\n    /* overflow: hidden;\r\nheight: 35px; */\r\n    cursor: default;\r\n}\r\n\r\n\r\n/* Button card */\r\n\r\n\r\n.card__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width: 128px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var(--main-color);\r\n    margin-top: 23.7px;\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    /* centrar el boton */\r\n    display: block;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n    outline: none;\r\n    cursor: pointer;\r\n    box-shadow: 0 1px 3px var(--opacity-12), 0 3px 3px var(--opacity-24);\r\n    transition: 0.3s;\r\n}\r\n\r\n\r\n/* HOVER */\r\n\r\n\r\n.card__button:not([disabled]):hover {\r\n    background-color: var(--accent-color);\r\n    box-shadow: none;\r\n    /*color: var(--main-color);*/\r\n    transition: 0.3s;\r\n}\r\n\r\n\r\n/* INVALID DISABLED  */\r\n\r\n\r\n.card__button:disabled {\r\n    background-color: var(--main-color);\r\n    cursor: default;\r\n}\r\n\r\n\r\n/* FIN Button card */\r\n\r\n\r\n/* FIN CARDS */\r\n/*# sourceMappingURL=data:application/json;base64, */");

