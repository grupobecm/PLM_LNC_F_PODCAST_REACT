            //console.log( this.personal.person_id.rfc);
            //this.pdf = this.personal.Documents[0].documento;
            this.name = this.personal.person_id.Nombre;
            this.lastName = this.personal.person_id.apellido;
            this.rfc = this.personal.person_id.rfc;
            this.mail = this.personal.person_id.email;
            this.description = this.personal.person_id.descripcionActividades;
            this.cuenta = this.personal.cuenta.DatosCuenta;
