        //console.log(data);
        let question = this.dialog.open(src_app_Views_user_messageUser_questions_user_questions_user_component__WEBPACK_IMPORTED_MODULE_13__["QuestionsUserComponent"], {
            width: '550px',
            data: {
                question: 'CD-001',
                id: data.id,
                tracking: data.clave_rastreo
            },
            disableClose: true
        });
        question.afterClosed().subscribe(res => {
            this.AllRecordsRispersions();
            this.dialog.closeAll();
        });
    }
};
