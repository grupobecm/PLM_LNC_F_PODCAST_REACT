        });
    }
    listCardCosts() {
        this.showLoad = true;
        this.serviceCards.listCardCosts().subscribe(res => {
            //  //console.log(res);
            this.classic_price = res[0].costoUnit;
            this.platinum_price = res[1].costoUnit;
            this.golden_price = res[2].costoUnit;
            //person__last_name
            this.showLoad = false;
        }, error => {
            this.showLoad = false;
            //console.log(error.error)
            //console.log(error)
        });
    }
    ngOnInit() {
    }
    cancelar() {
        this.saldo = 0;
    }
    submit() {
        this.calc();
        let txt = document.getElementById("monto_total");
        //console.log(txt.innerHTML);
        let total = txt.innerHTML;
        //  //console.log(total);
        let data = {
            Clasica: this.classic_quantity,
            Platino: this.platinum_quantity,
            Dorada: this.golden_quantity,
            Subtotal: this.subtotal,
            monto_total_iva: Number(total),
        };
        //console.log(data)
        this.serviceCards.assignCardsAxisAccounts(this.idAccount, data).subscribe(res => {
            //console.log(res);
            this.showLoad = false;
            this.dialog.open(src_app_Views_user_messageUser_success_user_success_user_component__WEBPACK_IMPORTED_MODULE_15__["SuccessUserComponent"], {
