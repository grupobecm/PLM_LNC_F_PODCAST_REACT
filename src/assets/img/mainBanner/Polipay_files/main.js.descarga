                    this.documentosCenCost[i].doc =
                        this.cenCost.RazonSocial.Documentos[j].documento;
                    this.documentosCenCost[i].id =
                        this.cenCost.RazonSocial.Documentos[j].id;
                    let status = this.cenCost.RazonSocial.Documentos[j].status;
                    let coment = this.cenCost.RazonSocial.Documentos[j].comentario;
                    this.form.controls["radioBoton" + (i + 1)].setValue(status);
                    if (status == "D") {
                        this.form.controls["motivoDevolucion" + (i + 1)].setValue(coment);
