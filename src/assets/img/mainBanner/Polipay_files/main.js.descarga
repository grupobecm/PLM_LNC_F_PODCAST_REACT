ta-clock);\r\n}\r\n\r\n.activeLA {\r\n    background: var(--accent-color) !important;\r\n}\r\n\r\n.active2 {\r\n    background: var(--accent-color);\r\n    color: var(--white);\r\n}\r\n\r\n.activeL1 {\r\n    background: var(--bolita-clock);\r\n    transform: rotate(-61deg);\r\n}\r\n\r\n.activeL2 {\r\n    background: var(--bolita-clock);\r\n    transform: rotate(-31deg);\r\n}\r\n\r\n.activeL3 {\r\n    background: var(--bolita-clock);\r\n    transform: rotate(0deg);\r\n}\r\n\r\n.activeL4 {\r\n    background: var(--bolita-clock);\r\n    transform: rotate(30deg);\r\n}\r\n\r\n.activeL5 {\r\n    background: var(--bolita-clock);\r\n    transform: rotate(60deg);\r\n}\r\n\r\n.activeL6 {\r\n    background: var(--bolita-clock);\r\n    transform: rotate(90deg);\r\n}\r\n\r\n.activeL7 {\r\n    background: var(--bolita-clock);\r\n    transform: rotate(120deg);\r\n}\r\n\r\n.activeL8 {\r\n    background: var(--bolita-clock);\r\n    transform: rotate(150deg);\r\n}\r\n\r\n.activeL9 {\r\n    background: var(--bolita-clock);\r\n    transform: rotate(180deg);\r\n}\r\n\r\n.activeL10 {\r\n    background: var(--bolita-clock);\r\n    transform: rotate(210deg);\r\n}\r\n\r\n.activeL11 {\r\n    background: var(--bolita-clock);\r\n    transform: rotate(240deg);\r\n}\r\n\r\n.activeL12 {\r\n    background: var(--bolita-clock);\r\n    transform: rotate(270deg);\r\n}\r\n\r\n.number:hover {\r\n    background: var(--bolita-clock);\r\n    color: var(--grey-light4) !important;\r\n}\r\n\r\n.number:nth-child(2) {\r\n    top: 25px;\r\n    left: calc(50% + 25px);\r\n}\r\n\r\n.number:nth-child(2):hover+.linea1 {\r\n    background: var(--bolita-clock) !important;\r\n    transform: rotate(-61deg);\r\n}\r\n\r\n.number:nth-child(4) {\r\n    top: 60px;\r\n    right: 25px;\r\n}\r\n\r\n.number:nth-child(4):hover+.linea2 {\r\n    background: var(--bolita-clock) !important;\r\n    transform: rotate(-31deg);\r\n}\r\n\r\n.number:nth-child(6) {\r\n    top: calc(50% - 20px);\r\n    right: 10px;\r\n}\r\n\r\n.number:nth-ch