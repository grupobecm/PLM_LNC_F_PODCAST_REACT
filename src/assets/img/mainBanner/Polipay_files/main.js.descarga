iente</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{ element.empresa }}</td>\r\n            </ng-container>\r\n            <!-- Columna Ordenante -->\r\n            <ng-container matColumnDef=\"nombre_beneficiario\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Beneficiario</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{ element.nombre_beneficiario }}</td>\r\n            </ng-container>\r\n            <!-- Columna Monto -->\r\n            <ng-container matColumnDef=\"monto\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Monto</th>\r\n                <td mat-cell *matCellDef=\"let element\"> {{ element.monto | currency }} MXN</td>\r\n            </ng-container>\r\n            <!-- Columna Clave de rastreo -->\r\n            <ng-container matColumnDef=\"clave_rastreo\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Clave de Rastreo</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{ element.clave_rastreo }}</td>\r\n            </ng-container>\r\n            <!-- Columna Clave de rastreo -->\r\n            <ng-container matColumnDef=\"fecha_creacion\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Fecha de Operación</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{ element.fecha_creacion | date:'dd/MM/yyyy HH:mm' }}</td>\r\n            </ng-container>\r\n            <!-- Columna boton asignar servicios -->\r\n            <ng-container matColumnDef=\"button\">\r\n                <th mat-header-cell *matHeaderCellDef></th>\r\n                <td mat-cell *matCellDef=\"let element\">\r\n                    <div>\r\n                        <!-- <button class=\"verdetalles_button quitmrg  | background-main color-white\" (click)=\"seeDetails(element)\" fxLayoutAlign=\"center center\">\r\n                            <span class=\"\">Ver Detalles</span>\r\n                        </button> -->\r