let RelojComponent = class RelojComponent {
    constructor(dialogRef, data) {
        this.dialogRef = dialogRef;
        this.data = data;
        this.horas = true;
        this.selectAm = true;
        this.selectAm2 = true;
        this.hora = "12";
        this.minuto = "00";
        this.ampm = "A.M.";
        this.horaF = "12";
        this.minutoF = "00";
        this.ampmF = "A.M.";
    }
    cambiarHora(event, hora) {
        let div = document.querySelectorAll('.number');
        div.forEach((item, i) => {
            item.classList.remove('active');
            item.classList.remove('active2');
        });
        let linea = document.querySelectorAll('.linea');
        linea.forEach((item, i) => {
            item.classList.remove('activeL');
            item.classList.remove('activeL1');
            item.classList.remove('activeL2');
            item.classList.remove('activeL3');
            item.classList.remove('activeL4');
            item.classList.remove('activeL5');
            item.classList.remove('activeL6');
            item.classList.remove('activeL7');
            item.classList.remove('activeL8');
            item.classList.remove('activeL9');
            item.classList.remove('activeL10');
            item.classList.remove('activeL11');
            item.classList.remove('activeL12');
            item.classList.remove('activeLA');
        });
        event.target.classList.add('active2');
        switch (hora) {
            case '01':
            case '0C':
                event.target.nextElementSibling.classList.add('activeL1');
                event.target.nextElementSibling.classList.add('activeLA');
                break;
            case '02':
            case 'DD':
                event.target.nextElementSibling.classList.add('activeL2');
                event.target.nextElementSibling.classList.add('activeLA');
                break;
            case '03':
            case '15':
                event.target.nextElementSibling.classList.add('activeL3');
                event.target.nextElementSibling.classList.add('activeLA');
                break;
            case '04':
            case '20':
                event.target.nextElementSibling.classList.add('activeL4');
                event.target.nextElementSibling.classList.add('activeLA');
                break;
            case '05':
            case '25':
                event.target.nextElementSibling.classList.add('activeL5');
                event.target.nextElementSibling.classList.add('activeLA');
                break;
            case '06':
            case '30':
                event.target.nextElementSibling.classList.add('activeL6');
                event.target.nextElementSibling.classList.add('activeLA');
                break;
            case '07':
            case '35':
                event.target.nextElementSibling.classList.add('activeL7');
                event.target.nextElementSibling.classList.add('activeLA');
                break;
            case '08':
            case '40':
                event.target.nextElementSibling.classList.add('activeL8');
                event.target.nextElementSibling.classList.add('activeLA');
                break;
            case '09':
            case '45':
                event.target.nextElementSibling.classList.add('activeL9');
                event.target.nextElementSibling.classList.add('activeLA');
                break;
            case '10':
            case '50':
                event.target.nextElementSibling.classList.add('activeL10');
                event.target.nextElementSibling.classList.add('activeLA');
                break;
            case '11':
            case '55':
                event.target.nextElementSibling.classList.add('activeL11');
                event.target.nextElementSibling.classList.add('activeLA');
                break;
            case '12':
            case '00':
                event.target.nextElementSibling.classList.add('activeL12');
                event.target.nextElementSibling.classList.add('activeLA');
                break;
        }
        if (this.horas) {
            this.horaF = hora;
            document.getElementById('input__minutos').disabled = false;
        }
        else {
            if (hora == '0C') {
                this.minutoF = '05';
                this.minuto = '05';
            }
            else if (hora == 'DD') {
                this.minutoF = '10';
                this.minuto = '10';
            }
            else {
                this.minutoF = hora;
                this.minuto = hora;
            }
        }
        document.getElementById('input__minutos').focus();
        this.horas = false;
    }
    cambiarAMPM(ampm) {
        this.ampm = ampm;
        this.selectAm = false;
        this.selectAm2 = !this.selectAm2;
    }
    aceptar() {
        this.dialogRef.close([this.horaF, this.minutoF, this.ampm]);
    }
    limpiar() {
        this.horas = true;
        this.selectAm = true;
        this.selectAm2 = true;
        this.hora = "12";
        this.minuto = "00";
        this.horaF = "12";
        this.minutoF = "00";
        this.ampm = "A.M.";
    }
    time() {
        this.sleep(80);
        this.hora = this.horaF;
        this.minuto = this.minutoF;
    }
    sleep(milliseconds) {
        var start = new Date().getTime();
        for (var i = 0; i < 1e7; i++) {
            if ((new Date().getTime() - start) > milliseconds) {
                break;
            }
        }
    }
    hola() {
        if (Number(this.minuto) <= 9) {
            this.minuto = '0' + this.minuto;
        }
        if (Number(this.minuto) > 59) {
            this.minuto = '0' + this.minuto;
        }
        if (this.minuto == "0null") {
            this.minuto = '00';
        }
        this.minutoF = this.minuto.toString();
    }
};
