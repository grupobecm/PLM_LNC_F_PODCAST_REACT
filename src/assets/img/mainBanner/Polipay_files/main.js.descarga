                let arr_input = Array.prototype.slice.call(input);
                let arr_select = Array.prototype.slice.call(select);
                for (let i = 0; i < arr_input.length; i++) {
                    arr_select[i].style.width = (arr_input[i].offsetWidth) + "px";
                    arr_select[i].style.cssText += 'z-index: 999 !important';
                }
                clearInterval(refresh);
            }, 10);
        }
    }
    // Select selecciona un elemento
    select(val, i) {
        // Obtiene el "campo" seleccionado (Por "campo" quiero decir select e input) todo ese bloque
        let campos = (document.getElementsByClassName("filtro")[i]).getElementsByClassName("valor");
        // Obtiene unicamente el input select (donde se muetra la opcion seleccionada del select) 
        let input_actual = document.getElementsByClassName("input_select")[i].innerHTML;
        if (input_actual != "") {
            switch (input_actual) {
                case 'Beneficiario':
                    this.arrayindividual[0] = input_actual;
                    break;
                case 'Fecha de Operación':
                    this.arrayindividual[1] = input_actual;
                    break;
            }
        }
        // Habilita y muestra los campos seleccionados
        switch (val) {
            case 'Beneficiario':
                campos[0].style.display = "block";
                campos[1].style.display = "none";
                campos[0].disabled = false;
                this.arrayindividual[0] = null;
                document.getElementsByClassName("input_select")[i].innerHTML = 'Beneficiario';
                break;
            case 'Fecha de Operación':
                campos[0].style.display = "none";
                campos[1].style.display = "block";
                campos[1].classList.remove("disabled");
                this.arrayindividual[1] = null;
                document.getElementsByClassName("input_select")[i].innerHTML = 'Fecha de Operación';
