                    this.listGroupsBeneficiary.data.length > 0 ? this.noData = false : this.noData = true;
                    this.numRegister = this.listGroupsBeneficiary.data.length;
                    //console.log(this.numRegister);
                }, error => {
                    this.showLoad = false;
                    this.ningunDato = true;
                    //console.log(error.error)
