            this.showLoad = true;
            let fileList = event.target.files;
            // se verifica que exitan archivos
            if (fileList.length > 0) {
                let file = fileList[0];
                // se verifica que sea la extensión solicitada
                if (file.name.split('.')[1] == 'pdf') {
                    //verificamos el tamaño
                    if (file.size / 1024 / 1024 / 1024 < 1) {
                        this.file = file.name;
                        let reader = new FileReader();
                        reader.readAsDataURL(file);
                        //extraemos la información
                        reader.onload = (loadedEvent) => {
                            var fileFbaseaux;
                            //console.log(reader.result);
                            fileFbaseaux = reader.result;
                            fileFbaseaux = fileFbaseaux.split(","[0]);
                            this.file_ = fileFbaseaux[1];
                            //console.log("base 64 formateada:", this.file_);
                            this.error = false;
                        };
                    }
                    else {
                        // this.exito = false;
                        this.form.get('file').setValue(null);
                        this.file = "Seleciona el archivo";
                        // this.mensaje_error = 'Archivo demasiado grande, máximo 1Gb.';
                        this.error = true;
                    }
                }
                else {
                    // this.exito = false;
                    this.form.get('file').setValue(null);
                    this.file = "Seleciona el archivo";
                    // this.mensaje_error = 'La extensión no es permitida. Sólo XLSX (Microsoft Excel).'
                    this.error = true;
                }
            }
        });
