    //PARA BANCO
    mostrar2() {
        if (this.flg) {
            if (this.guardar) {
                document.getElementById("fondo2").style.display = 'block';
                document.getElementById("lista2").classList.add("mostrar2");
                document.getElementById("fondo2").style.zIndex = "13";
                document.getElementById("select1").style.zIndex = "13";
                document.getElementById("fondoColonia1").style.zIndex = "12";
                document.getElementById("selectColonia1").style.zIndex = "12";
                this.flg = false;
            }
        }
        else {
            this.ocultar2();
        }
    }
    ocultar2() {
        document.getElementById("fondo2").style.display = 'none';
        document.getElementById("lista2").classList.remove("mostrar2");
        this.flg = true;
        if (this.banco == '\u00a0') {
            this.rojobanco = true;
            this.auxFlgBanco = 1;
        }
    }
    actualizar2(value) {
        this.banco = value.institucion;
        this.banco_id = value.clabe;
        this.form.get('banco').setValue(this.banco);
        this.auxFlgBanco = 0;
        if (this.rojobanco) {
            this.rojobanco = false;
        }
    }
    // PARA COLONIA 1
