o }\">Banco*</span>\r\n                                        <div class=\"form__input select | font-roboto \"\r\n                                            [ngClass]=\"{ 'form__input_alert': requeridoBanco() || rojobanco}\" id=\"banco\"\r\n                                            type=\"text\" name=\"frecuent\" (click)=\"mostrar2()\">\r\n                                            {{ banco }}\r\n                                            <div class=\"flecha\" id=\"flecha\"\r\n                                                [ngClass]=\"{ 'flecha--alert': requeridoBanco() || rojobanco }\"></div>\r\n                                            <ul class=\"ul-select all zIndex-10 maxAlturaYScroll elscroll\" id=\"lista2\">\r\n                                                <li *ngFor=\"let banco of Bancos\" fxLayout=\"row wrap\"\r\n                                                    fxLayoutAlign=\"end center\" (click)=\"actualizar2(banco)\">\r\n                                                    <span class=\"texto__select\" fxFlex=\"95\">{{banco.institucion}}</span>\r\n                                                </li>\r\n                                            </ul>\r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                                <div class=\"alertTransfer\" *ngIf=\"requeridoBanco()\">\r\n                                    <span class=\"alert__text | color-red\">\r\n                                        Por favor escoge un banco\r\n                                    </span>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                        <div fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n                            <div fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n                                <!-- RFC Destinatario