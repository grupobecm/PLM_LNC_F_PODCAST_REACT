   <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoEstado() && form.get('estado_legal').touched) }\" autocomplete=\"off\" type=\"text\" name=\"estado_legal\" id=\"estado_legal\" formControlName=\"estado_legal\" [(ngModel)]=\"estado_legalModel\"\r\n                            required>\r\n                        <div class=\" alertTransfer\" *ngIf=\"requeridoEstado_legal() && form.get('estado_legal').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el Estado</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space  form--password-mt\" fxFlex=\"60\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoCalle_legal() && form.get('calle_legal').touched) }\" translate>Calle*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoCalle_legal() && form.get('calle_legal').touched) }\" autocomplete=\"off\" type=\"text\" name=\"calle_legal\" id=\"calle_legal\" formControlName=\"calle_legal\" [(ngModel)]=\"calle_legalModel\"\r\n                            required>\r\n                        <div class=\" alertTransfer\" *ngIf=\"requeridoCalle_legal() && form.get('calle_legal').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura la Calle</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space form--password-mt\" fxFlex=\"20\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridonoExterior_legal() && form.get('noExterior_legal').touched) }\" translate>No. Exterior*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridonoExterior_legal() && form.get('noExterior_legal').touched) }\" autocomplete=\"off\" type=\"text\" name=\"noExterior_legal\" id=\"noExterior_legal\" formControlName=\"noExterior_legal\"\r\n                            [(ngModel)]=\"noExterior_legalModel\" required>\r\n                        <div class=\" alertTransfer\" *ngIf=\"requeridonoExterior_legal() && form.get('noExterior_legal').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el Número Exterior</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space form--password-mt margin--rigth\" fxFlex=\"20\">\r\n                        <span class=\"form__text  pass | font-roboto\" translate>No. Interior</span>\r\n                        <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"noInterior_legal\" id=\"noInterior_legal\" formControlName=\"noInterior_legal\" [(ngModel)]=\"noInterior_legalModel\">\r\n                    </div>\r\n                </div>\r\n\r\n\r\n                <div class=\"mt-4\" fxFlex=\"100\">\r\n                    <button class=\"confirmar__button button-margin | color-white\" id=\"submit2\" type=\"button\" (click)=\"alPaso3()\" translate>Continuar</button>\r\n                </div>\r\n\r\n\r\n            </div>\r\n\r\n            <div *ngIf=\"paso3\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div class=\"mt-3\" fxFlex=\"100\">\r\n                    <p class=\"mensajeObl\" translate>User.Messages.RequiredFields</p>\r\n                </div>\r\n                <div class=\"mt-5\" fxFlex=\"100\">\r\n                    <p class=\"Subtitle color-accent remove-fondo\" translate>Documentos de la Razón Social</p>\r\n                </div>\r\n                <div class=\"mt-5\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"50\" fxLayout=\"row wrap\">\r\n                        <