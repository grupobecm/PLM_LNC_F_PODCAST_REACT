                        ////console.log(aux);
                        ////console.log("-------");
                        aux[10] = " ";
                        aux[11] = "2";
                        aux[12] = "3";
                        aux[14] = "5";
                        aux[15] = "9";
                        aux[17] = "0";
                        aux[18] = "0";
                        aux[aux.length - 1] = "";
                        this.fecha2 = aux.join('');
                        //console.log(this.fecha2);
                        aux = this.fecha1.split('');
                        ////console.log("-------");
                        ////console.log(aux);
                        ////console.log("-------");
                        aux[10] = " ";
                        aux[11] = "0";
                        aux[12] = "0";
                        aux[14] = "0";
                        aux[15] = "1";
                        aux[17] = "0";
                        aux[18] = "0";
                        aux[aux.length - 1] = "";
                        this.fecha1 = aux.join('');
                        //console.log(this.fecha1);
                        break;
                    case "Observaciones":
                        this.observaciones = filtro[i].valor;
                        break;
                }
            }
            if (this.router.url.includes('/administrador/pendientes/individual') || this.router.url.includes('/administrador/canceladas/individual')
                || this.router.url.includes('/administrador/enviadas/individual') || this.router.url.includes('/administrador/devueltas')) {
                if (this.fecha1 == 'null') {
                    this.fecha1 = '';
                }
                if (this.fecha2 == 'null') {
                    this.fecha2 = '';
                }
                //console.log("Filtro");
            }
            else {
                //console.log(this.fecha1);
                //console.log(this.fecha2);
            }
        }
        else {
            //console.log("masivas");
            this.showLoad = true;
            let filtro = this.form.value.filtro;
            for (let i = 0; i < filtro.length; i++) {
                switch (filtro[i].campo) {
                    case "Fecha de Dispersión":
                        this.fecha1 = (new Date(filtro[i].valor.begin).toISOString());
