  </div>\r\n          <div>\r\n              <span class=\"text color-60\">R.F.C. del Centro de Costo</span>\r\n              <p class=\"subtitle color-74\"><b>{{cenCost.RazonSocial.Rfc}}</b></p>\r\n          </div>\r\n          <div>\r\n              <span class=\"text color-60\">Clabe de Traspaso Final</span>\r\n              <p class=\"subtitle color-74\"><b>{{ClaveTraspasoFinal}}</b></p>\r\n          </div>\r\n          <div>\r\n              <span class=\"text color-60\">Banco</span>\r\n              <p class=\"subtitle color-74\"><b>{{Banco}}</b></p>\r\n          </div>\r\n          <div class=\"mt-5\">\r\n              <p class=\"color-accent\"><b>DOMICILIO FISCAL</b></p>\r\n              <span class=\"subtitle color-74\"> {{addressCen}} </span>\r\n          </div>\r\n          <div class=\"mt-5\">\r\n            <p class=\"color-accent\"><b>CLABE TRASPASO FINAL ANTERIOR</b></p>\r\n\r\n            <span class=\"text color-60\">Clabe de Traspaso Final</span>\r\n            <p class=\"subtitle color-74\"><b>{{cenCost.RazonSocial.ClaveTraspasoFinal}}</b></p>\r\n            <span class=\"text color-60\">Banco</span>\r\n            <p class=\"subtitle color-74\"><b>{{cenCost.RazonSocial.Banco}}</b></p>\r\n        </div>\r\n          </div>\r\n          <div fxFlex=\"75\" fxLayout=\"row wrap\">\r\n            <div fxFlex=\"100\">\r\n                <p class=\"color-accent\"><b>DOCUMENTOS</b></p>\r\n            </div>\r\n            <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"30\">\r\n                    <nav class=\"nav-barAD | \" fxFlex=\"100\" fxLayoutAlign=\"center start\">\r\n                        <ul class=\"navbar__menuAD\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                            <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento1()\" [ngClass]=\"{'activeD1': document1}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                                <a class=\"navbar__textAD | \">Datos Bancarios</a>\r\n                            </li>\r\n                        </ul>\r\n                    </nav>\r\n                </div>\r\n                <div fxFlex=\"68\" class=\"contenedor \" fxLayout=\"row wrap\">\r\n                    <div class=\"documents\">\r\n                        <div *ngIf=\"document1\" class=\"pdf-container mt-2\">\r\n                            <iframe class=\"pdf-container__view elscroll\" fxFlex=\"100\" [src]=\"documentosCenCost[0].doc | safeurl\"></iframe>\r\n                        </div>\r\n                        <div *ngIf=\"document1\" class=\"mt-3\" fxLayout=\"row wrap\">\r\n                            <div class=\"mb-2\" fxFlex=\"100\">\r\n                                <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n                            </div>\r\n                            <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                                <mat-radio-group fxFlex=\"100\" fxLayoutAlign=\"space-between center\" formControlName=\"radioBoton1\" (change)=\"motivo1 = selected($event, 'motivoDevolucion1')\" >\r\n                                    <mat-radio-button value=\"P\">Pendiente</mat-radio-button>\r\n                                    <mat-radio-button value=\"C\">Correcto</mat-radio-button>\r\n                                    <mat-radio-button value=\"D\">Devolver documento</mat-radio-button>\r\n                                </mat-radio-group>\r\n\r\n                                <div *ngIf=\"motivo1\" fxFlex=\"100\">\r\n                                    <div class=\"form\" fxFlex=\"100\">\r\n                                        <span class=\"form__text user | font-roboto\">Motivo de la devolución*</span>\r\n                                        <textarea class=\"formCon__input user | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"motivoDevolucion1\" formControlName=\"motivoDevolucion1\"></textarea>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n\r\n                    </div>\r\n                    <div class=\"contenedor-boton\" fxFlex=\"100\" fxLayoutAlign=\"end center\">\r\n                        <button class=\"confirmar__button | color-white\" type=\"button\" (click)=\"validarDoc('1')\"><b>Confirmar</b></button>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        </div>\r\n\r\n\r\n\r\n        <div *ngIf=\"paso2\" class=\"mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between start\">\r\n            <div fxFlex=\"100\">\r\n                <span class=\"text color-60\">Razón Social</span>\r\n                <p class=\"subtitle color-74\"><b>{{cenCost.RazonSocial.Nombre}}</b></p>\r\n            </div>\r\n            <div fxFlex=\"48\" class=\"mr-3\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"100\">\r\n                    <div class=\"tabla__una\" fxFlex=\"100\">\r\n                        <table class=\"tabla tabla-ordenes-enviadas | background-white\">\r\n                            <thead>\r\n                                <tr class=\"tr | color-main\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                                    <th class=\"th th--ml | color-accent\" fxFlex=\"100\">Documentos del Representante Legal</th>\r\n                                </tr>\r\n                            </thead>\r\n\r\n                            <tbody class=\"tablas__tbody\">\r\n                              <tr class=\"tr | color-third\" fxLayout=\"row wrap\" fxLayoutAlign=\"none center\">\r\n                                  <td class=\"th th--ml  th--content | color-third bold\" fxFlex=\"60\">Contrato o Estado de Cuenta bancario</td>\r\n                                  <td class=\"th th--align-right th--content| color-third\" fxFlex=\"15\">Estado:</td>\r\n                                  <td class=\"th th--align th--content | status--correct bold\" fxFlex=\"15\" *ngIf=\"form.value.radioBoton1=='C'\">CORRECTO</td>\r\n                                  <td class=\"th th--align th--content | status bold\" fxFlex=\"15\" *ngIf=\"form.value.radioBoton1=='P'\">PENDIENTE</td>\r\n                                  <td class=\"th th--align th--content | status--fail bold\" fxFlex=\"15\" *ngIf=\"form.value.radioBoton1=='D'\">DEVUELTO</td>\r\n                                  <td class=\"th th--ml  th--content | color-third bold\" fxFlex=\"100\" *ngIf=\"form.value.radioBoton1=='D'\">Motivo de la devolución: <br> {{form.value.motivoDevolucion1}}\r\n                                  </td>\r\n                              </tr>\r\n\r\n                          </tbody>\r\n\r\n                        </table>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div fxFlex=\"48\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"100\">\r\n                    <div class=\"tabla__una\" fxFlex=\"100\">\r\n                        <table class=\"tabla tabla-ordenes-enviadas | background-white\">\r\n                            <thead>\r\n                                <tr class=\"tr | color-main\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                                    <th class=\"th th--ml | color-accent\" fxFlex=\"100\">Resultado de verificación de documentos</th>\r\n                                </tr>\r\n                            </thead>\r\n                            <tbody class=\"tablas__tbody\" *ngIf=\"validate == true\">\r\n                                <tr class=\" | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                                    <td class=\"th th--ml  th--content | color-third \" fxFlex=\"100\"><b>El Cambio de Cuenta Clabe Para Traspaso final <span class=\"color-grey ml-1\">puede ser aUtorizado</span>, la Documentación es correcta.</b></td>\r\n                                </tr>\r\n                                <tr class=\" | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\">&nbsp;</td>\r\n                                </tr>\r\n                                <tr class=\" | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\">&nbsp;</td>\r\n                                </tr>\r\n                            </tbody>\r\n                            <tbody class=\"tablas__tbody\" *ngIf=\"validate == false\">\r\n                                <tr class=\" | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                                    <td class=\"th th--ml  th--content | color-third \" fxFlex=\"100\"><b>El Cambio de Cuenta Clabe Para Traspaso final <span class=\"color-red ml-1\">no puede ser Autorizado</span>  hasta que los documentos devueltos sean correctos.</b></td>\r\n                                </tr>\r\n                                <tr class=\" | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\">&nbsp;</td>\r\n                                </tr>\r\n                                <tr class=\" | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\"><b>notifica al personal administrativo de BecPolimentes SAPI de CV, para que revise la información y actualice los\r\n                                        documentos para una segunda revisión.</b></td>\r\n                                </tr>\r\n                            </tbody>\r\n\r\n                        </table>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"mt-5\" fxFlex=\"60\" fxFlexOffset=\"40\" fxLayoutAlign=\"end end\">\r\n                <button class=\"regresar__button mr-3 | color-third\" id=\"btn\" type=\"button\" (click)=\"alPaso1()\" translate>Regresar</button>\r\n                <button class=\"confirmar__button  | color-white\" id=\"submit1\" type=\"button\" (click)=\"submit()\"  *ngIf=\"validate == true && statusSolicitud!='Devuelta'\" translate>Autorizar</button>\r\n                <button class=\"confirmar__button  | color-white\" id=\"submit2\" type=\"button\" (click)=\"submit()\" *ngIf=\"validate == false && statusSolicitud!='Devuelta'\" translate>Notificar</button>\r\n            </div>\r\n        </div>\r\n\r\n    </form>\r\n\r\n</div>\r\n\r\n<!-- Loader -->\r\n<app-loading *ngIf=\"showLoad\"></app-loading>\r\n");

