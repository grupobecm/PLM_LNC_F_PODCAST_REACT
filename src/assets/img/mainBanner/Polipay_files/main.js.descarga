let ListReceivedAxisAcountAComponent = class ListReceivedAxisAcountAComponent {
    constructor(dialog, router, formBuilder, storageClient, serviceClient) {
        this.dialog = dialog;
        this.router = router;
        this.formBuilder = formBuilder;
        this.storageClient = storageClient;
        this.serviceClient = serviceClient;
        this.cuenta = "";
        //Tablas de Angular Material
        this.displayedColumns = ['empresa', 'nombre_emisor', 'monto', "clave_rastreo", 'date_modify', 'button'];
        this.listStaffExternal = [];
        this.ningunDato = false;
        this.noData = false;
        this.numRegister = 0;
        this.latName = "";
        this.showLoad = false;
        this.color = 'primary';
        this.listPersonal();
    }
    listPersonal(size = 99999, nombreEmisor = null, date1 = null, date2 = null) {
        this.showLoad = true;
        //datos que enviamos a back, probablemente se regres
        this.serviceClient.listReceived(size, nombreEmisor, date1, date2).subscribe(res => {
            //console.log(res);
            this.ningunDato = false;
            /*res.results.forEach(element => {
                element.person__last_name=element.person__last_name.replace("*"," ");
            });*/
            let variable = [...res.results];
            this.listStaffExternal = new _angular_material_table__WEBPACK_IMPORTED_MODULE_13__["MatTableDataSource"](variable);
            //person__last_name
            this.showLoad = false;
            this.listStaffExternal.sort = this.sort;
            this.listStaffExternal.paginator = this.paginator;
            this.listStaffExternal.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listStaffExternal.data.length;
            //console.log(this.numRegister);
        }, error => {
            this.showLoad = false;
            this.ningunDato = true;
            //console.log(error.error)
            //console.log(error)
        });
    }
    openFilter() {
        let filtro = this.dialog.open(_filter_axis_acount_received_filter_axis_acount_received_component__WEBPACK_IMPORTED_MODULE_21__["FilterAxisAcountReceivedComponent"], {
            width: "90%",
            panelClass: "custom-dialog-container"
        });
        filtro.afterClosed().subscribe(res => {
            let nombre_emisor = null;
            let date1 = null;
            let date2 = null;
            //console.log(res);
            if (res == undefined) {
            }
            else {
                if (res != 'Reset filtro') {
                    for (let i = 0; i < res.data.filtro.length; i++) {
                        switch (res.data.filtro[i].campo) {
                            case 'Emisor':
                                nombre_emisor = res.data.filtro[i].valor;
                                break;
                            case 'Fecha de Operación':
                                date1 = res.data.filtro[i].valor.begin.toISOString().split("T")[0] + " 00:00";
                                date2 = res.data.filtro[i].valor.end.toISOString().split("T")[0] + " 23:59";
                                break;
                        }
                    }
                    this.listPersonal(9999, nombre_emisor, date1, date2);
                }
            }
        });
    }
    seedetailsReceived(element) {
        //console.log(element);
        //console.log(element.id);
        //this.showLoad = true;
        this.serviceClient.detailsReceived(element.id).subscribe(res => {
            //console.log(res);
            // for(let i=0;i<=element.id;i++){
            //  //console.log(res[i].nombre_beneficiario);
            //}
            this.showLoad = false;
            this.dialog.open(_details_received_axis_account_a_details_received_axis_account_a_component__WEBPACK_IMPORTED_MODULE_20__["DetailsReceivedAxisAccountAComponent"], {
                width: "600px",
                data: {
                    res: res[0],
                    type: 'P'
                },
                panelClass: ['custom-dialog-container'],
                disableClose: true,
            });
        }, error => {
            //console.log(error);
        });
    }
    requestCards(data) {
        this.storageClient.setInfoExternalP(data);
        this.router.navigate(["/usuario/dispersiones/peronal-externo/asignar-tarjetas-personal-externo"]);
    }
    statusChange(dato) {
        //console.log(dato);
        let question = this.dialog.open(src_app_Views_user_messageUser_questions_user_questions_user_component__WEBPACK_IMPORTED_MODULE_18__["QuestionsUserComponent"], {
            data: {
                question: 'D-001',
                username: dato.name,
                id: dato.id,
                //Mando true para mandar un motivo en la desactivacion
                motivo: true
            },
            disableClose: true,
        });
        question.afterClosed().subscribe(res => {
            if (res != undefined) {
                if (res.event) {
                    let form = this.dialog.open(src_app_Views_user_messageUser_form_user_form_user_component__WEBPACK_IMPORTED_MODULE_17__["FormUserComponent"], {
                        width: '500px',
                        data: {
                            form: 'D-001',
                            id: dato.id,
                            username: dato.name,
                        },
                        disableClose: true,
                    });
                    form.afterClosed().subscribe(res => {
                        if (res != undefined) {
                            if (res.event) {
                                //console.log(dato.username);
                                let success = this.dialog.open(src_app_Views_user_messageUser_success_user_success_user_component__WEBPACK_IMPORTED_MODULE_19__["SuccessUserComponent"], {
                                    width: '500px',
                                    data: {
                                        success: 'D-003',
                                        username: dato.name,
                                    },
                                    disableClose: true,
                                });
                                success.afterClosed().subscribe(res => {
                                    this.listPersonal();
                                });
                            }
                        }
                    });
                }
            }
        });
    }
};
