ields</p>\r\n        </div>\r\n        <div class=\"mt-5\" fxFlex=\"100\">\r\n            <p class=\"infor | mensajeObl\">Layout con información de nuevos beneficiarios a cargar*</p>\r\n        </div>\r\n        <div fxFlex=\"100\">\r\n            <div class=\"cargar\" fxFlex=\"40\" fxLayoutAlign=\"start center\">\r\n                <input class=\"boton__input\" name=\"file\" formControlName=\"file\" id=\"file\" style=\"display: none\"\r\n                    type=\"file\" (change)=\"fileChange($event)\" #hiddenfileinput\r\n                    accept=\".xlsx, .csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel\">\r\n                <button type=\"button\" class=\"cargar__button | color-white\" [ngClass]=\"{'boton--alert': error }\"\r\n                    routerLinkActive=\"active\" (click)=\"hiddenfileinput.click()\">\r\n                    <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                    <b>Cargar Archivo</b></button>\r\n                <div fxFlex=\"80\" fxLayout=\"row\" fxLayoutAlign=\"center start\">\r\n                    <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ file }}</span>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"mt-5\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\">\r\n            <div class=\"ml-3\" fxLayoutAlign=\"end end\">\r\n                <button class=\"cancelar__button | color-third\"\r\n                    [routerLink]=\"['/usuario/dispersiones/peronal-externo/lista-personal-externo']\"\r\n                    type=\"button\">Cancelar</button>\r\n            </div>\r\n            <div class=\"ml-3\" fxLayoutAlign=\"end end\">\r\n                <button class=\"confirmar__button | color-white\" type=\"submit\">Continuar</button>\r\n            </div>\r\n        </div>\r\n    </form>\r\n\r\n    <div class=\"content\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"