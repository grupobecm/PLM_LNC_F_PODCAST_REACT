                campos[3].style.display = "none";
                campos[2].classList.remove("disabled");
                this.arrayindividual[2] = null;
                document.getElementsByClassName("input_select")[i].innerHTML = 'Fecha de Operación';
                break;
            case 'Folio1':
                campos[0].style.display = "none";
                campos[1].style.display = "none";
                campos[2].style.display = "none";
                campos[3].style.display = "block";
                campos[3].disabled = false;
                this.arrayindividual[3] = null;
                document.getElementsByClassName("input_select")[i].innerHTML = 'Folio';
