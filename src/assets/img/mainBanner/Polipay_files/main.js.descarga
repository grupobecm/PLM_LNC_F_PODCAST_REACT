let AxisAccountAdministrationComponent = class AxisAccountAdministrationComponent {
    constructor(router, serviceAxisAccount, storageAdmin) {
        this.router = router;
        this.serviceAxisAccount = serviceAxisAccount;
        this.storageAdmin = storageAdmin;
        this.showLoad = false;
        this.rfc = "";
        this.cuenta = "";
        this.clabe = "";
        this.giro = "";
        this.fecha_constitucion = "";
        this.representante_legal = "";
        this.email = "";
        this.name_stp = "";
        this.TP = "Tarjetas de Prepago";
        this.T = "Transferencias";
        this.flagT = true;
        this.flagTP = true;
        this.flagTwoS = false;
        this.noRequest = true;
        this.prepaidCards = true;
        this.transfer = true;
        if (this.storageAdmin.CenterCostExist) {
            this.data = this.storageAdmin.CenterCost;
            // //console.log(this.data);
            this.id = this.data.id;
            // //console.log(this.data.id);
            // if( this.data.services[1] == this.TP){
            //   this.noRequest = false
            // }
            // if(this.data.services[0] == this.TP){
            //   this.transfer = false
            // }
            if (this.data.services.length >= 2) {
                this.flagT = true;
                this.flagTP = true;
                this.flagTwoS = false;
            }
            else {
                if (this.data.services.length == 1) {
                    if (this.data.services[0] == 'Tarjetas de Prepago') {
                        this.flagTwoS = true;
                        this.flagTP = true;
                        this.flagT = false;
                    }
                }
            }
            this.showLoad = true;
            this.serviceAxisAccount.deatilsAxisAccount(this.id).subscribe(res => {
                this.showLoad = false;
                // //console.log(res);
                this.rfc = res.empresa_id.rfc;
                this.name_stp = res.empresa_id.name_stp;
                //this.datos_banco = res.empresa_id.banco;
                this.giro = res.empresa_id.giro;
                this.cuenta = res.empresa_id.cuenta;
                this.representante_legal = res.representante_legal.name;
                this.email = res.representante_legal.email;
                this.id = res.empresa_id.id;
                this.dataAxis = res.empresa_id;
            }, error => {
                this.showLoad = false;
                // //console.log(error);
            });
            // //console.log(this.data);
            //this.rfc = this.data.rfc
            this.cuenta = this.data.cuenta;
            this.clabe = this.data.clabe;
