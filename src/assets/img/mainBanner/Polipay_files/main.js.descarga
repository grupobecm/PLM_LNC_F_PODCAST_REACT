    detalles() {
        if (this.moral == true) {
            this.service.detailsExternalClientMoral(this.id).subscribe(res => {
                //console.log(res);
                this.clienteMoral = res;
                const address = res.cliente_externo_moral.domicilio[0];
                this.getAddressFormat(address);
                this.clienteMoral.representante_legal.nombre = this.clienteMoral.representante_legal.nombre.replace("*", " ");
