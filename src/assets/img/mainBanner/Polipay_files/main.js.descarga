                        },
                        disableClose: true,
                    });
                    failDialog.afterClosed().subscribe((res) => {
                        this.router.navigate(['/administrador/pending/individual']);
                    });
                });
            }
            else {
                this.router.navigate(['/administrador/pending/individual']);
            }
        });
    }
};
