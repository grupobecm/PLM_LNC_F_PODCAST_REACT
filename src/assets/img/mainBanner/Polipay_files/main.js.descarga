let SessionExpiredComponent = class SessionExpiredComponent {
    constructor(router, serviceLogin, storageHome) {
        this.router = router;
        this.serviceLogin = serviceLogin;
        this.storageHome = storageHome;
    }
    ngOnInit() { }
    logout() {
        //Cerrar sesion API
        this.serviceLogin.logout({ id: this.storageHome.IdUserValue }).subscribe(res => {
            this.storageHome.clear();
            this.router.navigate(['/']);
            location.reload();
        }, error => {
            ////console.log(error.error);     // Mensaje de error API
        });
    }
};
