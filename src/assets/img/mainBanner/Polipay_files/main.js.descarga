let FiltroReportesComponent = class FiltroReportesComponent {
    constructor(data, dialogRef, formBuilder, router, dateAdapter) {
        this.data = data;
        this.dialogRef = dialogRef;
        this.formBuilder = formBuilder;
        this.router = router;
        this.dateAdapter = dateAdapter;
        // Fecha para ultimo mes y ultimos dos meses
        this.date = new Date();
        // Fecha para el inputDate
        this.datenow = new Date();
        // Bandera para aparecer los campos para rango de fechas
        this.flgFechasRango = false;
        this.fecha1 = "null";
        this.fecha2 = "null";
        this.observaciones = "";
        this.form = formBuilder.group({
            fecha1: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_4__["Validators"].required]],
            fecha2: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_4__["Validators"].required]],
        });
    }
    ngOnInit() {
    }
    ultimoMes() {
        var d = new Date();
        let fechaformato2 = new Date(d.setMonth(d.getMonth())).toISOString();
        let fechaformato = new Date(d.setMonth(d.getMonth() - 1)).toISOString();
        //console.log(fechaformato);
        //Fecha para las 23:00
        let aux = fechaformato2.split('');
        aux[10] = " ";
        aux[11] = "2";
        aux[12] = "3";
        aux[14] = "5";
        aux[15] = "9";
        aux[17] = "0";
        aux[18] = "0";
        aux[20] = "0";
        aux[21] = "0";
        aux[22] = "0";
        aux[23] = "";
        aux[aux.length - 1] = "";
        this.fecha2 = aux.join('');
        //Fecha ppara 00:00
        aux = fechaformato.split('');
        aux[10] = " ";
        aux[11] = "0";
        aux[12] = "0";
        aux[14] = "0";
        aux[15] = "0";
        aux[17] = "0";
        aux[18] = "0";
        aux[20] = "0";
        aux[21] = "0";
        aux[22] = "0";
        aux[23] = "";
        aux[aux.length - 1] = "";
        this.fecha1 = aux.join('');
        let json = {
            fechainicio: this.fecha1,
            fechafin: this.fecha2
        };
        this.dialogRef.close(json);
        //console.log(fechaformato);
        //console.log(fechaformato2);
        //console.log(this.fecha1);
        //console.log(this.fecha2);
    }
    ultimosDosMeses() {
        var d = new Date();
        d.setMonth(d.getMonth() - 2);
        this.dialogRef.close(d);
    }
    fechaRango() {
        this.flgFechasRango = !this.flgFechasRango;
    }
    submit() {
        //console.log(this.form.value);
        this.dialogRef.close(this.form.value);
        let filtro = this.form.value.filtro;
        for (let i = 0; i < filtro.length; i++) {
            switch (filtro[i].campo) {
                case "Fecha de Dispersión":
                    this.fecha1 = (new Date(filtro[i].valor.begin).toISOString());
                    this.fecha2 = (new Date(filtro[i].valor.end).toISOString());
                    let aux = this.fecha2.split('');
                    aux[10] = " ";
                    aux[11] = "2";
                    aux[12] = "3";
                    aux[14] = "5";
                    aux[15] = "9";
                    aux[17] = "0";
                    aux[18] = "0";
                    aux[20] = "0";
                    aux[21] = "0";
                    aux[22] = "0";
                    aux[23] = "";
                    aux[aux.length - 1] = "";
                    this.fecha2 = aux.join('');
                    ////console.log(this.fecha2);
                    aux = this.fecha1.split('');
                    aux[10] = " ";
                    aux[11] = "0";
                    aux[12] = "0";
                    aux[14] = "0";
                    aux[15] = "0";
                    aux[17] = "0";
                    aux[18] = "0";
                    aux[20] = "0";
                    aux[21] = "0";
                    aux[22] = "0";
                    aux[23] = "";
                    aux[aux.length - 1] = "";
                    this.fecha1 = aux.join('');
                    ////console.log(this.fecha1);
                    break;
            }
        }
        this.registros = "";
        this.dialogRef.close({ data: {
                data: this.registros,
                filtrar: false,
                filtro: {
                    observaciones: this.observaciones,
                    fecha1: this.fecha1,
                    fecha2: this.fecha2
                }
            } });
    }
    cerrar() {
        this.dialogRef.close("Reset Filtro");
    }
    mostrarTodas() {
        return this.router.url.includes("/reportes/total");
    }
    mostrarIncome() {
        return this.router.url.includes("/reportes/ingresos");
    }
    mostrarExpenses() {
        return this.router.url.includes("/reportes/egresos");
    }
