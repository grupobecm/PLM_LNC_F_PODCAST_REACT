let MassiveSComponent = class MassiveSComponent {
    constructor(router, dialog) {
        this.router = router;
        this.dialog = dialog;
        this.numeroRegistros = 0;
        this.cero = false;
        this.numeroRegistrosaMostrar = 5;
        this.showLoad = false;
        this.pagina_actual = 1;
        this.next_page = 0;
        this.prev_page = 0;
        this.total = 0;
        this.total_paginas = 0;
        this.numeroRegistrosF = 0;
        this.numeroRegistrosaMostrarF = 5;
        this.pagina_actualF = 1;
        this.next_pageF = 0;
        this.prev_pageF = 0;
        this.totalF = 0;
        this.total_paginasF = 0;
        this.filtradas = true;
        this.beneficiario = "";
        this.fecha1 = "null";
        this.fecha2 = "null";
        this.clave = "";
        this.totalAux = 0;
        //ordenamiento de datos
        this.noorder = true;
        this.noorderF = true;
        //---
        this.client = true;
        this.observ = true;
        this.fecha = true;
        this.showLoad = true;
        this.ListTransfer();
    }
    //Orde de datos de tabla
    ordenarClient() {
        this.client = !this.client;
        if (this.client) {
            this.ascendenteClient();
        }
        else {
            this.descendenteClient();
        }
    }
    ascendenteClient() {
        this.registros.sort(function (a, b) {
            if (a.company < b.company)
                return -1;
        });
    }
    descendenteClient() {
        this.registros.sort(function (a, b) {
            if (a.company > b.company)
                return -1;
        });
    }
    ordenarObservaciones() {
        this.observ = !this.observ;
        if (this.observ) {
            this.ascendenteObservaciones();
        }
        else {
            this.descendenteObservaciones();
        }
    }
    ascendenteObservaciones() {
        this.registros.sort(function (a, b) {
            if (a.observaciones < b.observaciones)
                return -1;
        });
    }
    descendenteObservaciones() {
        this.registros.sort(function (a, b) {
            if (a.observaciones > b.observaciones)
                return -1;
        });
    }
    ordenFecha() {
        this.fecha = !this.fecha;
        if (this.fecha) {
            this.ascendenteFecha();
        }
        else {
            this.descendenteFecha();
        }
    }
    ascendenteFecha() {
        this.registros.sort(function (a, b) {
            if (a.date_created < b.date_created)
                return -1;
        });
    }
    descendenteFecha() {
        this.registros.sort(function (a, b) {
            if (a.date_created > b.date_created)
                return -1;
        });
    }
    liquidar(id, message) {
        // let id_cm = {id: id}
        // this.dialog.open(QuestionsComponent,{
        //disableClose: true,
        //   width: '500px',
        //   data:{
        //     success: 3,
        //     message:message,
        //     id: id_cm
        //   }
        // })
    }
    cancelar(id, message) {
        // let id_cm = {id: id}
        // this.dialog.open(QuestionsComponent,{
        //disableClose: true,
        //   width: '500px',
        //   data:{
        //     success: 2,
        //     id: id_cm,
        //     message:message
        //   }
        // })
    }
    detallesM(dato) {
        this.router.navigate(['/administrador/pendientes/detallesmassive']);
    }
    noOrdenar() {
        //console.log('funcion 0');
        if (this.numeroRegistrosaMostrar < 100) {
            this.noorder = true;
        }
        else if (this.numeroRegistrosaMostrar > 100) {
            this.noorder = false;
        }
    }
    ListTransfer() {
        this.showLoad = true;
        this.pagina_actual = 1;
    }
    next() {
        if (this.next_page != null) {
            this.showLoad = true;
            this.pagina_actual++;
        }
    }
    prev() {
        if (this.prev_page != null) {
            this.showLoad = true;
            this.pagina_actual--;
        }
    }
    inicio() {
        this.ListTransfer();
    }
    fin() {
        if (Number(this.total_paginas.toFixed()) < Number(this.total_paginas)) {
            this.pagina_actual = Number(this.total_paginas.toFixed()) + 1;
        }
        else {
            this.pagina_actual = Number(this.total_paginas.toFixed());
        }
        this.showLoad = true;
    }
    update() {
        if (this.numeroRegistrosaMostrar == 0) {
            this.numeroRegistrosaMostrar = this.total;
        }
        this.ListTransfer();
        this.noOrdenar();
    }
    exportarXlsx() {
        this.showLoad = true;
    }
    detalles(data) {
        const navigationExtras = { state: { example: data } };
        this.router.navigate(['/administrador/pendientes/detallesmassive'], navigationExtras);
    }
};
