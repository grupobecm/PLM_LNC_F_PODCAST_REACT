rior\">\r\n                                </button>\r\n\r\n                                <button class=\"boton next\" (click)=\"next()\">\r\n                                    <img src=\"../../../../assets/img/icons/next.svg\" alt=\"Página siguiente\">\r\n                                </button>\r\n\r\n                                <button class=\"boton end\" (click)=\"fin()\">\r\n                                    <img src=\"../../../../assets/img/icons/end.svg\" alt=\"Ultima página\">\r\n                                </button>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <!-- FIN Tabla enviadas -->\r\n            </div>\r\n\r\n\r\n\r\n        </div>\r\n    </div>\r\n    <!-- Loading -->\r\n    <app-loading *ngIf=\"showLoad\"></app-loading>\r\n\r\n\r\n</div>");

