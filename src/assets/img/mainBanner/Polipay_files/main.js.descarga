ment\">{{ element.fecha_creacion | date:'dd/MM/yyyy HH:mm' }} Hrs.</td> -->\r\n            </ng-container>\r\n            <ng-container matColumnDef=\"button\">\r\n                <th mat-header-cell *matHeaderCellDef></th>\r\n                <td mat-cell *matCellDef=\"let element\">\r\n                    <div>\r\n                        <button class=\"verdetalles_button quitmrg  | background-opacity-main color-white\" (click)=\"seedetails(element)\" fxLayoutAlign=\"center center\" fxFlex.xl=\"60\">\r\n                            <span class=\"\"><img src=\"../../../../../../../../assets/img/icons/eye-icon_blue.svg\" alt=\"\"></span>\r\n                        </button>\r\n                    </div>\r\n                </td>\r\n            </ng-container>\r\n            <tr mat-header-row *matHeaderRowDef=\"displayedColumns\"></tr>\r\n            <tr mat-row *matRowDef=\"let row; columns: displayedColumns\"></tr>\r\n            <tr mat-footer-row *matFooterRowDef=\"['noData']\" [hidden]=\"numRegister > 0\"></tr>\r\n\r\n        </table>\r\n        <mat-paginator fxFlex=\"100\" [pageSizeOptions]=\"[100]\" showFirstLastButtons></mat-paginator>\r\n    </div>\r\n\r\n\r\n</div>\r\n<!-- Loader -->\r\n<app-loading *ngIf=\"showLoad\"></app-loading>");

