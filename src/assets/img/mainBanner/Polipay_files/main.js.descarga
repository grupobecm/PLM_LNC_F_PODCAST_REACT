            this.listStaffExternal.data.length > 0
                ? (this.noData = false)
                : (this.noData = true);
            this.numRegister = this.listStaffExternal.data.length;
        }, (error) => {
            this.showLoad = false;
            this.ningunDato = true;
            //console.log(error.error);
        });
    }
    details(dato) {
        //console.log(dato);
        sessionStorage.setItem("cenCost", JSON.stringify(dato));
        if (JSON.parse(sessionStorage.getItem("cenCost")).estado__nombreEdo) {
            if (JSON.parse(sessionStorage.getItem("cenCost")).estado__nombreEdo == "Devuelta") {
                if (JSON.parse(sessionStorage.getItem("cenCost")).tipoSolicitud_id == '15') {
                    this.router.navigate(["/usuario/administration/costcenteruser/correctcostcenter"], {
                        state: {
                            dato: dato,
                        },
                    });
                }
                else if (JSON.parse(sessionStorage.getItem("cenCost")).tipoSolicitud_id == '23') {
                    this.router.navigate(["/usuario/administration/costcenteruser/correct-legal-representative"], {
                        state: {
                            dato: dato,
                        },
                    });
                }
                else {
                    this.router.navigate(["/usuario/administration/costcenteruser/returncostcenter"], {
                        state: {
                            dato: dato,
                        },
                    });
                }
            }
            else {
                this.router.navigate(["/usuario/administration/costcenteruser/detailscostcenter"], {
                    state: {
                        dato: dato,
                    },
                });
            }
        }
        else {
            this.router.navigate(["/usuario/administration/costcenteruser/detailscostcenter"], {
                state: {
                    dato: dato,
                },
            });
        }
    }
    alPaso1() {
        this.paso1 = true;
        this.paso2 = false;
        this.getListCostCenter("activo", null, null, null);
    }
    alPaso2() {
        this.paso1 = false;
