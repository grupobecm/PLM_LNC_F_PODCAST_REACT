    // Muetra los campos dependiendo si es individual o masiva
    mostrarIndividualMasiva() {
        return this.router.url.includes("invidualStatusTransferT") || this.router.url.includes("/individual") || this.router.url.includes("/devueltas");
    }
    // Muestra el icono de + dependiendo si es individual o masiva
    aparecer(i) {
        if (this.router.url.includes("invidualStatusTransferT")) {
            // Para individual
            // Si es el ultimo elemento muestra el + pero si es el ultimo elemento de los 4
            // permitidos no lo muetra
            if (i == this.t.length - 1 && i < 3) {
                return true;
            }
            return false;
        }
        else {
            // Para masivas
            // Si es el ultimo elemento muestra el + pero si es el ultimo elemento de los 3
            // permitidos no lo muetra
            if (i == this.t.length - 1 && i < 2) {
                return true;
            }
            return false;
        }
    }
    // Si el elemento del select se encuentra dentro del arreglo arrayindividual lo muestra,
    // si no, no lo muestra. Esto es para no mostrar campos ya usados/repetidos
    usadoIndividual(item) {
        if (this.arrayindividual.includes(item)) {
            return true;
        }
        return false;
    }
    // Si el elemento del select se encuentra dentro del arreglo arrayMasiva lo muestra,
    // si no, no lo muestra. Esto es para no mostrar campos ya usados/repetidos
    usadoMasivo(item) {
        if (this.arrayMasiva.includes(item)) {
            return true;
        }
        return false;
    }
    // Logica del select
    //Muestra el select
    mostrar(i) {
        let aux = this.arrayindividual.every(element => element == null);
        let aux2 = this.arrayMasiva.every(element => element == null);
        if (!(aux || aux2)) {
            document.getElementsByClassName("fondo")[i].style.visibility = "visible";
            document.getElementsByClassName("select")[i].style.display = "block";
            document.getElementsByClassName("select")[i].style.visibility = "visible";
            document.getElementsByClassName("select")[i].style.opacity = "1";
        }
    }
    //Oculta el select
    ocultar(i) {
        document.getElementsByClassName("fondo")[i].style.visibility = "hidden";
        document.getElementsByClassName("select")[i].style.display = "none";
        document.getElementsByClassName("select")[i].style.visibility = "hidden";
        document.getElementsByClassName("select")[i].style.opacity = "0";
    }
    // Cierra el dialog y regresa una cadena "Reset Filtro"
    cerrar() {
        this.dialogRef.close('Reset filtro');
    }
};
