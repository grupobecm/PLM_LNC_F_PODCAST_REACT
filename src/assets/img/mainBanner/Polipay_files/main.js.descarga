                clearInterval(refresh);
            }, 10);
        }
    }
    // Select selecciona un elemento
    select(val, i) {
        // Obtiene el "campo" seleccionado (Por "campo" quiero decir select e input) todo ese bloque
        let campos = (document.getElementsByClassName("filtro")[i]).getElementsByClassName("valor");
        // Obtiene unicamente el input select (donde se muetra la opcion seleccionada del select) 
        let input_actual = document.getElementsByClassName("input_select")[i].innerHTML;
        if (input_actual != "") {
            switch (input_actual) {
                case 'Beneficiario':
                    this.arrayindividual[0] = input_actual;
                    break;
                case 'Fecha de Operación':
                    this.arrayindividual[1] = input_actual;
                    break;
            }
        }
        // Habilita y muestra los campos seleccionados
        switch (val) {
            case 'Beneficiario':
                campos[0].style.display = "block";
                campos[1].style.display = "none";
                campos[0].disabled = false;
                this.arrayindividual[0] = null;
                document.getElementsByClassName("input_select")[i].innerHTML = 'Beneficiario';
                break;
            case 'Fecha de Operación':
                campos[0].style.display = "none";
                campos[1].style.display = "block";
                campos[1].classList.remove("disabled");
                this.arrayindividual[1] = null;
                document.getElementsByClassName("input_select")[i].innerHTML = 'Fecha de Operación';
                break;
        }
        input_actual = val;
        this.ocultar(i);
    }
    // Boton de Aceptar
    onSubmit() {
        let campos = document.getElementsByClassName("input_select");
        for (let i = 0; i < campos.length; i++) {
            this.form.value.filtro[i].campo = document.getElementsByClassName("input_select")[i].innerHTML;
        }
        //console.log("->",this.form.value);
        this.dialogRef.close({ data: this.form.value });
    }
    // Si el elemento del select se encuentra dentro del arreglo arrayindividual lo muestra,
    // si no, no lo muestra. Esto es para no mostrar campos ya usados/repetidos
    usadoIndividual(item) {
        if (this.arrayindividual.includes(item)) {
            return true;
        }
        return false;
    }
    // Muestra el icono de + dependiendo si es individual o masiva
    aparecer(i) {
        if (i == this.t.length - 1 && i < 1) {
            return true;
        }
        return false;
    }
    // Logica del select
    //Muestra el select
    mostrar(i) {
        let aux = this.arrayindividual.every(element => element == null);
        if (!(aux)) {
            document.getElementsByClassName("fondo")[i].style.visibility = "visible";
            document.getElementsByClassName("select")[i].style.display = "block";
            document.getElementsByClassName("select")[i].style.visibility = "visible";
            document.getElementsByClassName("select")[i].style.opacity = "1";
        }
    }
    //Oculta el select
    ocultar(i) {
        document.getElementsByClassName("fondo")[i].style.visibility = "hidden";
        document.getElementsByClassName("select")[i].style.display = "none";
        document.getElementsByClassName("select")[i].style.visibility = "hidden";
        document.getElementsByClassName("select")[i].style.opacity = "0";
    }
    // Cierra el dialog y regresa una cadena "Reset Filtro"
    cerrar() {
        this.dialogRef.close('Reset filtro');
    }
};
