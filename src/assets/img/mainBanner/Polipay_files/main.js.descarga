ainer-icon{\r\n    position: relative;\r\n    cursor: pointer;\r\n}\r\n\r\n.texto4 {\r\n    font-size: 16px;\r\n    line-height: 1.5;\r\n    letter-spacing: 0.15px;\r\n}\r\n\r\n.label-container{\r\n    font-size: 10px;\r\n    padding: 5px;\r\n    border-radius: 5px;\r\n    background: var(--opacity-74);\r\n}\r\n\r\n.label-container,.label-container--dos{\r\n    position: absolute;\r\n    width: 130px;\r\n    height: 60px;\r\n    border-radius: 6px;\r\n    background-color: var(--opacity-74);\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    visibility: hidden;\r\n    opacity: 1;\r\n    transition: 0.2s;\r\n    margin-top: 5px;\r\n}\r\n\r\n.container-icon:hover .label-container{\r\n    visibility: visible;\r\n    opacity: 1;\r\n}\r\n/*# sourceMappingURL=data:application/json;base64, */");

