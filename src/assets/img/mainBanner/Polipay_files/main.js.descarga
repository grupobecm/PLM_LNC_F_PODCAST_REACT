            this.listProcessed.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listProcessed.data.length;
        }, error => {
            //console.log("Error", error);
            this.showLoad = false;
        });
    }
    seedetailsIndividual(element) {
        //console.log(element);
        this.showLoad = true;
        this.serviceClient.detaislMassiveDispersions(9999, this.dato.masivo_trans_id, 5, null, null, null, this.id).subscribe(res => {
            this.showLoad = false;
            this.dialog.open(_detail_massive_dispersion_detail_massive_dispersion_component__WEBPACK_IMPORTED_MODULE_12__["DetailMassiveDispersionComponent"], {
                width: "544px",
                data: {
