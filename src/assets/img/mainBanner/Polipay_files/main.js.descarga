    codigoPostal(postal_code, numeroFormulario) {
        this.showLoad = true;
        if (numeroFormulario == 1) {
            this.colonia = '\u00a0';
            this.form.get('colonia').setValue('');
        }
        else {
            this.colonia_legal = '\u00a0';
            this.form.get('colonia_legal').setValue('');
        }
        this.serviceBank.codigoPostal(postal_code).subscribe(res => {
            this.direccion = res;
            //console.log(this.direccion);
            if (this.direccion.status == "REQUEST_DENIED") {
                //console.log('DESHABILITAR CAMPO');
                this.flagColonia1 = true;
                this.flagColonia2 = true;
            }
            if (!(this.direccion.status == "ZERO_RESULTS")) {
                /* OBTENER COLONIAS */
                if (numeroFormulario == 1) {
                    this.colonias = this.direccion.results[0].postcode_localities;
                    if (this.colonias == undefined) {
                        this.colonias = [];
                        this.colonias.push(this.direccion.results[0].address_components[1].long_name);
                    }
                }
                else {
                    this.colonias_legal = this.direccion.results[0].postcode_localities;
                    if (this.colonias_legal == undefined) {
                        this.colonias_legal = [];
                        this.colonias_legal.push(this.direccion.results[0].address_components[1].long_name);
                    }
                }
                /* OBTENER ESTADO */
                this.estadoMunicipio = this.direccion.results[0].address_components[3].long_name;
                /* OBTENER ALCALDIA/MUNICIPIO */
                this.alcaldia = this.direccion.results[0].address_components[2].long_name;
                if (numeroFormulario == 1) {
                    this.EstadoE = this.estadoMunicipio;
                    this.AlcaldiaE = this.alcaldia;
                }
                else {
                    this.estado_legalModel = this.estadoMunicipio;
                    this.municipio_legalModel = this.alcaldia;
                }
            }
        }, error => {
            //Error del service codigo postal
            //console.log(error);
        });
        this.showLoad = false;
    }
    codigoPostalFisica(postal_code) {
        this.showLoad = true;
        this.coloniaF = '\u00a0';
        this.form2.get('colonia').setValue('');
        this.serviceBank.codigoPostal(postal_code).subscribe(res => {
            this.direccion = res;
            //console.log(this.direccion);
            if (this.direccion.status == "REQUEST_DENIED") {
                //console.log('DESHABILITAR CAMPO');
                this.flagColonia1 = true;
                this.flagColonia2 = true;
            }
            if (!(this.direccion.status == "ZERO_RESULTS")) {
                /* OBTENER COLONIAS */
                this.coloniasF = this.direccion.results[0].postcode_localities;
                //console.log(this.coloniasF);
                if (this.coloniasF == undefined) {
                    this.coloniasF = [];
                    this.coloniasF.push(this.direccion.results[0].address_components[1].long_name);
                }
                /* OBTENER PAÍS */
                this.fisicaModel.pais = this.direccion.results[0].address_components[5].long_name;
                /* OBTENER ESTADO */
                this.estadoMunicipio = this.direccion.results[0].address_components[3].long_name;
                /* OBTENER ALCALDIA/MUNICIPIO */
                this.alcaldia = this.direccion.results[0].address_components[2].long_name;
                this.fisicaModel.estado = this.estadoMunicipio;
                this.fisicaModel.municipio = this.alcaldia;
            }
        }, error => {
            //Error del service codigo postal
            //console.log(error);
        });
        this.showLoad = false;
    }
    buscar(e) {
        if (this.CPE.length == 5) {
            //console.log("Buscar");
            this.codigoPostal(this.CPE, 1);
        }
    }
    buscar2(e) {
        if (this.CP_legalModel.length == 5) {
            //console.log("Buscar");
            this.codigoPostal(this.CP_legalModel, 2);
        }
    }
    buscar3(e) {
        if (this.fisicaModel.CP.length == 5) {
            //console.log("Buscar",this.fisicaModel.CP);
            this.codigoPostalFisica(this.fisicaModel.CP);
        }
    }
