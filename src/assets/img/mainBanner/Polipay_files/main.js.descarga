let FirstLoginComponent = class FirstLoginComponent {
    constructor(router, fb, servicio, service) {
        this.router = router;
        this.fb = fb;
        this.servicio = servicio;
        this.service = service;
        this.alert = false;
        this.showLoad = false;
        this.randomString = '';
        this.form = this.createForm();
        console.log("constructor", JSON.parse(sessionStorage.getItem('newUser')));
        this.dataUser = JSON.parse(sessionStorage.getItem('newUser'));
        console.log(this.dataUser);
        this.id = JSON.parse(sessionStorage.getItem('newUser')).id;
    }
    // Se crea el formulario
    createForm() {
        return this.fb.group({
            newPassword: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_7__["Validators"].required, _angular_forms__WEBPACK_IMPORTED_MODULE_7__["Validators"].minLength(8), _angular_forms__WEBPACK_IMPORTED_MODULE_7__["Validators"].pattern(/\d/), src_app_utils_validator_pass__WEBPACK_IMPORTED_MODULE_10__["hasMayus"].hasMayus, src_app_utils_validator_pass__WEBPACK_IMPORTED_MODULE_10__["hasSpecial"].hasSpecial]],
            confirmPassword: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_7__["Validators"].required]],
        }, {
            validators: src_app_utils_validator_pass__WEBPACK_IMPORTED_MODULE_10__["hasEqualFirstPass"],
        });
    }
    generateRandomString(length = 18) {
        const characters = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
        const charactersLength = characters.length;
        let result = "";
        for (let i = 0; i < length; i++) {
            const randomIndex = Math.floor(Math.random() * charactersLength);
            result += characters[randomIndex];
            this.randomString = result;
        }
        return result;
    }
    /* Enviar formulario */
    submit() {
        if (this.form.valid) {
            const value = this.form.value;
            this.showLoad = true;
            let data = {
                password: this.form.get('newPassword').value,
                passwordConfirm: this.form.get('confirmPassword').value,
            };
            /*let data = {
              password: crypto.SHA256(this.form.get('newPassword').value).toString(),
              passwordConfirm: crypto.SHA256(this.form.get('confirmPassword').value).toString(),
            };*/
            this.generateRandomString();
            console.log(this.randomString);
            this.servicio.newPassFirst(data, this.id).subscribe(res => {
                //console.log(res);  //Mensaje de exito en la consulta
                this.showLoad = false;
                let jsonBack_Pomelo = {
                    email: this.dataUser.email,
                    curp: this.randomString,
                    rol: 2,
                    rfc: '',
                    idByCompany: '',
                    company: '',
                    name_ceco_polipay: this.dataUser.data_empresa.centro_costos[0].persona_cuenta_name,
                    id_centroCostos: this.dataUser.data_empresa.centro_costos[0].persona_cuenta_id,
                    id_cuentaWallet: '',
                    id_Benificiario: '',
                    status: 'activo',
                    password_polipay_bank: data.password
                };
                this.showLoad = true;
                //console.log('service para vinvulacion con Pomelo');
                this.service.createBenefyPomelo(jsonBack_Pomelo).subscribe(res2 => {
                    this.showLoad = false;
                    console.log("SUCCESS", res2);
                    //console.log(aux);
                    this.showLoad = false;
                }, error2 => {
                    console.log("Error", error2);
                    this.showLoad = false;
                });
                this.router.navigate(['/pass-guardado']);
            }, error => {
                //console.log(error);
                this.showLoad = false;
                this.alert = true;
            });
        }
    }
    /* Show and Hidden password */
    showHiddenPassword(id) {
        let input = document.getElementById(id);
        input.type == 'password' ? input.type = 'text' : input.type = 'password';
        input.focus();
    }
    // Checa si ambas contraseñas son iguales 
    areEquals() {
        if (this.form.hasError('noSonIguales') &&
            this.form.get('newPassword').dirty &&
            this.form.get('confirmPassword').dirty) {
            this.alert = true;
            return true;
        }
        else {
            this.alert = false;
            return false;
        }
    }
};
