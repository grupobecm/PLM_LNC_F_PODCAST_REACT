        this.numRegister = this.listStaffExternal.data.length;
        //console.log(this.listStaffExternal.filteredData);
    }
    listExternalCustomerRequest() {
        this.showLoad = true;
        this.serviceAccount.getExternalClientListRequest(this.id).subscribe((res) => {
            //console.log("solicitudes",res);
            this.ningunDato = false;
            this.moralSol = [];
            this.fisSol = [];
            let variable = res.results;
            for (let i = 0; i < variable.length; i++) {
                if (variable[i].dato_json.cliente_name) {
                    variable[i].dato_json = variable[i].dato_json.cliente_name;
                }
                else {
                    variable[i].dato_json = variable[i].dato_json.person_info.name;
                }
                this.fisSol.push(variable[i]);
            }
            this.filtroSolicitudes();
        }, error => {
            this.showLoad = false;
            this.ningunDato = true;
            //console.log(error.error)
        });
        this.showLoad = false;
    }
    filtroSolicitudes() {
        this.showLoad = true;
        let varAux = [];
        if (this.moral == true) {
            varAux = this.moralSol;
        }
        else {
            varAux = this.fisSol;
        }
