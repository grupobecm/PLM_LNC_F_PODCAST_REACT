                //Aqui va dialog para crear centros de costos
            }
            else {
                // //console.log('si hay centros de costos');
                this.dataService = JSON.parse(this.storageClient2.InfoCostCenterValue);
                this.id = this.dataService.persona_cuenta_id;
            }
        }
        else {
            if (JSON.parse(this.storageClient.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storageClient.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    // //console.log('tp');
                    // //console.log(JSON.parse(this.storageClient.infoUserValue));
                    this.dataService = JSON.parse(this.storageClient.infoUserValue);
                    this.id = this.dataService.cuenta_id;
                    // //console.log(this.id);
                }
                else {
                    if (JSON.parse(this.storageClient.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        // //console.log('t');
