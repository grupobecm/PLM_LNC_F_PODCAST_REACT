            panelClass: "custom-dialog-container",
        });
        filtro.afterClosed().subscribe((res) => {
            let benefi = null;
            let state = null;
            let date1 = null;
            let date2 = null;
            //console.log(res);
            if (res == undefined) {
            }
            else {
                if (res != "Reset filtro") {
                    for (let i = 0; i < res.data.filtro.length; i++) {
                        switch (res.data.filtro[i].campo) {
                            case "Nombre de Centro de Costos":
                                benefi = res.data.filtro[i].valor;
                                break;
                            case "Fecha de Captura":
                                date1 =
                                    res.data.filtro[i].valor.begin.toISOString().split("T")[0];
                                date2 =
                                    res.data.filtro[i].valor.end.toISOString().split("T")[0];
                                break;
                        }
                    }
                }
            }
            let size = 9999;
            benefi = benefi;
            state = state;
            this.getListCostCenter(type, benefi, date1, date2);
        });
    }
};
