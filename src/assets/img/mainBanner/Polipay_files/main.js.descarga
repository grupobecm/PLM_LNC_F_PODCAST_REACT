let ListClientsUserComponent = class ListClientsUserComponent {
    constructor(router, dialog, service, storageClient) {
        this.router = router;
        this.dialog = dialog;
        this.service = service;
        this.storageClient = storageClient;
        this.displayedColumns = ['nombre', 'cuenta', 'clabe', 'fechaCaptura', 'estado', 'button1', 'button2'];
        this.listStaffExternal = [];
        this.ningunDato = false;
        this.noData = false;
        this.numRegister = 0;
        this.clientList = [];
        this.showLoad = false;
        this.client_name = "";
        this.estado = "";
        this.cuenta = "";
        this.clabe = "";
        this.fecha_inicio = "";
        this.fecha_fin = "";
        this.moral = false;
        this.moralSol = [];
        this.fisSol = [];
        this.showLoad = true;
        //console.log(JSON.parse(this.storageClient.InfoCostCenterValue));
        this.id = JSON.parse(this.storageClient.InfoCostCenterValue).persona_cuenta_id;
        this.getClientList();
    }
    getClientList() {
        this.showLoad = true;
        //console.log("ID del centro de costos",this.id);
        this.service.seeClients(this.id, this.client_name, this.estado, this.cuenta, this.clabe, this.fecha_inicio, this.fecha_fin).subscribe(res => {
            //console.log(res);
            this.ningunDato = false;
            this.moralSol = [];
            this.fisSol = [];
            let variable = [...res.results];
            for (let i = 0; i < variable.length; i++) {
                if (variable[i].tipo_persona_id == 1) {
                    this.moralSol.push(variable[i]);
                }
                else {
                    this.fisSol.push(variable[i]);
                }
            }
            this.filtroSolicitudes();
        }, error => {
            //console.log(error);
        });
    }
    filtroSolicitudes() {
        let varAux = [];
        if (this.moral == true) {
            varAux = this.moralSol;
        }
        else {
            varAux = this.fisSol;
        }
        this.clientList = new _angular_material_table__WEBPACK_IMPORTED_MODULE_11__["MatTableDataSource"](varAux);
        this.clientList.sort = this.sort;
        this.clientList.paginator = this.paginator;
        this.clientList.data.length > 0 ? this.noData = false : this.noData = true;
        this.numRegister = this.clientList.data.length;
        this.showLoad = false;
    }
    details(dato) {
        //console.log(dato);
        const data = {
            moral: this.moral,
            id: dato.id_persona_CC,
            idSol: dato.id_tabla_solicitud,
            estado: dato.estado
        };
        //console.log(data);
        sessionStorage.setItem("clienteExterno", JSON.stringify(data));
        if (dato.estado != "Devuelta") {
            this.router.navigate(['/usuario/administration/clientsuser/administrationclients']);
        }
        else {
            //console.log(dato.estado);
            // this.openDialog();
            this.router.navigate(['/usuario/administration/clientsuser/corregirclient']);
        }
    }
    openDialog() {
        this.dialog.open(src_app_Views_home_cambie_movil_dialog_cambie_movil_dialog_component__WEBPACK_IMPORTED_MODULE_15__["CambieMovilDialogComponent"]);
    }
    openFilter() {
        const filtro = this.dialog.open(_filter_client_user_filter_client_user_component__WEBPACK_IMPORTED_MODULE_13__["FilterClientUserComponent"], {
            width: '90%',
            panelClass: 'custom-dialog-container',
            data: {
                numeroRegistrosMostrar: this.numeroRegistrosaMostrarF
            },
            disableClose: true,
        });
        filtro.afterClosed().subscribe(res => {
            //console.log(res);
            if (res == undefined) {
            }
            else {
                if (res != 'Reset filtro') {
                    for (let i = 0; i < res.data.filtro.length; i++) {
                        switch (res.data.filtro[i].campo) {
                            case 'Cliente':
                                this.client_name = res.data.filtro[i].valor;
                                break;
                            case 'Cuenta':
                                this.cuenta = res.data.filtro[i].valor;
                                break;
                            case 'Estado':
                                this.estado = res.data.filtro[i].valor;
                                break;
                            case 'Clabe':
                                this.clabe = res.data.filtro[i].valor;
                                break;
                        }
                    }
                }
            }
            this.getClientList();
        });
    }
    filterButton(status) {
        this.moral = status;
        if (status == true) {
            this.moralData = 1;
        }
        else {
            this.moralData = 2;
        }
        this.filtroSolicitudes();
    }
};
