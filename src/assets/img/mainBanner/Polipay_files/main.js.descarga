        //console.log("->", val);
        switch (val) {
            case 'Tarjetahabiente':
                this.arrayindividual[0] = val;
                break;
            case 'Número de tarjeta':
                this.arrayindividual[1] = val;
                break;
            default:
                break;
        }
        //console.log(this.arrayindividual);
        this.t.removeAt(i);
