          <button type=\"button\" class=\"cargar__button | color-white\" [ngClass]=\"{'boton--alert': arregloErrores_rs[5] }\" routerLinkActive=\"active\" (click)=\"hiddenfile5input.click()\">\r\n                            <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                            <b>Cargar Archivo*</b>\r\n                        </button>\r\n                        <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                            <span fxFlex=\"100\" class=\"color-third mt-2 ml-3\">{{documents_centro_costos.controls[5].get('nombre').value }}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\" alertTransfer\" *ngIf=\"arregloErrores_rs[5]\">\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresVacio_rs[5]\">Por favor carga el PLD</span>\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresFormat_rs[5]\">Formato de archivo incorrecto. Debe ser un archivo PDF</span>\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresSize_rs[5]\">Tamaño máximo de archivo superado</span>\r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n            <div class=\"margin-row-button\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"50\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n                    <div fxFlex=\"100\">\r\n                        <p class=\"color-60\">Otro documento</p>\r\n                    </div>\r\n                    <div class=\"\" fxFlex=\"100\" fxLayout=\"row\">\r\n                        <input class=\"boton__input\" style=\"display: none\" type=\"file\" (change)=\"fileChange($event, 6,'rs')\" #hiddenfile6input accept=\".pdf, application/pdf\">\r\n                        <button type=\"button\" class=\"cargar__button | color-white\" [ngClass]=\"{'boton--alert': arregloErrores_rs[6] }\" routerLinkActive=\"active\" (click)=\"hiddenfile6input.click()\">\r\n                            <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                            <b>Cargar Archivo</b>\r\n                        </button>\r\n                        <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                            <span fxFlex=\"100\" class=\"color-third mt-2 ml-3\">{{ documents_centro_costos.controls[6].get('nombre').value }}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\" alertTransfer\" *ngIf=\"arregloErrores_rs[6]\">\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresVacio_rs[6]\">Por favor carga el documento</span>\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresFormat_rs[6]\">Formato de archivo incorrecto. Debe ser un archivo PDF</span>\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresSize_rs[6]\">Tamaño máximo de archivo superado</span>\r\n                    </div>\r\n\r\n                </div>\r\n                <div *ngIf=\"flgEspecificar\" fxFlex=\"50\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\" class=\"form | selectbox\">\r\n                    <span class=\"form__text user | \" [ngClass]=\"{ 'form__text_alert': this.form.get('Especificaciones').touched && this.form.get('Especificaciones').hasError('required') }\">Especifica*</span>\r\n                    <input id=\"especificacionesId\" class=\"formOb__input  user\" [ngClass]=\"{ 'formOb__input_alert': this.form.get('Especificaciones').touched && this.form.get('Especificaciones').hasError('required')  }\" type=\"text\" autocomplete=\"off\" formControlName=\"Especificaciones\">\r\n                    <div class=\" alertTransfer\" *ngIf=\" this.form.get('Especificaciones').touched && this.form.get('Especificaciones').hasError('required')  \">\r\n                        <span class=\"alert__text | color-red\">Por favor captura las especificaciones de tu documento</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"hr\"></div>\r\n\r\n            <div class=\"\" fxFlex=\"100\">\r\n                <p class=\"Subtitle color-accent remove-fondo\" translate>Documentos del Representante Legal</p>\r\n            </div>\r\n            <div class=\"margin-row-button\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"50\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"100\">\r\n                        <p class=\"color-60\">INE/Pasaporte/DNI del Representante Legal*</p>\r\n                    </div>\r\n                    <div class=\"\" fxFlex=\"100\" fxLayout=\"row\">\r\n                        <input class=\"boton__input\" style=\"display: none\" type=\"file\" (change)=\"fileChange($event, 0,'rl')\" #hiddenfile7input accept=\".pdf, application/pdf\">\r\n                        <button type=\"button\" class=\"cargar__button | color-white\" [ngClass]=\"{'boton--alert': arregloErrores_rl[0] }\" routerLinkActive=\"active\" (click)=\"hiddenfile7input.click()\">\r\n                            <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                            <b>Cargar Archivo*</b>\r\n                        </button>\r\n                        <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                            <span fxFlex=\"100\" class=\"color-third mt-2 ml-3\">{{ documents_representante_legal.controls[0].get('nombre').value }}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\" alertTransfer\" *ngIf=\"arregloErrores_rl[0]\">\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresVacio_rl[0]\">Por favor carga la identi