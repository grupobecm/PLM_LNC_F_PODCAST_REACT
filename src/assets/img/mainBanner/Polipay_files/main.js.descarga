let ProcessedIndividualesComponent = class ProcessedIndividualesComponent {
    constructor(dialog, router, serviceClient, storageClient, storageHome, storage) {
        this.dialog = dialog;
        this.router = router;
        this.serviceClient = serviceClient;
        this.storageClient = storageClient;
        this.storageHome = storageHome;
        this.storage = storage;
        this.cuenta = "";
        this.displayedColumns = ['id', 'nombre_beneficiario', 'monto', 'fecha_creacion', 'button'];
        this.listProcessed = [];
        this.showLoad = false;
        /* Datos de dispersiones masivas */
        this.dateDispersion = "";
        this.observation = "";
        this.folio = "";
        this.nameUser = "";
        this.monto = "";
        this.dateOperation = "";
        this.empresaName = "";
        this.noData = false;
        this.numRegister = 0;
        if (!this.storageClient.DispertionDataExist) {
            this.router.navigate(["/usuario/dispersiones/estado-dispersion/massive-dispersion/processed-dispersion-massive"]);
        }
        else {
            this.dato = JSON.parse(this.storageClient.DispertionDataValue);
            sessionStorage.removeItem('mass_dispersal');
        }
        //console.log("Datos",this.dato);
        this.empresaName = JSON.parse(this.storage.infoUserValue).data_empresa.cuenta_eje.name;
        // this.detailsIndividualMassives();
        if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length >= 3) {
            //console.log('tp y t');
            //this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
            ////console.log(this.id);
            if (this.storageClient.InfoCostCenterExist == false) {
                //console.log("bye");
                this.dataService = JSON.parse(this.storage.infoUserValue);
                //Aqui va dialog para crear centros de costos
            }
            else {
                //console.log('si hay centros de costos');
                this.dataService = JSON.parse(this.storageClient.InfoCostCenterValue);
                this.id = this.dataService.persona_cuenta_id;
            }
        }
        else {
            if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    //console.log('tp');
                    this.dataService = JSON.parse(this.storage.infoUserValue);
                    this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
                    //console.log(this.id);
                }
                else {
                    if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        //console.log('t');
                        //console.log(this.storageClient.InfoCostCenterExist);
                        if (this.storageClient.InfoCostCenterExist == false) {
                            //console.log("bye");
                            this.dataService = JSON.parse(this.storage.infoUserValue);
                        }
                        else {
                            //console.log("si hay servicios ");
                            this.dataService = JSON.parse(this.storageClient.InfoCostCenterValue);
                            this.id = this.dataService.persona_cuenta_id;
                            //console.log(this.dataService)
                            //console.log(this.dataService.persona_cuenta_id);
                        }
                    }
                }
            }
        }
        this.observation = this.dato.observations;
        this.dateDispersion = this.dato.date_modified;
        this.listIndividualDispersionMassive();
    }
    listIndividualDispersionMassive(nameBenefi = null, date1 = null, date2 = null) {
        this.showLoad = true;
        this.serviceClient.detaislMassiveDispersions(9999, this.dato.id, 5, nameBenefi, date1, date2, this.id).subscribe(res => {
            this.showLoad = false;
            this.listProcessed = new _angular_material_table__WEBPACK_IMPORTED_MODULE_9__["MatTableDataSource"](res.results);
            //console.log(res)
            this.listProcessed.sort = this.sort;
            this.listProcessed.paginator = this.paginator;
            this.paginator._intl.itemsPerPageLabel = 'Filas por página';
            this.listProcessed.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listProcessed.data.length;
        }, error => {
            //console.log("Error", error);
            this.showLoad = false;
        });
    }
    seedetailsIndividual(element) {
        //console.log(element);
        this.showLoad = true;
        this.serviceClient.detaislIndividualDispersionsMassive(element.id).subscribe(res => {
            //console.log(res);
            this.showLoad = false;
            this.dialog.open(_detail_massive_dispersion_detail_massive_dispersion_component__WEBPACK_IMPORTED_MODULE_14__["DetailMassiveDispersionComponent"], {
                width: "544px",
                data: {
                    res: res.details,
                    type: 'P'
                },
                panelClass: ['custom-dialog-container'],
                disableClose: true,
            });
        }, error => {
            //console.log(error);
        });
    }
    ngOnInit() {
    }
    regresar() {
        this.router.navigate(['/usuario/dispersiones/estado-dispersion/massive-dispersion/processed-dispersion-massive']);
    }
    openFilter() {
        let filtro = this.dialog.open(_filtro_individual_massives_filtro_individual_massives_component__WEBPACK_IMPORTED_MODULE_15__["FiltroIndividualMassivesComponent"], {
            width: "90%",
            panelClass: "custom-dialog-container"
        });
        filtro.afterClosed().subscribe(res => {
            let nameBenefi = null;
            let date1 = null;
            let date2 = null;
            //console.log(res);
            if (res == undefined) {
            }
            else {
                if (res != 'Reset filtro') {
                    for (let i = 0; i < res.data.filtro.length; i++) {
                        switch (res.data.filtro[i].campo) {
                            case 'Fecha de Dispersión':
                                date1 = (res.data.filtro[i].valor.begin).toISOString().split("T")[0] + " 00:00:00";
                                date2 = (res.data.filtro[i].valor.end).toISOString().split("T")[0] + " 23:59:59";
                                break;
                            case 'Nombre de Usuario':
                                nameBenefi = res.data.filtro[i].valor;
                                break;
                        }
                    }
                }
            }
            this.listIndividualDispersionMassive(nameBenefi, date1, date2);
        });
    }
    exportXLSX(id = this.id, idtype = 4, name = null, clabe = null, nameBenefy = null, date1 = null, date2 = null, status = 1) {
        this.showLoad = true;
        //console.log(id);
        this.serviceClient.exportXlsxMasives(id, idtype, name, clabe, nameBenefy, date1, date2, status, this.dato.id).subscribe(res => {
            //console.log(res.detail[0].data);
            window.open(res.detail[0].data, "_blank");
            this.showLoad = false;
        }, error => {
            //console.log(error);
            this.showLoad = false;
        });
    }
};
