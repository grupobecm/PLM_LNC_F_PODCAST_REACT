    aparecer(i) {
        if (i == 0) {
            return true;
        }
        return false;
    }
    max() {
        if (this.t.length == this.auxMax) {
            return false;
        }
        return true;
    }
    terminacion(i, ter) {
        switch (ter) {
            case 'ER':
                if (i == 1 || i == 3) {
                    return true;
                }
                return false;
            case 'DO':
                if (i == 2) {
                    return true;
                }
                return false;
            case 'TO':
                if (i >= 4 && i <= 7) {
                    return true;
                }
                return false;
            case 'VO':
                if (i == 8) {
                    return true;
                }
                return false;
            case 'NO':
                if (i == 9) {
                    return true;
                }
                return false;
            case 'MO':
                if (i % 10 == 0) {
                    return true;
                }
                return false;
            case 'AVO':
                if (i % 10 != 0 && i > 10) {
                    return true;
                }
                return false;
            default:
                return false;
        }
    }
    ValidarCheck1() {
        if (!this.check_legalModel && this.alta_personalModel == false) {
            this.alta_personalModel = true;
