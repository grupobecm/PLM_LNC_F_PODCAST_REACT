        const titulosExcel = ['Número Emisor', 'Clabe Emisor', 'Número Receptor', 'Clabe Receptor', 'Fecha Operación', 'Monto', 'Número Referencia', 'Clave Rastreo', 'Folio Transacción', 'Concepto'];
