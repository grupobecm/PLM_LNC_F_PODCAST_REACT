                    }
                }
            }
            let size = 9999;
            let id = this.idCenterC;
            date1 = date1;
            date2 = date2;
            benefy = benefy;
            clave = clave;
            this.listTransferReceived(size, id, benefy, clave, date1, date2);
        });
    }
    exportarXlsx(id = this.idCenterC, idtype = 5, name = null, clabe = null, nameBenefy = null, date1 = null, date2 = null, status = 1) {
        this.showLoad = true;
        this.serviceClient.exportXlsx(id, idtype, name, clabe, nameBenefy, date1, date2, status, null).subscribe(res => {
            //console.log(res.detail[0].data);
            window.open(res.detail[0].data, "_blank");
            this.showLoad = false;
