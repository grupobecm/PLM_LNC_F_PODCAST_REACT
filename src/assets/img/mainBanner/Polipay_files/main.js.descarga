       </div>\r\n            <div class=\"form_space \" fxFlex=\"30\">\r\n                <span class=\"form__text  pass | font-roboto\">Apellido Materno</span>\r\n                <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"lastNameM\" id=\"lastNameM\" formControlName=\"lastNameM\">\r\n            </div>\r\n\r\n            <div class=\"form_space \" fxFlex=\"30\">\r\n                <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requiredData('rfc') && form.get('rfc').touched) }\">R.F.C.</span>\r\n                <input class=\"form__input password rfc-uppercase | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requiredData('rfc') && form.get('rfc').touched) }\" autocomplete=\"off\" type=\"text\" name=\"rfc\" id=\"rfc\" formControlName=\"rfc\">\r\n                <div class=\" alertTransfer\" *ngIf=\"requiredData('rfc') && form.get('rfc').touched \">\r\n                  <span class=\"alert__text | color-red\" *ngIf=\"!form.get('rfc').errors.rfcNoHomoInvalid\" translate>Por favor captura un RFC valido.</span>\r\n                  <!-- <span class=\"alert__text | color-red\" *ngIf=\"form.get('rfc').errors.rfcNoHomoInvalid\"> Por favor captura un RFC valido. No debe incluir la homoclave</span> -->\r\n              </div>\r\n            </div>\r\n            <div class=\"form_space \" fxFlex=\"30\">\r\n                <span class=\"form__text  pass | font-roboto\">Télefono</span>\r\n                <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"lastNameM\" id=\"lastNameM\" formControlName=\"lastNameM\">\r\n            </div>\r\n            <div class=\"form_space  \" fxFlex=\"30\">\r\n                <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requiredData('email') && form.get('email').touched) }\" translate>Correo Electrónico*</span>\r\n                <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requiredData('email') && form.get('email').touched) }\" autocomplete=\"off\" type=\"text\" name=\"email\" id=\"email\" formControlName=\"email\" required>\r\n                <div class=\" alertTransfer\" *ngIf=\"requiredData('email') && form.get('email').touched \">\r\n                    <span class=\"alert__text | color-red\" translate> Por favor captura el correo electrónico</span>\r\n                </div>\r\n            </div>\r\n            <div class=\"mt-4\" fxFlex=\"50\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"100\" fxLayoutAlign=\"start end\">\r\n                    <p class=\"color-third subtitle\">Identificación Oficial</p>\r\n                </div>\r\n                <div class=\"mt-1\" fxFlex=\"100\" fxLayout=\"row\">\r\n                    <input class=\"boton__input\" name=\"documento\" id=\"documento\" style=\"display: none\" type=\"file\" (change)=\"fileChange($event)\" #hiddenfileinput accept=\".pdf, application/pdf\">\r\n                    <button type=\"button\" class=\"cargar__file quitmrg | color-white\" routerLinkActive=\"active\" (click)=\"hiddenfileinput.click()\">\r\n              <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n              <b>Cargar Archivo</b></button>\r\n                    <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                        <span fxFlex=\"100\" class=\"color-third ml-3\">{{ file }}</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div class=\"mt-5\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\">\r\n            <div class=\"ml-3\" fxLayoutAlign=\"end end\">\r\n                <!-- (click)=\"cancel()\" -->\r\n                <button class=\"cancelar__button | \" type=\"button\" [routerLink]=\"['/usuario/dispersiones/peronal-externo/lista-personal-externo']\" routerLinkActive=\"active\"><b>Cancelar</b></button>\r\n            </div>\r\n            <div class=\"ml-3\" fxLayoutAlign=\"end end\">\r\n                <button class=\"confirmar__button | color-white\" type=\"submit\" id=\"confirm\" *ngIf=\"servicesTP\"><b>Confirmar</b></button>\r\n                <button class=\"confirmar__button | color-white\" (click)=\"submit2()\" type=\"button\" id=\"confirm2\" *ngIf=\"!servicesTP\"><b>Confirmar</b></button>\r\n            </div>\r\n        </div>\r\n    </form>\r\n</div>\r\n<!-- Loading -->\r\n\r\n<app-loading *ngIf=\"showLoad\"></app-loading>\r\n");

