            this.numRegister = this.listStaffExternal.data.length;
            //console.log(this.numRegister);
        }, error => {
            this.showLoad = false;
            this.ningunDato = true;
            //console.log(error.error)
        });
    }
    openFilter() {
        let filtro = this.dialog.open(_filter_transactions_own_accounts_filter_transactions_own_accounts_component__WEBPACK_IMPORTED_MODULE_14__["FilterTransactionsOwnAccountsComponent"], {
            width: "90%",
            panelClass: "custom-dialog-container"
        });
        filtro.afterClosed().subscribe(res => {
            let originAccount = null;
            let date1 = null;
            let date2 = null;
            //console.log(res);
            if (res == undefined) {
            }
            else {
                if (res != 'Reset filtro') {
                    for (let i = 0; i < res.data.filtro.length; i++) {
                        switch (res.data.filtro[i].campo) {
                            case 'Cuenta de Origen':
                                originAccount = res.data.filtro[i].valor;
                                break;
                            case 'Fecha de Operación':
                                date1 = (res.data.filtro[i].valor.begin).toISOString().split("T")[0] + " 00:00:00";
                                date2 = (res.data.filtro[i].valor.end).toISOString().split("T")[0] + " 23:59:59";
                                break;
                        }
                    }
                }
            }
            let size = 9999;
            originAccount = originAccount;
            this.listTransferOwnAccounts(size, this.cue_id, originAccount, date1, date2);
        });
    }
    seeDetails(element) {
        //console.log(element);
        this.showLoad = true;
