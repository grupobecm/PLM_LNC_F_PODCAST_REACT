/* harmony import */ var _raw_loader_massive_c_component_html__WEBPACK_IMPORTED_MODULE_1__ = __webpack_require__(/*! raw-loader!./massive-c.component.html */ "0pOR");
/* harmony import */ var _massive_c_component_css__WEBPACK_IMPORTED_MODULE_2__ = __webpack_require__(/*! ./massive-c.component.css */ "suiC");
/* harmony import */ var _Styles_tabla_v2_css__WEBPACK_IMPORTED_MODULE_3__ = __webpack_require__(/*! ./../../../../Styles/tabla-v2.css */ "3tKn");
/* harmony import */ var _Styles_ordering_css__WEBPACK_IMPORTED_MODULE_4__ = __webpack_require__(/*! ./../../../../Styles/ordering.css */ "ed+n");
