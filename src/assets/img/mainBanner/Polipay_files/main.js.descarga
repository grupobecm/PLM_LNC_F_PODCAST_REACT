s=\"button-verification-code ml-2 | color-third background-grey-dark font-roboto\" type=\"button\" (click)=\"openFilter()\">\r\n                FILTRO\r\n            </button>\r\n\r\n            <!--<div class=\"descargas\" fxFlex=\"20\" fxLayoutAlign=\"space-evenly center\">\r\n                <img src=\"../../../../assets/img/icons/exp-xlsx.svg\" (click)=\"exportarXlsx()\" alt=\"Exportar XLSX\">\r\n                <div class=\"label-container\">\r\n                    <label class=\"label__copy | color-white\" translate>User.Tooltip.ExportXLSX</label>\r\n                </div>\r\n            </div>-->\r\n        </div>\r\n\r\n    </div>\r\n    <div class=\"mat-elevation-z8 margin-cont\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n        <table mat-table [dataSource]=\"listProcessed\" fxFlex=\"100\" matSort>\r\n            <!-- Columna No se encontraron registros -->\r\n            <ng-container matColumnDef=\"noData\">\r\n                <td mat-footer-cell *matFooterCellDef [attr.colspan]=\"displayedColumns.length\" [attr.align]=\"'center'\">\r\n                    <span *ngIf=\"noData===true\">No se encontraron registros.</span>\r\n                </td>\r\n            </ng-container>\r\n            <!-- Columna Cliente -->\r\n            <ng-container matColumnDef=\"id\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Folio</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{element.id}}</td>\r\n            </ng-container>\r\n            <ng-container matColumnDef=\"nombre_beneficiario\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Nombre de Usuario</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{element.nombre_beneficiario}}</td>\r\n            </ng-container>\r\n            <ng-container matColumnDef=\"monto\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Monto</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{element.monto | currency }} MXN</td>\r\n            </ng-container>\r\n            <ng-container matColumnDef=\"fecha_creacion\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Fecha y Hora <br>de Operación</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{element.fecha_creacion | date:'dd/MM/yyyy HH:mm' }} hrs.</td>\r\n            </ng-container>\r\n            <ng-container matColumnDef=\"button\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header></th>\r\n                <td mat-cell *matCellDef=\"let element\">\r\n                    <div>\r\n                        <!-- <button class=\"verdetalles_button quitmrg  | background-main color-white\" (click)=\"seedetailsIndividual(element)\" fxLayoutAlign=\"center center\" fxFlex.xl=\"60\">\r\n                            <span class=\"\"><img src=\"../../../../../../../assets/img/eye-icon.png\" alt=\"\"> Ver Detalles</span>\r\n                        </button> -->\r\n                        <button class=\"verdetalles_button quitmrg  | background-opacity-main color-white\" (click)=\"seedetailsIndividual(element)\" fxLayoutAlign=\"center center\" fxFlex.xl=\"60\">\r\n                            <span class=\"\"><img src=\"../../../../../../../../assets/img/icons/eye-icon_blue.svg\" alt=\"\"></span>\r\n                        </button>\r\n                    </div>\r\n                </td>\r\n            </ng-container>\r\n\r\n            <tr mat-header-row *matHeaderRowDef=\"displayedColumns\"></tr>\r\n            <tr mat-row *matRowDef=\"let row; columns: displayedColumns\"></tr>\r\n            <tr mat-footer-row *matFooterRowDef=\"['noData']\" [hidden]=\"numRegister > 0\"></tr>\r\n        </table>\r\n        <mat-paginator fxFlex=\"100\" [pageSizeOptions]=\"[100]\" showFirstLastButtons></mat-paginator>\r\n    </div>\r\n\r\n</div>\r\n<!-- Loading -->\r\n<app-loading *ngIf=\"showLoad\"></app-loading>\r\n");

