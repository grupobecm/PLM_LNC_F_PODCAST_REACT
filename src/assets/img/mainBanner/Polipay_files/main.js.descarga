            this.name = res.PersonInfo[0].name;
            this.email = res.PersonInfo[0].email;
            this.phone = res.PersonInfo[0].phone;
            this.permiso = res.PersonInfo[0].group[0].name;
            this.permiso = this.permiso.split("*")[1];
            this.centroCosto = res.CostCenterList;
            //console.log("json respuesta", this.docColaborador);
