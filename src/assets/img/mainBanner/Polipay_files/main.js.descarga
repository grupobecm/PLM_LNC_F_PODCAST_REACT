/* harmony default export */ __webpack_exports__["default"] = ("<!-- Barra menu lateal (numero de cuenta y clabe) -->\r\n<app-menu fxFlex=\"16.66\"></app-menu>\r\n<!-- FIN Barra menu lateal (numero de cuenta y clabe) -->\r\n\r\n<div class=\"dashboard-transaction\" fxFlex=\"83.33\" fxLayout=\"row wrap\" fxLayoutAlign=\"center start\">\r\n    <app-saldo-transactions fxFlex=\"100\"></app-saldo-transactions>\r\n    <div class=\"padding--15-no-bottom\" fxFlex=\"100\">\r\n        <p class=\"mensajeObl\" translate>User.Messages.RequiredFields</p>\r\n    </div>\r\n    <form *appPermission=\"['289']\" [formGroup]=\"form\" novalidate (ngSubmit)=\"submit()\" class=\"padding--15\" fxFlex=\"100\"\r\n        fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n\r\n        <div fxFlex=\"48\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n            <div fxFlex=\"100\" class=\"form\">\r\n                <div class=\"fondo-cerrar-select zIndex12\" id=\"fondo\" (click)=\"ocultar()\"></div>\r\n                <div class=\"select-container zIndex13\" id=\"select1\" fxFlex=\"100\">\r\n                    <span class=\"form__text user | font-roboto\"\r\n                        [ngClass]=\"{ 'form__text_alert': requeridoBanco() || rojobanco }\">Nombre del\r\n                        Beneficiario*</span>\r\n                    <div>\r\n                        <div class=\"form__input select | font-roboto\"\r\n                            [ngClass]=\"{ 'form__input_alert': requeridoBanco() || rojobanco}\" ng type=\"text\"\r\n                            name=\"frecuent\" (click)=\"mostrar()\">\r\n                            {{ frecuentes }}\r\n                            <div class=\"flecha1\" id=\"flecha\"\r\n                                [ngClass]=\"{ 'flecha--alert': requeridoBanco() || rojobanco }\"></div>\r\n                        </div>\r\n                        <div class=\"all\" id=\"lista\">\r\n                            <div class=\"search\" fxLayoutAlign=\"center center\">\r\n                                <input class=\"form__input2 form__input--padding\" type=\"text\" [(ngModel)]=\"buscar\"\r\n                                    (ngModelChange)=\"filtrarFrecuentes()\" [ngModelOptions]=\"{standalone: true}\">\r\n                                <img class=\"icon__search\" src=\"../../../../../../assets/img/icons/search-24px.svg\"\r\n                                    alt=\"buscar frecuentes\">\r\n                            </div>\r\n                            <ul class=\"ul-select frecuentes elscroll\">\r\n                                <li *ngIf=\"total == 0\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                                    <span class=\"texto__select\" fxFlex=\"95\">No se encontrarón frecuentes </span>\r\n                                </li>\r\n                                <!-- <li *ngIf=\"total != 0\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\" (click)=\"cancelar()\">\r\n                                    <span class=\"texto__select\" fxFlex=\"95\">&nbsp;</span>\r\n                                </li> -->\r\n                                <li *ngFor=\"let frequent of copyCompany; index as i \" fxLayout=\"row wrap\"\r\n                                    (click)=\"mostrar()\" fxLayoutAlign=\"end center\" (click)=\"actualizar(frequent, true)\">\r\n                                    <div fxFlex=\"95\" fxLayoutAlign=\"start center\" *ngIf=\"total != 0\">\r\n                                        <!-- <img *ngIf=\"frequent.is_favorite\"\r\n                                            src=\"../../../../../../assets/img/icons/favorite-24px.svg\" alt=\"\"> -->\r\n                                        <!-- <div class=\"heard-invisible\" *ngIf=\"!frequent.is_favorite\"></div> -->\r\n                                        <span class=\"texto__select\" fxFlex=\"95\">{{frequent.person__name}} {{frequent.person__last_name}}</span>\r\n                                    </div>\r\n                                </li>\r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"alertTransfer\" *ngIf=\"requeridoBanco()\">\r\n                <span class=\"alert__text | color-red\">Por favor captura el Nombre del Beneficiario </span>\r\n            </div>\r\n\r\n            <!-- Check asignar fecha dispersion -->\r\n            <!-- <div class=\"form  selectbox \" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <mat-checkbox fxFlex=\"100\" class=\"mr-2 producto__checkbox form--auxiliar-mt | color-third\"\r\n                    formControlName=\"is_schedule\" [(ngModel)]=\"is_schedule\" (change)=\"addDate()\">¿Deseas programar una\r\n                    fecha de dispersión?</mat-checkbox>\r\n            </div>  -->\r\n            <!-- Campo Fecha de dispersion -->\r\n            <div class=\"form\" fxFlex=\"48\" class=\"selectbox\" *ngIf=\"form.get('is_schedule').value\">\r\n                <div class=\"fecha\" fxLayout=\"row wrap\">\r\n                    <p class=\"form__date label_fecha form__text user text-date--position | font-roboto\"\r\n                        [ngClass]=\"{ 'form__text_alert': (required('fechaProgramada') && form.get('fechaProgramada').touched) }\"\r\n                        translate>Fecha de dispersión*</p>\r\n                    <mat-form-field class=\"valor campo_fecha disabled\"\r\n                        [ngClass]=\"{ 'form__input_alert': (required('fechaProgramada') && form.get('fechaProgramada').touched) }\"\r\n                        fxFlex=\"100\">\r\n                        <input class=\"borde-fecha\" matInput class=\"date\" [satDatepicker]=\"picker7\" autocomplete=\"off\"\r\n                            name=\"fechaProgramada\" id=\"fechaProgramada\" formControlName=\"fechaProgramada\" readonly\r\n                            [min]=\"datenow\" required>\r\n                        <sat-datepicker #picker7 [rangeMode]=\"false\" [selectFirstDateOnClose]=\"true\"\r\n                            [rangeHoverEffect]=\"false\">\r\n                        </sat-datepicker>\r\n                        <sat-datepicker-toggle class=\"suffix\" matSuffix [for]=\"picker7\"></sat-datepicker-toggle>\r\n                    </mat-form-field>\r\n                    <!-- Alertas -->\r\n                    <div fxFlex=\"100\" class=\"alertTransfer alertTransfer--fecha margen-alert\"\r\n                        *ngIf=\"(required('fechaProgramada') && form.get('fechaProgramada').touched)\">\r\n                        <span class=\"alert__text | color-red\" translate>Por favor captura una fecha</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"form ml-3\" fxFlex=\"48\" *ngIf=\"form.get('is_schedule').value\">\r\n                <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': hourNull }\" translate>Hora\r\n                    de dispersión*</span>\r\n                <input (click)=\"selectHour()\" type=\"text\" readonly class=\"form__input password | font-roboto\"\r\n                    [ngClass]=\"{ 'form__input_alert': hourNull }\" autocomplete=\"off\" formControlName=\"hora_operacion\"\r\n                    [ngModel]=\"hora_operacion\" required>\r\n                <div class=\" alertTransfer\" *ngIf=\"hourNull\">\r\n                    <span class=\"alert__text | color-red\" translate> Por favor captura la Hora de dispersión </span>\r\n                </div>\r\n            </div>\r\n\r\n            <!-- Campo Concepto -->\r\n            <div class=\"form\" fxFlex=\"100\" fxLayout=\"row wrap\" class=\"selectbox\">\r\n                <span class=\"form__text user | \"\r\n                    [ngClass]=\"{ 'form__text_alert': (required('concepto_pago') && form.get('concepto_pago').touched) }\">Concepto*</span>\r\n                <!--<input type=\"text\">-->\r\n                    <textarea rows=\"5\"  class=\"formCon__input  user |\"\r\n                    [ngClass]=\"{ 'formCon__input_alert': (required('concepto_pago') && form.get('concepto_pago').touched) }\"\r\n                    name=\"observaciones\" autocomplete=\"off\" id=\"concepto_pago\" formControlName=\"concepto_pago\"\r\n                    [ngModel]=\"concept\"></textarea>\r\n                <!-- Alertas -->\r\n                <div class=\" alertTransfer\" *ngIf=\"required('concepto_pago') && form.get('concepto_pago').touched \">\r\n                    <span class=\"alert__text | color-red\">Por favor captura el concepto</span>\r\n                </div>\r\n            </div>\r\n    \r\n\r\n\r\n        </div>\r\n\r\n\r\n\r\n\r\n        <!-- Segunda Columna -->\r\n        <div class=\"ml-3\" fxFlex=\"48\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n            <!-- Campo Numero de cuenta  -->\r\n            <div class=\"form\" fxFlex=\"100\">\r\n                <span class=\"form__text  pass | font-roboto\"\r\n                    [ngClass]=\"{ 'form__text_alert': (required('cta_beneficiario') && form.get('cta_beneficiario').touched) }\"\r\n                    translate>Número de Tarjeta*</span>\r\n                <input type=\"text\" class=\"form__input password | font-roboto\"\r\n                    [ngClass]=\"{ 'form__input_alert': (required('cta_beneficiario') && form.get('cta_beneficiario').touched) }\"\r\n                    autocomplete=\"off\" id=\"cta_beneficiario\" formControlName=\"cta_beneficiario\" [ngModel]=\"accountB\"\r\n                    required>\r\n                <!-- Alertas -->\r\n                <div class=\" alertTransfer\"\r\n                    *ngIf=\"form.get('cta_beneficiario').touched && (form.get('cta_beneficiario').hasError('required'))\">\r\n                    <span class=\"alert__text | color-red\" *ngIf=\"form.get('cta_beneficiario').hasError('required')\"\r\n                        translate> Por favor captura el Número de Cuenta </span>\r\n                    <span class=\"alert__text | color-red\" *ngIf=\"form.get('cta_beneficiario').hasError('noNueve')\"\r\n                        translate> El número de Cuenta debe iniciar con 9</span>\r\n                    <span class=\"alert__text | color-red\" *ngIf=\"form.get('cta_beneficiario').hasError('noTen')\"\r\n                        translate> El número de Cuenta debe debe ser de 10 dígitos</span>\r\n                </div>\r\n            </div>\r\n            <!-- Campo Monto -->\r\n            <div class=\"position\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div class=\"form \" fxFlex=\"50\">\r\n                    <img class=\"imgmonto\" *ngIf=\"!(required('monto') && form.get('monto').touched)\" type=\"image\"\r\n                        src=\"../../../../../../assets/img/icons/montoForm.svg\">\r\n                    <img class=\"imgmonto\" *ngIf=\"(required('monto') && form.get('monto').touched)\" type=\"image\"\r\n                        src=\"../../../../../../assets/img/icons/montoFormError.svg\">\r\n                    <span class=\"form__text pass move--left\"\r\n                        [ngClass]=\"{ 'form__text_alert': (required('monto') && form.get('monto').touched) }\">Monto*</span>\r\n                    <input type=\"number\" class=\"form__input password imgmonto--padding montoF\"\r\n                        [ngClass]=\"{ 'form__input_alert': (required('monto') && form.get('monto').touched) }\"\r\n                        autocomplete=\"off\" id=\"monto\" name=\"monto\" formControlName=\"monto\" required [ngModel]=\"amountB\">\r\n                    <!-- Alertas  -->\r\n                    <div class=\" alertTransfer\"\r\n                        *ngIf=\"form.get('monto').hasError('montoMinimo') && form.get('monto').errors  && form.get('monto').touched\">\r\n                        <span class=\"alert__text | color-red\"> Por favor captura el monto, este dato debe de ser mayor a\r\n                            $1 MXN</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        \r\n\r\n        </div>\r\n\r\n        <!-- Tercera Columna -->\r\n        <!-- <div class=\"ml-3\" fxFlex=\"32\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n            <div class=\"form \" fxFlex=\"100\" fxLayout=\"row wrap\" class=\"selectbox\">\r\n                <mat-checkbox fxFlex=\"100\" class=\"color-third form--auxiliar-mt | ocultarT\">Bloque vacio!<br>que mira!</mat-checkbox>\r\n            </div>\r\n            <div class=\"form\" fxFlex=\"100\" *ngIf=\"form.get('is_schedule').value\">\r\n                <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': hourNull }\" translate>Hora de dispersión*</span>\r\n                <input (click)=\"selectHour()\" type=\"text\" readonly class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': hourNull }\" autocomplete=\"off\" formControlName=\"hora_operacion\" [ngModel]=\"hora_operacion\" required>\r\n                <div class=\" alertTransfer\" *ngIf=\"hourNull\">\r\n                    <span class=\"alert__text | color-red\" translate> Por favor captura la Hora de dispersión </span>\r\n                </div>\r\n            </div>\r\n\r\n        </div>  -->\r\n\r\n        <div class=\"mt-5\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"end end\">\r\n            <button type=\"button\" class=\"cancelar__button button--margin | \" [routerLink]=\"['/usuario/dispersiones/']\"\r\n                routerLinkActive=\"active\"><b>Cancelar</b></button>\r\n            <button type=\"submit\" class=\"confirmar__button button--marign button--margin-left | color-white\"\r\n                id=\"confirm\"><b>Confirmar</b></button>\r\n        </div>\r\n\r\n    </form>\r\n\r\n</div>\r\n<!-- Loader -->\r\n<app-loading *ngIf=\"showLoad\"></app-loading>\r\n");

