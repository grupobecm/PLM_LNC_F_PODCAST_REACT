v>\r\n                    </div>\r\n                </li>\r\n                <div class=\"scroll elscroll\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <li class=\"noti\" fxFlex=\"100\" fxLayout=\"row wrap\" *ngFor=\"let notificacion of notificaciones\">\r\n                        <div class=\"notificacion__cabecera\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\">\r\n                            <div class=\"cebecera__campana-estado\" fxLayout=\"row\" fxLayoutAlign=\"end center\">\r\n                                <span class=\"cabecera__pildora\" [ngClass]=\"{'exitosa': notificacion.estado == 'Exitosa', 'pendiente': notificacion.estado == 'Pendiente', 'devuelta': notificacion.estado == 'Devolución'}\">\r\n                                    {{ notificacion.estado }}\r\n                                </span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"notificacion__tipo-icon\" fxFlex=\"20\" fxLayoutAlign=\"start end\">\r\n                            <img class=\"notificacion__icon\" *ngIf=\"notificacion.tipo == 'transferencia'\" src=\"./../../../assets/img/icons/exitosa.svg\" alt=\"Notificacion\">\r\n                            <img class=\"notificacion__icon\" *ngIf=\"notificacion.tipo == 'error'\" src=\"./../../../assets/img/icons/close_blue.svg\" alt=\"Notificacion\">\r\n                            <img class=\"notificacion__icon\" *ngIf=\"notificacion.tipo == 'autorizado'\" src=\"./../../../assets/img/icons/palomita_exitosa.svg\" alt=\"Notificacion\">\r\n                            <img class=\"notificacion__icon\" *ngIf=\"notificacion.tipo == 'deposito'\" src=\"./../../../assets/img/icons/deposito.svg\" alt=\"Notificacion\">\r\n                        </div>\r\n                        <div class=\"notificacion__contenido\" fxFlex=\"60\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n                            <div class=\"notificacion__motivo | color-third\" fxFlex=\"100\">\r\n                                {{ notificacion.motivo }}\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"cabecera__close\" fxFlex=\"20\" fxLayoutAlign=\"end end\">\r\n                            <img src=\"./../../../assets/img/icons/delete.svg\" alt=\"Eliminar notificacion\">\r\n                        </div>\r\n                    </li>\r\n                </div>\r\n\r\n\r\n\r\n            </ul>\r\n        </div>\r\n    </div>\r\n\r\n    <div class=\"menu\">\r\n        <div class=\"menu__fondo\" id=\"menu_contenedor\" (click)=\"showMenu('menu_contenedor','menu')\"></div>\r\n\r\n        <div class=\"menu__contenedor | color-third  disable-selection\">\r\n            <ul class=\"menu__items background-white\" id=\"menu\">\r\n                <li class=\"item items--user mt-3\" fxLayout=\"row wrap\" fxLayoutAlign=\"start center\">\r\n                    <div fxFlex=\"100\" fxLayout=\"row\">\r\n                        <div class=\"img__contenedor\" fxLayoutAlign=\"center center\">\r\n                            <img class=\"item__img  item__img--user\" src=\"../../assets/img/icons/profile-icon.svg\" alt=\"Perfil\">\r\n                        </div>\r\n                        <div class=\"item__contenedor-label\" fxLayout=\"column\">\r\n                            <span class=\"item__text item__text--user item__text-mb\">Usuario</span>\r\n                            <span class=\"item__text item__text--user\">{{ username }}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"ultima__conexion\" fxFlex=\"100\" fxLayout=\"row\">\r\n                        <div class=\"space\">\r\n\r\n                        </div>\r\n                        <div fxLayout=\"row wrap\">\r\n                            <label class=\"item__text__ultima item__text--size\">Última conexión</label>\r\n                            <div fxFlex=\"100\" f