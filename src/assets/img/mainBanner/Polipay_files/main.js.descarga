em.empresa__name }}</b>\r\n                    </p>\r\n                </div>\r\n            </div>\r\n\r\n            <div fxFlex=\"75\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"100\">\r\n                    <p class=\"color-accent\"><b>DOCUMENTOS</b></p>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"30\">\r\n                        <nav class=\"nav-barAD | \" fxFlex=\"100\" fxLayoutAlign=\"center start\">\r\n                            <ul class=\"navbar__menuAD\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                                <!-- <li fxFlex=\"100\" class=\"navbar__itemsAD ocultarT\" (click)=\"Documento1()\" [ngClass]=\"{'activeD1': document1}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                                    <a class=\"navbar__textAD | \">Identificación Oficial</a>\r\n                                </li> -->\r\n                                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento2()\" [ngClass]=\"{'activeD1': document2}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                                    <a class=\"navbar__textAD | \">Carta Responsiva</a>\r\n                                </li>\r\n                            </ul>\r\n                        </nav>\r\n                    </div>\r\n                    <div fxFlex=\"68\" class=\"contenedor \" fxLayout=\"row wrap\">\r\n                        <div class=\"documents\">\r\n                            <div *ngIf=\"document2\" class=\"pdf-container mt-2\">\r\n                                <iframe class=\"pdf-container__view elscroll\" fxFlex=\"100\" [src]=\"documentCR | safeurl\"></iframe>\r\n                            </div>\r\n                            <div *ngIf=\"document2\" class=\"mt-3\" fxLayout=\"row wrap\">\r\n                                <di