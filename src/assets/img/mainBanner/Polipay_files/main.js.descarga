                    <div fxLayout=\"row wrap\" fxFlex=\"100\">\r\n                                <div fxFlex=\"100\">\r\n                                    <span class=\"texto3 | color-grey-dark3\">Estado</span>\r\n                                    <div fxLayout=\"row wrap\" *ngIf=\"activado || desactivado\">\r\n                                        <p class=\"texto4 mr-5\" *ngIf=\"desactivado\">Desactivado</p>\r\n                                        <p class=\"texto4 mr-5\" *ngIf=\"activado\">Activado</p>\r\n                                        <mat-slide-toggle [color]=\"color\" (change)=\"activeCheck()\" [(ngModel)]=\"checkStatus\" [checked]=\"checkStatus\">\r\n                                        </mat-slide-toggle>\r\n                                    </div>\r\n                                    <div fxLayout=\"row wrap\" *ngIf=\"sinestatus\">\r\n                                        <p class=\"texto4 mr-5\">Sin Estatus</p>\r\n                                    </div>\r\n                                    <div fxLayout=\"row wrap\" *ngIf=\"pendiente\">\r\n                                        <p class=\"texto4 mr-5\">Pendiente</p>\r\n                                    </div>\r\n                                    <div fxLayout=\"row wrap\" *ngIf=\"devuelto\">\r\n                                        <p class=\"texto4 mr-5\">Devuelto</p>\r\n                                    </div>\r\n                                    <div fxLayout=\"row wrap\" *ngIf=\"edit\">\r\n                                        <p class=\"texto4 mr-5\">Pendiente</p>\r\n                                    </div>\r\n                                </div>\r\n                                <div fxFlex=\"100\" *ngIf=\"pendiente\">\r\n                                    <span class=\"texto3 | color-grey-dark3\">Observaciones</span>\r\n                                    <p class=\"texto4\">LA INFORMACIÓN SE ENCUENTRA EN PROCESO DE REVISIÓN</p>\r\n                                </div>\r\n                                <div fxFlex=\"100\" *ngIf=\"edit\">\r\n                                    <span class=\"texto3 | color-grey-dark3\">Observaciones</span>\r\n                                    <p class=\"texto4\">LA INFORMACIÓN SE ENCUENTRA EN PROCESO DE REVISIÓN</p>\r\n                                </div>\r\n                                <div fxFlex=\"100\" *ngIf=\"devuelto\">\r\n                                    <span class=\"texto3 | color-grey-dark3\">Tipo de solicitud</span>\r\n                                    <p class=\"texto4\">{{texttypeSol}}</p>\r\n                                </div>\r\n                                <div fxFlex=\"100\" class=\"form\" *ngIf=\"desactivado\">\r\n                                    <span class=\"form__text user | font-roboto\" [ngClass]=\"{ 'form__text_alert': (validaMotivo) }\">Motivo*</span>\r\n                                    <textarea class=\"formCon__input user | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"motivoDesactivado\" required [(ngModel)]=\"textMotivo\"></textarea>\r\n                                    <div class=\" alertTransfer\" *ngIf=\"(validaMotivo)\">\r\n                                        <span class=\"alert__text | color-red\" translate> Por favor captura el nombre del\r\n                                            grupo</span>\r\n                                    </div>\r\n                                </div>\r\n                                <div fxFlex=\"100\" fxLayout=\"row wrap\" *ngIf=\"desactivado\">\r\n                                    <div fxFlex=\"100\">\r\n                                        <p class=\"color-third\">Documento Probatorio*</p>\r\n                                    </div>\r\n                                    <div class=\"\" fxFlex=\"100\" fxLayout=\"row\">\r\n                                        <input class=\"boton__input\" name=\"file_\" id=\"file_\" style=\"display: none\" type=\"file\" [(ngModel)]=\"fileMotivo\" (change)=\"fileChange($event)\" #hiddenfileinput accept=\".pdf, application/pdf\">\r\n                                        <button type=\"button\" class=\"cargar__button | color-white\" [ngClass]=\"{'boton--alert':  validaFileMotivo }\" routerLinkActive=\"active\" (click)=\"hiddenfileinput.click()\">\r\n\r\n                                            <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                                            <b>cargar Archivo*</b></button>\r\n                                        <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                                            <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ file }}</span>\r\n                                        </div>\r\n                                    </div>\r\n                                    <div class=\" alertTransfer\" *ngIf=\"validaFileMotivo\">\r\n                                        <span class=\"alert__text | color-red\">Por favor carga el Documento\r\n                                            Probatorio</span>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div fxFlex=\"45\" class=\"contenedor-estado\">\r\n                    <div fxFlex=\"100\" class=\"header\">\r\n                        <div>\r\n                            <span class=\"texto2 | color-main\">Centros de Costos ASIGNADOS</span>\r\n                            <div *ngFor=\"let centro of colaborador.CostCenterList; let i = index\">\r\n                                <p class=\"texto4\">{{colaborador.CostCenterList[i].empresa__name}}</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <di