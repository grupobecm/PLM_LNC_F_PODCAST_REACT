">\r\n                    <div class=\"tabla__una\" fxFlex=\"100\">\r\n                        <table class=\"tabla tabla-ordenes-enviadas | background-white\">\r\n                            <thead>\r\n                                <tr class=\"tr | color-main\" fxLayout=\"row\" fxLayoutAlign=\"start center\">\r\n                                    <th class=\"th th--ml th--align  | color-accent\" fxFlex=\"100\">Documentos del Cliente Externo</th>\r\n                                </tr>\r\n                            </thead>\r\n\r\n                            <tbody class=\"tablas__tbody\">\r\n                                <tr class=\"tr | color-third\" fxLayout=\"row wrap\" fxLayoutAlign=\"none center\">\r\n                                    <td class=\"th th--ml  th--content | color-third bold\" fxFlex=\"60\">Identificación</td>\r\n                                    <td class=\"th th--align-right th--content| color-third\" fxFlex=\"15\">Estado:</td>\r\n                                    <td class=\"th th--align th--content | status--correct bold\" fxFlex=\"15\" *ngIf=\"this.externalClientF.documentos[0].status=='C'\">CORRECTO</td>\r\n                                    <td class=\"th th--align th--content | status--fail bold\" fxFlex=\"15\" *ngIf=\"this.externalClientF.documentos[0].status=='D'\">DEVUELTO</td>\r\n                                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\" *ngIf=\"this.externalClientF.documentos[0].status=='D'\">Motivo de la devolución: <br> {{externalClientF.documentos[0].comentario}}\r\n                                    </td>\r\n                                </tr>\r\n                                <tr class=\"tr | color-third\" fxLayout=\"row wrap\" fxLayoutAlign=\"none center\">\r\n                                    <td class=\"th th--ml  th--content | color-third bold\" fxFlex=\"60\">Edo. Cta. Bancario</td>\r\n                                    <td class=\"th th--align-right th--content| color-third\" fxFlex=\"15\">Estado:</td>\r\n                                    <td class=\"th th--align th--content | status--correct bold\" fxFlex=\"15\" *ngIf=\"this.externalClientF.documentos[1].status=='C'\">CORRECTO</td>\r\n                                    <td class=\"th th--align th--content | status--fail bold\" fxFlex=\"15\" *ngIf=\"this.externalClientF.documentos[1].status=='D'\">DEVUELTO</td>\r\n                                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\" *ngIf=\"this.externalClientF.documentos[1].status=='D'\">Motivo de la devolución: <br> {{externalClientF.documentos[1].comentario}}\r\n                                    </td>\r\n                                </tr>\r\n                                <tr class=\"tr | color-third\" fxLayout=\"row wrap\" fxLayoutAlign=\"none center\">\r\n                                    <td class=\"th th--ml  th--content | color-third bold\" fxFlex=\"60\">Constancia alta sat</td>\r\n                                    <td class=\"th th--align-right th--content| color-third\" fxFlex=\"15\">Estado:</td>\r\n                                    <td class=\"th th--align th--content | status--correct bold\" fxFlex=\"15\" *ngIf=\"this.externalClientF.documentos[2].status=='C'\">CORRECTO</td>\r\n                                    <td class=\"th th--align th--content | status--fail bold\" fxFlex=\"15\" *ngIf=\"this.externalClientF.documentos[2].status=='D'\">DEVUELTO</td>\r\n                                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\" *ngIf=\"this.externalClientF.documentos[2].status=='D'\">Motivo de la devolución: <br> {{externalClientF.documentos[2].comentario}}\r\n                                    </td>\r\n                                </tr>\r\n                                <tr class=\"tr | color-third\" fxLayout=\"row wrap\" fxLayoutAlign=\"none center\">\r\n                                    <td class=\"th th--ml  th--content | color-third bold\" fxFlex=\"60\">Comprobante de Domicilio</td>\r\n                                    <td class=\"th th--align-right th--content| color-third\" fxFlex=\"15\">Estado:</td>\r\n                                    <td class=\"th th--align th--content | status--correct bold\" fxFlex=\"15\" *ngIf=\"this.externalClientF.documentos[3].status=='C'\">CORRECTO</td>\r\n                                    <td class=\"th th--align th--content | status--fail bold\" fxFlex=\"15\" *ngIf=\"this.externalClientF.documentos[3].status=='D'\">DEVUELTO</td>\r\n                                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\" *ngIf=\"this.externalClientF.documentos[3].status=='D'\">Motivo de la devolución: <br> {{externalClientF.documentos[3].comentario}}\r\n                                    </td>\r\n                                </tr>\r\n                                <tr class=\"tr | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\">&nbsp;</td>\r\n                                </tr>\r\n\r\n\r\n                            </tbody>\r\n\r\n                        </table>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"contenedor-boton\" fxFlex=\"98\" fxLayoutAlign=\"end center\">\r\n                <div fxLayoutAlign=\"end center\">\r\n                    <button class=\"confirmar__button | color-white\" (click)=\"alPaso3()\"><b>Continuar</b></button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n        <div *ngIf=\"paso3\" class=\"mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between start\">\r\n            <span class=\"note\" fxFlex=\"100\">Por favor revisa tus documentos y la información que capturaste en la Solicitud de Apertura de Cuenta para tu Cliente. Si es necesario corrige los datos capturados y/o carga los documentos que se solicitan. </span>\r\n            <div fxFlex=\"30\" fxLayout=\"row wrap\">\r\n                <div class=\"mb-2\">\r\n                    <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n                </div>\r\n                <div class=\"form_space\" fxFlex=\"100\" *ngIf=\"datosCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoApellidoPF() && form2.get('apellidoP').touched) }\" translate>Apellido Paterno*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoApellidoPF() && form2.get('apellidoP').touched) }\" autocomplete=\"off\" type=\"text\" name=\"apellidoP\" id=\"apellidoP\" formControlName=\"apellidoP\" [(ngModel)]=\"fisicaModel.apellidoP\"\r\n                        required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoApellidoPF() && form2.get('apellidoP').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el apellido paterno</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space\" fxFlex=\"100\" *ngIf=\"datosCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" translate>Apellido Materno</span>\r\n                    <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"apellidoM\" id=\"apellidoM\" formControlName=\"apellidoM\" [(ngModel)]=\"fisicaModel.apellidoM\">\r\n                </div>\r\n                <div class=\"form_space\" fxFlex=\"100\" *ngIf=\"datosCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoNombreF() && form2.get('nombre').touched) }\" translate>Nombre(s)*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoNombreF() && form2.get('nombre').touched) }\" autocomplete=\"off\" type=\"text\" name=\"nombre\" id=\"nombre\" formControlName=\"nombre\" [(ngModel)]=\"fisicaModel.nombre\"\r\n                        required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoNombreF() && form2.get('nombre').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el nombre</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space\" fxFlex=\"100\" fxLayout=\"row wrap\" *ngIf=\"datosCEF==true\">\r\n                    <div class=\"fecha\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                        <p class=\"form__date label_fecha pass | font-roboto\" [ngClass]=\"{ 'form__date_alert': (form2.get('fechanacimiento').hasError('requerido') && form2.get('fechanacimiento').touched)  || form2.get('fechanacimiento').hasError('menorEdad')}\" translate>Fecha de Nacimiento*</p>\r\n                        <mat-form-field class=\"valor campo_fecha disabled\" [ngClass]=\"{ 'mat-form-field_alert': (form2.get('fechanacimiento').hasError('requerido') && form2.get('fechanacimiento').touched) || form2.get('fechanacimiento').hasError('menorEdad')}\" fxFlex=\"100\">\r\n                            <input matInput class=\"date\" [satDatepicker]=\"picker6\" autocomplete=\"off\" name=\"fechanacimientoR\" id=\"fechanacimientoR\" formControlName=\"fechanacimiento\" [(ngModel)]=\"fisicaModel.fechanacimiento\" readonly [max]=\"datenow\" required>\r\n                            <sat-datepicker #picker6 [rangeMode]=\"false\" [selectFirstDateOnClose]=\"true\" [rangeHoverEffect]=\"false\">\r\n                            </sat-datepicker>\r\n                            <sat-datepicker-toggle matSuffix [for]=\"picker6\"></sat-datepicker-toggle>\r\n                        </mat-form-field>\r\n                    </div>\r\n                    <div class=\"alertTransfer margen-alert\" *ngIf=\"( (form2.get('fechanacimiento').hasError('requerido') || form2.get('fechanacimiento').hasError('required')) && form2.get('fechanacimiento').touched) || form2.get('fechanacimiento').hasError('menorEdad')\"\r\n                        [ngClass]=\"{'alert-margin': (requeridoNombreF() && form2.get('nombre').touched) || (requeridoApellidoPF() && form2.get('apellidoP').touched)}\">\r\n                        <span *ngIf=\"((form2.get('fechanacimiento').hasError('requerido') || form2.get('fechanacimiento').hasError('required')) && form2.get('fechanacimiento').touched)\" class=\"alert__text | color-red\" translate> Por favor captura la Fecha de Nacimiento</span>\r\n                        <span *ngIf=\"((form2.get('fechanacimiento').hasError('menorEdad') || form2.get('fechanacimiento').hasError('required')) && form2.get('fechanacimiento').touched)\" class=\"alert__text | color-red\" translate>Esta persona no puede ser menor de edad</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space form--password-mt\" fxFlex=\"100\" *ngIf=\"datosCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoCorreoF() && form2.get('correo').touched) }\" translate>Correo Electrónico*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoCorreoF() && form2.get('correo').touched) }\" autocomplete=\"off\" type=\"text\" name=\"correo_legal\" id=\"correo_legal\" formControlName=\"correo\" [(ngModel)]=\"fisicaModel.correo\"\r\n                        required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoCorreoF() && form2.get('correo').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el correo electrónico</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space\" fxFlex=\"100\" *ngIf=\"datosCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoTelefonoF() && form2.get('telefono').touched) }\" translate>Teléfono*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoTelefonoF() && form2.get('telefono').touched) }\" autocomplete=\"off\" type=\"text\" name=\"telefono\" id=\"telefono\" formControlName=\"telefono\" [(ngModel)]=\"fisicaModel.telefono\"\r\n                        required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoTelefonoF() && form2.get('telefono').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el teléfono</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space\" fxFlex=\"60\" *ngIf=\"rfcCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoRFCF() && form2.get('rfc').touched) }\" translate>R.F.C.*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoRFCF() && form2.get('rfc').touched) }\" autocomplete=\"off\" type=\"text\" name=\"RFC_legal\" id=\"RFC_legal\" formControlName=\"rfc\" [(ngModel)]=\"fisicaModel.rfc\" required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoRFCF() && form2.get('rfc').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el R.F.C.</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space\" fxFlex=\"40\" *ngIf=\"rfcCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoHomoclaveF() && form2.get('homoclave').touched) }\" translate>Homoclave*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoHomoclaveF() && form2.get('homoclave').touched) }\" autocomplete=\"off\" type=\"text\" name=\"homoclave\" id=\"homoclave\" formControlName=\"homoclave\" [(ngModel)]=\"fisicaModel.homoclave\"\r\n                        required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoHomoclaveF() && form2.get('homoclave').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura la homoclave</span>\r\n                    </div>\r\n                </div>\r\n                <span class=\"th th--align form--password-mt | color-accent\" fxFlex=\"100\" *ngIf=\"rfcCEF==true\">DOMICILIO</span>\r\n                <div class=\"form_space \" fxFlex=\"40\" *ngIf=\"domCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoCPF() && form2.get('CP').touched) }\" translate>Código Postal*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoCPF() && form2.get('CP').touched) }\" autocomplete=\"off\" type=\"text\" name=\"CP_legal\" id=\"CP_legal\" formControlName=\"CP\" [(ngModel)]=\"fisicaModel.CP\"\r\n                        required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoCPF() && form2.get('CP').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Código Postal</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space  margin--rigth\" fxFlex=\"60\" *ngIf=\"domCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoEstadoF() && form2.get('estado').touched) }\" translate>Estado*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoEstadoF() && form2.get('estado').touched) }\" autocomplete=\"off\" type=\"text\" name=\"estado_legal\" id=\"estado_legal\" formControlName=\"estado\" [(ngModel)]=\"fisicaModel.estado\"\r\n                        required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoEstadoF() && form2.get('estado').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Estado</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form__space \" fxFlex=\"100\" *ngIf=\"domCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoColoniaF() && form2.get('colonia').touched) }\" translate>Colonia*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoColoniaF() && form2.get('colonia').touched) }\" autocomplete=\"off\" type=\"text\" name=\"colonia\" id=\"colonia\" formControlName=\"colonia\" required [(ngModel)]=\"fisicaModel.colonia\">\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoColoniaF() && form2.get('colonia').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura la colonia</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space\" fxFlex=\"100\" *ngIf=\"domCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoAlcaldiaF() && form2.get('municipio').touched) }\" translate>Municipio/Alcaldía*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoAlcaldiaF() && form2.get('municipio').touched) }\" autocomplete=\"off\" type=\"text\" name=\"municipio_legal\" id=\"municipio_legal\" formControlName=\"municipio\" [(ngModel)]=\"fisicaModel.municipio\"\r\n                        required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoAlcaldiaF() && form2.get('municipio').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Municipio/Alcaldía</span>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"form_space \" fxFlex=\"100\" *ngIf=\"domCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoCalleF() && form2.get('calle').touched) }\" translate>Calle*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoCalleF() && form2.get('calle').touched) }\" autocomplete=\"off\" type=\"text\" name=\"calle_legal\" id=\"calle_legal\" formControlName=\"calle\" [(ngModel)]=\"fisicaModel.calle\"\r\n                        required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridoCalleF() && form2.get('calle').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura la Calle</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space\" fxFlex=\"50\" *ngIf=\"domCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridonoExteriorF() && form2.get('noExterior').touched) }\" translate>No. Exterior*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridonoExteriorF() && form2.get('noExterior').touched) }\" autocomplete=\"off\" type=\"text\" name=\"noExterior_legal\" id=\"noExterior_legal\" formControlName=\"noExterior\"\r\n                        [(ngModel)]=\"fisicaModel.noExterior\" required>\r\n                    <div class=\" alertTransfer\" *ngIf=\"requeridonoExteriorF() && form2.get('noExterior').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Número Exterior</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space margin--rigth\" fxFlex=\"50\" *ngIf=\"domCEF==true\">\r\n                    <span class=\"form__text  pass | font-roboto\" translate>No. Interior</span>\r\n                    <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"noInteriorF\" id=\"noInteriorF\" formControlName=\"noInterior\" [(ngModel)]=\"fisicaModel.noInterior\">\r\n                </div>\r\n            </div>\r\n\r\n            <div fxFlex=\"70\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"30\">\r\n                        <nav class=\"nav-barAD | \" fxFlex=\"100\" fxLayoutAlign=\"center start\">\r\n                            <ul class=\"navbar__menuAD\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento1()\" [ngClass]=\"{'activeD1': document1}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                                    <a class=\"navbar__textAD | \">Identificación</a>\r\n                                </li>\r\n                                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento2()\" [ngClass]=\"{'activeD1': document2}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                                    <a class=\"navbar__textAD | \">Edo. Cta. Bancario</a>\r\n                                </li>\r\n                                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento3()\" [ngClass]=\"{'activeD1': document3}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                                    <a class=\"navbar__textAD | \">Constancia alta sat</a>\r\n                                </li>\r\n                                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento4()\" [ngClass]=\"{'activeD1': document4}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                                    <a class=\"navbar__textAD | \">Comprobante de domicilio</a>\r\n                                </li>\r\n                            </ul>\r\n                        </nav>\r\n                    </div>\r\n                    <div fxFlex=\"70\" class=\"contenedor \" fxLayout=\"row wrap\" fxLayoutAlign=\"end start\">\r\n                        <div fxFlex=\"100\" class=\"documents\">\r\n                            <div *ngIf=\"document1\" class=\"pdf-container mt-2\">\r\n                                <iframe class=\"pdf-container__view elscroll\" fxFlex=\"100\" [src]=\"externalClientF.documentos[0].documento | safeurl\"></iframe>\r\n                            </div>\r\n                            <div *ngIf=\"document2\" class=\"pdf-container mt-2\">\r\n                                <iframe class=\"pdf-container__view elscroll\" fxFlex=\"100\" [src]=\"externalClientF.documentos[1].documento | safeurl\"></iframe>\r\n                            </div>\r\n                            <div *ngIf=\"document3\" class=\"pdf-container mt-2\">\r\n                                <iframe class=\"pdf-container__view elscroll\" fxFlex=\"100\" [src]=\"externalClientF.documentos[2].documento | safeurl\"></iframe>\r\n                            </div>\r\n                            <div *ngIf=\"document4\" class=\"pdf-container mt-2\">\r\n                                <iframe class=\"pdf-container__view elscroll\" fxFlex=\"100\" [src]=\"externalClientF.documentos[3].documento | safeurl\"></iframe>\r\n                            </div>\r\n                            <div *ngIf=\"document1 \" class=\"mt-3\" fxLayout=\"row wrap\">\r\n                                <div class=\"mb-2\" fxFlex=\"100\">\r\n                                    <p class=\"mensajeObl\" *ngIf=\"this.fisicaModel.docs[0].status=='D'\">Los campos marcados con * son obligatorios</p>\r\n                                </div>\r\n                                <div class=\"mb-2\" fxFlex=\"100\" *ngIf=\"this.fisicaModel.docs[0].status=='C'\" >\r\n                                    <p class=\"mensajeObl\">¿Deseas actualizar el documento?</p>\r\n                                </div>\r\n                                <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                                    <mat-radio-group fxFlex=\"100\" fxLayoutAlign=\"start center\" formControlName=\"radioBoton\" [(ngModel)]=\"this.fisicaModel.docs[0].status\" *ngIf=\"this.fisicaModel.docs[0].status=='C'\" >\r\n                                        <mat-radio-button fxFlex=\"10\" value=\"D\">Sí</mat-radio-button>\r\n                                        <mat-radio-button fxFlex=\"10\" value=\"C\">No</mat-radio-button>\r\n                                    </mat-radio-group>\r\n                                    <div *ngIf=\"this.fisicaModel.docs[0].status=='D'\" fxFlex=\"100\">\r\n                                        <div class=\"mb-3\" fxFlex=\"100\" fxLayout=\"row\">\r\n                                            <input class=\"boton__input\" name=\"file_\" formControlName=\"file_\" id=\"file_\" style=\"display: none\" type=\"file\" (change)=\"fileChangeF($event)\" #hiddenfileinput accept=\".pdf, application/pdf\">\r\n                                            <button type=\"button\" class=\"cargar__button | color-white\" [ngClass]=\"{'boton--alert': form2.get('file_').hasError('required') && auxAlert }\" routerLinkActive=\"active\" (click)=\"hiddenfileinput.click()\">\r\n                                            <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                       