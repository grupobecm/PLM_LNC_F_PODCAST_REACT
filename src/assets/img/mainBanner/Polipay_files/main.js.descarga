        // 1: ESTAN MAL
        this.documento_evidencia = 1;
        this.motivo_documento_evidencia = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ac mi pharetra, porta metus sit amet, volutpat lorem. Donec eget scelerisque odio.";
        this.radioBoton = 'p';
        this.motivoDevolucion = "";
        this.collaborator = {
            cliente: "BecPolimentes SAPI de CV"
        };
        if (this.storage.CenterCostExist || this.storage.CollaboratorExist) {
            this.client = this.storage.Collaborator;
            this.center_cost = this.storage.CenterCost;
        }
        else {
            this.router.navigate(['/administrador/cuentaeje/collaborator/lista-colaborador']);
        }
    }
    /* AVANZAR ENTRE LOS PASOS */
    alPaso1() {
        this.paso1 = true;
        this.paso2 = false;
    }
    alPaso2() {
        this.paso1 = false;
        this.paso2 = true;
    }
    regresar() {
        this.router.navigate(['/administrador/cuentaeje/collaborator/lista-colaborador']);
    }
    submit1() {
        //console.log("Hola");
        this.alPaso2();
    }
    /*AVANZAR ENTRE DOCUMENTOS - paso1*/
    Documento1() {
        this.document1 = true;
        this.document2 = false;
    }
    Documento2() {
        this.document1 = false;
        this.document2 = true;
    }
    click() {
        ////console.log(this.form.value.radioBoton);
        if (this.radioBoton == 'd') {
            return true;
        }
        else {
            return false;
        }
    }
};
