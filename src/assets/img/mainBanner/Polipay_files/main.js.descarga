    // PARA COLONIA 1
    mostrarColonia1() {
        if (this.flg) {
            if (this.guardar) {
                document.getElementById("fondoColonia1").style.display = 'block';
                document.getElementById("listaColonia1").classList.add("mostrar2");
                document.getElementById("fondoColonia1").style.zIndex = "13";
                document.getElementById("selectColonia1").style.zIndex = "13";
                document.getElementById("fondo2").style.zIndex = "12";
                document.getElementById("select1").style.zIndex = "12";
                this.flg = false;
            }
        }
        else {
            this.ocultarColonia1();
        }
    }
    ocultarColonia1() {
        document.getElementById("fondoColonia1").style.display = 'none';
        document.getElementById("listaColonia1").classList.remove("mostrar2");
        this.flg = true;
        if (this.colonia == '\u00a0') {
            this.rojoColonia1 = true;
            this.auxFlgColonia1 = 1;
        }
    }
    actualizarColonia1(value) {
        this.colonia = value;
        this.form.get('colonia').setValue(this.colonia);
        this.form.get('calle').setValue('');
        this.form.get('no_exterior').setValue('');
        this.auxFlgColonia1 = 0;
        if (this.rojoColonia1) {
            this.rojoColonia1 = false;
        }
    }
