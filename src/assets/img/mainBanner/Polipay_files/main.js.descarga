        //console.log(this.id);
        this.listStaffExternal = null;
        this.showLoad = true;
        this.serviceClient.listCostCenters(type, this.id, name, start_date, end_date).subscribe((res) => {
            if (res.results.length == 1) {
                if (this.storageClient.InfoCostCenterExist == false && type == "activo") {
                    this.router.navigate(['/usuario/']);
