.svg\" alt=\"Cliente\">\r\n                <a class=\"navbar__text | color-main\" [routerLink]=\"['/administrador/cuentaeje/cuentas-eje/lista-clientes']\">Cliente</a>\r\n            </li>\r\n            <li class=\"navbar__items\" fxLayout=\"row\" fxLayoutAlign=\"center center\" [routerLink]=\"['/administrador/pending/individual']\" [class.active]=\"activePendientes()\">\r\n                <img class=\"navbar__img\" src=\"../../assets/img/icons/pendientes-icon.svg\" alt=\"Pendientes\">\r\n                <a class=\"navbar__text | color-main\" [routerLink]=\"['/administrador/pending/individual']\">Pendientes</a>\r\n            </li>\r\n            <!-- <li class=\"navbar__items\" fxLayout=\"row\" fxLayoutAlign=\"center center\" [routerLink]=\"['/administrador/created/individualC']\" [class.active]=\"activeCreated()\">\r\n                <img class=\"navbar__img\" src=\"../../assets/img/icons/pendientes-icon.svg\" alt=\"Creadas\">\r\n                <a class=\"navbar__text | color-main\" [routerLink]=\"['/administrador/created/individual']\">Creadas</a>\r\n            </li> -->\r\n            <li class=\"navbar__items\" fxLayout=\"row\" fxLayoutAlign=\"center center\" [routerLink]=\"['/administrador/canceled/individual']\" [class.active]=\"activeCanceladas()\">\r\n                <img class=\"navbar__img\" src=\"../../assets/img/icons/canceladas-icon.svg\" alt=\"Canceladas\">\r\n                <a class=\"navbar__text | color-main\" [routerLink]=\"['/administrador/canceled/individual']\">Canceladas</a>\r\n            </li>\r\n            <li class=\"navbar__items\" fxLayout=\"row\" fxLayoutAlign=\"center center\" [routerLink]=\"['/administrador/sent/individual']\" [class.active]=\"activeEnviadas()\">\r\n                <img class=\"navbar__img\" src=\"../../assets/img/icons/enviadas-icon.svg\" alt=\"Enviadas\">\r\n                <a class=\"navbar__text | color-main\" [routerLink]=\"['/administrador/sent/individual']\">Enviadas</a>\r\n            </li>\r\n            