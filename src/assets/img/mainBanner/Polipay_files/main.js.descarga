let PendingIndividualesComponent = class PendingIndividualesComponent {
    constructor(dialog, router, serviceClient, storageClient, storageHome, storage) {
        this.dialog = dialog;
        this.router = router;
        this.serviceClient = serviceClient;
        this.storageClient = storageClient;
        this.storageHome = storageHome;
        this.storage = storage;
        this.cuenta = "";
        this.displayedColumns = ['id', 'nombre_beneficiario', 'monto', 'fecha_creacion', 'button'];
        this.listProcessed = [];
        this.showLoad = false;
        /* Datos de dispersiones masivas */
        this.dateDispersion = "";
        this.observation = "";
        this.folio = "";
        this.nameUser = "";
        this.monto = "";
        this.dateOperation = "";
        this.empresaName = "";
        this.noData = false;
        this.numRegister = 0;
        if (!this.storageClient.DispertionDataExist) {
            this.router.navigate(["/usuario/dispersiones/estado-dispersion/massive-dispersion/processed-dispersion-massive"]);
        }
        else {
            this.dato = JSON.parse(this.storageClient.DispertionDataValue);
            sessionStorage.removeItem('mass_dispersal');
        }
        //console.log("Datos",this.dato);
        this.empresaName = JSON.parse(this.storage.infoUserValue).data_empresa.cuenta_eje.name;
        // this.detailsIndividualMassives();
        if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length >= 3) {
            //console.log('tp y t');
            //this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
            ////console.log(this.id);
            if (this.storageClient.InfoCostCenterExist == false) {
                //console.log("bye");
                this.dataService = JSON.parse(this.storage.infoUserValue);
                //Aqui va dialog para crear centros de costos
            }
            else {
                //console.log('si hay centros de costos');
                this.dataService = JSON.parse(this.storageClient.InfoCostCenterValue);
                this.id = this.dataService.persona_cuenta_id;
            }
        }
        else {
            if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    //console.log('tp');
                    this.dataService = JSON.parse(this.storage.infoUserValue);
                    this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
                    //console.log(this.id);
                }
                else {
                    if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        //console.log('t');
                        //console.log(this.storageClient.InfoCostCenterExist);
                        if (this.storageClient.InfoCostCenterExist == false) {
                            //console.log("bye");
                            this.dataService = JSON.parse(this.storage.infoUserValue);
                        }
                        else {
                            //console.log("si hay servicios ");
                            this.dataService = JSON.parse(this.storageClient.InfoCostCenterValue);
                            this.id = this.dataService.persona_cuenta_id;
                            //console.log(this.dataService)
                            //console.log(this.dataService.persona_cuenta_id);
                        }
                    }
                }
            }
        }
        this.observation = this.dato.observations;
        this.dateDispersion = this.dato.date_modified;
        this.listIndividualDispersionMassive();
    }
    listIndividualDispersionMassive(nameBenefi = null, date1 = null, date2 = null) {
        this.showLoad = true;
        this.serviceClient.detaislMassiveDispersions(9999, this.dato.id, 2, nameBenefi, date1, date2, this.id).subscribe(res => {
            this.showLoad = false;
            this.listProcessed = new _angular_material_table__WEBPACK_IMPORTED_MODULE_9__["MatTableDataSource"](res.results);
            //console.log(res)
            this.listProcessed.sort = this.sort;
            this.listProcessed.paginator = this.paginator;
            this.paginator._intl.itemsPerPageLabel = 'Filas por página';
            this.listProcessed.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listProcessed.data.length;
        }, error => {
            //console.log("Error", error);
            this.showLoad = false;
            if (error.error.status[0].includes("Usted no tiene permiso ")) {
