            lista[i] = [datos[i].cuenta_emisor, datos[i].clabe_emisor, datos[i].cta_beneficiario, datos[i].clabe_receptor, datos[i].fecha_creacion, datos[i].monto, datos[i].referencia_numerica, datos[i].clave_rastreo, datos[i].id, datos[i].concepto_pago];
        }
        this.serviceAdmin.serviceExcelConcentrates('Concentrado P-Moral Dispersiones Egresos', 'Reporte', titulosExcel, lista, tipo);
    }
};
