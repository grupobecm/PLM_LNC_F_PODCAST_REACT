          <ul class=\"ul-select frecuentes elscroll\">\r\n                                <li *ngIf=\"total2 == 0\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                                    <span class=\"texto__select\" fxFlex=\"95\">No se encontró ninguna tarjeta </span>\r\n                                </li>\r\n                                <!-- <li *ngIf=\"total != 0\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\" (click)=\"cancelar()\">\r\n                                    <span class=\"texto__select\" fxFlex=\"95\">&nbsp;</span>\r\n                                </li> -->\r\n                                <li *ngFor=\"let frequent of copyCompany2; index as i \" fxLayout=\"row wrap\"\r\n                                    (click)=\"mostrar2()\" fxLayoutAlign=\"end center\" (click)=\"actualizar2(frequent)\">\r\n                                    <div fxFlex=\"95\" fxLayoutAlign=\"start center\" *ngIf=\"total2 != 0\">\r\n                                        <span class=\"texto__select text_puntitos\" fxFlex=\"95\">{{frequent.tarjeta +\r\n                                            '&nbsp; &nbsp;' + frequent.nombre}}</span>\r\n                                        <!-- <span class=\"texto__select text_puntitos\" fxFlex=\"95\">{{frequent.tarjeta}}</span> -->\r\n                                    </div>\r\n                                </li>\r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n            </div>\r\n\r\n            <!-- <div fxFlex=\"100\" fxLayout=\"column\">\r\n                <div class=\"form\">\r\n                    <div class=\"fondo-cerrar-select zIndex10\" id=\"fondo2\" (click)=\"ocultar2()\"></div>\r\n                    <div class=\"select-container zIndex10\" id=\"select1\" fxFlex=\"100\">\r\n                        <span class=\"form__text user | font-roboto\" [ngClass]=\"{ 'form__text_alert': requeridoBanco() || rojobanco }\" translate>Nombre del Beneficiario*</span>\r\n                        <div class=\"form__input select | font-roboto \" [ngClass]=\"{ 'form__input_alert': requeridoBanco() || rojobanco}\" id=\"banco\" type=\"text\" name=\"frecuent\" (click)=\"mostrar2()\">\r\n                            {{ banco }}\r\n                            <div class=\"flecha\" id=\"flecha\" [ngClass]=\"{ 'flecha--alert': requeridoBanco() || rojobanco }\"></div>\r\n                            <ul class=\"ul-select all zIndex-10 maxAlturaYScroll elscroll\" id=\"lista2\">\r\n                                <li *ngFor=\"let banco of datalist; let i as index\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\" (click)=\"actualizar2(banco)\">\r\n                                    <span class=\"texto__select\" fxFlex=\"95\">{{banco.person__name}}</span>\r\n                                </li>\r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"alertTransfer\" *ngIf=\"requeridoBanco()\">\r\n                    <span class=\"alert__text | color-red\">Por favor captura el Nombre del Beneficiario </span>\r\n                </div>\r\n            </div> -->\r\n\r\n            <!-- Campo Numero de tarjeta  -->\r\n            <!-- <div class=\"form \" fxFlex=\"100\">\r\n                <span class=\"form__text  pass | font-roboto\" translate>Número de Tarjeta</span>\r\n                <input type=\"number\" class=\"form__input password | font-roboto\" (change)=\"changeCard()\" list=\"browsers2\"\r\n                    name=\"browser2\" id=\"browser2\" formControlName=\"card_beneficiario\" [(ngModel)]=\"card_beneficiary\">\r\n                <datalist class=\"elscroll\" id=\"browsers2\">\r\n                    <option class=\"elscroll\" *ngFor=\"let item of datalist2\" [value]=\"item.tarjeta\">{{item.nombre}}\r\n                </datalist>\r\n            </div> -->\r\n            <!-- Campo Numero de tarjeta 2  -->\r\n\r\n\r\n\r\n            <!-- Check asignar fecha dispersion -->\r\n            <!-- <div class=\"form  selectbox \" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <mat-checkbox fxFlex=\"100\" class=\"mr-2 producto__checkbox form--auxiliar-mt | color-third\"\r\n                    formControlName=\"is_schedule\" [(ngModel)]=\"is_schedule\" (change)=\"addDate()\">¿Deseas programar una\r\n                    fecha de dispersión?</mat-checkbox>\r\n            </div>  -->\r\n            <!-- Campo Fecha de dispersion -->\r\n            <div class=\"form\" fxFlex=\"48\" class=\"selectbox\" *ngIf=\"form.get('is_schedule').value\">\r\n                <div class=\"fecha\" fxLayout=\"row wrap\">\r\n                    <p class=\"form__date label_fecha form__text user text-date--position | font-roboto\"\r\n                        [ngClass]=\"{ 'form__text_alert': (required('fechaProgramada') && form.get('fechaProgramada').touched) }\"\r\n                        translate>Fecha de dispersión*</p>\r\n                    <mat-form-field class=\"valor campo_fecha disabled\"\r\n                        [ngClass]=\"{ 'form__input_alert': (required('fechaProgramada') && form.get('fechaProgramada').touched) }\"\r\n                        fxFlex=\"100\">\r\n                        <input class=\"borde-fecha\" matInput class=\"date\" [satDatepicker]=\"picker7\" autocomplete=\"off\"\r\n                            name=\"fechaProgramada\" id=\"fechaProgramada\" formControlName=\"fechaProgramada\" readonly\r\n                            [min]=\"datenow\" required>\r\n                        <sat-datepicker #picker7 [rangeMode]=\"false\" [selectFirstDateOnClose]=\"true\"\r\n                            [rangeHoverEffect]=\"false\">\r\n                        </sat-datepicker>\r\n                        <sat-datepicker-toggle class=\"suffix\" matSuffix [for]=\"picker7\"></sat-datepicker-toggle>\r\n                    </mat-form-field>\r\n                    <!-- Alertas -->\r\n                    <div fxFlex=\"100\" class=\"alertTransfer alertTransfer--fecha margen-alert\"\r\n                        *ngIf=\"(required('fechaProgramada') && form.get('fechaProgramada').touched)\">\r\n                        <span class=\"alert__text | color-red\" translate>Por favor captura una fecha</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"form ml-3\" fxFlex=\"48\" *ngIf=\"form.get('is_schedule').value\">\r\n                <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': hourNull }\" translate>Hora\r\n                    de dispersión*</span>\r\n                <input (click)=\"selectHour()\" type=\"text\" readonly class=\"form__input password | font-roboto\"\r\n                    [ngClass]=\"{ 'form__input_alert': hourNull }\" autocomplete=\"off\" formControlName=\"hora_operacion\"\r\n                    [ngModel]=\"hora_operacion\" required>\r\n                <div class=\" alertTransfer\" *ngIf=\"hourNull\">\r\n                    <span class=\"alert__text | color-red\" translate> Por favor captura la Hora de dispersión </span>\r\n                </div>\r\n            </div>\r\n\r\n\r\n        </div>\r\n\r\n\r\n\r\n\r\n        <!-- Segunda Columna -->\r\n        <div class=\"ml-3\" fxFlex=\"48\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n            <!-- Campo Numero de cuenta  -->\r\n            <div class=\"form\" fxFlex=\"100\">\r\n                <span class=\"form__text  pass | font-roboto\"\r\n                    [ngClass]=\"{ 'form__text_alert': (required('cta_beneficiario') && form.get('cta_beneficiario').touched) }\"\r\n                    translate>Número de Cuenta*</span>\r\n                <input type=\"text\" class=\"form__input password | font-roboto\"\r\n                    [ngClass]=\"{ 'form__input_alert': (required('cta_beneficiario') && form.get('cta_beneficiario').touched) }\"\r\n                  