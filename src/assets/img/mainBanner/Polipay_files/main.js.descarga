let IndividualCreatedAdminComponent = class IndividualCreatedAdminComponent {
    constructor(dialog, router, formBuilder, storageClient, serviceAdmin) {
        this.dialog = dialog;
        this.router = router;
        this.formBuilder = formBuilder;
        this.storageClient = storageClient;
        this.serviceAdmin = serviceAdmin;
        this.cuenta = "";
        //Tablas de Angular Material
        this.displayedColumns = ['empresa', 'nombre_beneficiario', 'monto', "clave_rastreo", 'fecha_creacion', 'button'];
        this.listStaffExternal = [];
        this.ningunDato = false;
        this.noData = false;
        this.numRegister = 0;
        this.latName = "";
        this.showLoad = false;
        this.color = 'primary';
        this.listPersonal();
    }
    listPersonal(size = 9999, id = null, statusId = 6, benefi = null, date1 = null, date2 = null, trackingKey = null) {
        this.showLoad = true;
        this.serviceAdmin.listTransactions(size, id, statusId, benefi, date1, date2, trackingKey).subscribe(res => {
            //console.log(res);
            this.ningunDato = false;
            // res.results.forEach(element => {
            //     element.nombre_beneficiario=element.nombre_beneficiario.replace("*"," ");
            // });
            let variable = [...res.results];
            this.listStaffExternal = new _angular_material_table__WEBPACK_IMPORTED_MODULE_13__["MatTableDataSource"](variable);
            //person__last_name
            this.showLoad = false;
            this.listStaffExternal.sort = this.sort;
            this.listStaffExternal.paginator = this.paginator;
            this.listStaffExternal.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listStaffExternal.data.length;
            //console.log(this.numRegister);
        }, error => {
            this.showLoad = false;
            this.ningunDato = true;
            //console.log(error.error)
        });
    }
    openFilter() {
        let filtro = this.dialog.open(_filter_created_individual_a_filter_created_individual_a_component__WEBPACK_IMPORTED_MODULE_21__["FilterCreatedIndividualAComponent"], {
            width: "90%",
            panelClass: "custom-dialog-container"
        });
        filtro.afterClosed().subscribe(res => {
            let benefi = null;
            let date1 = null;
            let date2 = null;
            let trackingKey = null;
            let id = null;
            //console.log(res);
            if (res == undefined) {
            }
            else {
                if (res != 'Reset filtro') {
                    for (let i = 0; i < res.data.filtro.length; i++) {
                        switch (res.data.filtro[i].campo) {
                            case 'Beneficiario':
                                benefi = res.data.filtro[i].valor;
                                break;
                            case 'Fecha de Operación':
                                date1 = res.data.filtro[i].valor.begin.toISOString().split("T")[0];
                                date2 = res.data.filtro[i].valor.end.toISOString().split("T")[0];
                                break;
                            case 'Clave de Rastreo':
                                trackingKey = res.data.filtro[i].valor;
                                break;
                            case 'Folio':
                                id = res.data.filtro[i].valor;
                                break;
                        }
                    }
                    //console.log(id);
                    this.listPersonal(9999, id, 1, benefi, date1, date2, trackingKey);
                }
            }
        });
    }
    seedetailsReceived(element) {
        //console.log(element);
        //console.log(element.id);
        this.dialog.open(_details_created_individual_a_details_created_individual_a_component__WEBPACK_IMPORTED_MODULE_20__["DetailsCreatedIndividualAComponent"], {
            width: "544px",
            data: {
                dato: element
            },
            disableClose: true,
        });
    }
    requestCards(data) {
        this.storageClient.setInfoExternalP(data);
        this.router.navigate(["/usuario/dispersiones/peronal-externo/asignar-tarjetas-personal-externo"]);
    }
    statusChange(dato) {
        //console.log(dato);
        let question = this.dialog.open(src_app_Views_user_messageUser_questions_user_questions_user_component__WEBPACK_IMPORTED_MODULE_18__["QuestionsUserComponent"], {
            data: {
                question: 'D-001',
                username: dato.name,
                id: dato.id,
                //Mando true para mandar un motivo en la desactivacion
                motivo: true
            },
            disableClose: true,
        });
        question.afterClosed().subscribe(res => {
            if (res != undefined) {
                if (res.event) {
                    let form = this.dialog.open(src_app_Views_user_messageUser_form_user_form_user_component__WEBPACK_IMPORTED_MODULE_17__["FormUserComponent"], {
                        width: '500px',
                        data: {
                            form: 'D-001',
                            id: dato.id,
                            username: dato.name,
                        },
                        disableClose: true,
                    });
                    form.afterClosed().subscribe(res => {
                        if (res != undefined) {
                            if (res.event) {
                                //console.log(dato.username);
                                let success = this.dialog.open(src_app_Views_user_messageUser_success_user_success_user_component__WEBPACK_IMPORTED_MODULE_19__["SuccessUserComponent"], {
                                    width: '500px',
                                    data: {
                                        success: 'D-003',
                                        username: dato.name,
                                    },
                                    disableClose: true,
                                });
                                success.afterClosed().subscribe(res => {
                                    this.listPersonal();
                                });
                            }
                        }
                    });
                }
            }
        });
    }
};
