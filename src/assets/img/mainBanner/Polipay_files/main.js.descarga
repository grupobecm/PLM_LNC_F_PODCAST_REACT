                    this.alPaso2();
                }
                break;
            default:
                break;
        }
    }
    /**Detecta el documento a mostrar */
    tipoDoc(val) {
        let tipo = '';
        switch (val) {
            case 1:
                tipo = 'Identificación Oficial';
                break;
            case 2:
                tipo = 'Carta Responsiva';
                break;
        }
        return tipo;
    }
