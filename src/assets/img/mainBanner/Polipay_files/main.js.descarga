33;\r\n    letter-spacing: 0.4px;\r\n    text-align: left;\r\n    color: var(--opacity-60);\r\n    margin-left: 16.5px;\r\n    background: var(--white);\r\n    padding: 0px 5px;\r\n}\r\n\r\n\r\n.form__input {\r\n    width: 100%;\r\n    height: 56px;\r\n    font-size: 16px;\r\n    line-height: 1.5;\r\n    letter-spacing: 0.15px;\r\n    text-align: left;\r\n    padding: 17px 16.5px;\r\n    outline: none;\r\n    border-radius: 4px;\r\n    border: solid 1px var(--opacity-12);\r\n    color: var(--opacity-74);\r\n}\r\n\r\n\r\n.form__input:-webkit-autofill {\r\n    box-shadow: 0 0 0px 1000px var(--white) inset;\r\n    -webkit-text-fill-color: var(--opacity-74);\r\n}\r\n\r\n\r\ninput:focus {\r\n    border: 2px solid var(--accent-color);\r\n}\r\n\r\n\r\ninput:focus+span {\r\n    color: var(--main-color);\r\n}\r\n\r\n\r\n.form:focus-within span {\r\n    color: var(--main-color);\r\n}\r\n\r\n\r\n.space-white {\r\n    display: block;\r\n    width: 334px;\r\n    height: 38px;\r\n    background: transparent;\r\n    margin: 14.5px 0 10px 0;\r\n}\r\n\r\n\r\n/* FIN Form and inputs */\r\n\r\n\r\n/* Button confirmar */\r\n\r\n\r\n.confirmar__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width: 128px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var(--main-color);\r\n    margin-top: 23.7px;\r\n    font-size: 14px;\r\n    font-weight: 500;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    /* centrar el boton */\r\n    display: block;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n    outline: none;\r\n    cursor: pointer;\r\n    box-shadow: 0 1px 3px var(--opacity-12), 0 3px 3px var(--opacity-24);\r\n    transition: 0.3s;\r\n}\r\n\r\n\r\n.confirmar__button:hover {\r\n    background-color: var( --grey-dark);\r\n    color: var( --main-color);\r\n    cursor: pointer;\r\n}\r\n\r\n\r\n.confirmar__button:disabled {\r\n    background-color: var( --grey-dark);\r\n    color: var( --third-color);\r\n    cursor: default;\r\n}\r\n\r\n\r\n/* Button cancelar */\r\n\r\n\r\n.cancelar__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width: 128px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var( --grey-dark);\r\n    margin-top: 23.7px;\r\n    font-size: 14px;\r\n    font-weight: 500;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    /* centrar el boton */\r\n    display: block;\r\n    margin-left: 0;\r\n    margin-right: auto;\r\n    outline: none;\r\n    cursor: pointer;\r\n    box-shadow: 0 1px 3px var(--opacity-12), 0 3px 3px var(--opacity-24);\r\n    transition: 0.3s;\r\n}\r\n\r\n\r\n.cancelar__button:hover {\r\n    background-color: var( --red);\r\n    color: var(--white);\r\n}\r\n\r\n\r\n/* tabla */\r\n\r\n\r\ntable {\r\n    margin: 16px 0px;\r\n    border-radius: 6px;\r\n    box-shadow: 0 0 6px 0 rgba(0, 0, 0, 0.65);\r\n    width: 100%;\r\n    table-layout: fixed;\r\n}\r\n\r\n\r\n.th--right {\r\n    text-align: right;\r\n}\r\n\r\n\r\n.beneficiario {\r\n    width: 25%;\r\n}\r\n\r\n\r\n.monto {\r\n    width: 15%;\r\n}\r\n\r\n\r\n.th--left {\r\n    text-align: left;\r\n}\r\n\r\n\r\nth,\r\ntd {\r\n    text-align: center;\r\n    padding: 15px 17px;\r\n}\r\n\r\n\r\n.tr {\r\n    border-bottom: 1px solid var(--grey-light);\r\n}\r\n\r\n\r\n.no-registros-container {\r\n    min-height: calc(100vh - 400px);\r\n}\r\n\r\n\r\n.botones {\r\n    position: absolute;\r\n    right: 23px;\r\n}\r\n\r\n\r\n.hola {\r\n    padding-top: 4.5px;\r\n    padding-bottom: 19.5px;\r\n}\r\n\r\n\r\n.label__filasPagina {\r\n    font-size: 16px;\r\n    line-height: 1.65;\r\n    text-align: center;\r\n    margin: 0;\r\n    margin-right: 8px;\r\n}\r\n\r\n\r\n.input__finasPagina {\r\n    width: 87px;\r\n    height: 38px;\r\n    padding-left: 23px;\r\n    border-radius: 6px;\r\n    border: solid 1px var(--grey-dark);\r\n    margin-right: 39px;\r\n}\r\n\r\n\r\n.label__numeroRegistros {\r\n    margin-right: 37px;\r\n}\r\n\r\n\r\n.boton {\r\n    border: none;\r\n    margin: 0px 16px;\r\n    outline: none;\r\n}\r\n\r\n\r\n.txt-left {\r\n    text-align: left;\r\n}\r\n\r\n\r\n.th-fav {\r\n    width: 5%;\r\n}\r\n\r\n\r\n.th-alias {\r\n    width: 15%;\r\n}\r\n\r\n\r\n.nombre {\r\n    width: 30%;\r\n}\r\n\r\n/*# sourceMappingURL=data:application/json;base64, */");

