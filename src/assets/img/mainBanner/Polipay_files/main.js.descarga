px;\r\n    }\r\n    .boton-solicitar img{\r\n        transform: scale(0.7);\r\n    }\r\n    .stock__texto--size{\r\n        font-size: 14px;\r\n    }\r\n\r\n}\r\n/*# sourceMappingURL=data:application/json;base64, */");

