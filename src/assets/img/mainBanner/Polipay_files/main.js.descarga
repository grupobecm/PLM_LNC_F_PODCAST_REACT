let DetailsDetailIndividualComponent = class DetailsDetailIndividualComponent {
    constructor(router, formBuilder, dialog, serviceAdmin) {
        this.router = router;
        this.formBuilder = formBuilder;
        this.dialog = dialog;
        this.serviceAdmin = serviceAdmin;
        this.showLoad = false;
        this.checked = false;
        if (this.router.getCurrentNavigation().extras.state == undefined) {
            this.router.navigate(['/administrador/pending/individual']);
        }
        else {
            this.datos = this.router.getCurrentNavigation().extras.state.dato;
            //console.log(this.datos);
            this.flagSTP = this.datos.status_trans_id;
        }
        this.form = formBuilder.group({
            radioBoton: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_4__["Validators"].required]],
            motivoDevolucion: ['']
        });
        this.detailsPeding();
    }
    detailsPeding() {
        this.showLoad = true;
        this.serviceAdmin.detailsPeding(this.datos.id).subscribe(res => {
            this.dataAux = res;
            //console.log(res);
            this.name_beneficiary = res.NombreBeneficiario;
            this.rfc = res.RFC;
            this.account_number = res.Clabe;
            this.amount = res.Monto;
            this.trackingKey = res.ClaveRastreo;
            this.email = res.Email;
            this.reference = res.Referencia;
            this.bank = res.Banco;
            this.concept = res.Concepto;
            this.dispersion_date = res.FechaDispersion;
            this.showLoad = false;
        }, error => {
            //console.log(error);
        });
    }
    submit() {
        if (this.form.value.radioBoton == 'd') {
            let dialog = this.dialog.open(_messageAdmin_questions_admin_questions_admin_component__WEBPACK_IMPORTED_MODULE_8__["QuestionsAdminComponent"], {
                width: '500px',
                panelClass: 'borde2',
                data: {
                    question: 'T-002',
                    username: this.name_beneficiary,
                    id: this.datos.id,
                    estado: this.form.value.radioBoton,
                    idStatus: 7,
                    motivo: this.form.value.motivoDevolucion
                },
                disableClose: true,
            });
            dialog.afterClosed().subscribe(res => {
                this.dialog.closeAll();
                this.router.navigate(['/administrador/pending/individual']);
            });
            //  //console.log('hola');
        }
        else {
            this.dialog.open(_messageAdmin_questions_admin_questions_admin_component__WEBPACK_IMPORTED_MODULE_8__["QuestionsAdminComponent"], {
                width: '500px',
                panelClass: 'borde2',
                data: {
                    question: 'T-001',
