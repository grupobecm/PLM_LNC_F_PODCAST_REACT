    listIndividualDispersionMassive(nameBenefi = null, date1 = null, date2 = null) {
        this.showLoad = true;
        this.serviceClient.detaislMassiveDispersions(9999, this.dato.masivo_trans_id, 3, nameBenefi, date1, date2, this.id).subscribe(res => {
            this.showLoad = false;
