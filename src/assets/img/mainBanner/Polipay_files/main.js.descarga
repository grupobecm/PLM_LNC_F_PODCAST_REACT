    constructor(formBuilder, dialog, serviceNewAdmin, router) {
        this.formBuilder = formBuilder;
        this.dialog = dialog;
        this.serviceNewAdmin = serviceNewAdmin;
        this.router = router;
        //prueba
        // PASO 1
        this.nombreCoModel = "";
        this.correoCoModel = "";
        this.fechanaCoModel = "";
        this.telCoModel = "";
        this.CentrocostCoModel = "";
        this.CentrocostCoModel2 = "";
        this.datenow = new Date();
        this.CheckSAdminModel = true;
        this.CheckAdminModel = false;
        this.checked = true;
        this.form = this.formBuilder.group({
            // PASO 1
            name: ["", [_angular_forms__WEBPACK_IMPORTED_MODULE_11__["Validators"].required]],
            a_paterno: ["", [_angular_forms__WEBPACK_IMPORTED_MODULE_11__["Validators"].required]],
            a_materno: ["", [_angular_forms__WEBPACK_IMPORTED_MODULE_11__["Validators"].required]],
            email: ["", [_angular_forms__WEBPACK_IMPORTED_MODULE_11__["Validators"].required, _angular_forms__WEBPACK_IMPORTED_MODULE_11__["Validators"].email]],
            fecha_nacimiento: ["", [_angular_forms__WEBPACK_IMPORTED_MODULE_11__["Validators"].required, src_app_utils_validator_pass__WEBPACK_IMPORTED_MODULE_15__["hasMenorEdad"].hasMenorEdad]],
            phone: ["", [_angular_forms__WEBPACK_IMPORTED_MODULE_11__["Validators"].required]],
            type_admin: ["is_staff", [_angular_forms__WEBPACK_IMPORTED_MODULE_11__["Validators"].required]],
            is_superuser: [""],
            is_staff: [""],
        });
    }
    submit() {
        if (this.form.valid) {
            // Coloca true o false dependiendo si se va a crear un super user o uno normal
            switch (this.form.get('type_admin').value) {
                case 'is_superuser':
                    this.form.get('is_superuser').setValue(true);
                    this.form.get('is_staff').setValue(true);
                    break;
                case 'is_staff':
                    this.form.get('is_superuser').setValue(false);
                    this.form.get('is_staff').setValue(true);
                    break;
            }
            //Cambia el formato de la fecha
            this.form.get('fecha_nacimiento').setValue((this.form.get('fecha_nacimiento').value).toISOString().split('T')[0]);
            this.modelNewAdmin = this.form.value;
            // Se conecta al servicio
            this.serviceNewAdmin.createNewAdmin(this.modelNewAdmin).subscribe(res => {
                // Success servicio
                let message = this.dialog.open(_messageAdmin_success_admin_success_admin_component__WEBPACK_IMPORTED_MODULE_17__["SuccessAdminComponent"], {
                    data: {
                        message: 0
                    },
                    disableClose: true,
                });
                message.afterClosed().subscribe(res => {
                    this.router.navigate(['/administrador/administraodres-polipay/lista-administradores-polipay']);
                });
            }, error => {
                // Error servicio
                let message = this.dialog.open(_messageAdmin_error_admin_error_admin_component__WEBPACK_IMPORTED_MODULE_16__["ErrorAdminComponent"], {
                    data: {
                        error: 'R-002',
                        message: error.error.status
                    },
                    disableClose: true,
                });
                message.afterClosed().subscribe(res => {
                    this.form.reset();
                    this.form.get('type_admin').setValue('is_staff');
                });
            });
        }
        else {
            //Focus a todos los elementos para saber cual es el invalido
            document.getElementById('name').focus();
            document.getElementById('a_paterno').focus();
            document.getElementById('a_materno').focus();
            document.getElementById('phone').focus();
            document.getElementById('email').focus();
            document.getElementById('fecha_nacimiento').focus();
            document.getElementById('submit').focus();
        }
    }
    isSuperAdmin() {
        if (sessionStorage.getItem("now_time")) {
            return true;
        }
        else {
            return false;
        }
    }
};
