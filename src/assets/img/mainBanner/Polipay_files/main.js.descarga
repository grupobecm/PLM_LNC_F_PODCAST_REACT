 zIndex10 color2\" id=\"fondo2\" (click)=\"ocultar2()\"></div>\r\n                        <div class=\"form select-container zIndex10\" fxFlex=\"100\">\r\n                            <span class=\"form__text user | font-roboto\" [ngClass]=\"{ 'form__text_alert': requeridoPeriodo() || rojobancoD }\" translate>Escoge el mes a visualizar</span>\r\n                            <div class=\"form__input select | font-roboto\" [ngClass]=\"{ 'form__input_alert': requeridoPeriodo() || rojobancoD }\" id=\"cuentaBeneficiario\" type=\"text\" name=\"frecuent\" (click)=\"mostrar2()\">\r\n                                {{ cuentaD }}\r\n                                <div class=\"flecha\" [ngClass]=\"{ 'flecha--alert': requeridoPeriodo() || rojobancoD }\"></div>\r\n                                <ul class=\"ul-select all maxAlturaYScroll alturaSelect elscroll\" id=\"lista2\">\r\n                                    <li fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                                        <span class=\"texto__select\" fxFlex=\"90\">Seleccione</span>\r\n                                    </li>\r\n                                    <!-- <li fxLayout=\"row wrap\" fxLayoutAlign=\"center center\" (click)=\"actualizar2('Últimos 12 meses', 1)\">\r\n                                        <span class=\"texto__select\" fxFlex=\"90\">Últimos 12 meses</span>\r\n                                    </li> -->\r\n                                    <li *ngFor=\"let destino of periodo\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\" (click)=\"actualizar2(destino.anio + ' - ' + destino.mes, destino)\">\r\n                                        <span class=\"texto__select\" fxFlex=\"90\">{{ destino.anio }} - {{ destino.mes }}</span>\r\n                                    </li>\r\n                                </ul>\r\n                            </div>\r\n                            <div class=\"alertTransfer\" *ngIf=\"requeridoPeriodo()\">\r\n                                <span class=\"alert__text | color-red\" translate>\r\n                                        User.Alerts.RequiredPeriod\r\n                                    </span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                    <!-- AQUI van los mensjaes de error -->\r\n                </div>\r\n\r\n                <div class=\"date-rank background-grey-light9\" fxFlex=\"45\" fxLayout=\"row wrap\">\r\n                    <span fxFlex=\"100\" class=\"rank \" fxLayoutAlign=\"start start\">Rango de fechas</span>\r\n                    <mat-form-field class=\"back background-grey-light9\">\r\n                        <mat-date-range-input [formGroup]=\"range\" [rangePicker]=\"picker\" [max]=\"datenow\">\r\n                            <input matStartDate class=\"back background-grey-light9\" formControlName=\"start\" [max]=\"datenow\" (dateChange)=\"DatePiker($event, 'date1')\" placeholder=\"Fecha inicial\">\r\n                            <input matEndDate class=\"back background-grey-light9\" formControlName=\"end\" [max]=\"datenow\" (dateChange)=\"DatePiker2($event, 'date2')\" placeholder=\"Fecha final\">\r\n                        </mat-date-range-input>\r\n                        <mat-datepicker-toggle matSuffix class=\"back background-grey-light9\" [for]=\"picker\"></mat-datepicker-toggle>\r\n                        <mat-date-range-picker #picker class=\"background-grey-light9\"></mat-date-range-picker>\r\n\r\n                        <mat-error *ngIf=\"range.controls.start.hasError('matStartDateInvalid')\">Invalid start date</mat-error>\r\n                        <mat-error *ngIf=\"range.controls.end.hasError('matEndDateInvalid')\">Invalid end date</mat-error>\r\n                    </mat-form-field>\r\n\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"cont-blanco cont-datos\" fxFlex=\"25\" fxLayout=\"row wrap\">\r\n            <span fxFlex=\"100\" class=\"texto3 | color-grey-dark3\">Nombre Completo</span>\r\n            <p fxFlex=\"100\" class=\"texto4 | color-74 \">{{ name }} {{ lastName }}</p>\r\n            <!-- Falta agregar apellidos -->\r\n            <span fxFlex=\"100\" class=\"texto3 | color-grey-dark3\">Fecha de nacimiento</span>\r\n            <p fxFlex=\"100\" class=\"texto4 | color-74 \"> {{ dateBirth }}</p>\r\n            <span fxFlex=\"100\" class=\"texto3 | color-grey-dark3\">R.F.C.</span>\r\n            <p fxFlex=\"100\" class=\"texto4 | color-74 \"> {{ rfc | uppercase }}</p>\r\n            <span fxFlex=\"100\" class=\"texto3 | color-grey-dark3\">Correo Electrónico</span>\r\n            <p fxFlex=\"100\" class=\"texto4 | color-74 \">{{ mail }}</p>\r\n        </div>\r\n        <!--Inicia tabla de operacion-->\r\n        <div class=\"box mat-elevation-z8  margin-cont--left\" fxFlex=\"73\" fxLayout=\"row wrap\">\r\n            <div class=\"\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                <table mat-table [dataSource]=\"listStaffExternal\" fxFlex=\"100\" matSort [attr.align]=\"'center'\">\r\n                    <!-- Columna No se encontraron registros -->\r\n                    <ng-container matColumnDef=\"noData\">\r\n                        <td mat-footer-cell *matFooterCellDef [attr.colspan]=\"displayedColumns.length\" [attr.align]=\"'center'\">\r\n                            <span *ngIf=\"noData===true\">No se encontraron registros.</span>\r\n                        </td>\r\n                    </ng-container>\r\n                    <!-- Columna Operacion -->\r\n                    <ng-container matColumnDef=\"operacion\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header fxFlex=\"40\">Operacion</th>\r\n                        <td mat-cell *matCellDef=\"let element\" fxFlex=\"38\">{{ element.Comercio }}</td>\r\n                    </ng-container>\r\n                    <!-- Columna Estado -->\r\n                  