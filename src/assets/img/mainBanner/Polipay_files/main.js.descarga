/ul>\r\n      </nav>\r\n    </div>\r\n    <form [formGroup]=\"form2\" fxFlex=\"100\" (ngSubmit)=\"submit()\" novalidate class=\"contenedor \" fxLayout=\"row wrap\">\r\n      <div *ngIf=\"paso1\" class=\"mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between start\">\r\n        <div fxFlex=\"49\" class=\"mr-3\" fxLayout=\"row wrap\" fxLayoutAlign=\"none stretch\">\r\n          <div class=\"mt-4\" fxFlex=\"100\">\r\n            <div class=\"tabla__una\" fxFlex=\"100\">\r\n              <table class=\"tabla tabla-ordenes-enviadas | background-white\">\r\n                <thead>\r\n                  <tr class=\"tr | color-main\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                    <th class=\"th  th--align  | color-accent\" fxFlex=\"100\">Resultado de verificación de documentos</th>\r\n                  </tr>\r\n                </thead>\r\n                <tbody class=\"tablas__tbody\">\r\n                  <tr class=\"tr th th--ml | color-third\" fxLayout=\"column\" fxLayoutAlign=\"none start\">\r\n                    <p class=\"th text\">El Representante Legal <span class=\"color-red bold text\">no puede ser\r\n                        cambiado</span> hasta que los documentos devueltos sean correctos.\r\n                    </p>\r\n                    <div class=\"mb-2 mt-2\" fxFlex=\"100\">\r\n                      <p class=\"th text\">\r\n                        A continuación verás un resumen de tus documentos. <br>\r\n                      </p>\r\n\r\n                    </div>\r\n                    <div class=\"mb-2 mt-2\" fxFlex=\"100\">\r\n                      <p class=\"th text\">\r\n                        Para ir a la corrección da clic en el botón continuar.\r\n                      </p>\r\n                    </div>\r\n                  </tr>\r\n                </tbody>\r\n              </table>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div fxFlex=\"49\" fxLayout=\"row wrap\" fxLayoutAlign=\"none stretch\">\r\n          <div class=\"mt-4\" fxFlex=\"100\">\r\n            <div class=\"tabla__una\" fxFlex=\"100\">\r\n              <table class=\"tabla tabla-ordenes-enviadas | background-white\">\r\n                <thead>\r\n                  <tr class=\"tr | color-main\" fxLayout=\"row\" fxLayoutAlign=\"start center\">\r\n                    <th class=\"th th--ml th--align  | color-accent\" fxFlex=\"100\">Documentos {{nameType}}</th>\r\n                  </tr>\r\n                </thead>\r\n                <tbody class=\"tablas__tbody\">\r\n                  <tr class=\"tr | color-third\" fxLayout=\"row wrap\" fxLayoutAlign=\"none center\">\r\n                    <td class=\"th th--ml  th--content | color-third bold\" fxFlex=\"50\">Identificación\r\n                    </td>\r\n                    <td class=\"th th--align-right th--content| color-third\" fxFlex=\"15\">Estado: </td>\r\n                    <td class=\"th th--align th--content | status--correct bold\" fxFlex=\"15\" *ngIf=\"status1=='C'\">\r\n                      CORRECTO</td>\r\n                    <td class=\"th th--align th--content | status--fail bold\" fxFlex=\"15\" *ngIf=\"status1=='D'\">DEVUELTO\r\n                    </td>\r\n                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\" *ngIf=\"status1=='D'\">Motivo de la\r\n                      devolución: <p>{{comment1}}</p>\r\n                    </td>\r\n                  </tr>\r\n                  <tr class=\"tr | color-third\" fxLayout=\"row wrap\" fxLayoutAlign=\"none center\">\r\n                    <td class=\"th th--ml  th--content | color-third bold\" fxFlex=\"50\">Costancia Alta SAT\r\n                    </td>\r\n                    <td class=\"th th--align-right th--content| color-third\" fxFlex=\"15\">Estado: </td>\r\n                    <td class=\"th th--align th--content | status--correct bold\" fxFlex=\"15\" *ngIf=\"status2=='C'\">\r\n                      CORRECTO</td>\r\n                    <td class=\"th th--align th--content | status--fail bold\" fxFlex=\"15\" *ngIf=\"status2=='D'\">DEVUELTO\r\n                    </td>\r\n                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\" *ngIf=\"status2=='D'\">Motivo de la\r\n                      devolución: <p>{{comment2}}</p>\r\n                    </td>\r\n                  </tr>\r\n                  <tr class=\"tr | color-third\" fxLayout=\"row wrap\" fxLayoutAlign=\"none center\">\r\n                    <td class=\"th th--ml  th--content | color-third bold\" fxFlex=\"50\">Comprobante de domicilio\r\n                    </td>\r\n                    <td class=\"th th--align-right th--content| color-third\" fxFlex=\"15\">Estado: </td>\r\n                    <td class=\"th th--align th--content | status--correct bold\" fxFlex=\"15\" *ngIf=\"status3=='C'\">\r\n                      CORRECTO</td>\r\n                    <td class=\"th th--align th--content | status--fail bold\" fxFlex=\"15\" *ngIf=\"status3=='D'\">DEVUELTO\r\n                    </td>\r\n                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\" *ngIf=\"status3=='D'\">Motivo de la\r\n                      devolución: <p>{{comment3}}</p>\r\n                    </td>\r\n                  </tr>\r\n                  <tr class=\"tr | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\">&nbsp;</td>\r\n                  </tr>\r\n                </tbody>\r\n\r\n              </table>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div class=\"contenedor-boton\" fxFlex=\"98\" fxLayoutAlign=\"end center\">\r\n          <div fxLayoutAlign=\"end center\">\r\n            <button class=\"confirmar__button | color-white\" (click)=\"alPaso2()\"><b>Continuar</b></button>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div *ngIf=\"paso2\" class=\"mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between start\">\r\n        <span class=\"note\" fxFlex=\"100\">Por favor revisa tus documentos y la información que capturaste para\r\n          {{nameType}}. Si es necesario corrige los datos capturados y/o carga\r\n          los documentos que se solicitan. </span>\r\n        <div class=\"mt-4\" fxFlex=\"30\" fxLayout=\"row wrap\">\r\n\r\n          <div  fxFlex=\"100\" fxLayout=\"row wrap\" *ngIf=\"flaginfoperson\">\r\n            <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n              <div class=\"form_space\" fxFlex=\"100\">\r\n                <p class=\"color-accent subtitle_info\">Representante Legal Anterior </p>\r\n              </div>\r\n              <div fxFlex=\"100\">\r\n                <span class=\"text color-60\">Nombre</span>\r\n                <p class=\"subtitle | color-74\"><b>{{ nameOldRL }}</b></p>\r\n              </div>\r\n              <div fxFlex=\"100\">\r\n                <span class=\"text color-60\">Correo Electrónico</span>\r\n                <p class=\"subtitle | color-74\"><b>{{ emilOldRL }}</b></p>\r\n              </div>\r\n              <div fxFlex=\"100\">\r\n                <span class=\"text color-60\">Correo Electrónico</span>\r\n                <p class=\"subtitle | color-74\"><b>{{ phoneOldRL }}</b></p>\r\n              </div>\r\n            </div>\r\n            <div class=\"form_space mt-4\" fxFlex=\"100\">\r\n              <p class=\"color-accent subtitle_info\">Datos personales</p>\r\n            </div>\r\n            <div class=\"mb-2\">\r\n              <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n            </div>\r\n            <div class=\"form_space\" fxFlex=\"100\">\r\n              <span class=\"form__text   | font-roboto\" translate\r\n                [ngClass]=\"{ 'form__text_alert': (required('name') && form2.get('name').touched) }\">Nombre*</span>\r\n              <input class=\"form__input  | font-roboto\"\r\n                [ngClass]=\"{ 'form__input_alert': (required('name') && form2.get('name').touched) }\" autocomplete=\"off\"\r\n                type=\"text\" name=\"name\" id=\"name\" formControlName=\"name\" required>\r\n              <div class=\"alertTransfer\" *ngIf=\"required('name') && form2.get('name').touched \">\r\n                <span class=\"alert__text | color-red\" translate> Por favor captura el nombre</span>\r\n              </div>\r\n            </div>\r\n            <div class=\"form_space\" fxFlex=\"50\">\r\n              <span class=\"form__text   | font-roboto\" translate\r\n                [ngClass]=\"{ 'form__text_alert': (required('lastName') && form2.get('lastName').touched) }\">Apellido\r\n                Paterno*</span>\r\n              <input class=\"form__input  | font-roboto\"\r\n                [ngClass]=\"{ 'form__input_alert': (required('lastName') && form2.get('lastName').touched) }\"\r\n                autocomplete=\"off\" type=\"text\" name=\"lastName\" id=\"lastName\" formControlName=\"lastName\" required>\r\n              <div class=\"alertTransfer\" *ngIf=\"required('lastName') && form2.get('lastName').touched \">\r\n                <span class=\"alert__text | color-red\" translate> Por favor captura el apellido paterno</span>\r\n              </div>\r\n            </div>\r\n            <div class=\"form_space\" fxFlex=\"50\">\r\n              <span class=\"form__text   | font-roboto\" translate\r\n                [ngClass]=\"{ 'form__text_alert': (required('secondName') && form2.get('secondName').touched) }\">Apellido\r\n                Materno*</span>\r\n              <input class=\"form__input  | font-roboto\"\r\n                [ngClass]=\"{ 'form__input_alert': (required('secondName') && form2.get('secondName').touched) }\"\r\n                autocomplete=\"off\" type=\"text\" name=\"secondName\" id=\"secondName\" formControlName=\"secondName\" required>\r\n              <div class=\"alertTransfer\" *ngIf=\"required('secondName') && form2.get('secondName').touched \">\r\n                <span class=\"alert__text | color-red\" translate> Por favor captura el apellido materno</span>\r\n              </div>\r\n            </div>\r\n            <div class=\"form_space \" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n              <div class=\"fecha\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <p class=\"form__date label_fecha pass | font-roboto\"\r\n                  [ngClass]=\"{ 'form__date_alert': ((form2.get('fechanacimiento').hasError('required') || form2.get('fechanacimiento').hasError('menorEdad')) && form2.get('fechanacimiento').touched) }\"\r\n                  translate>Fecha de Nacimiento*</p>\r\n                <mat-form-field class=\"valor campo_fecha disabled\"\r\n                  [ngClass]=\"{ 'mat-form-field_alert': ((form2.get('fechanacimiento').hasError('required') || form2.get('fechanacimiento').hasError('menorEdad')) && form2.get('fechanacimiento').touched) }\"\r\n                  id=\"fecha_nacimiento_block\" fxFlex=\"100\">\r\n                  <input matInput class=\"date\" [satDatepicker]=\"picker6\" id=\"fechanacimiento\" autocomplete=\"off\"\r\n                    name=\"fechanacimiento\" readonly [max]=\"datenow\" formControlName=\"fechanacimiento\" required>\r\n                  <sat-datepicker #picker6 [rangeMode]=\"false\" [selectFirstDateOnClose]=\"true\"\r\n                    [rangeHoverEffect]=\"false\">\r\n                  </sat-datepicker>\r\n                  <sat-datepicker-toggle matSuffix [for]=\"picker6\"\r\n                    [ngClass]=\"{'mat-datepicker-toggle-default-icon_alert': (form2.get('fechanacimiento').hasError('required') && form2.get('fechanacimiento').touched) }\">\r\n                  </sat-datepicker-toggle>\r\n                </mat-form-field>\r\n              </div>\r\n              <div class=\" alertTransfer fecha_const_alert\"\r\n                *ngIf=\"(form2.get('fechanacimiento').hasError('required') || form2.get('fechanacimiento