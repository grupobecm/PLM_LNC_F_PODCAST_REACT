let ReceivedTComponent = class ReceivedTComponent {
    constructor(dialog, serviceClient, storageClient) {
        this.dialog = dialog;
        this.serviceClient = serviceClient;
        this.storageClient = storageClient;
        this.displayedColumns = ['id', 'nombre_beneficiario', 'monto', 'fecha_creacion', 'button'];
        this.listLiquidate = [];
        this.showLoad = false;
        this.noData = false;
        this.numRegister = 0;
        this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
        this.idCenterC = this.dato.persona_cuenta_id;
        this.listTransferReceived();
        // this.showLoad = true;
    }
    listTransferReceived(size = 9999, id = this.idCenterC, beneficiario = null, clave_rastreo = null, date1 = null, date2 = null) {
