                this.flg = false;
            }
        }
        else {
            this.ocultar2();
        }
    }
    ocultar2() {
        document.getElementById("fondo2").style.display = 'none';
        document.getElementById("lista2").classList.remove("mostrar2");
        this.flg = true;
        if (this.banco == '\u00a0') {
            this.rojobanco = true;
            this.auxFlgBanco = 1;
        }
    }
    /* AQUI VA LA LOGICA PARA MOSTRAR FRECUENTES */
    actualizar(value, frecuent) {
        this.showLoad = true;
        //console.log(value, frecuent);
        this.frecuentes = value.nombre;
        this.showLoad = true;
        this.ServicesAxisAccountService.BanksAxisAccounts().subscribe((res) => {
            this.showLoad = false;
            for (let i = 0; i < res.length; i++) {
                const element = res[i].id;
                if (element == value.banco) {
                    //console.log(res[i].institucion);
                    this.idbanco = value.banco;
                    this.banco = res[i].institucion;
                    this.form.patchValue({
                        nombrebeneficiario: value.nombre,
                        cuentabeneficiario: value.cuenta,
                        email: value.email,
                        rfcurp: value.rfc_beneficiario,
                        monto: null,
                        conceptopago: null,
                        referencianumerica: null,
                        banco: value.banco
                    });
                    this.checked = frecuent;
                    document.getElementById("banco").style.cursor = "default";
                    document.getElementById("banco").style.background = "#FAFAFA";
                    document.getElementById("flecha").style.cursor = "default";
                    document.getElementById("flecha").style.borderTop = "8px solid #D9D9D9";
                    this.form.controls.nombrebeneficiario.disable();
                    this.form.controls.cuentabeneficiario.disable();
                    this.form.controls.rfcurp.disable();
                    this.form.controls.email.disable();
                    this.form.controls.banco.disable();
                    this.storage.setFrecuent(true);
                    if (frecuent) {
                        this.guardar = false;
                        // this.is_frecuent = true;
                    }
                    this.showLoad = false;
                }
            }
        }, error => {
            this.showLoad = false;
            //console.log(error);
        });
    }
    actualizar2(value) {
        this.banco = value.institucion;
        this.form.get('banco').setValue(value.id);
        this.idbanco = value.id;
        this.auxFlgBanco = 0;
        if (this.rojobanco) {
            this.rojobanco = false;
        }
    }
    cancelar() {
        this.form.reset();
        this.submitt = false;
        this.banco = '\u00a0';
        this.frecuentes = '\u00a0';
        sessionStorage.removeItem('polipay_third');
        sessionStorage.removeItem('data_frequent_contact');
        sessionStorage.removeItem('is_frecuent');
        this.form.patchValue({
            nombrebeneficiario: null,
            cuentabeneficiario: null,
            email: null,
            rfcurp: null,
            monto: null,
            conceptopago: null,
            referencianumerica: null,
            banco: null
        });
        this.guardar = true;
        this.auxFlgBanco = 0;
        this.rojobanco = false;
        if (document.getElementById("banco") != null && document.getElementById("flecha") != null) {
            document.getElementById("banco").style.cursor = "pointer";
            document.getElementById("banco").style.background = "#FFFFFF";
            document.getElementById("flecha").style.cursor = "pointer";
            document.getElementById("flecha").style.borderTop = "8px solid black";
        }
        if (document.getElementById("nombre") != null) {
            document.getElementById("nombre").removeAttribute('disabled');
        }
        if (document.getElementById("rfc") != null) {
            document.getElementById("rfc").removeAttribute('disabled');
        }
        if (document.getElementById("tarjeta") != null) {
            document.getElementById("tarjeta").removeAttribute('disabled');
        }
        if (document.getElementById("correo") != null) {
            document.getElementById("correo").removeAttribute('disabled');
        }
        this.form.get('alias').setValue(" ");
        this.form.get('rfcurp').setValue("");
        this.form.patchValue({ isFrecuent: false });
        this.form.get('banco').setValue("");
        this.checked = false;
        this.submitt = false;
    }
    filtrarFrecuentes() {
        this.copyCompany = [];
        for (let i = 0; i < this.company.length; i++) {
            if (this.company[i].alias.toLowerCase().includes(this.buscar.toLowerCase())) {
                this.copyCompany.push(this.company[i]);
            }
        }
        this.total = this.copyCompany.length;
    }
    BankList() {
        this.showLoad = true;
        this.ServicesAxisAccountService.BanksAxisAccounts().subscribe((res) => {
            this.showLoad = false;
            this.Bancos = res;
        }, error => {
            //console.log(error);
        });
    }
    keyPressNumbers(event) {
        var charCode = (event.which) ? event.which : event.keyCode;
        // Only Numbers 0-9
        if ((charCode < 48 || charCode > 57)) {
            event.preventDefault();
            return false;
        }
        else {
            return true;
        }
    }
    onPaste(event) {
        //console.log(event);
        let clipboardData = event.clipboardData;
        let pastedText = clipboardData.getData('text');
        //console.log(pastedText.length);
        //console.log(clipboardData);
        if (pastedText.length == 18) {
            //console.log('copiar', pastedText);
            this.autocomplete(pastedText);
        }
    }
    autocomplete(data) {
        // document.getElementById("fondo2").style.display = 'none';
        // document.getElementById("lista2").classList.remove("mostrar2");
        // this.flg = true;
        let accountP;
        if (data != '') {
            accountP = data;
            this.ServicesAxisAccountService.BanksAxisAccounts().subscribe((res) => {
                this.showLoad = false;
                var accounts = accountP.split("", 3);
                var accountsThird = accounts[0] + accounts[1] + accounts[2];
                for (let i = 0; i < res.length; i++) {
                    const element = res[i].clabe;
                    if (element == accountsThird) {
                        this.idbanco = res[i].id;
                        this.banco = res[i].institucion;
                        this.form.patchValue({
                            banco: res[i].institucion
                        });
                        this.form.controls.banco.disable();
                        document.getElementById("banco").style.cursor = "default";
                        document.getElementById("banco").style.background = "#FAFAFA";
                        document.getElementById("flecha").style.cursor = "default";
                        document.getElementById("flecha").style.borderTop = "8px solid #D9D9D9";
                        // this.flg = false;
                        // this.guardar = true;
                        break;
                    }
                }
            }, error => {
                this.showLoad = false;
                //console.log(error);
            });
        }
        else {
            accountP = this.form.get("cuentabeneficiario").value;
        }
    }
    referenceZero() {
        let reference;
        reference = this.form.get('referencianumerica').value;
        if (reference.length == 7) {
            for (let i = 0; i < reference[i].length; i++) {
                if (reference[0] == 0) {
                    this.flgZero = true;
                }
                else {
                    this.flgZero = false;
                }
            }
        }
    }
};
