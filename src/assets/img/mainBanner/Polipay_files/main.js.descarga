let ListDispersionPendingComponent = class ListDispersionPendingComponent {
    constructor(dialog, router, serviceClient, storageClient, storage) {
        this.dialog = dialog;
        this.router = router;
        this.serviceClient = serviceClient;
        this.storageClient = storageClient;
        this.storage = storage;
        this.displayedColumns = ['masivo_trans__observations', 'masivo_trans__date_liberation', 'nombre_emisor', 'button'];
        this.listProcessed = [];
        this.showLoad = false;
        this.noData = false;
        this.numRegister = 0;
        if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length >= 3) {
            //console.log('tp y t');
            //this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
            ////console.log(this.id);
            if (this.storageClient.InfoCostCenterExist == false) {
                //console.log("bye");
                this.dataService = JSON.parse(this.storage.infoUserValue);
                //Aqui va dialog para crear centros de costos
            }
            else {
                //console.log('si hay centros de costos');
                this.dataService = JSON.parse(this.storageClient.InfoCostCenterValue);
                this.id = this.dataService.persona_cuenta_id;
                this.ListAllMasiveDispersions();
            }
        }
        else {
            if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    //console.log('tp');
                    this.dataService = JSON.parse(this.storage.infoUserValue);
                    this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
                    //console.log(this.id);
                    this.ListAllMasiveDispersions();
                }
                else {
                    if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        //console.log('t');
                        //console.log(this.storageClient.InfoCostCenterExist);
                        if (this.storageClient.InfoCostCenterExist == false) {
                            //console.log("bye");
                            this.dataService = JSON.parse(this.storage.infoUserValue);
                        }
                        else {
                            //console.log("si hay servicios ");
                            this.dataService = JSON.parse(this.storageClient.InfoCostCenterValue);
                            this.id = this.dataService.persona_cuenta_id;
                            //console.log(this.dataService)
                            //console.log(this.dataService.persona_cuenta_id);
                            this.ListAllMasiveDispersions();
                        }
                    }
                }
            }
        }
        // this.ListAllMasiveDispersions();
    }
    ListAllMasiveDispersions(observations = null, date1 = null, date2 = null) {
        this.showLoad = true;
        this.serviceClient.ListMassiveDispersions(9999, 2, observations, date1, date2, this.id).subscribe(res => {
            this.listProcessed = new _angular_material_table__WEBPACK_IMPORTED_MODULE_9__["MatTableDataSource"](res.results);
            this.showLoad = false;
            //console.log(res)
            this.listProcessed.sort = this.sort;
            this.listProcessed.paginator = this.paginator;
            this.paginator._intl.itemsPerPageLabel = 'Filas por página';
            this.listProcessed.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listProcessed.data.length;
        }, error => {
            this.numRegister = 0;
            this.noData = true;
            this.showLoad = false;
        });
    }
    openFilter() {
        let filtro = this.dialog.open(_filtro_massives_dispersions_filtro_massives_dispersions_component__WEBPACK_IMPORTED_MODULE_15__["FiltroMassivesDispersionsComponent"], {
            width: "90%",
            panelClass: "custom-dialog-container"
        });
        filtro.afterClosed().subscribe(res => {
            let obser = null;
            let date1 = null;
            let date2 = null;
            //console.log(res);
            if (res == undefined) {
            }
            else {
                if (res != 'Reset filtro') {
                    for (let i = 0; i < res.data.filtro.length; i++) {
                        switch (res.data.filtro[i].campo) {
                            case 'Fecha de Dispersión':
                                date1 = (res.data.filtro[i].valor.begin).toISOString().split("T")[0] + " 00:00:00";
                                date2 = (res.data.filtro[i].valor.end).toISOString().split("T")[0] + " 23:59:59";
                                break;
                            case 'Observaciones':
                                obser = res.data.filtro[i].valor;
                                break;
                        }
                    }
                }
            }
            this.ListAllMasiveDispersions(obser, date1, date2);
        });
    }
    seedetailsIndividual(data) {
        //console.log(data)
        this.storageClient.setDispertionData(data);
        this.router.navigate(['usuario/dispersiones/estado-dispersion/individual-pending']);
    }
    cancelDispersion(data) {
        //console.log(data);
        let question = this.dialog.open(src_app_Views_user_messageUser_questions_user_questions_user_component__WEBPACK_IMPORTED_MODULE_14__["QuestionsUserComponent"], {
            width: '550px',
            data: {
                question: 'CD-002',
                id: data.id,
                idCC: this.id
            },
            disableClose: true
        });
        question.afterClosed().subscribe(res => {
            this.ListAllMasiveDispersions();
            this.dialog.closeAll();
        });
    }
    ngOnInit() {
    }
};
