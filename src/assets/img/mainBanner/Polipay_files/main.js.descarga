            let date2 = null;
            let trackingKey = null;
            let id = null;
            //console.log(res);
            if (res == undefined) {
            }
            else {
                if (res != 'Reset filtro') {
                    for (let i = 0; i < res.data.filtro.length; i++) {
                        switch (res.data.filtro[i].campo) {
                            case 'Beneficiario':
                                benefi = res.data.filtro[i].valor;
                                break;
                            case 'Fecha de Operación':
                                date1 = res.data.filtro[i].valor.begin.toISOString().split("T")[0];
                                date2 = res.data.filtro[i].valor.end.toISOString().split("T")[0];
                                break;
                            case 'Clave de Rastreo':
                                trackingKey = res.data.filtro[i].valor;
                                break;
                            case 'Folio':
                                id = res.data.filtro[i].valor;
                                break;
                        }
                    }
                    //console.log(id);
                    this.listPersonal(9999, id, 1, benefi, date1, date2, trackingKey);
                }
            }
        });
