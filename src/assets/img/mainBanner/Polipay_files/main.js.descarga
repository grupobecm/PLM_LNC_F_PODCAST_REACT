let PermissionDirective = class PermissionDirective {
    constructor(templateRef, viewContainer, storage) {
        this.templateRef = templateRef;
        this.viewContainer = viewContainer;
        this.storage = storage;
        this.permissionUser = JSON.parse(this.storage.infoUserValue).permisos;
        this.idUser = JSON.parse(this.storage.infoUserValue).id;
    }
    /* ngOnInit(): void {
      
    } */
    /**Funcion */
    set appPermission(val) {
        this.viewContainer.createEmbeddedView(this.templateRef);
        this.permission = val;
        this.updateView();
    }
    /**Actualizacion en Vista */
    updateView() {
        this.viewContainer.clear(); //Limpiar DOM <app-container></app-container>
        if (this.checkPermission()) {
            this.viewContainer.createEmbeddedView(this.templateRef);
        }
    }
    /**Acciones de Permisos */
    checkPermission() {
        let hasPermission = false;
        if (this.idUser && this.permissionUser) {
            for (const checkPermission of this.permission) {
                const permissionFound = this.permissionUser.find((permi) => {
                    return (Number(permi.id) === Number(checkPermission));
                });
                if (permissionFound) {
                    hasPermission = true;
                    break;
                }
            }
        }
        return hasPermission;
    }
};
PermissionDirective.ctorParameters = () => [
    { type: _angular_core__WEBPACK_IMPORTED_MODULE_1__["TemplateRef"] },
