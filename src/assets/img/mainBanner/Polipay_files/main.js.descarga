                }
            }
            else {
                if (auxAssing.includes(true) || auxAssingCards.includes(true)) {
                    this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_16__["ErrorUserComponent"], {
                        data: {
                            error: 'S-002',
                            message: card
                        },
                        disableClose: true
                    });
                }
                this.form.reset();
            }
