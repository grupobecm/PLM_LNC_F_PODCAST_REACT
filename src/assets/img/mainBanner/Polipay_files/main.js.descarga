;\r\n}\r\n\r\n/*form date*/\r\n\r\n.form_space {\r\n    position: relative;\r\n    top: 0;\r\n}\r\n\r\n.fecha {\r\n    position: relative;\r\n}\r\n\r\n.label_fecha {\r\n    position: absolute !important;\r\n    top: 16px !important;\r\n    left: -20px;\r\n    z-index: 10;\r\n    position: relative;\r\n    font-size: 12px;\r\n    line-height: 1.33;\r\n    letter-spacing: 0.4px;\r\n    text-align: left;\r\n    color: var(--opacity-60);\r\n    margin-left: 34.5px;\r\n    background: var(--white);\r\n    padding: 0px 5px;\r\n}\r\n\r\n.campo_fecha {\r\n    margin: 0;\r\n    bottom: 0;\r\n}\r\n\r\n.fecha_const_alert {\r\n    position: absolute;\r\n    top: 25px;\r\n    color: var(--red);\r\n    left: -20px;\r\n}\r\n\r\n.form__date_alert {\r\n    color: var(--red);\r\n    background: var(--white);\r\n}\r\n\r\n.mat-form-field_alert {\r\n    border: solid 1px var(--red) !important;\r\n    color: var(--red) !important;\r\n}\r\n\r\n.margen-alert {\r\n    top: 20px;\r\n}\r\n\r\n.alert-margin {\r\n    top: 0 !important;\r\n}\r\n\r\n/* Estilos para el datepicker */\r\n\r\n.mat-form-field-label-wrapper {\r\n    position: absolute !important;\r\n    left: 0 !important;\r\n    box-sizing: content-box !important;\r\n    width: 100% !important;\r\n    height: 100% !important;\r\n    overflow: hidden !important;\r\n    pointer-events: none !important;\r\n    top: -16px !important;\r\n}\r\n\r\n.mat-form-field {\r\n    width: 100% !important;\r\n    height: 56px !important;\r\n    font-size: 16px !important;\r\n    line-height: 1.5 !important;\r\n    letter-spacing: 0.15px !important;\r\n    text-align: left !important;\r\n    outline: none !important;\r\n    border-radius: 4px !important;\r\n    border: solid 1px var(--opacity-12);\r\n    color: var(--opacity-74);\r\n    cursor: pointer !important;\r\n    top: 9px !important;\r\n    padding: 8px 5px 0px 5px;\r\n}\r\n\r\n.mat-form-field-appearance-fill .mat-form-field-flex {\r\n    background: var(--grey-ligth9) !important;\r\n}\r\n\r\n.