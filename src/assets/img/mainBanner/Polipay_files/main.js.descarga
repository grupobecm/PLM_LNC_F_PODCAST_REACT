                <span class=\"texto__select\" fxFlex=\"95\">No se encontrarón direcciones</span>\r\n                                </li>\r\n\r\n                                <li *ngFor=\"let col of colonias\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\" (click)=\"actualizarColonia1(col)\">\r\n                                    <span class=\"texto__select\" fxFlex=\"95\">{{col}}</span>\r\n                                </li>\r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"alertTransfer\" *ngIf=\"requeridoColoniaSelect1()\">\r\n                        <span class=\"alert__text | color-red\">Por favor ingresa la Colonia</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space  form--password-mt\" fxFlex=\"30\" *ngIf=\"flagColonia1\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('colonia') && form.get('colonia').touched) }\" translate>Colonia*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('colonia') && form.get('colonia').touched) }\" autocomplete=\"off\" type=\"text\" name=\"colonia\" id=\"colonia\" formControlName=\"colonia\" required>\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('colonia') && form.get('colonia').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura la colonia</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space form--password-mt\" fxFlex=\"30\">\r\n                    <span class=\"form__text  pass | \" [ngClass]=\"{ 'form__text_alert': (requerido('alcaldia_mpio') && form.get('alcaldia_mpio').touched) }\" translate>Municipio/Alcaldía*</span>\r\n                    <input class=\"form__input password | \" [ngClass]=\"