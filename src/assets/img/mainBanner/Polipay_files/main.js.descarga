ck;\r\n    width: 80%;\r\n    -o-object-fit: cover;\r\n       object-fit: cover;\r\n    -o-object-position: 0px 0px;\r\n       object-position: 0px 0px;\r\n    min-height: auto;\r\n}\r\n\r\n/**/\r\n\r\n.squart__content {\r\n    box-shadow: 0 1px 8px 0 rgba(0, 0, 0, 0.16);\r\n    background-color: #fff;\r\n    padding: 3rem;\r\n    border-radius: 8px;\r\n}\r\n\r\n.squart__content2 {\r\n    box-shadow: 0 1px 8px 0 rgba(0, 0, 0, 0.16);\r\n    background-color: #081f64;\r\n    padding: 3rem;\r\n    border-radius: 8px;\r\n}\r\n\r\n@media (min-width: 0px) and (max-width: 565px) {\r\n    .squart__content {\r\n        box-shadow: 0 1px 8px 0 rgb(0 0 0 / 16%);\r\n        background-color: #fff;\r\n        padding: 4.1rem 3.1rem;\r\n        border-radius: 20px;\r\n        position: absolute;\r\n        top: -15%;\r\n    }\r\n    .squart__content2 {\r\n        box-shadow: 0 1px 8px 0 rgba(0, 0, 0, 0.16);\r\n        background-color: #081f64;\r\n        padding: 4.8rem 3rem;\r\n        border-radius: 20px;\r\n        position: absolute;\r\n        top: -16%;\r\n    }\r\n    .padding-cont1 {\r\n        padding: 0;\r\n        height: 45vh;\r\n        width: 100vw;\r\n    }\r\n    .conten-primary {\r\n        height: 100vh;\r\n        padding-bottom: 0;\r\n        background-color: var(--accent-color);\r\n    }\r\n    .padding-cont-movil {\r\n        /* padding: 7rem 5rem 0rem 5rem */\r\n        height: 55vh;\r\n        width: 100vw;\r\n    }\r\n    .content__photo2 {\r\n        width: 100%;\r\n        position: relative;\r\n    }\r\n    .imagen__photo2 {\r\n        display: block;\r\n        width: 80%;\r\n        -o-object-fit: cover;\r\n           object-fit: cover;\r\n        -o-object-position: 0px 0px;\r\n           object-position: 0px 0px;\r\n        min-height: auto;\r\n    }\r\n    .logo-poli2 {\r\n        position: absolute;\r\n        top: 3%;\r\n        left: 7%;\r\n        padding: 0;\r\n    }\r\n}\r\n\r\n@media (min-width: 566px) and (max-width: 768px) {\r\n    .squ