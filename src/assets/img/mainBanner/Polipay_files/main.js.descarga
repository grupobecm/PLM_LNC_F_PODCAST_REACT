            data: {
                questoion: "PP-001"
            },
            disableClose: true,
        });
    }
    editar(ismoral) {
        var data = {
            moral: ismoral,
            dato: this.personaFisica,
            id: this.id
        };
        sessionStorage.setItem("editCliExt", JSON.stringify(data));
        // this.openDialog();
        this.router.navigate(['/usuario/administration/clientsuser/physical-client/editclient']);
