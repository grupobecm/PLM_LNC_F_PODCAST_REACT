// LOGICA PARA INACTIVIDAD
let message;
let _logout;
function inactivity(dialog, router, service, storage) {
    window.onload = () => contadorInactividad(dialog, router, service, storage);
    document.onclick = () => contadorInactividad(dialog, router, service, storage);
    document.onscroll = () => contadorInactividad(dialog, router, service, storage);
    document.onkeypress = () => contadorInactividad(dialog, router, service, storage);
}
function contadorInactividad(dialog, router, service, storage) {
    document.onmousemove = null;
    clearTimeout(message);
    clearTimeout(_logout);
    message = setTimeout(() => {
        mensaje(dialog, router, service, storage);
    }, 300 * 1000); // 300 segundos == 5 minutos
}
function mensaje(dialog, router, service, storage) {
    clearTimeout(_logout);
    switch (router.url) {
        case "/":
        case "/codigo":
        case "/recuperar":
        case "/confirmacion":
        case "/nueva-contrasena":
        case "/contrasena-cambiada":
        case "/primera-contrasena":
        case "/pass-guardado":
        case "/token":
        case "/resolucion":
        case "/token-guardado":
        case "/investment":
        case "/check-balance":
        case "/404":
            break;
        default:
            document.onkeypress = null;
            document.onclick = null;
            document.onscroll = null;
            dialog.closeAll();
            let mensaje = dialog.open(_Views_general_messages_general_messages_component__WEBPACK_IMPORTED_MODULE_7__["GeneralMessagesComponent"], {
                data: {
                    success: 0,
                },
            });
            mensaje.afterClosed().subscribe(() => {
                document.onkeypress = () => contadorInactividad(dialog, router, service, storage);
                document.onclick = () => contadorInactividad(dialog, router, service, storage);
                document.onscroll = () => contadorInactividad(dialog, router, service, storage);
                document.onmousemove = () => contadorInactividad(dialog, router, service, storage);
                clearTimeout(_logout);
            });
            clearTimeout(_logout);
            _logout = setTimeout(() => logout(dialog, router, service, storage), 15 * 1000);
            break;
    }
}
// LOGICA PARA SALIDA LOGOUT
function logout(dialog, router, service, storage) {
    dialog.closeAll();
    service.logout({ email: storage.emailValue }).subscribe((res) => {
        sessionStorage.removeItem("session");
        sessionStorage.removeItem("rol");
        sessionStorage.removeItem("data_user");
        sessionStorage.removeItem("email");
        sessionStorage.removeItem("id");
        //router.navigate(['/']);
        location.reload();
    }, (error) => {
    });
}
// SESION CADUCA POR CERRAR SESION DE UN LADO
function caducar(storage, dialog, router) {
    let sesionViva = setInterval(() => {
        if (!storage.IdUserValue && router.url != "/") {
            clearInterval(sesionViva);
            switch (router.url) {
                case "/":
                case "/codigo":
                case "/recuperar":
                case "/confirmacion":
                case "/nueva-contrasena":
                case "/contrasena-cambiada":
                case "/primera-contrasena":
                case "/pass-guardado":
                case "/token":
                case "/resolucion":
                case "/token-guardado":
                case "/investment":
                case "/check-balance":
                case "/404":
                    break;
                default:
                    dialog.closeAll();
                    let mensaje = dialog.open(_Views_general_messages_general_messages_component__WEBPACK_IMPORTED_MODULE_7__["GeneralMessagesComponent"], {
                        data: {
                            success: 1,
                        },
                    });
                    mensaje.afterClosed().subscribe(() => {
                        sessionStorage.removeItem("session");
                        sessionStorage.removeItem("rol");
                        sessionStorage.removeItem("data_user");
                        sessionStorage.removeItem("email");
                        sessionStorage.removeItem("id");
                        //router.navigate(['/']);
                        location.reload();
                    });
                    break;
            }
        }
    }, 3000);
}
