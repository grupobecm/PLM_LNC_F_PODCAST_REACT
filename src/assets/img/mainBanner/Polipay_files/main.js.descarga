on: absolute;\r\n    width: 170px;\r\n    height: 40px;\r\n    border-radius: 6px;\r\n    background-color: var(--opacity-74);\r\n    display: flex;\r\n    justify-content: center;\r\n    align-items: center;\r\n    visibility: hidden;\r\n    opacity: 1;\r\n    transition: 0.2s;\r\n    margin-top: 0px;\r\n}\r\n\r\n.cont-2 {\r\n    position: absolute !important;\r\n    top: 40px !important;\r\n    font-size: 10px !important;\r\n    padding: 5px !important;\r\n    border-radius: 5px !important;\r\n    background: var(--opacity-74) !important;\r\n    opacity: 0 !important;\r\n    visibility: hidden !important;\r\n    transition: 0.2s !important;\r\n}\r\n\r\n.label__copy {\r\n    text-align: center;\r\n    font-size: 12px;\r\n    line-height: 1.67;\r\n    letter-spacing: -0.3px;\r\n    margin: 0;\r\n}\r\n\r\n.ocultar {\r\n    visibility: hidden;\r\n    opacity: 0;\r\n}\r\n\r\n.mostrar {\r\n    visibility: visible;\r\n    opacity: 1;\r\n}\r\n\r\n.container-icon:hover .label-container {\r\n    visibility: visible;\r\n    opacity: 1;\r\n}\r\n\r\n@media (min-width: 1024px) and (max-width: 1160px) {\r\n    .txt {\r\n        font-size: 12px;\r\n    }\r\n}\r\n/*# sourceMappingURL=data:application/json;base64, */");

