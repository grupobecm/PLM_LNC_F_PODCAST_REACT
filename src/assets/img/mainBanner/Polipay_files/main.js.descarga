/* harmony default export */ __webpack_exports__["default"] = ("<app-menu-administration-u fxFlex=\"16.66\"> </app-menu-administration-u>\r\n\r\n<div class=\"dashboard-admin\" fxFlex=\"83.33\" fxLayout=\"row wrap\" fxLayoutAlign=\"center start\">\r\n\r\n  <div class=\"regresar\" fxFlex=\"100\" fxLayoutAlign=\"space-between start\">\r\n    <div fxLayout=\"row wrap\" fxFlex=\"80\">\r\n      <h4 class=\"cliente-externo margin-top | color-main\" fxFlex=\"100\">Devolución de Documentos\r\n      </h4>\r\n    </div>\r\n\r\n    <button class=\"regresar__button | color-third\"\r\n      [routerLink]=\"['/usuario/administration/costcenteruser/listcostcenter']\" routerLinkActive=\"active\">\r\n      Regresar\r\n    </button>\r\n  </div>\r\n  <div class=\"mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n    <nav class=\"nav-barA | background-grey-dark\" fxFlex=\"100\" fxLayoutAlign=\"space-between center\">\r\n      <ul class=\"navbar__menuA\" fxFlex=\"100\" fxLayoutAlign=\"center center\">\r\n        <li fxFlex=\"100\" class=\"navbar__itemsA\" [ngClass]=\"{'active': paso1}\" fxLayout=\"row\"\r\n          fxLayoutAlign=\"center center\" routerLinkActive=\"active\" (click)=\"alPaso1()\">\r\n          <a class=\"navbar__textA | \">Resultado de la verificación</a>\r\n        </li>\r\n        <li fxFlex=\"100\" class=\"navbar__itemsA\" [ngClass]=\"{'active': paso2}\" fxLayout=\"row\"\r\n          fxLayoutAlign=\"center center\" routerLinkActive=\"active\" (click)=\"alPaso2()\">\r\n          <a class=\"navbar__textA | \">Información del Centro de Costo</a>\r\n        </li>\r\n        <li fxFlex=\"100\" class=\"navbar__itemsA\" [ngClass]=\"{'active': paso3}\" fxLayout=\"row\"\r\n          fxLayoutAlign=\"center center\" routerLinkActive=\"active\" (click)=\"alPaso3()\">\r\n          <a class=\"navbar__textA | \">Información del Representante Legal</a>\r\n        </li>\r\n      </ul>\r\n    </nav>\r\n  </div>\r\n  <div  fxFlex=\"100\" novalidate class=\"contenedor \" fxLayout=\"row wrap\">\r\n    <div *ngIf=\"paso1\" class=\"mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between start\">\r\n      <div fxFlex=\"48\" class=\"mr-3\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between stretch\">\r\n        <div fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"none stretch\">\r\n          <div class=\"mt-4\" fxFlex=\"100\">\r\n            <div class=\"tabla__una\" fxFlex=\"100\">\r\n              <table class=\"tabla tabla-ordenes-enviadas | background-white\">\r\n                <thead>\r\n                  <tr class=\"tr | color-main\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                    <th class=\"th  th--align  | color-accent\" fxFlex=\"100\">Resultado de verificación de documentos</th>\r\n                  </tr>\r\n                </thead>\r\n                <tbody class=\"tablas__tbody\">\r\n                  <tr class=\"tr th th--ml | color-third\" fxLayout=\"column\" fxLayoutAlign=\"none start\">\r\n                    <p class=\"th text\">El Centro de costos <span class=\"color-red bold text\">no puede ser\r\n                        activado</span> hasta que los documentos devueltos sean correctos.\r\n                    </p>\r\n                    <div class=\"mb-2 mt-2\" fxFlex=\"100\">\r\n                      <p class=\"th text\">\r\n                        A continuación verás un resumen de tus documentos. <br>\r\n                      </p>\r\n\r\n                    </div>\r\n                    <div class=\"mb-2 mt-2\" fxFlex=\"100\">\r\n                      <p class=\"th text\">\r\n                        Para ir a la corrección da clic en el botón continuar.\r\n                      </p>\r\n                    </div>\r\n                  </tr>\r\n                </tbody>\r\n              </table>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"none stretch\">\r\n          <div class=\"mt-4\" fxFlex=\"100\">\r\n            <div class=\"tabla__una\" fxFlex=\"100\">\r\n              <table class=\"tabla tabla-ordenes-enviadas | background-white\" *ngIf=\"documentosRepLeg\">\r\n                <thead>\r\n                  <tr class=\"tr | color-main\" fxLayout=\"row\" fxLayoutAlign=\"start center\">\r\n                    <th class=\"th th--ml th--align  | color-accent\" fxFlex=\"100\">Documentos Representante Legal</th>\r\n                  </tr>\r\n                </thead>\r\n                <tbody class=\"tablas__tbody\" *ngFor=\"let dr of documentosRepLeg\">\r\n                  <tr class=\"tr | color-third\" fxLayout=\"row wrap\" fxLayoutAlign=\"none center\">\r\n                    <td class=\"th th--ml  th--content | color-third bold\" fxFlex=\"50\">{{dr.doc_name}}\r\n                    </td>\r\n                    <td class=\"th th--align-right th--content| color-third\" fxFlex=\"15\">Estado: </td>\r\n                    <td class=\"th th--align th--content | status--correct bold\" fxFlex=\"15\" *ngIf=\"dr.doc_sta=='C'\">\r\n                      CORRECTO</td>\r\n                    <td class=\"th th--align th--content | status--fail bold\" fxFlex=\"15\" *ngIf=\"dr.doc_sta=='D'\">\r\n                      DEVUELTO\r\n                    </td>\r\n                    <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\" *ngIf=\"dr.doc_sta=='D'\">Motivo de la\r\n                      devolución: <p>{{dr.doc_comm}}</p>\r\n                    </td>\r\n                  </tr>\r\n                </tbody>\r\n              </table>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div fxFlex=\"48\" class=\"mr-3\" fxLayout=\"row wrap\" fxLayoutAlign=\"none stretch\">\r\n        <div class=\"mt-4\" fxFlex=\"100\">\r\n          <div class=\"tabla__una\" fxFlex=\"100\">\r\n            <table class=\"tabla tabla-ordenes-enviadas | background-white\" *ngIf=\"documentosCenCost\">\r\n              <thead>\r\n                <tr class=\"tr | color-main\" fxLayout=\"row\" fxLayoutAlign=\"start center\">\r\n                  <th class=\"th th--ml th--align  | color-accent\" fxFlex=\"100\">Documentos Centro de Costo</th>\r\n                </tr>\r\n              </thead>\r\n              <tbody class=\"tablas__tbody\" *ngFor=\"let dc of documentosCenCost\">\r\n                <tr class=\"tr | color-third\" fxLayout=\"row wrap\" fxLayoutAlign=\"none center\">\r\n                  <td class=\"th th--ml  th--content | color-third bold\" fxFlex=\"50\">{{dc.doc_name}}\r\n                  </td>\r\n                  <td class=\"th th--align-right th--content| color-third\" fxFlex=\"15\">Estado: </td>\r\n                  <td class=\"th th--align th--content | status--correct bold\" fxFlex=\"15\" *ngIf=\"dc.doc_sta=='C'\">\r\n                    CORRECTO</td>\r\n                  <td class=\"th th--align th--content | status--fail bold\" fxFlex=\"15\" *ngIf=\"dc.doc_sta=='D'\">DEVUELTO\r\n                  </td>\r\n                  <td class=\"th th--ml  th--content | color-third\" fxFlex=\"100\" *ngIf=\"dc.doc_sta=='D'\">Motivo de la\r\n                    devolución: <p>{{dc.doc_comm}}</p>\r\n                  </td>\r\n                </tr>\r\n              </tbody>\r\n            </table>\r\n          </div>\r\n        </div>\r\n      </div>\r\n\r\n      <div class=\"contenedor-boton\" fxFlex=\"98\" fxLayoutAlign=\"end center\">\r\n        <div fxLayoutAlign=\"end center\">\r\n          <button class=\"confirmar__button | color-white\" (click)=\"alPaso2()\"><b>Continuar</b></button>\r\n        </div>\r\n      </div>\r\n    </div>\r\n\r\n    <form [formGroup]=\"form1\" *ngIf=\"paso2\" class=\"mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between stretch\">\r\n      <span class=\"note\" fxFlex=\"100\">Por favor revisa tus documentos y la información que capturaste para\r\n        {{nameType}}. Si es necesario corrige los datos capturados y/o carga\r\n        los documentos que se solicitan. </span>\r\n      <div class=\"mt-4\" fxFlex=\"30\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n        <div class=\"mb-2\">\r\n          <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n        </div>\r\n        <div class=\"form_space\" fxFlex=\"100\">\r\n          <span class=\"form__text  | font-roboto\" translate\r\n            [ngClass]=\"{ 'form__text_alert': (requerido('RazonSocial','form1') && form1.get('RazonSocial').touched) }\">Razón\r\n            Social*</span>\r\n          <input class=\"form__input | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"RazonSocial\" id=\"RazonSocial\"\r\n            [ngClass]=\"{ 'form__input_alert': (requerido('RazonSocial','form1') && form1.get('RazonSocial').touched) }\"\r\n            formControlName=\"RazonSocial\" required>\r\n          <div class=\" alertTransfer\" *ngIf=\"requerido('RazonSocial','form1') && form1.get('RazonSocial').touched \">\r\n            <span class=\"alert__text | color-red\" translate> Por favor captura nombre del centro de costo</span>\r\n          </div>\r\n        </div>\r\n\r\n        <div fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n          <div class=\"form_space\" fxFlex=\"100\">\r\n            <span class=\"form__text  | font-roboto\" translate\r\n              [ngClass]=\"{ 'form__text_alert': (requerido('rfc','form1') && form1.get('rfc').touched) }\">R.F.C. del Centro de\r\n              Costo*</span>\r\n            <input class=\"form__input | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"rfc\" id=\"rfc\"\r\n              formControlName=\"rfc\" [ngClass]=\"{ 'form__input_alert': (requerido('rfc','form1') && form1.get('rfc').touched) }\"\r\n              required>\r\n            <div class=\" alertTransfer\" *ngIf=\"requerido('rfc','form1') && form1.get('rfc').touched \">\r\n              <span class=\"alert__text | color-red\" translate> Por favor captura rfc</span>\r\n            </div>\r\n          </div>\r\n          <div class=\"mt-4\" fxFlex=\"100\">\r\n            <h4 class=\"cliente-externo margin-top | color-accent\" fxFlex=\"100\">Domicilio Fiscal\r\n            </h4>\r\n          </div>\r\n          <div class=\"form_space\" fxFlex=\"40\">\r\n            <span class=\"form__text   | font-roboto\" translate\r\n              [ngClass]=\"{ 'form__text_alert': (requerido('CodigoPostal','form1') && form1.get('CodigoPostal').touched) }\">Codigo\r\n              Postal*</span>\r\n            <input class=\"form__input  | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"CodigoPostal\"\r\n              id=\"CodigoPostal\" formControlName=\"CodigoPostal\"\r\n              [ngClass]=\"{ 'form__input_alert': (requerido('CodigoPostal','form1') && form1.get('CodigoPostal').touched) }\"\r\n              required>\r\n            <div class=\"alertTransfer\" *ngIf=\"requerido('CodigoPostal','form1') && form1.get('CodigoPostal').touched \">\r\n              <span class=\"alert__text | color-red\" translate> Por favor captura el codigo</span>\r\n            </div>\r\n          </div>\r\n          <div class=\"form_space\" fxFlex=\"60\">\r\n            <span class=\"form__text   | font-roboto\" translate\r\n              [ngClass]=\"{ 'form__text_alert': (requerido('Estado','form1') && form1.get('Estado').touched) }\">Estado*</span>\r\n            <input class=\"form__input  | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"Estado\" id=\"Estado\"\r\n              formControlName=\"Estado\"\r\n              [ngClass]=\"{ 'form__input_alert': (requerido('Estado','form1') && form1.get('Estado').touched) }\" required>\r\n            <div class=\"alertTransfer\" *ngIf=\"requerido('Estado','form1') && form1.get('Estado').touched \">\r\n              <span class=\"alert__text | color-red\" translate> Por favor captura el estado</span>\r\n            </div>\r\n          </div>\r\n          <div class=\"form_space\" fxFlex=\"100\">\r\n            <span class=\"form__text   | font-roboto\" translate\r\n              [ngClass]=\"{ 'form__text_alert': (requerido('Municipio','form1') && form1.get('Municipio').touched) }\">Alcaldia/Municipio*</span>\r\n            <input class=\"form__input  | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"Municipio\" id=\"Municipio\"\r\n              formControlName=\"Municipio\"\r\n              [ngClass]=\"{ 'form__input_alert': (requerido('Municipio','form1') && form1.get('Municipio').touched) }\" required>\r\n            <div class=\"alertTransfer\" *ngIf=\"requerido('Municipio','form1') && form1.get('Municipio').touched \">\r\n              <span class=\"alert__text | color-red\" translate> Por favor captura el alcadia o municipio</span>\r\n            </div>\r\n          </div>\r\n          <div class=\"form_space\" fxFlex=\"100\">\r\n            <span class=\"form__text   | font-roboto\" translate\r\n              [ngClass]=\"{ 'form__text_alert': (requerido('Colonia','form1') && form1.get('Colonia').touched) }\">Colonia*</span>\r\n            <input class=\"form__input  | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"Colonia\" id=\"Colonia\"\r\n              formControlName=\"Colonia\"\r\n              [ngClass]=\"{ 'form__input_alert': (requerido('Colonia','form1') && form1.get('Colonia').touched) }\" required>\r\n            <div class=\"alertTransfer\" *ngIf=\"requerido('Colonia','form1') && form1.get('Colonia').touched \">\r\n              <span class=\"alert__text | color-red\" translate> Por favor captura la colonia</span>\r\n            </div>\r\n          </div>\r\n          <div class=\"form_space\" fxFlex=\"100\">\r\n            <span class=\"form__text   | font-roboto\" translate\r\n              [ngClass]=\"{ 'form__text_alert': (requerido('Calle','form1') && form1.get('Calle').touched) }\">Calle*</span>\r\n            <input class=\"form__input  | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"Calle\" id=\"Calle\"\r\n              formControlName=\"Calle\"\r\n              [ngClass]=\"{ 'form__input_alert': (requerido('Calle','form1') && form1.get('Calle').touched) }\" required>\r\n            <div class=\"alertTransfer\" *ngIf=\"requerido('Calle','form1') && form1.get('Calle').touched \">\r\n              <span class=\"alert__text | color-red\" translate> Por favor captura la calle</span>\r\n            </div>\r\n          </div>\r\n        </div>\r\n       <!-- <div class=\"mt-4\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\" *ngIf=\"mosDom==true\">\r\n          <div class=\"mt-4\" fxFlex=\"100\">\r\n            <h4 class=\"cliente-externo margin-top | color-accent\" fxFlex=\"100\">Cuenta de Traspaso Final\r\n            </h4>\r\n          </div>\r\n          <div class=\"form_space\" fxFlex=\"100\">\r\n            <span class=\"form__text  | font-roboto\" translate\r\n              [ngClass]=\"{ 'form__text_alert': (requerido('ClaveTraspaso','form1') && form1.get('ClaveTraspaso').touched) }\">Clave\r\n              Traspaso</span>\r\n            <input class=\"form__input | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"ClaveTraspaso\"\r\n              id=\"ClaveTraspaso\" formControlName=\"ClaveTraspaso\"\r\n              [ngClass]=\"{ 'form__input_alert': (requerido('ClaveTraspaso','form1') && form1.get('ClaveTraspaso').touched) }\"\r\n              required>\r\n            <div class=\" alertTransfer\" *ngIf=\"requerido('ClaveTraspaso','form1') && form1.get('ClaveTraspaso').touched \">\r\n              <span class=\"alert__text | color-red\" translate> Por favor captura nombre del centro de costo</span>\r\n            </div>\r\n          </div>\r\n          <div class=\"form_space form--password-mt | banco\" fxFlex=\"100\">\r\n            <div class=\"fondo-cerrar-select zIndex10\" id=\"fondo\" (click)=\"ocultar()\"></div>\r\n            <div class=\"select-container zIndex10\" id=\"select\" fxFlex=\"100\">\r\n              <span class=\"form__text user | font-roboto\">Banco</span>\r\n              <div class=\"form__input select | font-roboto \" id=\"banco\" type=\"text\" name=\"frecuent\" (click)=\"mostrar()\">\r\n                {{ bancos }}\r\n                <div class=\"flecha\" id=\"flecha\"></div>\r\n                <ul class=\"ul-select all zIndex-10 maxAlturaYScroll elscroll\" id=\"lista\">\r\n                  <li *ngFor=\"let banco of Bancos\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\"\r\n                    (click)=\"actualizar(banco)\">\r\n                    <span class=\"texto__select\" fxFlex=\"95\">{{ banco.institucion }}</span>\r\n                  </li>\r\n                </ul>\r\n              </div>\r\n            </div>\r\n          </div>\r\n        </div>-->\r\n      </div>\r\n\r\n      <div class=\"mt-4\" fxFlex=\"70\" fxLayout=\"row wrap\" fxLayoutAlign=\"start stretch\">\r\n        <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n          <div fxFlex=\"30\">\r\n            <nav class=\"nav-barAD | \" fxFlex=\"100\" fxLayoutAlign=\"center start\">\r\n              <ul class=\"navbar__menuAD\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento1()\" [ngClass]=\"{'activeD1': document1}\"\r\n                  fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                  <a class=\"navbar__textAD | \">Acta Constitutiva</a>\r\n                </li>\r\n                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento2()\" [ngClass]=\"{'activeD1': document2}\"\r\n                  fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                  <a class=\"navbar__textAD | \">Constancia Alta SAT</a>\r\n                </li>\r\n                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento3()\" [ngClass]=\"{'activeD1': document3}\"\r\n                  fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                  <a class=\"navbar__textAD | \">Reg. Público Comercio</a>\r\n                </li>\r\n                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento4()\" [ngClass]=\"{'activeD1': document4}\"\r\n                  fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                  <a class=\"navbar__textAD | \">Comprobante Domicilio</a>\r\n                </li>\r\n                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento5()\" [ngClass]=\"{'activeD1': document5}\"\r\n                  fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                  <a class=\"navbar__textAD | \">Edo. Cta Bancario</a>\r\n                </li>\r\n                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento6()\" [ngClass]=\"{'activeD1': document6}\"\r\n                  fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                  <a class=\"navbar__textAD | \">PLD</a>\r\n                </li>\r\n                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento7()\" [ngClass]=\"{'activeD1': document7}\"\r\n                  fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                  <a class=\"navbar__textAD | \">Otro</a>\r\n                </li>\r\n              </ul>\r\n            </nav>\r\n          </div>\r\n          <div fxFlex=\"70\" class=\"contenedor \" fxLayout=\"row wrap\" fxLayoutAlign=\"end start\">\r\n            <div fxFlex=\"100\" class=\"documents\">\r\n              <div *ngIf=\"document1\" class=\"pdf-container mt-2\">\r\n                <iframe class=\"elscroll pdf-container__view\" fxFlex=\"100\"\r\n                  [src]=\"documentosCenCost[0].doc_url | safeurl\"></iframe>\r\n              </div>\r\n              <div *ngIf=\"document2\" class=\"pdf-container mt-2\">\r\n                <iframe class=\"elscroll pdf-container__view\" fxFlex=\"100\"\r\n                  [src]=\"documentosCenCost[1].doc_url | safeurl\"></iframe>\r\n              </div>\r\n              <div *ngIf=\"document3\" class=\"pdf-container mt-2\">\r\n                <iframe class=\"elscroll pdf-container__view\" fxFlex=\"100\"\r\n                  [src]=\"documentosCenCost[2].doc_url | safeurl\"></iframe>\r\n              </div>\r\n              <div *ngIf=\"document4\" class=\"pdf-container mt-2\">\r\n                <iframe class=\"elscroll pdf-container__view \" fxFlex=\"100\"\r\n                  [src]=\"documentosCenCost[3].doc_url | safeurl\"></iframe>\r\n              </div>\r\n              <div *ngIf=\"document5\" class=\"pdf-container mt-2\">\r\n                <iframe class=\"elscroll pdf-container__view \" fxFlex=\"100\"\r\n                  [src]=\"documentosCenCost[4].doc_url | safeurl\"></iframe>\r\n              </div>\r\n              <div *ngIf=\"document6\" class=\"pdf-container mt-2\">\r\n                <iframe class=\"elscroll pdf-container__view \" fxFlex=\"100\"\r\n                  [src]=\"documentosCenCost[5].doc_url | safeurl\"></iframe>\r\n              </div>\r\n              <div *ngIf=\"document7\" class=\"pdf-container mt-2\">\r\n                <iframe class=\"elscroll pdf-container__view\" fxFlex=\"100\"\r\n                  [src]=\"documentosCenCost[6].doc_url | safeurl\"></iframe>\r\n              </div>\r\n              <div *ngIf=\"document1\" fxLayout=\"row wrap\">\r\n                <div class=\"mb-2\" fxFlex=\"100\">\r\n                  <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n                </div>\r\n                <div class=\"mb-2\" fxFlex=\"100\" fxLayout=\"row wrap\" *ngIf=\"form1.value.radioBoton1 != 'D'\">\r\n                  <p fxFlex=\"100\" class=\"mensajeObl\">¿Deseas actualizar el documento?</p>\r\n                  <mat-radio-group fxFlex=\"100\" fxLayoutAlign=\"start center\" formControlName=\"radioBoton1\">\r\n                    <mat-radio-button fxFlex=\"10\" value=\"P\">Sí</mat-radio-button>\r\n                    <mat-radio-button fxFlex=\"10\" value=\"C\">No</mat-radio-button>\r\n                  </mat-radio-group>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\"\r\n                  *ngIf=\"form1.value.radioBoton1 == 'D' || form1.value.radioBoton1 == 'P'\" class=\"mt-3\">\r\n                  <div fxFlex=\"100\">\r\n                    <div class=\"mb-3\" fxFlex=\"100\" fxLayout=\"row\">\r\n                      <input class=\"boton__input\" name=\"file1_\" formControlName=\"file1_\" id=\"file1_\"\r\n                        (change)=\"fileChangeF('fileF1', 'file1', 'file1_', $event, 'form1')\" style=\"display: none\" type=\"file\"\r\n                        #hiddenfileinput accept=\".pdf, application/pdf\">\r\n                      <button type=\"button\" class=\"cargar__button | color-white\" routerLinkActive=\"active\"\r\n                        [ngClass]=\"{'boton--alert': (requerido('file1_','form1') && form1.get('file1_').hasError('required')) }\"\r\n                        (click)=\"hiddenfileinput.click()\">\r\n                        <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                        <b>Cargar Archivo*</b></button>\r\n                      <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                        <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ fileF1 }}</span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <div *ngIf=\"document2\" class=\"mt-3\" fxLayout=\"row wrap\">\r\n                <div class=\"mb-2\" fxFlex=\"100\">\r\n                  <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n                </div>\r\n                <div class=\"mb-2\" fxFlex=\"100\" fxLayout=\"row wrap\" *ngIf=\"form1.value.radioBoton2 != 'D'\">\r\n                  <p fxFlex=\"100\" class=\"mensajeObl\">¿Deseas actualizar el documento?</p>\r\n                  <mat-radio-group fxFlex=\"100\" fxLayoutAlign=\"start center\" formControlName=\"radioBoton2\">\r\n                    <mat-radio-button fxFlex=\"10\" value=\"P\">Sí</mat-radio-button>\r\n                    <mat-radio-button fxFlex=\"10\" value=\"C\">No</mat-radio-button>\r\n                  </mat-radio-group>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\"\r\n                  *ngIf=\"form1.value.radioBoton2 == 'D' || form1.value.radioBoton2 == 'P'\">\r\n                  <div fxFlex=\"100\">\r\n                    <div class=\"mb-3\" fxFlex=\"100\" fxLayout=\"row\">\r\n                      <input class=\"boton__input\" name=\"file2_\" formControlName=\"file2_\" id=\"file2_\"\r\n                        (change)=\"fileChangeF('fileF2', 'file2', 'file2_',$event, 'form1')\" style=\"display: none\" type=\"file\"\r\n                        #hiddenfileinput accept=\".pdf, application/pdf\">\r\n                      <button type=\"button\" class=\"cargar__button | color-white\" routerLinkActive=\"active\"\r\n                        [ngClass]=\"{'boton--alert': (requerido('file2_','form1') && form1.get('file2_').hasError('required')) }\"\r\n                        (click)=\"hiddenfileinput.click()\">\r\n                        <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                        <b>Cargar Archivo*</b></button>\r\n                      <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                        <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ fileF2 }}</span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <div *ngIf=\"document3\" class=\"mt-3\" fxLayout=\"row wrap\">\r\n                <div class=\"mb-2\" fxFlex=\"100\">\r\n                  <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n                </div>\r\n                <div class=\"mb-2\" fxFlex=\"100\" fxLayout=\"row wrap\" *ngIf=\"form1.value.radioBoton3 != 'D'\">\r\n                  <p fxFlex=\"100\" class=\"mensajeObl\">¿Deseas actualizar el documento?</p>\r\n                  <mat-radio-group fxFlex=\"100\" fxLayoutAlign=\"start center\" formControlName=\"radioBoton2\">\r\n                    <mat-radio-button fxFlex=\"10\" value=\"P\">Sí</mat-radio-button>\r\n                    <mat-radio-button fxFlex=\"10\" value=\"C\">No</mat-radio-button>\r\n                  </mat-radio-group>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\"\r\n                  *ngIf=\"form1.value.radioBoton3 == 'D' || form1.value.radioBoton3 == 'P'\">\r\n                  <div fxFlex=\"100\">\r\n                    <div class=\"mb-3\" fxFlex=\"100\" fxLayout=\"row\">\r\n                      <input class=\"boton__input\" name=\"file3_\" formControlName=\"file3_\" id=\"file3_\"\r\n                        (change)=\"fileChangeF('fileF3', 'file3', 'file3_',$event, 'form1')\" style=\"display: none\" type=\"file\"\r\n                        #hiddenfileinput accept=\".pdf, application/pdf\">\r\n                      <button type=\"button\" class=\"cargar__button | color-white\" routerLinkActive=\"active\"\r\n                        [ngClass]=\"{'boton--alert': (requerido('file3_','form1') && form1.get('file3_').hasError('required')) }\"\r\n                        (click)=\"hiddenfileinput.click()\">\r\n                        <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                        <b>Cargar Archivo*</b></button>\r\n                      <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                        <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ fileF3 }}</span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <div *ngIf=\"document4\" class=\"mt-3\" fxLayout=\"row wrap\">\r\n                <div class=\"mb-2\" fxFlex=\"100\">\r\n                  <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n                </div>\r\n                <div class=\"mb-2\" fxFlex=\"100\" fxLayout=\"row wrap\" *ngIf=\"form1.value.radioBoton4 != 'D'\">\r\n                  <p fxFlex=\"100\" class=\"mensajeObl\">¿Deseas actualizar el documento?</p>\r\n                  <mat-radio-group fxFlex=\"100\" fxLayoutAlign=\"start center\" formControlName=\"radioBoton3\">\r\n                    <mat-radio-button fxFlex=\"10\" value=\"P\">Sí</mat-radio-button>\r\n                    <mat-radio-button fxFlex=\"10\" value=\"C\">No</mat-radio-button>\r\n                  </mat-radio-group>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\"\r\n                  *ngIf=\"form1.value.radioBoton3 == 'D' || form1.value.radioBoton3 == 'P'\">\r\n                  <div fxFlex=\"100\">\r\n                    <div class=\"mb-3\" fxFlex=\"100\" fxLayout=\"row\">\r\n                      <input class=\"boton__input\" name=\"file4_\" formControlName=\"file4_\" id=\"file4_\"\r\n                        (change)=\"fileChangeF('fileF4', 'file4', 'file4_',$event, 'form1')\" style=\"display: none\" type=\"file\"\r\n                        #hiddenfileinput accept=\".pdf, application/pdf\">\r\n                      <button type=\"button\" class=\"cargar__button | color-white\" routerLinkActive=\"active\"\r\n                        [ngClass]=\"{'boton--alert': (requerido('file4_','form1') && form1.get('file4_').hasError('required')) }\"\r\n                        (click)=\"hiddenfileinput.click()\">\r\n                        <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                        <b>Cargar Archivo*</b></button>\r\n                      <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                        <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ fileF4 }}</span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <div *ngIf=\"document5\" class=\"mt-3\" fxLayout=\"row wrap\">\r\n                <div class=\"mb-2\" fxFlex=\"100\">\r\n                  <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n                </div>\r\n                <div class=\"mb-2\" fxFlex=\"100\" fxLayout=\"row wrap\" *ngIf=\"form1.value.radioBoton5 != 'D'\">\r\n                  <p fxFlex=\"100\" class=\"mensajeObl\">¿Deseas actualizar el documento?</p>\r\n                  <mat-radio-group fxFlex=\"100\" fxLayoutAlign=\"start center\" formControlName=\"radioBoton5\">\r\n                    <mat-radio-button fxFlex=\"10\" value=\"P\">Sí</mat-radio-button>\r\n                    <mat-radio-button fxFlex=\"10\" value=\"C\">No</mat-radio-button>\r\n                  </mat-radio-group>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\"\r\n                  *ngIf=\"form1.value.radioBoton5 == 'D' || form1.value.radioBoton5 == 'P'\">\r\n                  <div fxFlex=\"100\">\r\n                    <div class=\"mb-3\" fxFlex=\"100\" fxLayout=\"row\">\r\n                      <input class=\"boton__input\" name=\"file5_\" formControlName=\"file5_\" id=\"file5_\"\r\n                        (change)=\"fileChangeF('fileF5', 'file5', 'file5_',$event, 'form1')\" style=\"display: none\" type=\"file\"\r\n                        #hiddenfileinput accept=\".pdf, application/pdf\">\r\n                      <button type=\"button\" class=\"cargar__button | color-white\" routerLinkActive=\"active\"\r\n                        [ngClass]=\"{'boton--alert': (requerido('file5_','form1') && form1.get('file5_').hasError('required')) }\"\r\n                        (click)=\"hiddenfileinput.click()\">\r\n                        <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                        <b>Cargar Archivo*</b></button>\r\n                      <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                        <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ fileF5 }}</span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <div *ngIf=\"document6\" class=\"mt-3\" fxLayout=\"row wrap\">\r\n                <div class=\"mb-2\" fxFlex=\"100\">\r\n                  <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n                </div>\r\n                <div class=\"mb-2\" fxFlex=\"100\" fxLayout=\"row wrap\" *ngIf=\"form1.value.radioBoton6 != 'D'\">\r\n                  <p fxFlex=\"100\" class=\"mensajeObl\">¿Deseas actualizar el documento?</p>\r\n                  <mat-radio-group fxFlex=\"100\" fxLayoutAlign=\"start center\" formControlName=\"radioBoton6\">\r\n                    <mat-radio-button fxFlex=\"10\" value=\"P\">Sí</mat-radio-button>\r\n                    <mat-radio-button fxFlex=\"10\" value=\"C\">No</mat-radio-button>\r\n                  </mat-radio-group>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\"\r\n                  *ngIf=\"form1.value.radioBoton6 == 'D' || form1.value.radioBoton6 == 'P'\">\r\n                  <div fxFlex=\"100\">\r\n                    <div class=\"mb-3\" fxFlex=\"100\" fxLayout=\"row\">\r\n                      <input class=\"boton__input\" name=\"file6_\" formControlName=\"file6_\" id=\"file6_\"\r\n                        (change)=\"fileChangeF('fileF6', 'file6', 'file6_',$event, 'form1')\" style=\"display: none\" type=\"file\"\r\n                        #hiddenfileinput accept=\".pdf, application/pdf\">\r\n                      <button type=\"button\" class=\"cargar__button | color-white\" routerLinkActive=\"active\"\r\n                        [ngClass]=\"{'boton--alert': (requerido('file6_','form1') && form1.get('file6_').hasError('required')) }\"\r\n                        (click)=\"hiddenfileinput.click()\">\r\n                        <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                        <b>Cargar Archivo*</b></button>\r\n                      <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                        <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ fileF6 }}</span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n              <div *ngIf=\"document7\" class=\"mt-3\" fxLayout=\"row wrap\">\r\n                <div class=\"mb-2\" fxFlex=\"100\">\r\n                  <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n                </div>\r\n                <div class=\"mb-2\" fxFlex=\"100\" fxLayout=\"row wrap\" *ngIf=\"form1.value.radioBoton7 != 'D'\">\r\n                  <p fxFlex=\"100\" class=\"mensajeObl\">¿Deseas actualizar el documento?</p>\r\n                  <mat-radio-group fxFlex=\"100\" fxLayoutAlign=\"start center\" formControlName=\"radioBoton7\">\r\n                    <mat-radio-button fxFlex=\"10\" value=\"P\">Sí</mat-radio-button>\r\n                    <mat-radio-button fxFlex=\"10\" value=\"C\">No</mat-radio-button>\r\n                  </mat-radio-group>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\"\r\n                  *ngIf=\"form1.value.radioBoton7 == 'D' || form1.value.radioBoton7 == 'P'\">\r\n                  <div fxFlex=\"100\">\r\n                    <div class=\"mb-3\" fxFlex=\"100\" fxLayout=\"row\">\r\n                      <input class=\"boton__input\" name=\"file7_\" formControlName=\"file7_\" id=\"file7_\"\r\n                        (change)=\"fileChangeF('fileF7', 'file7', 'file7_',$event, 'form1')\" style=\"display: none\" type=\"file\"\r\n                        #hiddenfileinput accept=\".pdf, application/pdf\">\r\n                      <button type=\"button\" class=\"cargar__button | color-white\" routerLinkActive=\"active\"\r\n                        [ngClass]=\"{'boton--alert': (requerido('file7_','form1') && form1.get('file7_').hasError('required')) }\"\r\n                        (click)=\"hiddenfileinput.click()\">\r\n                        <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                        <b>Cargar Archivo*</b></button>\r\n                      <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                        <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ fileF7 }}</span>\r\n                      </div>\r\n                    </div>\r\n                  </div>\r\n                </div>\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div fxFlex=\"30\" fxLayout=\"row\" fxLayoutAlign=\"start stretch\">\r\n            <div fxFlex=\"100\" fxLayout=\"row\" fxLayoutAlign=\"start end\">\r\n              <div class=\"form_space\" fxFlex=\"50\">\r\n                <span class=\"form__text   | font-roboto\" translate\r\n                  [ngClass]=\"{ 'form__text_alert': (requerido('NoExterior','form1') && form1.get('NoExterior').touched) }\">No.\r\n                  Exterior*</span>\r\n                <input class=\"form__input  | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"NoExterior\" id=\"NoExterior\"\r\n                  formControlName=\"NoExterior\"\r\n                  [ngClass]=\"{ 'form__input_alert': (requerido('NoExterior','form1') && form1.get('NoExterior').touched) }\" required>\r\n                <div class=\"alertTransfer\" *ngIf=\"requerido('NoExterior','form1') && form1.get('NoExterior').touched \">\r\n                  <span class=\"alert__text | color-red\" translate> Por favor captura el número exterior</span>\r\n                </div>\r\n              </div>\r\n              <div class=\"form_space\" fxFlex=\"50\">\r\n                <span class=\"form__text   | font-roboto\" translate>No. Interior</span>\r\n                <input class=\"form__input  | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"NoInterior\" id=\"NoInterior\"\r\n                  formControlName=\"NoInterior\">\r\n              </div>\r\n            </div>\r\n          </div>\r\n          <div fxFlex=\"\" fxLayout=\"row\" fxLayoutAlign=\"end stretch\">\r\n            <div class=\"contenedor-boton\" fxFlex=\"98\" fxLayoutAlign=\"end center\">\r\n              <div fxLayoutAlign=\"end center\">\r\n                <button class=\"confirmar__button | color-white\" (click)=\"alPaso3()\"><b>Continuar</b></button>\r\n              </div>\r\n            </div>\r\n            </div>\r\n        </div>\r\n      </div>\r\n    </form>\r\n\r\n    <form [formGroup]=\"form2\" *ngIf=\"paso3\" class=\"mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between start\">\r\n      <span class=\"note\" fxFlex=\"100\">Por favor revisa tus documentos y la información que capturaste para\r\n        {{nameType}}. Si es necesario corrige los datos capturados y/o carga\r\n        los documentos que se solicitan. </span>\r\n      <div class=\"mt-4\" fxFlex=\"30\" fxLayout=\"row wrap\" *ngIf=\"mosDom2==true\">\r\n        <div class=\"mb-2\">\r\n          <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n        </div>\r\n        <div class=\"form_space\" fxFlex=\"100\">\r\n          <span class=\"form__text  | font-roboto\" translate\r\n            [ngClass]=\"{ 'form__text_alert': (requerido('rApellidoPaterno','form2') && form2.get('rApellidoPaterno').touched) }\">Apellido\r\n            Paterno*</span>\r\n          <input class=\"form__input | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"rApellidoPaterno\" id=\"rApellidoPaterno\"\r\n            [ngClass]=\"{ 'form__input_alert': (requerido('rApellidoPaterno','form2') && form2.get('rApellidoPaterno').touched) }\"\r\n            formControlName=\"rApellidoPaterno\" required>\r\n          <div class=\" alertTransfer\" *ngIf=\"requerido('rApellidoPaterno','form2') && form2.get('rApellidoPaterno').touched \">\r\n            <span class=\"alert__text | color-red\" translate> Por favor captura apellido del representante legal</span>\r\n          </div>\r\n        </div>\r\n        <div class=\"form_space\" fxFlex=\"100\">\r\n          <span class=\"form__text  | font-roboto\" translate\r\n            [ngClass]=\"{ 'form__text_alert': (requerido('rApellidoMaterno','form2') && form2.get('rApellidoMaterno').touched) }\">Apellido\r\n            Materno*</span>\r\n          <input class=\"form__input | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"rApellidoMaterno\"\r\n            id=\"rApellidoMaterno\"\r\n            [ngClass]=\"{ 'form__input_alert': (requerido('rApellidoMaterno','form2') && form2.get('rApellidoMaterno').touched) }\"\r\n            formControlName=\"rApellidoMaterno\" required>\r\n          <div class=\" alertTransfer\" *ngIf=\"requerido('rApellidoMaterno','form2') && form2.get('rApellidoMaterno').touched \">\r\n            <span class=\"alert__text | color-red\" translate> Por favor captura apellido del representante legal</span>\r\n          </div>\r\n        </div>\r\n        <div class=\"form_space\" fxFlex=\"100\">\r\n          <span class=\"form__text  | font-roboto\" translate\r\n            [ngClass]=\"{ 'form__text_alert': (requerido('rNombre','form2') && form2.get('rNombre').touched) }\">Nombre(s)*</span>\r\n          <input class=\"form__input | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"rNombre\" id=\"rNombre\"\r\n            [ngClass]=\"{ 'form__input_alert': (requerido('rNombre','form2') && form2.get('rNombre').touched) }\"\r\n            formControlName=\"rNombre\" required>\r\n          <div class=\" alertTransfer\" *ngIf=\"requerido('rNombre','form2') && form2.get('rNombre').touched \">\r\n            <span class=\"alert__text | color-red\" translate> Por favor captura nombre del representante legal</span>\r\n          </div>\r\n        </div>\r\n        <div class=\"form_space\" fxFlex=\"100\">\r\n          <div class=\"fecha\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n            <p class=\"form__date label_fecha pass | \"\r\n              [ngClass]=\"{ 'form__date_alert': (requerido('rFechaNacimiento','form2') && form2.get('rFechaNacimiento').touched) }\"\r\n              translate>Fecha de Nacimiento*</p>\r\n            <mat-form-field class=\"valor campo_fecha disabled\" id=\"fecha_nacimiento_block\"\r\n              [ngClass]=\"{ 'mat-form-field_alert': (requerido('rFechaNacimiento','form2') && form2.get('rFechaNacimiento').touched) }\"\r\n              fxFlex=\"100\">\r\n              <input matInput [satDatepicker]=\"picker6\" id=\"fecha_nacimiento_rl_id\" autocomplete=\"off\"\r\n                name=\"rFechaNacimiento\" formControlName=\"rFechaNacimiento\" readonly required>\r\n              <sat-datepicker #picker6 [rangeMode]=\"false\" [selectFirstDateOnClose]=\"true\" [rangeHoverEffect]=\"false\">\r\n              </sat-datepicker>\r\n              <sat-datepicker-toggle matSuffix [for]=\"picker6\"></sat-datepicker-toggle>\r\n            </mat-form-field>\r\n          </div>\r\n\r\n          <div class=\" alertTransfer fecha_const_alert\" *ngIf=\"form2.get('rFechaNacimiento').touched \">\r\n            <span class=\"alert__text | color-red\" *ngIf=\"form2.get('rFechaNacimiento').hasError('required')\" translate>\r\n              Por favor captura la Fecha de Nacimiento</span>\r\n            <span class=\"alert__text | color-red\" *ngIf