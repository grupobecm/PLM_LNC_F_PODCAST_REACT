        });
    }
    adminSol(data) {
        //console.log('Json storage', data);
        this.storageAdmin.setSolCenterCost(data);
        sessionStorage.setItem("CentroCostosSol", JSON.stringify(data));
        let url = '';
        switch (data.tipoSolicitud_id) {
            case 19:
                url = '/administrador/cuentaeje/centros-costos/cambio-domicilio-centro-costos';
                break;
            case 21:
                url = '/administrador/cuentaeje/centros-costos/cambio-cuenta-centro-costos';
                break;
            case 23:
                url = '/administrador/cuentaeje/centros-costos/cambio-representante-centro-costos';
                break;
            default:
