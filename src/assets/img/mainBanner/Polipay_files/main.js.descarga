=\"form__text user | font-roboto\"\r\n                        [ngClass]=\"{ 'form__text_alert': (requerido('nombrebeneficiario') && submitt) }\">Nombre del\r\n                        Beneficiario*</span>\r\n                    <input class=\"form__input user | font-roboto\"\r\n                        [ngClass]=\"{ 'form__input_alert': (requerido('nombrebeneficiario') && submitt) }\" id=\"nombre\"\r\n                        autocomplete=\"off\" type=\"text\" maxlength=\"39\" name=\"nombrebeneficiario\" formControlName=\"nombrebeneficiario\"\r\n                        required>\r\n                    <!-- Alertas -->\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('nombrebeneficiario') && submitt \">\r\n                        <span class=\"alert__text | color-red\"> Por favor captura el nombre del beneficiario</span>\r\n                    </div>\r\n                </div>\r\n\r\n                <div fxFlex=\"30\" fxLayout=\"column\">\r\n                    <div class=\"form\">\r\n                        <div class=\"fondo-cerrar-select zIndex10\" id=\"fondo2\" (click)=\"ocultar2()\"></div>\r\n                        <div class=\"select-container zIndex10\" id=\"select1\" fxFlex=\"100\">\r\n                            <span class=\"form__text user | font-roboto\"\r\n                                [ngClass]=\"{ 'form__text_alert': requeridoBanco() || rojobanco }\">Banco*</span>\r\n                            <div class=\"form__input select | font-roboto \"\r\n                                [ngClass]=\"{ 'form__input_alert': requeridoBanco() || rojobanco}\" id=\"banco\" type=\"text\"\r\n                                name=\"frecuent\" (click)=\"mostrar2()\">\r\n                                {{ banco }}\r\n                                <div class=\"flecha\" id=\"flecha\"\r\n                                    [ngClass]=\"{ 'flecha--alert': requeridoBanco() || rojobanco }\"></div>\r\n                                <ul class=\"ul-select all z