 legal de un centro de costos -->\r\n    <div *ngIf=\"success == 'RL-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"listCenterCost()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Dispersiones   D-000 -->\r\n    <!--Dispersiones - cancelar una dispersion individual -->\r\n    <div *ngIf=\"success == 'DI-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - cancelar una dispersion masiva -->\r\n    <div *ngIf=\"success == 'DM-001'\" class=\"message\">\r\n        <p class=\"text | color-third\"> {{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Dispersiones - Tarjetas -  solicitud de tarjeta -->\r\n    <div *ngIf=\"success == 'D-001'\" class=\"message\">\r\n        <p class=\"text | color-third\"> Para continuar, descargar<br>ficha de Deposito.\r\n            <br><br> Después de realizarlo,<br>ponte en contacto con tu<br>ejecutivo Polipay.\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept boton-descargar | color-white background-main\"\r\n                type=\"button\"> <img src=\"../../../assets/img/icons/file_upload-24px.svg\"\r\n                    alt=\"Descargar ficha de deposito\"> descargar Ficha de Deposito </button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - Perfil Externo -  alta personal externo -->\r\n    <div *ngIf=\"success == 'D-002'\" class=\"message\">\r\n        <p class=\"text | color-third\"> Se ha creado el nuevo registro satisfactoriamente.</p>\r\n        <p class=\"text | color-third\"> Se ha generado con el número de cuenta {{ cuenta }}. </p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - Perfil Externo -  respuesta de desactivación  -->\r\n    <div *ngIf=\"success == 'D-003'\" class=\"message\">\r\n        <p class=\"text | color-third\"> Se ha eliminado a<br>{{ username | uppercase }}.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - Perfil Externo - Grupos -  respuesta de eliminar grupo -->\r\n    <div *ngIf=\"success == 'D-004'\" class=\"message\">\r\n        <p class=\"text | color-third\"> Se ha eliminado el grupo satisfactoriamente.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - Perfil Externo - Grupos -  respuesta de eliminar persona de grupo -->\r\n    <div *ngIf=\"success == 'D-005'\" class=\"message\">\r\n        <p class=\"text | color-third\"> Se elimino a {{ username}} del grupo {{ name | uppercase }} de forma\r\n            satisfactoria.\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Dispersiones - Tarjetas - solicitud saldo comisión positiva  -->\r\n    <!-- <div *ngIf=\"success == 'D-006'\" class=\"message\">\r\n        <p class=\"text | color-third\"> Para continuar, realiza una transferencia por\r\n            <br>${{ monto }} MXN a la cuenta clabe\r\n            <br>{{cuenta}} con la referencia\r\n            <br>{{reference}} en el concepto.</p>\r\n        <p class=\"text | color-third\">Se ha enviado a tu correo electrónico esta <br>información.</p>\r\n        <div fxLayout=\"row\">\r\n            <button id=\"button\" class=\"button-accept | color-white background-accent\" (click)=\"download()\"><a href=\"{{document}}\" target=\"_blank\" >Descargar Ficha Depósito </a></button>\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div> -->\r\n    <!--Dispersiones - dispersion individual cancelada  -->\r\n    <div *ngIf=\"success == 'D-007'\" class=\"message\">\r\n        <p class=\"text | color-third\">La dispersión para {{ username }} por ${{ monto }} MXN, fue cancelada exitosamente\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - Personal Externo - editar santisfactoriamente -->\r\n    <div *ngIf=\"success == 'D-008'\" class=\"message\">\r\n        <p class=\"text | color-third\"> Se ha guardado la edición <br>satisfactoriamente.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - dispersion individual cancelada  -->\r\n    <div *ngIf=\"success == 'D-009'\" class=\"message\">\r\n        <p class=\"text | color-third\"> La dispersión \"{{ observacion }}\", fue cancelada exitosamente</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - solicitar tarjetas centro de costo, sin carta  -->\r\n    <div *ngIf=\"success == 'D-010'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"cardRequest()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - solicitar tarjetas centro de costo con carta  -->\r\n    <div *ngIf=\"success == 'D-011'\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Para continuar, descargar<br>ficha de Deposito.\r\n            <br>\r\n            <br> Después de realizarlo,<br>ponte en contacto con tu<br>ejecutivo Polipay.\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 'D-011'\" mat-dialog-close id=\"button\"\r\n                class=\"button-accept boton-descargar | color-white background-main\" type=\"button\">\r\n                <img src=\"../../../assets/img/icons/file_upload-24px.svg\" alt=\"Descargar ficha de deposito\">\r\n                descargar Ficha de Deposito\r\n            </button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - Tarjetas - solicitud saldo comisión positiva  -->\r\n    <div *ngIf=\"success == 'D-012'\" class=\"message\">\r\n        <p class=\"text | color-third\"> Para continuar, realiza una transferencia por\r\n            <br>${{ any }} MXN a la cuenta clabe\r\n            <br>{{cuenta}} con la referencia\r\n            <br>{{reference}} en el concepto.\r\n        </p>\r\n        <p class=\"text | color-third\">Se ha enviado a tu correo electrónico esta <br>información.</p>\r\n        <div fxLayout=\"row\">\r\n            <button id=\"button\" class=\"button-accept | color-white background-accent\" (click)=\"downloadBalance()\"><a\r\n                    href=\"{{document}}\" target=\"_blank\">Descargar Ficha Depósito </a></button>\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - dispersión ndividual  -->\r\n    <div *ngIf=\"success == 'D-013'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"dispIndividual()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!-- GroupsBeneficiary  G-001 -->\r\n    <!--Grupos de Benefiiarios // Eliminar -->\r\n    <div *ngIf=\"success == 'G-001'\" class=\"message\">\r\n        <p class=\"text | color-third\"> {{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Grupos de Benefiiarios // Eliminar personal -->\r\n    <div *ngIf=\"success == 'G-002'\" class=\"message\">\r\n        <p class=\"text | color-third\">Se elimino a<br>{{ username }} del grupo<br>{{ name }} de forma satisfactoria.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Grupos de Benefiiarios // Crear -->\r\n    <div *ngIf=\"success == 'G-003'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Grupos de Benefiiarios // Crear -->\r\n    <div *ngIf=\"success == 'GB-003'\" class=\"message\">\r\n        <p class=\"text | color-third\">El grupo {{name}} fue creado exitosamente</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Grupos de Benefiiarios // Editar -->\r\n    <div *ngIf=\"success == 'G-004'\" class=\"message\">\r\n        <p class=\"text | color-third\">Se edito el grupo {{ name }} de forma satisfactoria.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <!-- EDIT USER  E-001 -->\r\n    <div *ngIf=\"success == 'E-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">Se ha actualizado tu <br>contraseña</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <!-- Transacciones a Terceros T-001-->\r\n    <div *ngIf=\"success == 'T-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"listFrequent()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!-- Transferencia Individual-->\r\n    <div *ngIf=\"success == 'T-002'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"listTransferIndividual()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!-- Transacciones Polipay Polipay T-001-->\r\n    <!-- Crear transacción de Polipay Polipay T-001-->\r\n    <div *ngIf=\"success == 'TP-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"listSendPolipay()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Transacciones a cuentas propias TOA-002-->\r\n    <div *ngIf=\"success == 'TOA-002'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"reiniciar()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <!-- Reports  R-001-->\r\n\r\n    <!-- Tarjetas  C-001-->\r\n    <div *ngIf=\"success == 'C-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">Se han asignado a {{ username }} las tarjetas:</p>\r\n        <p class=\"text | color-third\" *ngFor=\"let item of cards\">{{ item }}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"reiniciar()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <!--Grupo de Frecuentes // Eliminar -->\r\n    <div *ngIf=\"success == 'GF-001'\" class=\"message\">\r\n        <p class=\"text | color-third\"> {{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"closeAll()\"\r\n                [routerLink]=\"['/usuario/transactions/frequent-accounts/frequent-third/groupsfrecuentesterceros/seegroupsterceros']\"\r\n                routerLinkActive=\"active\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Grupo de Frecuentes // Eliminar -->\r\n    <div *ngIf=\"success == 'GF-002'\" class=\"message\">\r\n        <p class=\"text | color-third\"> {{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"closeAll()\"\r\n                [routerLink]=\"['/usuario/transactions/frequent-accounts/frequent-third/groupsfrecuentesterceros/seegroupsterceros']\"\r\n                routerLinkActive=\"active\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Grupo de Permisos-->\r\n    <div *ngIf=\"success == 'GP-001'\" class=\"message\">\r\n        <p class=\"text | color-third\"> {{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button [mat-dialog-close]=\"'Aceptar'\" id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <div *ngIf=\"success == 'GP-002'\" class=\"message\">\r\n        <p class=\"text | color-third\"> {{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button [mat-dialog-close]=\"'Aceptar'\" id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\" (click)=\"returnListGroupPermis()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Alta Beneficiario-->\r\n    <div *ngIf=\"success == 'AB-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">Se han creado las nuevas cuentas satisfactoriamente. <br><br> Para conocer los\r\n            números de cuenta, accede a los detalles de las listadas.</p>\r\n        <div fxLayout=\"row \">\r\n            <button [mat-dialog-close]=\"'Aceptar'\" id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\" (click)=\"returnListPersonalExterno()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Alta Tarjetas Beneficiario-->\r\n    <div *ngIf=\"success == 'AB-002'\" class=\"message\">\r\n        <p class=\"text | color-third\">Se han asignado las tarjetas satisfactoriamente. <br><br> Para saber más, accede a\r\n            los detalles de las cuentas listadas.</p>\r\n        <div fxLayout=\"row \">\r\n            <button [mat-dialog-close]=\"'Aceptar'\" id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\" (click)=\"returnListPersonalExterno()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- TOKEN DINAMICO -->\r\n\r\n    <div *ngIf=\"success == 'TD-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <!-- COLABORADORES -->\r\n\r\n    <div *ngIf=\"success == 'COL-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Centro de Costo-->\r\n    <div *ngIf=\"success == 'CC-000'\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Tu operación se realizó\r\n            <br>satisfactoriamente.\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button [mat-dialog-close]=\"'Aceptar'\" id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <div *ngIf=\"success == 'CC-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button [mat-dialog-close]=\"'Aceptar'\" id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n\r\n</div>");

/***/ }),

