align: left;\r\n    padding: 17px 16.5px;\r\n    outline: none;\r\n    border-radius: 4px;\r\n    border: solid 1px var(--opacity-12);\r\n    color: var(--opacity-74);\r\n    cursor: pointer;\r\n  }\r\n  \r\n  .valor{\r\n    display: none;\r\n  }\r\n  \r\n  .first{\r\n    display: block;\r\n  }\r\n  \r\n  input[type=number]::-webkit-inner-spin-button, \r\n  input[type=number]::-webkit-outer-spin-button { \r\n    -webkit-appearance: none; \r\n    margin: 0; \r\n  }\r\n  \r\n  input[type=number] { -moz-appearance:textfield; }\r\n  \r\n  .form__input[type=\"date\"]{\r\n    margin-top: 24px;\r\n    margin-left: 14px;\r\n  }\r\n  \r\n  .form{\r\n    cursor: pointer;\r\n    position: relative;\r\n  }\r\n  \r\n  .select{\r\n    display: none;\r\n    position: absolute;\r\n    visibility: hidden;\r\n    opacity: 0;\r\n    transition: 0.2s;\r\n    margin-top: 4px;\r\n  }\r\n  \r\n  .select ul{\r\n    list-style: none;\r\n    padding: 0;\r\n    margin: 0;\r\n    width: 100%;\r\n  \r\n    border-radius: 4px;\r\n    box-shadow: 0 0 6px 0 rgba(0, 0, 0, 0.65);\r\n    max-height: calc(60vh - 155px);\r\n  \r\n  }\r\n  \r\n  .select ul li{\r\n    width: 100%;\r\n    cursor: pointer;\r\n    height: 32px;\r\n    color: var(--opacity-74);\r\n    display: block;\r\n  }\r\n  \r\n  ul li:hover{\r\n    background: var(--grey-light);\r\n  }\r\n  \r\n  li::after{\r\n    content: '';\r\n    position: relative;\r\n    border-bottom: 1px solid var(--grey-dark);\r\n    width: 90%;\r\n    top: 4px;\r\n  }\r\n  \r\n  li:last-child::after{\r\n    content: '';\r\n    position: relative;\r\n    border-bottom: 1px solid transparent;\r\n    width: 90%;\r\n    top: 5px;\r\n  }\r\n  \r\n  .fechas{\r\n      margin-top: 40px;\r\n  }\r\n  \r\n  .fecha__texto{\r\n    position: relative;\r\n  }\r\n  \r\n  .etiqueta{\r\n      position: absolute;\r\n      margin-left: 14px;\r\n      top: 16px;\r\n      left: 16.5px;\r\n      font-family: Roboto;\r\n      font-size: 12px;\r\n      padding: 0px 5px;\r\n      line-height: 1.33;\r\n      letter-spacing: 0.4px;\r\n      color: var(--opacity-60);\r\n      display: block;\r\n      background: var(--white);\r\n      z-index: 3;\r\n  }\r\n  \r\n  .select_text{\r\n    display: block;\r\n    width: 90%;\r\n    text-align: left;\r\n  }\r\n  \r\n  .fondo{\r\n    position: absolute;\r\n    width: 100%;\r\n    height: 100%;\r\n    top: 0;\r\n    left: 0;\r\n    z-index: 998 !important;\r\n    background: transparent;\r\n    visibility: hidden;\r\n    transition: 0.3s;\r\n  }\r\n  \r\n  .linea{\r\n    height: 1px;\r\n    width: 100%;\r\n    border-top: 1px solid var(--grey-dark);\r\n    margin: 18.5px 0px 31.5px 0px;\r\n  }\r\n  \r\n  /* Button confirmar */\r\n  \r\n  .confirmar__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width: 128px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var(--main-color);\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    margin-left: 26.4px;\r\n  \r\n    outline: none;\r\n    cursor: pointer;\r\n    box-shadow: 0 1px 3px var(--opacity-12), 0 3px 3px var(--opacity-24);\r\n    transition: 0.3s;\r\n  }\r\n  \r\n  .disabled{\r\n    background: #fafafa !important;\r\n  }\r\n  \r\n  .confirmar__button:hover {\r\n    background-color: var( --grey-dark);\r\n    color: var(--main-color);\r\n  }\r\n  \r\n  .confirmar__button:disabled {\r\n    background-color: var( --grey-dark);\r\n    color: var( --third-color);\r\n    cursor: default;\r\n  }\r\n  \r\n  /* Button cancelar */\r\n  \r\n  .cancelar__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width: 128px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var( --grey-dark);\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n  \r\n    outline: none;