let DetailsReturnedUTComponent = class DetailsReturnedUTComponent {
    constructor(data, router, dialog, serviceTrans) {
        this.data = data;
        this.router = router;
        this.dialog = dialog;
        this.serviceTrans = serviceTrans;
        this.showLoad = false;
        this.authorized = true;
        this.dato = data.dato;
        //console.log("-------");
        //console.log(this.dato);
        //console.log("-------");
        this.seeDetails();
        // this.cuentadestino = this.dato.cuenta;
