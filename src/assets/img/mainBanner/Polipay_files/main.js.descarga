            date_modify: date_dispersionR3,
            hora: this.form.get("hora_operacion").value,
        };
        this.serviceReceived
            .createReceivedPersons(data, this.form.get("company").value)
            .subscribe((res) => {
            //console.log(res);
            this.dialog.open(_messageAdmin_success_admin_success_admin_component__WEBPACK_IMPORTED_MODULE_10__["SuccessAdminComponent"], {
                data: { success: "R-001" },
                disableClose: true,
            });
            this.form.reset();
            this.banco = "\u00a0";
            this.person = "\u00a0";
        }, (error) => {
            //console.log(error);
            this.dialog.open(_messageAdmin_error_admin_error_admin_component__WEBPACK_IMPORTED_MODULE_9__["ErrorAdminComponent"], {
                data: { error: "R-001" },
                disableClose: true,
            });
            this.form.reset();
            this.banco = "\u00a0";
            this.person = "\u00a0";
        });
        //console.log(this.form.value);
        // }
    }
    EscogerHora() {
        let dataDialog = this.dialog.open(_reloj_reloj_component__WEBPACK_IMPORTED_MODULE_11__["RelojComponent"], {
            panelClass: ["border-none"],
        });
        let formato24Horas = {
            "01": "13",
            "02": "14",
            "03": "15",
            "04": "16",
            "05": "17",
            "06": "18",
            "07": "19",
            "08": "20",
            "09": "21",
            "10": "22",
            "11": "23",
            "12": "12",
        };
        dataDialog.afterClosed().subscribe((res) => {
            if (res == undefined) {
                this.hora_operacion = "";
            }
            else {
                if (res[2] == "P.M.") {
                    res[0] = formato24Horas[res[0]];
                }
                if (res[2] == "A.M." && res[0] == "12") {
                    res[0] = "00";
                }
                this.hora_operacion = res[0] + ":" + res[1];
            }
        });
    }
    //Función para mostrar la lista en consola------2
    personsList() {
        this.serviceReceived.receivedPersons().subscribe((res) => {
            //console.log(res);
            res.forEach((element) => {
                if (element.persona_cuenta__last_name != null || element.persona_cuenta__last_name != undefined) {
                    element.persona_cuenta__last_name =
                        element.persona_cuenta__last_name.replace("*", " ");
                    element.persona_cuenta__name = element.persona_cuenta__name.replace("*", " ");
                }
            });
            this.persons = res;
        }, (error) => {
            //console.log(error);
        });
    }
    BankList() {
        this.ServicesAxisAccountService.BanksAxisAccounts().subscribe((res) => {
            this.Bancos = res;
        }, (error) => {
            //console.log(error);
        });
    }
    ngOnInit() { }
};
