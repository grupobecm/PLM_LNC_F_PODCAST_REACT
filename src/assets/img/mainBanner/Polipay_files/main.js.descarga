ferencia_numerica') && submitt\">\r\n                                <span class=\"alert__text | color-red\">Por favor captura tu número de referencia, debe ser de 7\r\n                                    dígitos</span>\r\n                            </div>\r\n                            <div *ngIf=\"flgZero\">\r\n                                <span class=\"alert__text | color-red\">El número de referencia no puede iniciar con 0\r\n                                    (cero)</span>\r\n                            </div>\r\n                        </div>\r\n\r\n\r\n\r\n                    <!-- Input save en frecuentes -->\r\n                    <div *ngIf=\"ocultarCampoAlias\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center start\">\r\n                        <div class=\"checkfrecuent\" fxFlex=\"100\">\r\n                            <mat-checkbox fxFlex=\"100\" class=\"mr-2 check\" name=\"is_frecuent\" id=\"check\"\r\n                                formControlName=\"is_frecuent\" (change)=\"Checked()\" [(ngModel)]=\"isFrecuentR\">Guardar\r\n                                para frecuentes transferencias</mat-checkbox>\r\n                        </div>\r\n                        <div class=\"form input-alias\" fxFlex=\"100\" *ngIf=\"checked\">\r\n                            <div class=\"input-alias2\">\r\n                                <span class=\"form__text user | font-roboto\"\r\n                                    [ngClass]=\"{ 'form__text_alert': (aliasOpcional() && form.get('alias').touched) }\">Alías*</span>\r\n                                <input class=\"form__input user | font-roboto\"\r\n                                    [ngClass]=\"{ 'form__input_alert': (aliasOpcional() && form.get('alias').touched) }\"\r\n                                    autocomplete=\"off\" type=\"text\" id=\"aliasP\" name=\"alias\" formControlName=\"alias\"\r\n                                    [ngModel]=\"aliasR\">\r\n                                <!-- Alertas 