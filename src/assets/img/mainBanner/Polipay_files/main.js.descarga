px !important;\r\n    line-height: 1.5 !important;\r\n    letter-spacing: 0.15px !important;\r\n    text-align: left !important;\r\n    outline: none !important;\r\n    border-radius: 4px !important;\r\n    border: solid 1px var(--opacity-12);\r\n    color: var(--opacity-74);\r\n    cursor: pointer !important;\r\n    top: 26px !important;\r\n}\r\n\r\n/*INPUT*/\r\n\r\n.form__text {\r\n    position: relative;\r\n    top: 11px;\r\n    font-size: 12px;\r\n    line-height: 1.33;\r\n    letter-spacing: 0.4px;\r\n    text-align: left;\r\n    color: var(--opacity-60);\r\n    margin-left: 16.5px;\r\n    background: var(--white);\r\n    padding: 0px 5px;\r\n}\r\n\r\n.form__input,\r\n.form__input2 {\r\n    width: 100%;\r\n    height: 56px;\r\n    font-size: 16px;\r\n    line-height: 1.5;\r\n    letter-spacing: 0.15px;\r\n    text-align: left;\r\n    padding: 17px 16.5px;\r\n    outline: none;\r\n    border-radius: 4px;\r\n    border: solid 1px var(--opacity-12);\r\n    color: var(--opacity-74);\r\n}\r\n\r\n.form_space {\r\n    padding-right: 15px;\r\n}\r\n\r\n.button-dateC {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    width: 206px;\r\n    height: 43px;\r\n    padding: 0 13px;\r\n    border-radius: 24px;\r\n    margin-top: 0px;\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    /* centrar el boton */\r\n    display: block;\r\n    outline: none;\r\n    cursor: pointer;\r\n}\r\n\r\n.button-dateC:hover {\r\n    background-color: var( --main-color);\r\n    color: var( --white);\r\n    cursor: pointer;\r\n}\r\n\r\n/**/\r\n\r\n.confirmar__button {\r\n    margin-left: 0 !important;\r\n    margin-right: 0 !important;\r\n}\r\n\r\n/**/\r\n\r\n.num {\r\n    font-size: 19px;\r\n    font-weight: bold;\r\n}\r\n\r\ntable td {\r\n    font-size: 12px;\r\n}\r\n/*# sourceMappingURL=data:application/json;base64, */");

