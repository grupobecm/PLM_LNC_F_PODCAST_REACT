                let arr_input = Array.prototype.slice.call(input);
                let arr_select = Array.prototype.slice.call(select);
                for (let i = 0; i < arr_input.length; i++) {
                    arr_select[i].style.width = (arr_input[i].offsetWidth) + "px";
                    arr_select[i].style.cssText += 'z-index: 999 !important';
                }
                clearInterval(refresh);
            }, 10);
        }
    }
    // Select selecciona un elemento
    select(val, i) {
        // Obtiene el "campo" seleccionado (Por "campo" quiero decir select e input) todo ese bloque
