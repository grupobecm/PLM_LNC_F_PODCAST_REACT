                if (file.name.split('.')[1] == 'pdf') {
                    //verificamos el tamaño
                    if (file.size / 1024 / 1024 / 1024 < 1) {
                        this.file = file.name;
                        let reader = new FileReader();
                        reader.readAsDataURL(file);
                        //extraemos la información
