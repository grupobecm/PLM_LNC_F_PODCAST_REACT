            //console.log(error);
        });
    }
    searchbank(data) {
        this.service.BanksAxisAccounts().subscribe((res) => {
            this.bankList = res;
            for (let i = 0; i < this.bankList.length; i++) {
                if (this.bankList[i].institucion == data) {
                    this.bankId = this.bankList[i].clabe;
                    break;
                }
            }
        }, (error) => {
            //console.log(error);
        });
    }
    getbankList2(data) {
        this.service.BanksAxisAccounts().subscribe((res) => {
            this.bankList = res;
            for (let i = 0; i < this.bankList.length; i++) {
                if (this.bankList[i].clabe == data) {
                    this.bancos = this.bankList[i].institucion;
                    this.bankId = this.bankList[i].clabe;
                    this.form2.get("banco").setValue(data);
                    break;
                }
            }
        }, (error) => {
            //console.log(error);
        });
        this.showLoad = false;
    }
    actualizar(value) {
        this.bancos = value.institucion;
        this.searchbank(this.bancos);
        this.form2.get("banco").setValue(value.id);
    }
