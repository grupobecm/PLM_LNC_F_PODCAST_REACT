let DetailMassiveComponent = class DetailMassiveComponent {
    constructor(router, dialog) {
        this.router = router;
        this.dialog = dialog;
        this.cero = true;
        this.filtradas = true;
        this.numeroRegistros = 0;
        this.numeroRegistrosaMostrar = 5;
        this.showLoad = false;
        this.pagina_actual = 1;
        this.next_page = 0;
        this.prev_page = 0;
        this.total = 0;
        this.total_paginas = 0;
        this.totalAux = 0;
        const navigation = this.router.getCurrentNavigation();
        const state = navigation.extras.state;
        if (state == undefined) {
            this.router.navigate(['/administrador/pendientes/masiva']);
        }
        this.example = state.example;
        this.ListTransfer();
    }
    ListTransfer() {
        this.showLoad = true;
        this.pagina_actual = 1;
        this.showLoad = true;
    }
    next() {
        if (this.next_page != null) {
            this.showLoad = true;
            this.pagina_actual++;
        }
    }
    prev() {
        if (this.prev_page != null) {
            this.showLoad = true;
            this.pagina_actual--;
        }
    }
    inicio() {
        this.ListTransfer();
    }
    fin() {
        if (Number(this.total_paginas.toFixed()) < Number(this.total_paginas)) {
            this.pagina_actual = Number(this.total_paginas.toFixed()) + 1;
        }
        else {
            this.pagina_actual = Number(this.total_paginas.toFixed());
        }
        this.showLoad = true;
    }
    detalles(dato) {
        this.dialog.open(src_app_Views_user_transactions_third_transfer_status_details_details_component__WEBPACK_IMPORTED_MODULE_7__["DetailsComponent"], {
            width: '35%',
            data: {
                dato: dato
            },
            panelClass: 'custom-dialog-container',
            disableClose: true,
        });
    }
    update() {
        ////console.log(this.numeroRegistrosaMostrar);
        if (this.numeroRegistrosaMostrar == 0) {
            this.numeroRegistrosaMostrar = this.total;
        }
        this.ListTransfer();
    }
    details(dato) {
        this.router.navigate(['/administrador/pendientes/detallesdetallesm'], {
            state: {
                dato: dato,
                example: this.example
            }
        });
    }
};
