menu {\r\n    position: absolute;\r\n    width: 100%;\r\n    height: 100%;\r\n    overflow: hidden;\r\n}\r\n\r\n.menu__icon {\r\n    cursor: pointer;\r\n}\r\n\r\n.menu__fondo {\r\n    position: absolute;\r\n    width: 100%;\r\n    height: 100%;\r\n    background: var(--opacity-50);\r\n    opacity: 0;\r\n    transition: 0.3s;\r\n    visibility: hidden;\r\n    z-index: 5;\r\n}\r\n\r\n.menu__items {\r\n    position: absolute;\r\n    display: block;\r\n    width: 340px;\r\n    height: 100%;\r\n    margin: 0;\r\n    right: -360px;\r\n    transition: 0.6s;\r\n    padding: 0;\r\n    z-index: 6;\r\n    top: 60px;\r\n    box-shadow: -5px 0 6px 0 rgba(0, 0, 0, 0);\r\n}\r\n\r\n.item {\r\n    display: block;\r\n    width: 100%;\r\n    height: 52px;\r\n    border-bottom: solid 1px var(--grey-dark);\r\n    cursor: pointer;\r\n    transition: 0.3s;\r\n}\r\n\r\n/* HOVER PARA ITEM MENU */\r\n\r\n.item:hover {\r\n    background: var(--accent-color);\r\n}\r\n\r\n.item:hover .item__text {\r\n    color: var(--white);\r\n}\r\n\r\n.item:hover .item__text--user {\r\n    color: var(--color-third);\r\n}\r\n\r\n.item:hover .item__img {\r\n    filter: brightness(0) invert(1);\r\n}\r\n\r\n.item:hover .item__img--user {\r\n    filter: none;\r\n}\r\n\r\n.items--user {\r\n    height: 130px;\r\n    cursor: default;\r\n}\r\n\r\n.items--user:hover,\r\n.items--notificacion:hover {\r\n    background: var(--white);\r\n}\r\n\r\n.item__text {\r\n    font-size: 18px;\r\n    line-height: 1.2;\r\n    text-align: left;\r\n    color: var(--third-color);\r\n}\r\n\r\n.ultima__conexion {\r\n    padding: 14px 14px 0px 14px;\r\n}\r\n\r\n.item__text__ultima {\r\n    font-size: 18px;\r\n    line-height: 1.2;\r\n    text-align: left;\r\n    color: var(--third-color);\r\n}\r\n\r\n.space {\r\n    display: block;\r\n    width: 55px;\r\n    height: 10px;\r\n    background: transparent;\r\n}\r\n\r\n.item__text--size {\r\n    font-size: 14px;\r\n}\r\n\r\n.item__text-upper {\r\n    text-transform: uppercase;\r\n    font-size: 20px;\r\n    line-height: 1.08;\r\n}\r\n\r\n.item__text-mb {\r\n    margin-bottom: 3px;\r\n}\r\n\r\n.img__contenedor {\r\n    display: block;\r\n    width: 30.7px;\r\n    margin-left: 19px;\r\n    margin-right: 17.8px;\r\n}\r\n\r\n.mostrar {\r\n    opacity: 1;\r\n    transition: 0.6s;\r\n    visibility: visible;\r\n}\r\n\r\n.deslizar {\r\n    right: 0px;\r\n    transition: 0.6s;\r\n    box-shadow: -5px 0 6px 0 var(--opacity-50);\r\n}\r\n\r\n/* FIN Estilos MENU */\r\n\r\n/* Estilos Body */\r\n\r\n.body-user {\r\n    width: 100%;\r\n    min-height: calc(100vh - 136px - 60px);\r\n    z-index: 1;\r\n}\r\n\r\n/* FIN Estilos Body */\r\n\r\n/* Estilos footer home USER */\r\n\r\n._footer {\r\n    left: 0;\r\n    bottom: 0;\r\n    width: 100%;\r\n    height: 5.75rem;\r\n    /* 60px */\r\n    z-index: 0;\r\n}\r\n\r\n.footer__email,\r\n.footer__phone {\r\n    height: 23.5px;\r\n}\r\n\r\n.marca__text,\r\n.email__text,\r\n.phone__text,\r\n.version__text {\r\n    font-size: 16px;\r\n    font-weight: 600;\r\n    line-height: 21px;\r\n    text-align: left;\r\n    margin-left: 7.8px;\r\n}\r\n\r\n.marca__text--left {\r\n    margin-left: 19px;\r\n}\r\n\r\na.marca__text:hover {\r\n    text-decoration: underline;\r\n    color: white;\r\n}\r\n\r\n/* .footer__version {\r\n  position: absolute;\r\n  right: 19px;\r\n}\r\n\r\n.version__text::before {\r\n  content: '';\r\n  display: inline-block;\r\n  width: 21.25px;\r\n  height: 28.77px;\r\n  background: transparent;\r\n} */\r\n\r\n/* FIN Estilos footer home */\r\n\r\n@media (max-height: 657px) {\r\n    .body__slider {\r\n        height: 55vh;\r\n    }\r\n}\r\n\r\n@media (max-width: 599px) {\r\n    .card-container {\r\n        width: 80%;\r\n    }\r\n    .footer__version {\r\n        position: inherit;\r\n        text-align: center;\r\n    }\r\n}\r\n\r\n@media (max-width: 1380px) {\r\n    .marca__text,\r\n    .email__text,\r\n    .phone__text,\r\n    .version__text {\r\n        font-size: 15px;\r\n    }\r\n}\r\n\r\n@media (max-width: 1280px) {\r\n    .marca__text,\r\n    .email__text,\r\n    .phone__text,\r\n    .version__text {\r\n        font-size: 13px;\r\n    }\r\n}\r\n\r\n@media (max-width: 1130px) {\r\n    .marca__text,\r\n    .email__text,\r\n    .phone__text,\r\n    .version__text {\r\n        font-size: 11px;\r\n    }\r\n}\r\n\r\n/* FIN Estilos footer home  USER */\r\n\r\n@media(width: 1024px) {\r\n    .navbar__text {\r\n        font-size: 15px;\r\n    }\r\n}\r\n\r\n.scroll {\r\n    overflow-y: scroll;\r\n    max-height: calc( 100% - 142px);\r\n}\r\n\r\n.items--notificacion {\r\n    height: 82px;\r\n    cursor: default;\r\n}\r\n\r\n.noti {\r\n    padding: 11px;\r\n    border-bottom: 1px solid var(--grey-dark);\r\n}\r\n\r\n.item--notHover:hover {\r\n    background: var(--white);\r\n}\r\n\r\n.items--heigth {\r\n    height: 116px;\r\n}\r\n\r\n.cabecera__pildora {\r\n    border-radius: 20px;\r\n    padding: 0px 25px;\r\n    margin-left: 11px;\r\n    margin-bottom: 22px;\r\n}\r\n\r\n.menu__icon--notificacion {\r\n    display: block;\r\n    position: absolute;\r\n    top: 0;\r\n    right: -5px;\r\n    width: 18px;\r\n    height: 18px;\r\n    background: var(--accent-color);\r\n    color: var(--white);\r\n    border-radius: 50%;\r\n    text-align: center;\r\n    font-size: 12px;\r\n}\r\n\r\n.menu__icon--notificacion span {\r\n    position: relative;\r\n    top: 0px;\r\n    right: 0px;\r\n}\r\n\r\n.cabecera__close {\r\n    cursor: pointer;\r\n}\r\n\r\n.exitosa {\r\n    border: 1px solid var(--green-success);\r\n    background: var(--green-success-opacity);\r\n    color: var(--green-success);\r\n}\r\n\r\n.pendiente {\r\n    border: 1px solid var(--blue-slope);\r\n    background: var(--blue-slope-opacity);\r\n    color: var(--blue-slope);\r\n}\r\n\r\n.devuelta {\r\n    border: 1px solid var(--red);\r\n    background: var(--red-opacity);\r\n    color: var(--red);\r\n}\r\n/*# sourceMappingURL=data:application/json;base64, */");

