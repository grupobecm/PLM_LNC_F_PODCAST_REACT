/* harmony default export */ __webpack_exports__["default"] = ("<app-menu-administration-u fxFlex=\"16.66\"> </app-menu-administration-u>\r\n<!-- <div class=\"dashboard-admin\" fxFlex=\"83.33\" fxLayout=\"row wrap\" fxLayoutAlign=\"center start\" *ngIf=\"moral==true\">\r\n\r\n    <div class=\"regresar\" fxFlex=\"100\" fxLayoutAlign=\"space-between start\">\r\n        <div fxLayout=\"row wrap\" fxFlex=\"80\">\r\n            <h3 class=\"cuenta-eje | color-accent\" fxFlex=\"100\">{{ center_cost }}</h3>\r\n            <h4 class=\"cliente-externo margin-top | color-main\" fxFlex=\"100\">Solicitud de apertura de Cuenta Cliente Externo</h4>\r\n        </div>\r\n\r\n        <button class=\"regresar__button | color-third\" [routerLink]=\"['/administrador/cuentaeje/clientes-externos/lista-cliente-externo']\" routerLinkActive=\"active\">\r\n        Regresar\r\n        </button>\r\n    </div>\r\n\r\n    <div class=\"mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n        <nav class=\"nav-barA | background-grey-dark\" fxFlex=\"100\" fxLayoutAlign=\"space-between center\">\r\n            <ul class=\"navbar__menuA\" fxFlex=\"100\" fxLayoutAlign=\"center center\">\r\n                <li fxFlex=\"100\" class=\"navbar__itemsA\" [ngClass]=\"{'active': paso1}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\" (click)=\"alPaso1()\">\r\n                    <a class=\"navbar__textA | \">Información del cliente externo</a>\r\n                </li>\r\n                <li fxFlex=\"100\" class=\"navbar__itemsA\" [ngClass]=\"{'active': paso2}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\" (click)=\"alPaso2()\">\r\n                    <a class=\"navbar__textA | \">Representante legal</a>\r\n                </li>\r\n                <li fxFlex=\"100\" class=\"navbar__itemsA\" [ngClass]=\"{'active': paso3}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\" (click)=\"alPaso3()\">\r\