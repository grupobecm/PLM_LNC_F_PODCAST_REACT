    }
    submit() {
        this.submitt = true;
        if (this.form.invalid || Number(this.form.value.referencianumerica) < 1000000) {
            this.auxFlgBanco = 1;
            this.showLoad = false;
            return;
        }
        let data = {
            "cuenta_beneficiario": this.form.get("cuentabeneficiario").value,
            "monto": this.form.get("monto").value,
            "nombre_beneficiario": this.form.get("nombrebeneficiario").value,
            "banco_beneficiario_id": this.idbanco,
            "banco_beneficiario_name": this.banco,
            "referencia_numerica": this.form.get("referencianumerica").value,
            "concepto_pago": this.form.get("conceptopago").value,
            "rfc_curp_beneficiario": this.form.get("rfcurp").value == '' ? null : this.form.get("rfcurp").value,
            "email": this.form.get("email").value,
            "alias": this.form.get("alias").value,
            "is_frecuent": this.form.get('isFrecuent').value,
            "auth": {
                "token": ''
            }
        };
