let FormUserComponent = class FormUserComponent {
    constructor(router, data, dialog, dialogRef, formBuilder, serviceClient) {
        this.router = router;
        this.data = data;
        this.dialog = dialog;
        this.dialogRef = dialogRef;
        this.formBuilder = formBuilder;
        this.serviceClient = serviceClient;
        this.showLoad = false;
        //Atributos para recibir datos o relacionar mensajes con otros componentes
        this.formField = "";
        this.message = "";
        this.messageNormal = "";
        this.errores = null;
        this.unico = false;
        this.username = ""; //nombres de personas
        this.name = ""; // nombres de grupos, etc
        this.cuenta = "";
        this.monto = "";
        this.observacion = "";
        this.email = "";
        this.formField = data.form;
        this.message = data.message;
        this.messageNormal = data.messageNormal;
        this.errores = data.errores;
        this.unico = data.unico;
        this.username = data.username; // nombre de persona
        this.name = data.name; //nombre de institucion
        this.cuenta = data.cuenta;
        this.monto = data.monto;
        this.observacion = data.observacion;
        this.email = data.email;
        this.id = data.id;
        this.formReason1 = this.formBuilder.group({
            motivo: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_7__["Validators"].required]],
        });
    }
    closeAll() {
        this.dialog.closeAll();
    }
    submit() {
        if (this.formReason1.valid) {
            this.showLoad = true;
            this.serviceClient.deactivateExternalStaff(this.id, this.formReason1.value).subscribe(res => {
                this.dialogRef.close({ event: true });
                this.showLoad = false;
            }, error => {
                //console.log("Error",error);
                this.dialogRef.close({ event: false });
                this.showLoad = false;
            });
        }
        else {
            document.getElementById("motivo").focus();
        }
    }
    required(field) {
        if (this.formReason1.get(field).errors == null) {
            return false;
        }
        else {
            return true;
        }
    }
