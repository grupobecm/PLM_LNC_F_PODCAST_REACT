                this.nombre_beneficiario = res[0].nombre.replace("*", " ").replace("  ", " ");
                this.email_beneficiary = res[0].email;
            }
            else {
                this.form.get('cta_beneficiario').setValue("");
                this.nombre_beneficiario = '';
            }
            this.datalist2 = res;
            this.copyCompany2 = this.datalist2;
            for (let i = 0; i < this.datalist2.length; i++) {
                if (this.card == null) {
                    this.card = this.form.get('card_beneficiario').value;
                }
                this.datalist2[i].nombre = this.datalist2[i].nombre.replace("*", " ").replace("  ", " ");
                this.datalist2.tarjeta;
            }
        });
    }
    filtrarFrecuentes() {
        this.copyCompany = [];
        for (let i = 0; i < this.company.length; i++) {
            if (this.company[i].person__name.toLowerCase().includes(this.buscar.toLowerCase())) {
                this.copyCompany.push(this.company[i]);
            }
        }
        this.total = this.copyCompany.length;
    }
    filtrarFrecuentes2() {
        this.copyCompany2 = [];
        //console.log(this.datalist2.length)
        //console.log(this.buscar2)
        for (let i = 0; i < this.datalist2.length; i++) {
            if (this.datalist2[i].tarjeta.includes(this.buscar2)) {
                //console.log(this.datalist2[i]);
                this.copyCompany2.push(this.datalist2[i]);
            }
        }
        this.total2 = this.copyCompany2.length;
        //console.log(this.copyCompany2);
        //console.log(this.total2);
    }
    changeDatalist() {
        let nombre = this.form.get('nombre_beneficiario').value;
        //console.log(nombre);
        //console.log(this.company);
        for (let i = 0; i < this.company.length; i++) {
            //console.log(this.company);
            if (this.company[i].person_id === this.id__beneficiary) {
                this.form.get('cta_beneficiario').setValue(this.company[i].cuenta[0].cuenta);
                this.email_beneficiary = this.company[i].person__email;
                this.group_beneficiary = this.company[i].nombre_grupo;
                break;
            }
            else {
                this.form.get('cta_beneficiario').setValue("");
            }
        }
    }
};
