let ListBalanceUserComponent = class ListBalanceUserComponent {
    constructor(dialog, router, formBuilder, storageClient, serviceClient, storageHome, storage) {
        this.dialog = dialog;
        this.router = router;
        this.formBuilder = formBuilder;
        this.storageClient = storageClient;
        this.serviceClient = serviceClient;
        this.storageHome = storageHome;
        this.storage = storage;
        this.cuenta = "";
        //Tablas de Angular Material
        this.displayedColumns = ['id', 'monto', 'commission', 'total', 'estado', 'fecha', 'button'];
        this.listRequest = [];
        this.solicitudes = [];
        this.ningunDato = false;
        this.noData = false;
        this.numRegister = 0;
        this.showLoad = false;
        //Servicios de la Cuenta eje 
        this.commissionT = 0;
        this.percentageT = 0;
        this.productT = "";
        this.TP = "Tarjetas de Prepago";
        this.commissionTP = 0;
        this.productTP = "";
        this.percentageTP = 0;
        //---
        this.dataServices = "";
        this.dataServices2 = "";
        this.iva = 16;
        this.color = 'primary';
        this.maxall = 20;
        if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length >= 3) {
            //console.log('tp y t');
            //this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
            ////console.log(this.id);
            if (this.storageClient.InfoCostCenterExist == false) {
                //console.log("bye");
                this.dataService = JSON.parse(this.storage.infoUserValue);
                //Aqui va dialog para crear centros de costos
            }
            else {
                //console.log('si hay centros de costos');
                this.dataService = JSON.parse(this.storageClient.InfoCostCenterValue);
                this.id = this.dataService.persona_cuenta_id;
                this.listBalanceUser();
            }
        }
        else {
            if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    //console.log('tp');
                    this.dataService = JSON.parse(this.storage.infoUserValue);
                    this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
                    //console.log(this.id);
                    this.listBalanceUser();
                }
                else {
                    if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        //console.log('t');
                        //console.log(this.storageClient.InfoCostCenterExist);
                        if (this.storageClient.InfoCostCenterExist == false) {
                            //console.log("bye");
                            this.dataService = JSON.parse(this.storage.infoUserValue);
                        }
                        else {
                            //console.log("si hay servicios ");
                            this.dataService = JSON.parse(this.storageClient.InfoCostCenterValue);
                            this.id = this.dataService.persona_cuenta_id;
                            //console.log(this.dataService)
                            //console.log(this.dataService.persona_cuenta_id);
                            this.listBalanceUser();
                        }
                    }
                }
            }
        }
    }
    listBalanceUser() {
        this.showLoad = true;
        this.serviceClient.listRequestBalanceUser(this.id).subscribe(res => {
            //this.listRequest = new MatTableDataSource<Balance>(res);
            // //console.log(res[0]);
            //--- Servicios 
            //console.log('omision',res)
            this.commissions = res[0].comisiones;
            //console.log(this.commissions)
            this.dataServices = this.commissions[0].producto;
            // //console.log(this.dataServices);
            //En caso de haber 1 Servicio
            this.solicitudes = res[0].solicitudes;
            this.listRequest = new _angular_material_table__WEBPACK_IMPORTED_MODULE_11__["MatTableDataSource"](this.solicitudes);
            this.listRequest.sort = this.sort;
            this.listRequest.paginator = this.paginator;
            this.paginator._intl.itemsPerPageLabel = 'Filas por página';
            this.listRequest.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listRequest.data.length;
            // //console.log(this.numRegister);
            this.showLoad = false;
            // Validacion para hacer operaciones en html
            if (this.dataServices == this.TP) {
                // Servicios de Tarjetas Prepago
                this.commissionTP = this.commissions[0].Porcentaje;
                // //console.log('TP',this.commissionTP);
                this.negativa2 = this.commissions[0].Comision;
                if (this.dataServices != this.TP) {
                    // Servicios de Transferencias
                    this.commissionT = this.commissions[1].Porcentaje;
                    this.negativa = this.commissions[1].Comision;
                }
            }
            else {
                // Servicios de Transferencias
                this.commissionT = this.commissions[0].Porcentaje;
                // //console.log('T',this.commissionT);
                this.negativa = this.commissions[0].Comision;
                // //console.log('Comision T',this.negativa);
                if (this.commissions[1].producto == this.TP) {
                    // Servicios de Tarjetas Prepago
                    this.commissionTP = this.commissions[1].Porcentaje;
                    // //console.log('TP',this.commissionTP);
                    this.negativa2 = this.commissions[1].Comision;
                    // //console.log('Comision TP',this.negativa2);
                }
            }
        }, error => {
            this.showLoad = false;
            this.ningunDato = true;
            // //console.log(error.error)
        });
    }
    seeDetails(element, i) {
        // //console.log(element, i);
        this.showLoad = true;
        this.serviceClient.listRequestBalanceUser(JSON.parse(this.storageHome.infoUserValue).cuenta_id).subscribe(res => {
            // //console.log(res[0]);
            this.solicitudes = res[0].solicitudes;
            // //console.log("Solicidutdes",this.solicitudes[i]);
            this.showLoad = false;
            // Validacion para hacer operaciones en html
            if (this.dataServices == this.TP) {
                // Servicios de Tarjetas Prepago
                this.commissionTP = this.commissions[0].Porcentaje;
                // //console.log('TP',this.commissionTP);
                this.negativa2 = this.commissions[0].Comision;
                if (this.dataServices != this.TP) {
                    // Servicios de Transferencias
                    this.commissionT = this.commissions[1].Porcentaje;
                    this.negativa = this.commissions[1].Comision;
                }
            }
            else {
                // Servicios de Transferencias
                this.commissionT = this.commissions[0].Porcentaje;
                // //console.log('T',this.commissionT);
                this.negativa = this.commissions[0].Comision;
                // //console.log('Comision T',this.negativa);
                if (this.commissions[1].producto == this.TP) {
                    // Servicios de Tarjetas Prepago
                    this.commissionTP = this.commissions[1].Porcentaje;
                    // //console.log('TP',this.commissionTP);
                    this.negativa2 = this.commissions[1].Comision;
                    // //console.log('Comision TP',this.negativa2);
                }
            }
            this.dialog.open(_details_balnce_user_details_balnce_user_component__WEBPACK_IMPORTED_MODULE_19__["DetailsBalnceUserComponent"], {
                width: "544px",
                data: {
                    res: this.solicitudes[i],
                    type: 'L',
                    commission: this.commissionTP,
                    positive: this.negativa2
                },
                panelClass: ['custom-dialog-container'],
                disableClose: true,
            });
        }, error => {
            this.showLoad = false;
            //  //console.log(error);
        });
    }
    requestCards(data) {
        this.storageClient.setInfoExternalP(data);
        // //console.log(data);
        this.router.navigate(["/usuario/dispersiones/peronal-externo/asignar-tarjetas-personal-externo"]);
    }
    statusChange(dato) {
        // //console.log(dato);
        let question = this.dialog.open(_messageUser_questions_user_questions_user_component__WEBPACK_IMPORTED_MODULE_17__["QuestionsUserComponent"], {
            data: {
                question: 'D-001',
                username: dato.name,
                id: dato.id,
                //Mando true para mandar un motivo en la desactivacion
                motivo: true
            },
            disableClose: true,
        });
        question.afterClosed().subscribe(res => {
            if (res != undefined) {
                if (res.event) {
                    let form = this.dialog.open(_messageUser_form_user_form_user_component__WEBPACK_IMPORTED_MODULE_16__["FormUserComponent"], {
                        width: '500px',
                        data: {
                            form: 'D-001',
                            id: dato.id,
                            username: dato.name,
                        },
                        disableClose: true,
                    });
                    form.afterClosed().subscribe(res => {
                        if (res != undefined) {
                            if (res.event) {
                                // //console.log(dato.username);
                                let success = this.dialog.open(_messageUser_success_user_success_user_component__WEBPACK_IMPORTED_MODULE_18__["SuccessUserComponent"], {
                                    width: '500px',
                                    data: {
                                        success: 'D-003',
                                        username: dato.name,
                                    },
                                    disableClose: true
                                });
                                success.afterClosed().subscribe(res => {
                                    this.listBalanceUser();
                                });
                            }
                        }
                    });
                }
