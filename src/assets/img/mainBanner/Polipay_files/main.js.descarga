  border-bottom: 1px solid var(--third-color);\r\n}\r\n.submenu__item{\r\n    border-top: 1px solid var(--third-color);\r\n}\r\n.menu__item a{\r\n    display: block;\r\n    text-transform: uppercase;\r\n    padding: 13.5px 0px;\r\n    font-size: 16px;\r\n    line-height: 1.35;\r\n    text-align: left;\r\n    margin-left: 18px;\r\n}\r\n.triangulo{\r\n    width: 16px;\r\n    border-top: none;\r\n    border-left: 8px solid transparent;\r\n    border-right: 8px solid transparent;\r\n    border-bottom: 7px solid var(--main-color);\r\n    margin-right: 7px;\r\n    transition: 0.3s;\r\n}\r\n.girar{\r\n    transform: rotate(-180deg);\r\n    transition: 0.3s;\r\n}\r\n.menu__item:hover{\r\n    background: var(--white);\r\n    cursor: pointer;\r\n}\r\n.menu__item--hover:hover{\r\n    background: var(--third-color);\r\n    cursor: pointer;\r\n    color: var(--white);\r\n}\r\n.item--mt{\r\n    border-bottom: none;\r\n    margin-bottom: 0px;\r\n}\r\n.margin--top{\r\n    border-top: 1px solid var(--third-color);\r\n}\r\n.submenu{\r\n    list-style: none;\r\n    overflow: hidden;\r\n    height: 0;\r\n    transition: 0.3s;\r\n}\r\n.submenu__item a{\r\n    display: block;\r\n    text-transform: uppercase;\r\n    padding: 13.5px 0px;\r\n    font-size: 14px;\r\n    line-height: 1.35;\r\n    text-align: left;\r\n    margin-left: 18px;\r\n    color: var(--white);\r\n}\r\n.submenu__item:hover{\r\n    background: var(--third-color);\r\n    color: var(--white);\r\n    cursor: pointer;\r\n}\r\na:hover.color-white {\r\n  color: var(--white) !important;\r\n}\r\n/* FIN MENU */\r\n\r\n/*# sourceMappingURL=data:application/json;base64, */");

