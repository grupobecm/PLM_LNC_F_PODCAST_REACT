    //CAMPOS EN ROJO
    requeridoBanco() {
        if (this.form.get('banco').errors == null || this.auxFlgBanco == 0) {
            return false;
        }
        else {
            return true;
        }
    }
    requerido(campo) {
        if (this.form.get(campo).errors == null) {
            return false;
        }
        else {
            return true;
        }
    }
    //FIN CAMPOS EN ROJO
    mostrar() {
        if (this.flg) {
            document.getElementById("fondo").style.display = 'block';
            document.getElementById("lista").classList.add("mostrar");
            document.getElementById("select1").style.zIndex = "14";
            this.buscar = "";
            this.copyCompany = this.company;
            this.total = this.copyCompany.length;
            this.flg = false;
        }
        else {
            this.ocultar();
        }
    }
    ocultar() {
        document.getElementById("fondo").style.display = 'none';
        document.getElementById("lista").classList.remove("mostrar");
        this.flg = true;
    }
    mostrar2() {
        // //console.log("flag", this.flg);
        // //console.log("is_active", this.is_frecuent);
        if (this.flg) {
            if (this.guardar) {
                document.getElementById("fondo2").style.display = 'block';
                document.getElementById("lista2").classList.add("mostrar2");
                document.getElementById("select1").style.zIndex = "8";
                // if(this.is_frecuent == false){
                //   this.guardar = true;
