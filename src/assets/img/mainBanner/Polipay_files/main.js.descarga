    submit() {
        if (this.form.valid) {
            let jsonBackNew = {
                "representante_legal": {
                    "name": this.form.get('name').value,
                    "first_last_name": this.form.get('a_paterno').value,
                    "second_last_name": this.form.get('a_materno').value,
                    "fecha_nacimiento": this.form.get('fecha_nacimiento').value,
                    "rfc": this.form.get('rfc').value,
                    "email": this.form.get('email').value,
                    "phone": this.form.get('phone').value,
                },
                "domicilio_representante_legal": {
                    "codigopostal": this.form.get('codigopostal_rl').value,
                    "colonia": this.form.get('colonia_rl').value,
                    "alcaldia_mpio": this.form.get('alcaldia_mpio_rl').value,
                    "estado": this.form.get('estado_rl').value,
                    "calle": this.form.get('calle_rl').value,
                    "no_exterior": this.form.get('no_exterior_rl').value,
                    "no_interior": this.form.get('no_interior_rl').value
                },
                "DocumentsRepresentanteLegal": [
                    {
                        "TipoDocumentoId": 12,
                        "documento": this.file_
                    },
                    {
                        "TipoDocumentoId": 8,
                        "documento": this.file1_
                    },
                    {
                        "TipoDocumentoId": 5,
                        "documento": this.file2_
                    }
                ]
            };
            this.showLoad = true;
            this.serviceCC.newLegalRep(this.dataRLCenterCosto.idCenterCost, jsonBackNew).subscribe(res => {
                this.showLoad = false;
                //console.log(res);
                this.dialog.closeAll();
                let dialog = this.dialog.open(_messageUser_success_user_success_user_component__WEBPACK_IMPORTED_MODULE_19__["SuccessUserComponent"], {
                    width: '500px',
                    data: {
                        success: 'RL-001',
                        messageNormal: res.detail[0].message
                    },
                    disableClose: true,
                });
                dialog.afterClosed().subscribe(res => {
                    this.router.navigate(['/usuario/administration/costcenteruser/listcostcenter']);
                    this.dialog.closeAll();
                });
                let jsonBackRemove = {
                    "motivo": this.dataRLCenterCosto.motivo,
                    "ComprobanteDocumento": [
                        {
                            "TipoDocumento": 21,
                            "Documento": this.dataRLCenterCosto.ComprobanteDocumento[0].Documento,
                            "Comentario": this.dataRLCenterCosto.ComprobanteDocumento[0].Comentario
                        }
                    ]
                };
                this.showLoad = true;
                this.serviceCC.removeLegalRep(this.dataRLCenterCosto.idCenterCost, jsonBackRemove).subscribe(res => {
                    //console.log(res);
                    this.showLoad = false;
                }), error => {
                    //console.log(error);
                    this.showLoad = false;
                };
                ///-------
            }), error => {
                //console.log(error);
                this.showLoad = false;
            };
        }
        else {
            //console.log(this.form);
        }
    }
