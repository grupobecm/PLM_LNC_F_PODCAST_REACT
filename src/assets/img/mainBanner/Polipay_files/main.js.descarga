        ////console.log(this.numeroRegistrosaMostrar);
        if (this.numeroRegistrosaMostrar == 0) {
            this.numeroRegistrosaMostrar = this.total;
        }
        this.ListTransfer();
    }
    detalles(dato) {
        this.dialog.open(_third_transfer_status_details_details_component__WEBPACK_IMPORTED_MODULE_5__["DetailsComponent"], {
            width: '35%',
            data: {
                dato: dato
            },
            panelClass: 'custom-dialog-container',
