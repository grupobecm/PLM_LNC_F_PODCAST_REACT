let SentTComponent = class SentTComponent {
    constructor(serviceClient, dialog, storageClient, storage) {
        this.serviceClient = serviceClient;
        this.dialog = dialog;
        this.storageClient = storageClient;
        this.storage = storage;
        this.displayedColumns = ['id', 'nombre_beneficiario', 'monto', 'fecha_creacion', 'button'];
        this.listLiquidate = [];
        this.showLoad = false;
        this.noData = false;
        this.numRegister = 0;
        if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length >= 3) {
            //console.log('tp y t');
            // this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
            // //console.log(this.id);
            if (this.storageClient.InfoCostCenterExist == false) {
                //console.log("bye");
                this.dato = JSON.parse(this.storage.infoUserValue);
                //Aqui va dialog para crear centros de costos
            }
            else {
                //console.log('si hay centros de costos');
                this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
                //console.log(this.dato)
                //console.log(this.dato.persona_cuenta_id);
                this.idCenterC = this.dato.persona_cuenta_id;
                // this.saldoDisponible2=this.dato.monto;
            }
        }
        else {
            if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    //console.log('tp');
                    this.dato = JSON.parse(this.storage.infoUserValue);
                    this.idCenterC = this.dato.cuenta_id;
                }
                else {
                    if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        //console.log('t');
                        // this.flagT = true;
                        // this.flagTP = false;
                        // this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
                        // //console.log(this.id);
                        //console.log(this.storageClient.InfoCostCenterExist );
                        if (this.storageClient.InfoCostCenterExist == false) {
                            //console.log("bye");
                            this.dato = JSON.parse(this.storage.infoUserValue);
                            //Aqui va el dialog para llevar a crear centros de costos
                        }
                        else {
                            //console.log("si hay servicios ");
                            this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
                            //console.log(this.dato)
                            //console.log(this.dato.persona_cuenta_id);
                            // this.saldoDisponible2=this.dato.monto;
                            this.idCenterC = this.dato.persona_cuenta_id;
                            // this.saldoDisponible2=this.dato.monto;
                        }
                    }
                }
            }
        }
        // this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
        // this.idCenterC = this.dato.persona_cuenta_id
        //console.log(this.idCenterC);
        this.listTransferSent();
        // this.exportarXlsx();
        //console.log('Hola');
    }
    listTransferSent(size = 9999, id = this.idCenterC, state = 1, beneficiario = null, date1 = null, date2 = null) {
        this.showLoad = true;
        this.serviceClient.TransferDetailsIndividual(size, id, state, beneficiario, date1, date2).subscribe(res => {
            this.listLiquidate = new _angular_material_table__WEBPACK_IMPORTED_MODULE_10__["MatTableDataSource"](res.results);
            //console.log(res)
            this.showLoad = false;
            this.listLiquidate.sort = this.sort;
            this.listLiquidate.paginator = this.paginator;
            this.paginator._intl.itemsPerPageLabel = 'Filas por página';
            this.listLiquidate.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listLiquidate.data.length;
        }, error => {
            //console.log(error);
        });
    }
    openFilter() {
        let filtro = this.dialog.open(_filtro_sentd_ut_filtro_sentd_ut_component__WEBPACK_IMPORTED_MODULE_15__["FiltroSentdUTComponent"], {
            width: "90%",
            panelClass: "custom-dialog-container"
        });
        filtro.afterClosed().subscribe(res => {
            let benefy = null;
            let date1 = null;
            let date2 = null;
            //console.log(res);
            if (res == undefined) {
            }
            else {
                if (res != 'Reset filtro') {
                    for (let i = 0; i < res.data.filtro.length; i++) {
                        switch (res.data.filtro[i].campo) {
                            case 'Fecha de Operación':
                                date1 = (res.data.filtro[i].valor.begin).toISOString().split("T")[0];
                                date2 = (res.data.filtro[i].valor.end).toISOString().split("T")[0];
                                break;
                            case 'Beneficiario':
                                benefy = res.data.filtro[i].valor;
                                break;
                        }
                    }
                }
            }
            //console.log(date1, date2);
            let size = 9999;
            let id = this.idCenterC;
            let state = 1;
            date1 = date1;
            date2 = date2;
            benefy = benefy;
            this.listTransferSent(size, id, state, benefy, date1, date2);
        });
    }
    exportarXlsx(id = this.idCenterC, idtype = 2, name = null, clabe = null, nameBenefy = null, date1 = null, date2 = null, status = 1) {
        this.showLoad = true;
        this.serviceClient.exportXlsx(id, idtype, name, clabe, nameBenefy, date1, date2, status, null).subscribe(res => {
            //console.log(res.detail[0].data);
            window.open(res.detail[0].data, "_blank");
            this.showLoad = false;
        }, error => {
            this.showLoad = false;
            //console.log(error);
        });
    }
    seeDetails(element) {
        // //console.log(element);
        this.dialog.open(_details_sentd_ut_details_sentd_ut_component__WEBPACK_IMPORTED_MODULE_14__["DetailsSentdUTComponent"], {
            width: "550px",
            data: {
                dato: element,
                type: 'L'
            },
            panelClass: ['custom-dialog-container'],
            disableClose: true
        });
    }
    ngOnInit() {
    }
};
