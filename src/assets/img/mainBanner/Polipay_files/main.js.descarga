                PersonList: [],
                is_schedule: this.form.get("is_schedule").value,
                schedule: fecha,
                MontoTotal: this.form.get("monto").value,
                NombreGrupo: this.group_beneficiary,
            };
            if (this.arrayJsonPABack.length == 0) {
                data.PersonList = [];
            }
            else {
                data.PersonList = this.arrayJsonPABack;
            }
