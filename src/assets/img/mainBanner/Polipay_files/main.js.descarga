                this.showLoad = true;
                this.serviceAdmin.returnCardsIntecc(card).subscribe(res => {
                    this.showLoad = false;
                    //console.log(res)
                    this.datalist = res;
                    //console.log(this.datalist);
                });
            }
        }
    }
    addCards() {
        let card = this.form.get('razon_social').value;
        if (card.length == 16 && !this.asignar.includes(card) && !this.assignCards.includes(card)) {
            //console.log(card);
            this.asignar.push(card);
            this.form.reset();
            if ((this.asignar.length + this.assignCards.length) >= this.limite) {
                document.getElementById("searchCardField").classList.add("disabled");
                this.form.get('razon_social').setValue("   ");
