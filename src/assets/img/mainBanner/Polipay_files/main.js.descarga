                            username: dato.name,
                        },
                        disableClose: true,
                    });
                    form.afterClosed().subscribe(res => {
                        if (res != undefined) {
                            if (res.event) {
                                //console.log(dato.username);
                                let success = this.dialog.open(src_app_Views_user_messageUser_success_user_success_user_component__WEBPACK_IMPORTED_MODULE_19__["SuccessUserComponent"], {
                                    width: '500px',
                                    data: {
                                        success: 'D-003',
                                        username: dato.name,
                                    },
                                    disableClose: true,
                                });
                                success.afterClosed().subscribe(res => {
                                    this.listPersonal();
                                });
                            }
                        }
                    });
                }
            }
        });
    }
};
