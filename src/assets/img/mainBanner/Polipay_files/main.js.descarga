    openFilter() {
        let filtro = this.dialog.open(_filter_beneficiary_user_filter_beneficiary_user_component__WEBPACK_IMPORTED_MODULE_19__["FilterBeneficiaryUserComponent"], {
            width: "90%",
            panelClass: "custom-dialog-container",
        });
        filtro.afterClosed().subscribe((res) => {
            //console.log('Ventana', res);
            if (res != undefined) {
                let filtro = null;
                let name = null;
                let curp = null;
                let email;
                let status;
                let idByCompany;
                let company;
                let id_centroCostos;
                let id_cuentaWallet;
                let id_Benificiario;
                let num_cards = null;
                let creation_date1 = null;
                let creation_date2 = null;
                this.date01 = null;
                this.date02 = null;
                if (res == undefined) {
                }
                else {
                    if (res != "Reset filtro") {
                        for (let i = 0; i < res.data.filtro.length; i++) {
                            switch (res.data.filtro[i].campo) {
                                case "Nombre del Beneficiario":
                                    name = res.data.filtro[i].valor;
                                    filtro = "?id=0AIKQ1A";
                                    break;
                                case "CURP":
                                    curp = res.data.filtro[i].valor;
                                    filtro = `?curp=${curp}`;
                                    break;
                                case "Email":
                                    email = res.data.filtro[i].valor;
                                    filtro = `?email=${email}`;
                                    break;
                                case "Status":
                                    status = res.data.filtro[i].valor;
                                    filtro = `?status=${status}`;
                                    break;
                                case "idByCompany":
                                    idByCompany = res.data.filtro[i].valor;
                                    filtro = `?idByCompany=${idByCompany}`;
                                    break;
                                case "company":
                                    company = res.data.filtro[i].valor;
                                    filtro = `?company=${company}`;
                                    break;
                                case "id_centroCostos":
                                    id_centroCostos = res.data.filtro[i].valor;
                                    filtro = `?id_centroCostos=${id_centroCostos}`;
                                    break;
                                case "id_cuentaWallet":
                                    id_cuentaWallet = res.data.filtro[i].valor;
                                    filtro = `?id_cuentaWallet=${id_cuentaWallet}`;
                                    break;
                                case "id_Benificiario":
                                    id_Benificiario = res.data.filtro[i].valor;
                                    filtro = `?id_Benificiario=${id_Benificiario}`;
                                    break;
                                case "Fecha de Creación":
                                    creation_date1 = res.data.filtro[i].valor.begin;
                                    creation_date2 = res.data.filtro[i].valor.end;
                                    this.date01 =
                                        creation_date1.getFullYear() +
                                            "-" +
                                            ((creation_date1.getMonth() + 1).toString().length > 1
                                                ? creation_date1.getMonth() + 1
                                                : "0" + (creation_date1.getMonth() + 1)) +
                                            "-" +
                                            (creation_date1.getDate().toString().length > 1
                                                ? creation_date1.getDate()
                                                : "0" + creation_date1.getDate());
                                    this.date02 =
                                        creation_date2.getFullYear() +
                                            "-" +
                                            ((creation_date2.getMonth() + 1).toString().length > 1
                                                ? creation_date2.getMonth() + 1
                                                : "0" + (creation_date2.getMonth() + 1)) +
                                            "-" +
                                            (creation_date2.getDate().toString().length > 1
                                                ? creation_date2.getDate()
                                                : "0" + creation_date2.getDate());
                                    break;
                                case "Número de tarjetas":
                                    num_cards = res.data.filtro[i].valor;
                                    break;
                            }
                        }
                    }
                }
                // //console.log(this.date01);
                // //console.log(this.date02);
                // //console.log(name);
                // //console.log(num_cards);
                // //console.log(creation_date1);
                // //console.log(creation_date2);
                this.showLoad = true;
                this.serviceClient
                    .externalPersonnelFilter(9999, this.date01, this.date02, name, true, num_cards, this.id)
                    .subscribe((res) => {
                    //console.log(res);
                    this.ningunDato = false;
                    res.forEach((element) => {
                        if (res.surname != null || res.surname != undefined) {
                            element.person__last_name = `${res.name} ${res.surname}`;
                        }
                    });
                    this.listStaffExternal =
                        new _angular_material_table__WEBPACK_IMPORTED_MODULE_11__["MatTableDataSource"](res);
