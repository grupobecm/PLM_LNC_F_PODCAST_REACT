nto</p>\r\n                </div>\r\n                <div fxFlex=\"55\" fxLayoutAlign=\"start center\">\r\n                    <p class=\"dato | color-third\">{{ amount | currency }} MXN</p>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"borderb\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"45\" fxLayoutAlign=\"start center\">\r\n                    <p class=\" | color-main\">Concepto</p>\r\n                </div>\r\n                <div fxFlex=\"55\" fxLayoutAlign=\"start center\">\r\n                    <p class=\"dato | color-third\">{{ concept }}</p>\r\n                </div>\r\n            </div>\r\n            <div class=\"borderb\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"45\" fxLayoutAlign=\"start center\">\r\n                    <p class=\" | color-main\">Referencia</p>\r\n                </div>\r\n                <div fxFlex=\"55\" fxLayoutAlign=\"start center\">\r\n                    <p class=\"dato | color-third\">{{ reference }}</p>\r\n                </div>\r\n            </div>\r\n            <div class=\"borderb\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"45\" fxLayoutAlign=\"start center\">\r\n                    <p class=\" | color-main\">Fecha y hora</p>\r\n                </div>\r\n                <div fxFlex=\"55\" fxLayoutAlign=\"start center\">\r\n                    <p class=\"dato | color-third\">{{ dispersion_date | date: 'd/M/yyyy HH:mm' }} horas</p>\r\n                </div>\r\n            </div>\r\n            <div class=\"borderb\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"45\" fxLayoutAlign=\"start center\">\r\n                    <p class=\" | color-main\">Tipo de operación</p>\r\n                </div>\r\n                <div fxFlex=\"55\" fxLayoutAlign=\"start center\">\r\n                    <p class=\"dato | color-third\">{{type_operation}}</p>\r\n                </div>\r\n           