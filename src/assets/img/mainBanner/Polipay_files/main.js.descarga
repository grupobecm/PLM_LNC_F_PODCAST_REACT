          </ul>\r\n                </nav>\r\n            </div>\r\n    \r\n            <div *ngIf=\"paso1\" class=\"verificacion mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between start\">\r\n                <div class=\"datos\" fxFlex=\"29\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between space-between\">\r\n                    <div>\r\n                        <div>\r\n                            <span class=\"text color-60\">Nombre</span>\r\n                            <p class=\"subtitle | color-74\"><b>{{ client.cliente }}</b></p>\r\n                        </div>\r\n                        <div>\r\n                            <span class=\"text color-60\">Correo Electrónico</span>\r\n                            <p class=\"subtitle | color-74\"><b>america.monsalvo@polimentes.com</b></p>\r\n                        </div>\r\n                        <div>\r\n                            <span class=\"text color-60\">Número Telefónico</span>\r\n                            <p class=\"subtitle | color-74\"><b>9934723892</b></p>\r\n                        </div>\r\n                        <div>\r\n                            <span class=\"text color-60\">Permiso</span>\r\n                            <p class=\"subtitle | color-74\"><b>Capturar</b></p>\r\n                        </div>\r\n                    </div>\r\n                    \r\n                    <div class=\"domicilio\">\r\n                        <span class=\"text-centro text-centro--margin-bottom | color-main\">Centros de Costos ASIGNADOS</span>\r\n                        <p class=\"subtitle subtible-margin--left | color-74\" *ngFor=\"let item of client.centro_costos \">\r\n                            <b>{{ item.nombre }}</b>\r\n                        </p>\r\n                    </div>\r\n                </div>\r\n    \r\n                <div fxFlex=\"69\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"100\">\r\n                        <p class=\"text-centro | color-accent\">DOCUMENTOS</p>\r\n                    </div>\r\n                    <div fxFlex=\"100\" fxLayout=\"row\">\r\n    \r\n                        <div fxFlex=\"100\" class=\"contenedor\" fxLayout=\"row wrap\">\r\n                            <div class=\"documents\" fxFlex=\"100\">\r\n                                \r\n                                <ngx-extended-pdf-viewer [(src)]=\"pdf\" [useBrowserLocale]=\"true\" zoom=\"50%\" [height]=\"'40vh'\" backgroundColor=\"#404040\" theme=\"dark\"></ngx-extended-pdf-viewer>\r\n\r\n                                <div class=\"mt-3\" fxLayout=\"row wrap\">\r\n                                    <div class=\"mb-2\" fxFlex=\"100\">\r\n                                        <p class=\"mensajeObl mensajeObl--12\">Los campos marcados con * son obligatorios</p>\r\n                                    </div>\r\n                                    <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                                        <mat-radio-group fxFlex=\"100\" fxLayoutAlign=\"start center\" [(ngModel)]=\"radioBoton\">\r\n                                            <mat-radio-button class=\"radioBotones\" value=\"p\" [checked]=\"true\">Pendiente</mat-radio-button>\r\n                                            <mat-radio-button class=\"radioBotones\" value=\"e\">Correcto</mat-radio-button>\r\n                                            <mat-radio-button class=\"radioBotones\" value=\"d\">Devolver documento</mat-radio-button>\r\n                                        </mat-radio-group>\r\n    \r\n                                        <!-- Motivo -->\r\n    \r\n                                        <div *ngIf=\"click()\" fxFlex=\"100\">\r\n                                            <div class=\"form\" fxFlex=\"100\">\r\n                                                <span class=\"form__text user | font-roboto\">Motivo de la devolución*</span>\r\n                                                <textarea class=\"form