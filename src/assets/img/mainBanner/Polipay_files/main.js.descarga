let IncomeMovementsDisUserComponent = class IncomeMovementsDisUserComponent {
    constructor(serviceClient, dialog, storageClient, storageClient2, serviceAdmin) {
        this.serviceClient = serviceClient;
        this.dialog = dialog;
        this.storageClient = storageClient;
        this.storageClient2 = storageClient2;
        this.serviceAdmin = serviceAdmin;
        // public displayedColumns: string[] = ['nombre_beneficiario', 'concepto', 'numCuenta', 'monto', 'saldo_remanente', 'fecha_creacion'];
        this.displayedColumns = ['nombre_beneficiario', 'concepto', 'numCuenta', 'monto', 'saldo_remanente', 'fecha_creacion'];
        this.listPending = [];
        this.showLoad = false;
        this.ningunDato = false;
        this.noData = false;
        this.numRegister = 0;
        this.servicesTP = true;
        if (JSON.parse(this.storageClient.infoUserValue).data_empresa.commissions.length >= 3) {
            //console.log('tp y t');
            //this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
            ////console.log(this.id);
            if (this.storageClient2.InfoCostCenterExist == false) {
                //console.log("bye");
                this.dataService = JSON.parse(this.storageClient.infoUserValue);
                //Aqui va dialog para crear centros de costos
            }
            else {
                //console.log('si hay centros de costos');
                this.dataService = JSON.parse(this.storageClient2.InfoCostCenterValue);
                this.id = this.dataService.persona_cuenta_id;
                this.servicesTP = false;
            }
        }
        else {
            if (JSON.parse(this.storageClient.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storageClient.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    //console.log('tp');
                    //console.log(JSON.parse(this.storageClient.infoUserValue));
                    this.dataService = JSON.parse(this.storageClient.infoUserValue);
                    this.id = this.dataService.cuenta_id;
                    //console.log(this.id);
                    this.servicesTP = true;
                }
                else {
                    if (JSON.parse(this.storageClient.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        //console.log('t');
                        //console.log(this.storageClient2.InfoCostCenterExist);
                        if (this.storageClient2.InfoCostCenterExist == false) {
                            //console.log("bye");
                            //console.log(JSON.parse(this.storageClient.infoUserValue));
                            this.dataService = JSON.parse(this.storageClient.infoUserValue);
                        }
                        else {
                            //console.log("si hay servicios ");
                            this.dataService = JSON.parse(this.storageClient2.InfoCostCenterValue);
                            this.id = this.dataService.persona_cuenta_id;
                            //console.log(this.dataService)
                            //console.log(this.dataService.persona_cuenta_id);
                            this.servicesTP = true;
                        }
                    }
                }
            }
        }
        this.AllRecordsRispersions();
    }
    AllRecordsRispersions(size = 9999, date1 = null, date2 = null) {
        this.showLoad = true;
        this.serviceClient.listIncomeMovements(size, this.id, date1, date2).subscribe(res => {
            this.listPending = new _angular_material_table__WEBPACK_IMPORTED_MODULE_9__["MatTableDataSource"](res.results);
            //console.log(res.results);
            this.listPending.sort = this.sort;
            this.listPending.paginator = this.paginator;
            this.paginator._intl.itemsPerPageLabel = 'Filas por página';
            this.listPending.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listPending.data.length;
            //console.log(this.numRegister);
            this.showLoad = false;
        }, error => {
            this.numRegister = 0;
            this.noData = true;
        });
    }
    ngOnInit() {
    }
    openFilter() {
        let filtro = this.dialog.open(_filter_movements_dispersion_u_filter_movements_dispersion_u_component__WEBPACK_IMPORTED_MODULE_15__["FilterMovementsDispersionUComponent"], {
            width: "40%",
            panelClass: "custom-dialog-container"
        });
        filtro.afterClosed().subscribe(res => {
            let date1 = null;
            let date2 = null;
            //console.log(res);
            date1 = res.data.date1F;
            date2 = res.data.date2F;
            //console.log(date1);
            //console.log(date2);
            this.AllRecordsRispersions(9999, date1, date2);
        });
    }
    exportExcel(tipo) {
        const titulosExcel = ['Beneficiario', 'Concepto', 'Número Cuenta', 'Monto', 'Saldo Remanente', 'Fecha y Hora Operación'];
        let lista = [];
        const datos = this.listPending.filteredData;
        if (datos.length > 0) {
            for (let i = 0; i < datos.length; i++) {
                let saldo = 0;
                if (datos[i].saldo_remanente == null) {
                    saldo = datos[i].saldo_remanente_beneficiario;
                }
                else {
                    saldo = datos[i].saldo_remanente;
                }
                lista[i] = [datos[i].nombre_beneficiario, datos[i].concepto_pago, datos[i].cta_beneficiario, datos[i].monto + ',' + datos[i].tipo_movimiento, saldo, moment__WEBPACK_IMPORTED_MODULE_16__(datos[i].fecha_creacion).format('DD/MM/YYYY HH:mm') + 'Hrs.'];
            }
