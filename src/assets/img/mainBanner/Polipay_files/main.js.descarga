/* harmony default export */ __webpack_exports__["default"] = ("<div class=\"container-heigth\">\r\n\r\n<app-menu-admin fxFlex=\"16.66\"></app-menu-admin>\r\n<!-- FIN Barra menu lateal (numero de cuenta y clabe) -->\r\n\r\n<div class=\"dashboard-admin \" fxFlex=\"83.33\" fxLayout=\"row wrap\" fxLayoutAlign=\"start space-between\">\r\n    <div fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center start\">\r\n            <div class=\"regresar\" fxFlex=\"100\" fxLayoutAlign=\"space-between start\">\r\n            <div fxLayout=\"row wrap\">\r\n                <h3 class=\"cuenta-eje | color-accent\" fxFlex=\"100\">{{ center_cost }}</h3>\r\n                <h4 class=\"cliente-externo margin-top | color-main\" fxFlex=\"100\">Solicitud de Baja de Cliente Externo</h4>\r\n            </div>\r\n\r\n            <button class=\"regresar__button | color-third\" (click)=\"regresar()\">\r\n                Regresar\r\n            </button>\r\n        </div>\r\n        <!--MENU -->\r\n        <div class=\"mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n            <nav class=\"nav-barA | background-grey-dark\" fxFlex=\"100\"fxLayoutAlign=\"space-between center\">\r\n                <ul class=\"navbar__menuA\" fxFlex=\"100\" fxLayoutAlign=\"center center\">\r\n                    <li fxFlex=\"100\" class=\"navbar__itemsA\" [ngClass]=\"{'active': paso1}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                        <a class=\"navbar__textA | \">Descripción de la baja</a>\r\n                    </li>\r\n                    <li fxFlex=\"100\" class=\"navbar__itemsA\" [ngClass]=\"{'active': paso2}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                        <a class=\"navbar__textA | \">Resultado de verificacion</a>\r\n                    </li>\r\n                </ul>\r\n            </nav>\r\n        </div>\r\n\r\n        <div *ngIf=\"paso1\" class=\"verificacion mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between start\">\r\n            <div class=\"datos\" fxFlex=\"29\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between space-between\">\r\n                <div>\r\n                    <div>\r\n                        <span class=\"text color-60\">{{nameType}}</span>\r\n                        <p class=\"subtitle | color-74\"><b>{{solData.name}}</b></p>\r\n                    </div>\r\n                    <div>\r\n                        <span class=\"text color-60\">R.F.C.</span>\r\n                        <p class=\"subtitle | color-74\"><b>{{solData.rfc}}</b></p>\r\n                    </div>\r\n                    <div>\r\n                        <span class=\"text color-60\">{{nameType1}}</span>\r\n                        <p class=\"subtitle | color-74\"><b>{{solData.clabe}}</b></p>\r\n                    </div>\r\n                    <div>\r\n                        <span class=\"text color-60\">{{nameType2}}</span>\r\n                        <p class=\"subtitle | color-74\"><b>{{solData.bank}}</b></p>\r\n                    </div>\r\n                </div>\r\n                \r\n                <div class=\"domicilio\">\r\n                    <span class=\"text-centro | color-accent\">{{nameType3}}</span>\r\n                    <p class=\"subtitle | color-74\"><b>{{solData.address}}</b></p>\r\n                </div>\r\n            </div>\r\n\r\n            <div fxFlex=\"69\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"100\">\r\n                    <p class=\"text-centro | color-accent\">DOCUMENTOS</p>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row\">\r\n                    <div fxFlex=\"30\">\r\n                        <nav class=\"nav-barAD | \" fxFlex=\"100\" fxLayoutAlign=\"center start\">\r\n                            <ul class=\"navbar__menuAD\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento1()\" [ngClass]=\"{'activeD1': document1}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                                    <a class=\"navbar__textAD | \">Motivo de baja</a>\r\n                                </li>\r\n                                <li fxFlex=\"100\" class=\"navbar__itemsAD\" (click)=\"Documento2()\" [ngClass]=\"{'activeD1': document2}\" fxLayout=\"row\" fxLayoutAlign=\"center center\" routerLinkActive=\"active\">\r\n                                    <a class=\"navbar__textAD | \">Documento de evidencia</a>\r\n                                </li>\r\n                            </ul>\r\n                        </nav>\r\n                    </div>\r\n\r\n                    <div fxFlex=\"70\" class=\"contenedor\" fxLayout=\"row wrap\">\r\n                        <div class=\"documents\">\r\n\r\n                            <div *ngIf=\"document1\" class=\"pdf-container mt-2\" fxLayout=\"row wrap\">\r\n                                <span class=\"documento__titulo\" fxFlex=\"100\">{{ asunto_documento }}</span>\r\n                                <p class=\"documento__texto\" fxFlex=\"100\">{{ documento_motivo }}</p>\r\n                                <div class=\"block-space\" fxFlex=\"100\">\r\n                                        \r\n                                </div>\r\n                            </div>\r\n                            <div *ngIf=\"document2\" class=\"pdf-container mt-2\">\r\n                                <ngx-extended-pdf-viewer [(src)]=\"pdf\" [useBrowserLocale]=\"true\" zoom=\"50%\" [height]=\"'40vh'\" backgroundColor=\"#404040\" theme=\"dark\"></ngx-extended-pdf-viewer>\r\n                            </div>\r\n\r\n                            <div  *ngIf=\"document2\" class=\"mt-3\" fxLayout=\"row wrap\">\r\n                                <div class=\"mb-2\" fxFlex=\"100\">\r\n                                    <p class=\"mensajeObl mensajeObl--12\">Los campos marcados con * son obligatorios</p>\r\n                                </div>\r\n                                <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                                    <mat-radio-group fxFlex=\"100\" fxLayoutAlign=\"space-between center\" [(ngModel)]=\"radioBoton\">\r\n                                        <mat-radio-button value=\"p\" [checked]=\"true\">Pendiente</mat-radio-button>\r\n                                        <mat-radio-button value=\"e\">Correcto</mat-radio-button>\r\n                                        <mat-radio-button value=\"d\">Devolver documento</mat-radio-button>\r\n                                    </mat-radio-group>\r\n\r\n                                    <!-- Motivo -->\r\n\r\n                                    <div *ngIf=\"click()\" fxFlex=\"100\">\r\n                                        <div class=\"form\" fxFlex=\"100\">\r\n                                            <span class=\"form__text user | font-roboto\">Motivo de la devolución*</span>\r\n                                            <textarea class=\"formCon__input user | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"motivoDevolucion\" [(ngModel)]=\"motivoDevolucion\" required></textarea>\r\n                                        </div>\r\n                                    </div>\r\n\r\n                                    <div *ngIf=\"!click()\" fxFlex=\"100\">\r\n                                        <div class=\"block-space\" fxFlex=\"100\">\r\n                                        \r\n                                        </div>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div *ngIf=\"paso2\" class=\"verificacion mt-3 container-heigth\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between start\">\r\n\r\n                <div fxLayout=\"column\" fxFlex=\"100\">\r\n                    <span class=\"text color-60\">Razón Social</span>\r\n                    <p class=\"subtitle | color-74\"><b>{{ client }}</b></p>\r\n                </div>\r\n\r\n                <div fxFlex=\"49\" fxLayout=\"row wrap\">\r\n                    <div class=\"contenedor-estado-documentos\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"none start\">\r\n                        <div fxFlex=\"100\">\r\n                            <p class=\"contenedor__texto  color-accent\"><b>Documentos del Representante Legal</b></p>\r\n                        </div>\r\n                        \r\n                        <div class=\"estado-documentos__estado\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between center\">\r\n                            <p class=\"estado__texto | color-third\">Documento de Evidencia</p>\r\n                            <p class=\"estado__estado | color-third\">Estado:  <span class=\"correcto-incorrecto\" [ngClass]=\"estado[documento_evidencia].valor ? 'color-green' : 'color-red-return'\"> {{ estado[documento_evidencia].texto }}</span></p>\r\n                            <div *ngIf=\"!estado[documento_evidencia].valor\" class=\"estado__motivo\" fxFlex=\"100\">\r\n                                <p class=\"motivo motivo--upercase | color-third\">Motivo de devolución:</p>\r\n                                <p class=\"motivo | color-third\">{{ motivo_documento_evidencia }}</p>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n                <div fxFlex=\"49\" fxLayout=\"row wrap\">\r\n                    <div class=\"contenedor-resultado\" [ngClass]=\"estado[documento_evidencia].valor ? 'altura' : ''\" fxLayout=\"row wrap\" fxLayoutAlign=\"none start\">\r\n                        <div fxFlex=\"100\">\