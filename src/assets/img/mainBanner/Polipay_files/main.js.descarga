ncept}}</td>\r\n                    </tr>\r\n                    <tr class=\"tr | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                        <td class=\"th th--ml  th--content | color-main\" fxFlex=\"100\">Referencia</td>\r\n                        <td class=\"th th--align-right th--content | color-third\" fxFlex=\"100\">000</td>\r\n                    </tr>\r\n\r\n                </tbody>\r\n                <!-- FIN CONTENIDO -->\r\n            </table>\r\n\r\n        </div>\r\n\r\n        <!-- Verification code -->\r\n        <form [formGroup]=\"form\" (ngSubmit)=\"submit()\" fxFlex=\"42\" fxLayout=\"row wrap\">\r\n            <div fxFlex=\"100\" fxLayoutAlign=\"center center\">\r\n                <p class=\"color-red msj-confirmar\" translate>User.Messages.MessagesToken</p>\r\n            </div>\r\n            <!-- Verification code -->\r\n            <div class=\"form__code code\" fxFlex=\"100\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                <input class=\"code__input input--ax | font-roboto color-second\" type=\"password\" placeholder=\"*\"\r\n                    formControlName=\"code1\" maxlength=\"1\" id=\"code1\" (keyup)=\"jump($event, 'code2')\" autocomplete=\"off\">\r\n                <input class=\"code__input input--ml | font-roboto color-second\" type=\"password\" placeholder=\"*\"\r\n                    formControlName=\"code2\" maxlength=\"1\" id=\"code2\" (keyup)=\"jump($event, 'code3')\" autocomplete=\"off\">\r\n                <input class=\"code__input input--ml | font-roboto color-second\" type=\"password\" placeholder=\"*\"\r\n                    formControlName=\"code3\" maxlength=\"1\" id=\"code3\" (keyup)=\"jump($event, 'code4')\" autocomplete=\"off\">\r\n                <input class=\"code__input input--ml | font-roboto color-second\" type=\"password\" placeholder=\"*\"\r\n                    formControlName=\"code4\" maxlength=\"1\" id=\"code4\" (keyup)=\"jump($event, 'submit')\"\r\n     