m__text_alert': (requeridoTelefono() && form.get('phone').touched) }\" translate>Número Telefónico*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoTelefono() && form.get('phone').touched) }\" autocomplete=\"off\" type=\"text\" name=\"phone\" id=\"phone\" formControlName=\"phone\"\r\n                             required>\r\n                        <div class=\" alertTransfer\" *ngIf=\"requeridoTelefono() && form.get('phone').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el teléfono del colaborador</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space form--password-mt\" fxFlex=\"33\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoCorreo() && form.get('email').touched) }\" translate>Correo Electrónico*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoCorreo() && form.get('email').touched) }\" autocomplete=\"off\" id=\"email\" type=\"email\" name=\"email\" formControlName=\"email\" \r\n                            required>\r\n                        <div class=\" alertTransfer\" *ngIf=\"requeridoCorreo() && form.get('email').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el correo electrónico</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space form--password-mt\" fxFlex=\"33\" fxLayout=\"row wrap\">\r\n                        <div class=\"fecha\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                            <p class=\"form__date label_fecha pass | font-roboto\" [ngClass]=\"{ 'form__date_alert': (form.get('fecha_nacimiento').hasError('requerido') && form.get('fecha_nacimie