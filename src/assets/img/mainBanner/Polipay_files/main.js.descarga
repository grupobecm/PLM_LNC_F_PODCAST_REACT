    onSubmit() {
        let campos = document.getElementsByClassName("input_select");
        for (let i = 0; i < campos.length; i++) {
            this.form.value.filtro[i].campo = document.getElementsByClassName("input_select")[i].innerHTML;
        }
        //console.log("->",this.form.value);
        this.dialogRef.close({ data: this.form.value });
    }
    // Si el elemento del select se encuentra dentro del arreglo arrayindividual lo muestra,
    // si no, no lo muestra. Esto es para no mostrar campos ya usados/repetidos
    usadoIndividual(item) {
        if (this.arrayindividual.includes(item)) {
            return true;
        }
        return false;
    }
    // Muestra el icono de + dependiendo si es individual o masiva
    aparecer(i) {
        if (i == this.t.length - 1 && i < 1) {
            return true;
        }
        return false;
    }
    // Logica del select
    //Muestra el select
    mostrar(i) {
        let aux = this.arrayindividual.every(element => element == null);
