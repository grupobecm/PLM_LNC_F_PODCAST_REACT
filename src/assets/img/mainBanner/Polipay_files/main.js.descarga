    exportExcel(tipo) {
        const titulosExcel = ['Beneficiario', 'Concepto', 'Número Cuenta', 'Monto', 'Saldo Remanente', 'Fecha y Hora Operación'];
        let lista = [];
        const datos = this.listPending.filteredData;
        if (datos.length > 0) {
            for (let i = 0; i < datos.length; i++) {
                let saldo = 0;
                if (datos[i].saldo_remanente == null) {
                    saldo = datos[i].saldo_remanente_beneficiario;
                }
                else {
                    saldo = datos[i].saldo_remanente;
                }
                lista[i] = [datos[i].nombre_beneficiario, datos[i].concepto_pago, datos[i].cta_beneficiario, datos[i].monto + ',' + datos[i].tipo_movimiento, saldo, moment__WEBPACK_IMPORTED_MODULE_15__(datos[i].fecha_creacion).format('DD/MM/YYYY HH:mm') + 'Hrs.'];
            }
            this.serviceAdmin.generateExcelAsistentes('Reporte de Ingresos', 'Ingresos', titulosExcel, lista, tipo);
        }
        else {
            this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_16__["ErrorUserComponent"], {
                data: {
                    error: 'RPT-001',
                    messageNormal: 'El documento no se puede generar, no hay registros'
                },
                disableClose: true
            });
        }
    }
};
