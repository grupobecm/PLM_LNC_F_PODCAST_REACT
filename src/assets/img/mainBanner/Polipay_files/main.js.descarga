        this.total = this.copyCompany.length;
    }
    // Validacion campo numero de cuenta
    keyPressNumbers(event) {
        //console.log(event.key);
        var charCode = event.which ? event.which : event.keyCode;
        //console.log(charCode);
        // Only Numbers 0-9
        if (charCode < 48 || charCode > 57) {
            event.preventDefault();
            return false;
        }
        else {
            return true;
        }
    }
    keyPressNumbers2(event) {
        //console.log(event);
        let long = this.form.get("cta_beneficiario").value.length;
        var charCode = event.which ? event.which : event.keyCode;
        if (charCode == 13 && long == 10) {
            this.autocomplete('');
        }
        // Only Numbers 0-9
        if (charCode < 48 || charCode > 57) {
            event.preventDefault();
            return false;
        }
        else {
            return true;
        }
    }
    onPaste(event) {
        let clipboardData = event.clipboardData;
        let pastedText = clipboardData.getData('text');
        if (pastedText.length == 10) {
            //console.log('copiar',pastedText);
            this.autocomplete(pastedText);
        }
    }
    autocomplete(data) {
        let accountP;
        if (data != '') {
            accountP = data;
        }
        else {
            accountP = this.form.get("cta_beneficiario").value;
        }
        //console.log(accountP);
        //console.log(accountP.length);
        if (accountP.length == 10) {
            this.showLoad = true;
            this.serviceClient.acompleteAccountPtoP(accountP).subscribe((res) => {
                //console.log(res);
                if (res.length == 0) {
                    this.showLoad = false;
                    this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_17__["ErrorUserComponent"], {
                        width: "550px",
                        data: {
                            error: "TD-001",
                            messageNormal: "El número de cuenta no existe, por favor verifique que el dato sea correcto",
                        },
                        disableClose: true,
                    });
                }
                else if (res.length > 1) {
                    this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_17__["ErrorUserComponent"], {
                        width: "550px",
                        data: {
                            error: "TP-002",
                            messageNormalId: "PTP001",
                        },
                        disableClose: true,
                    });
                    this.form.reset();
                }
                else {
                    this.clabeR = res[0].cuenta;
                    this.form
                        .get("nombre_beneficiario")
                        .setValue(res[0].persona_cuenta__name);
                    this.form.controls.nombre_beneficiario.disable();
                    this.form.controls.cta_beneficiario.disable();
                    this.showLoad = false;
                }
            }, (error) => {
                //console.log(error);
                this.showLoad = false;
                this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_17__["ErrorUserComponent"], {
                    width: "550px",
                    data: {
                        error: "TD-001",
                        messageNormal: error.error.detail[0].message,
                    },
                    disableClose: true,
                });
            });
        }
        else {
            accountP = this.form.get("cta_beneficiario").value;
        }
    }
    referenceZero() {
        let reference;
        reference = this.form.get('referencia_numerica').value;
        //console.log(reference);
        if (reference.length == 7) {
            for (let i = 0; i < reference[i].length; i++) {
                if (reference[0] == 0) {
                    this.flgZero = true;
                }
                else {
                    this.flgZero = false;
                }
            }
        }
    }
};
