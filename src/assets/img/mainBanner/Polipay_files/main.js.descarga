/* harmony default export */ __webpack_exports__["default"] = ("/* Navbar de pasos */\r\n\r\n.nav-barA {\r\n    height: 47px;\r\n}\r\n\r\n.navbar__menuA {\r\n    display: flex;\r\n    list-style: none;\r\n    margin: 0;\r\n    padding: 0;\r\n}\r\n\r\n.navbar__itemsA {\r\n    text-align: center;\r\n    display: block;\r\n    height: 47px;\r\n    cursor: pointer;\r\n    text-align: center;\r\n    transition: 0.1s;\r\n    border-bottom: 2px solid #223E92;\r\n}\r\n\r\n.navbar__imgA {\r\n    vertical-align: middle;\r\n    margin-right: 12px;\r\n}\r\n\r\n.navbar__textA {\r\n    display: inline-block;\r\n    vertical-align: middle;\r\n    font-size: 18px;\r\n    line-height: 1.53;\r\n    text-align: center;\r\n    text-transform: uppercase;\r\n    color: var(--third-color);\r\n    text-decoration: none;\r\n}\r\n\r\n.active {\r\n    background: var(--white);\r\n    border-left: 2px solid #223E92;\r\n    border-right: 2px solid #223E92;\r\n    border-top: 2px solid #223E92;\r\n    border-bottom: none;\r\n}\r\n\r\n.active .navbar__textA {\r\n    color: var(--main-color);\r\n}\r\n\r\n.active .navbar__imgA {\r\n    filter: brightness(0) invert(1);\r\n}\r\n\r\n/* FIN Navbar */\r\n\r\n/* Navbar de documentos */\r\n\r\n/* .nav-barAD {\r\n    height: 47px;\r\n} */\r\n\r\n.navbar__menuAD {\r\n    /* display: flex;\r\n    list-style: none;\r\n    margin: 0;\r\n    padding: 0; */\r\n    /* list-style-type: none;\r\n    margin: 0;\r\n    padding: 0;\r\n    width: 60px; */\r\n    list-style-type: none;\r\n    margin: 0;\r\n    padding: 0;\r\n    width: 200px;\r\n    background-color: #f1f1f1;\r\n    margin-right: -4px;\r\n}\r\n\r\n.navbar__itemsAD {\r\n    text-align: center;\r\n    display: block;\r\n    color: #000;\r\n    padding: 8px 16px;\r\n    text-decoration: none;\r\n    cursor: pointer;\r\n    text-align: center;\r\n    transition: 0.1s;\r\n    border-bottom: 2px solid white;\r\n    /* text-align: center;\r\n    display: block;\r\n    height: 47px;\r\n    cursor: pointer;\r\n    text-align: center;\r\n    transition: 0.1s;\r\n    border-bottom: 2px solid #223E92; */\r\n}\r\n\r\n.navbar__imgAD {\r\n    vertical-align: middle;\r\n    margin-right: 12px;\r\n}\r\n\r\n.navbar__textAD {\r\n    display: inline-block;\r\n    vertical-align: middle;\r\n    font-size: 18px;\r\n    line-height: 1.53;\r\n    text-align: center;\r\n    text-transform: uppercase;\r\n    color: var(--third-color);\r\n    text-decoration: none;\r\n}\r\n\r\n.activeD1 {\r\n    background: var(--white);\r\n    border-left: 2px solid #223E92;\r\n    border-right: none;\r\n    border-top: 2px solid #223E92;\r\n    border-bottom: 2px solid #223E92;\r\n    z-index: 3;\r\n}\r\n\r\n.activeD1 .navbar__textAD {\r\n    color: var(--main-color);\r\n}\r\n\r\n.activeD1 .navbar__imgAD {\r\n    filter: brightness(0) invert(1);\r\n}\r\n\r\n/* FIN Navbar */\r\n\r\n.Title {\r\n    font-size: 26px;\r\n}\r\n\r\n.subtitle {\r\n    font-size: 16px;\r\n}\r\n\r\n.text {\r\n    font-size: 12px !important;\r\n}\r\n\r\n/*botone*/\r\n\r\n.regresar__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width: 170px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var( --grey-dark);\r\n    margin-top: 23.7px;\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    /* centrar el boton */\r\n    display: block;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n    outline: none;\r\n    cursor: pointer;\r\n    box-shadow: 0 1px 3px var(--opacity-12), 0 3px 3px var(--opacity-24);\r\n    transition: 0.3s;\r\n}\r\n\r\n.confirmar__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width: 209px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var(--main-color);\r\n    margin-top: 23.7px;\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    outline: none;\r\n    cursor: pointer;\r\n    box-shadow: 0 1px 3px var(--opacity-12), 0 3px 3px var(--opacity-24);\r\n    transition: 0.3s;\r\n}\r\n\r\n.confirmar__button:hover {\r\n    background-color: var( --grey-dark);\r\n    color: var( --main-color);\r\n    cursor: pointer;\r\n}\r\n\r\n.documents {\r\n    padding: 0px 8px;\r\n    border-top: 2px solid #223E92;\r\n    border-left: 2px solid #223E92;\r\n    border-bottom: 2px solid #223E92;\r\n}\r\n\r\n.pdf-container__view{\r\n    width: 100%;\r\n    border: none;\r\n    height: 275px !important; \r\n}\r\n\r\n.formCon__input:-webkit-autofill {\r\n    box-shadow: 0 0 0px 1000px var(--white) inset;\r\n    -webkit-text-fill-color: var(--opacity-74);\r\n}\r\n\r\n.formCon__input {\r\n    width: 100%;\r\n    height: 105px;\r\n    font-size: 16px;\r\n    line-height: 1.5;\r\n    letter-spacing: 0.15px;\r\n    text-align: left;\r\n    padding: 17px 16.5px;\r\n    outline: none;\r\n    border-radius: 4px;\r\n    border: solid 1px var(--opacity-12);\r\n    color: var(--opacity-74);\r\n}\r\n\r\n.form__inputCon:-webkit-autofill {\r\n    box-shadow: 0 0 0px 1000px var(--white) inset;\r\n    -webkit-text-fill-color: var(--opacity-74);\r\n}\r\n\r\n.formCon__input:focus {\r\n    border: 2px solid var(--accent-color);\r\n}\r\n\r\n.formCon__input:focus+span {\r\n    color: var(--main-color);\r\n}\r\n\r\n.formCon__input:focus-within span {\r\n    color: var(--main-color);\r\n}\r\n\r\n/* Tabla datos */\r\n\r\n.no-registros {\r\n    width: 100%;\r\n    border-radius: 6px;\r\n    box-shadow: 0 0 6px 0 rgba(0, 0, 0, 0.65);\r\n    margin-top: 10px;\r\n    text-align: center;\r\n}\r\n\r\n.tabla {\r\n    width: 100%;\r\n    box-shadow: 0 0 6px 0 rgba(0, 0, 0, 0.65);\r\n    margin-top: 10px;\r\n}\r\n\r\n.tr {\r\n    font-size: 18px;\r\n    font-weight: 600;\r\n    line-height: 1.47;\r\n    text-align: left;\r\n    border-bottom: 1px solid var(--grey-light4);\r\n    text-transform: uppercase;\r\n}\r\n\r\n.th {\r\n    display: inline-block;\r\n    margin-top: 5px;\r\n    margin-bottom: 5px;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.th--content {\r\n    font-size: 16px;\r\n    font-weight: normal;\r\n    font-stretch: normal;\r\n    font-style: normal;\r\n    line-height: 1.65;\r\n    letter-spacing: -0.4px;\r\n    text-align: left;\r\n}\r\n\r\n.tr:last-child {\r\n    border-bottom: none;\r\n}\r\n\r\n.th--no-margin {\r\n    margin: 0;\r\n}\r\n\r\n.th--ml {\r\n    margin-left: 22.5px;\r\n}\r\n\r\n.th--mr {\r\n    margin-right: 22.5px;\r\n}\r\n\r\n.th--align {\r\n    text-align: left;\r\n}\r\n\r\n.mr--scroll {\r\n    margin-right: 34.5px;\r\n}\r\n\r\n.th--align-center {\r\n    text-align: center;\r\n}\r\n\r\n.th--align-right {\r\n    text-align: right;\r\n    margin-right: 15px;\r\n}\r\n\r\n.bold {\r\n    font-weight: 600;\r\n}\r\n\r\n.status{\r\n    color: #3a555b;\r\n}\r\n\r\n.status--correct{\r\n    color: #36851a;\r\n}\r\n\r\n.status--fail{\r\n    color: #ff0000;\r\n}\r\n\r\n/* FIN Tabla datos */\r\n/*# sourceMappingURL=data:application/json;base64, */");

