let DispersionLiquidatedComponent = class DispersionLiquidatedComponent {
    constructor(serviceClient, dialog, storageClient, storageHome, storage) {
        this.serviceClient = serviceClient;
        this.dialog = dialog;
        this.storageClient = storageClient;
        this.storageHome = storageHome;
        this.storage = storage;
        this.displayedColumns = ['id', 'nombre_beneficiario', 'monto', 'fecha_creacion', 'button'];
        this.listLiquidate = [];
        this.showLoad = false;
        this.noData = false;
        this.numRegister = 0;
        if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length >= 3) {
            //console.log('tp y t');
            //this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
            ////console.log(this.id);
            if (this.storageClient.InfoCostCenterExist == false) {
                //console.log("bye");
                this.dataService = JSON.parse(this.storage.infoUserValue);
                //Aqui va dialog para crear centros de costos
            }
            else {
                //console.log('si hay centros de costos');
                this.dataService = JSON.parse(this.storageClient.InfoCostCenterValue);
                this.id = this.dataService.persona_cuenta_id;
                this.AllRecordsRispersions();
            }
        }
        else {
            if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    //console.log('tp');
                    this.dataService = JSON.parse(this.storage.infoUserValue);
                    this.id = this.dataService.cuenta_id;
                    //console.log(this.id);
                    this.AllRecordsRispersions();
                }
                else {
                    if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        //console.log('t');
                        //console.log(this.storageClient.InfoCostCenterExist);
                        if (this.storageClient.InfoCostCenterExist == false) {
                            //console.log("bye");
                            this.dataService = JSON.parse(this.storage.infoUserValue);
                        }
                        else {
                            //console.log("si hay servicios ");
                            this.dataService = JSON.parse(this.storageClient.InfoCostCenterValue);
                            this.id = this.dataService.persona_cuenta_id;
                            //console.log(this.dataService)
                            //console.log(this.dataService.persona_cuenta_id);
                            this.AllRecordsRispersions();
                        }
                    }
                }
            }
        }
    }
    AllRecordsRispersions(size = 99999, date1 = null, date2 = null, beneficiario = null, nameEmisor = null, status = 1, razonId = this.id) {
        //console.log(size,date1, date2, beneficiario, nameEmisor, status, razonId );
        this.showLoad = true;
        this.serviceClient.ListIndividualDispersions(size, date1, date2, beneficiario, nameEmisor, status, razonId).subscribe(res => {
            //console.log(res);
            this.listLiquidate = new _angular_material_table__WEBPACK_IMPORTED_MODULE_9__["MatTableDataSource"](res.results);
            this.listLiquidate.sort = this.sort;
            this.listLiquidate.paginator = this.paginator;
            this.paginator._intl.itemsPerPageLabel = 'Filas por página';
            this.listLiquidate.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listLiquidate.data.length;
            this.showLoad = false;
        }, error => {
            //console.log(error);
            this.showLoad = false;
        });
    }
    seedetails(element) {
        this.showLoad = true;
        this.serviceClient.detaisIndividualDispersions(element.id).subscribe(res => {
            this.showLoad = false;
            //console.log(res);
            this.dialog.open(_details_dispersion_details_dispersion_component__WEBPACK_IMPORTED_MODULE_13__["DetailsDispersionComponent"], {
                width: "544px",
                data: {
                    res: res,
                    type: 'L'
                },
                panelClass: ['custom-dialog-container'],
                disableClose: true,
            });
        }, error => {
            //console.log(error);
            this.showLoad = false;
        });
    }
    openFilter() {
        let filtro = this.dialog.open(_filter_individual_dispersion_filter_individual_dispersion_component__WEBPACK_IMPORTED_MODULE_14__["FilterIndividualDispersionComponent"], {
            width: "90%",
            panelClass: "custom-dialog-container"
        });
        filtro.afterClosed().subscribe(res => {
            let emisor = null;
            let benefi = null;
            let date1 = null;
            let date2 = null;
            //console.log(res);
            if (res == undefined) {
            }
            else {
                if (res != 'Reset filtro') {
                    for (let i = 0; i < res.data.filtro.length; i++) {
                        switch (res.data.filtro[i].campo) {
                            case 'Nombre del Emisor':
                                emisor = res.data.filtro[i].valor.begin;
                                break;
                            case 'Fecha de Dispersión':
                                date1 = (res.data.filtro[i].valor.begin).toISOString().split("T")[0];
                                date2 = (res.data.filtro[i].valor.end).toISOString().split("T")[0];
                                break;
                            case 'Nombre del Beneficiario':
                                benefi = res.data.filtro[i].valor;
                                break;
                        }
                    }
                }
            }
            this.AllRecordsRispersions(99999, date1, date2, benefi, emisor, 1, this.id);
        });
    }
    ngOnInit() {
    }
};
