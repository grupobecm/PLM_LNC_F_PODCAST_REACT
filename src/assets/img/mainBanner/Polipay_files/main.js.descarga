r\n\r\n.confirmar__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width: 128px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var(--main-color);\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    margin-left: 26.4px;\r\n    outline: none;\r\n    cursor: pointer;\r\n    box-shadow: 0 1px 3px var(--opacity-12), 0 3px 3px var(--opacity-24);\r\n    transition: 0.3s;\r\n}\r\n\r\n.disabled {\r\n    background: #fafafa !important;\r\n}\r\n\r\n.confirmar__button:hover {\r\n    background-color: var( --grey-dark);\r\n    color: var(--main-color);\r\n}\r\n\r\n.confirmar__button:disabled {\r\n    background-color: var( --grey-dark);\r\n    color: var( --third-color);\r\n    cursor: default;\r\n}\r\n\r\n/* Button cancelar */\r\n\r\n.cancelar__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width: 128px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var( --grey-dark);\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    outline: none;\r\n    cursor: pointer;\r\n    box-shadow: 0 1px 3px var(--opacity-12), 0 3px 3px var(--opacity-24);\r\n    transition: 0.3s;\r\n}\r\n\r\n.cancelar__button:hover {\r\n    background-color: var( --red);\r\n    color: var(--white);\r\n}\r\n\r\n::-webkit-scrollbar {\r\n    display: none;\r\n}\r\n\r\n.mat-form-field-label-wrapper {\r\n    position: absolute !important;\r\n    left: 0 !important;\r\n    box-sizing: content-box !important;\r\n    width: 100% !important;\r\n    height: 100% !important;\r\n    overflow: hidden !important;\r\n    pointer-events: none !important;\r\n    top: 20px !important;\r\n}\r\n\r\n.mat-form-field {\r\n    width: calc(99.99% + 20px) !important;\r\n    height: 56px !important;\r\n    font-size: 16px 