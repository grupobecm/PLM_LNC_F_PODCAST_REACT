ert\">\r\n                            <span class=\"alert__text | color-red\">Por favor carga el Comprobante de Domicilio</span>\r\n                        </div>\r\n\r\n                    </div>\r\n                </div>\r\n                <div class=\"mt-5\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"50\" fxLayout=\"row wrap\">\r\n                        <div fxFlex=\"100\">\r\n                            <p class=\"color-third\">Estado de Cuenta Bancario*</p>\r\n                        </div>\r\n                        <div class=\"\" fxFlex=\"100\" fxLayout=\"row\">\r\n                            <input class=\"boton__input\" name=\"file4_\" formControlName=\"file4_\" id=\"file4_\" style=\"display: none\" type=\"file\" (change)=\"fileChange4($event)\" #hiddenfile4input accept=\".pdf, application/pdf\">\r\n                            <button type=\"button\" class=\"cargar__button | color-white\" [ngClass]=\"{'boton--alert': form.get('file4_').hasError('required') && auxAlert }\" routerLinkActive=\"active\" (click)=\"hiddenfile4input.click()\">\r\n                      <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                      <b>Cargar Layout*</b></button>\r\n                            <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                                <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ file4 }}</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\" alertTransfer\" *ngIf=\"form.get('file4_').hasError('required') && auxAlert\">\r\n                            <span class=\"alert__text | color-red\">Por favor carga el Estado de Cuenta Bancario</span>\r\n                        </div>\r\n\r\n                    </div>\r\n                    <div fxFlex=\"50\" fxLayout=\"row wrap\">\r\n                        <div fxFlex=\"100\">\r\n                            <p class=\"color-third\">Documento de Prevención de Lavado de Dinero (PLD)*</p>\r\n                        </div>\r\n                        <div class=\"\" fxFlex=\"100\" fxLayout=\"row\">\r\n                            <input class=\"boton__input\" name=\"file5_\" formControlName=\"file5_\" id=\"file5_\" style=\"display: none\" type=\"file\" (change)=\"fileChange5($event)\" #hiddenfile5input accept=\".pdf, application/pdf\">\r\n                            <button type=\"button\" class=\"cargar__button | color-white\" [ngClass]=\"{'boton--alert': form.get('file5_').hasError('required') && auxAlert }\" routerLinkActive=\"active\" (click)=\"hiddenfile5input.click()\">\r\n                    <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                    <b>Cargar Layout*</b></button>\r\n                            <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                                <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ file5 }}</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\" alertTransfer\" *ngIf=\"form.get('file5_').hasError('required') && auxAlert\">\r\n                            <span class=\"alert__text | color-red\">Por favor carga el PLD</span>\r\n                        </div>\r\n\r\n                    </div>\r\n                </div>\r\n                <div class=\"mt-5\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"50\" fxLayout=\"row wrap\">\r\n                        <div fxFlex=\"100\">\r\n                            <p class=\"color-third\">Otro documento</p>\r\n                        </div>\r\n                        <div class=\"\" fxFlex=\"100\" fxLayout=\"row\">\r\n                            <input class=\"boton__input\" name=\"file6_\" formControlName=\"file6_\" id=\"file6_\" style=\"display: none\" type=\"file\" (change)=\"fileChange6($event)\" #hiddenfile6inpu