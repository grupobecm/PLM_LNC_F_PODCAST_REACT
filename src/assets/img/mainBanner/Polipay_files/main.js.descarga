                let name = null;
                let creation_date1 = null;
                let creation_date2 = null;
                this.date01 = null;
                this.date02 = null;
                if (res == undefined) {
                }
                else {
                    if (res != 'Reset filtro') {
                        //console.log(res.data);
                        for (let i = 0; i < res.data.filtro.length; i++) {
                            switch (res.data.filtro[i].campo) {
                                case 'Nombre del Beneficiario':
                                    name = res.data.filtro[i].valor;
                                    break;
                                case 'Fecha de Creación':
                                    creation_date1 = (res.data.filtro[i].valor.begin);
                                    creation_date2 = (res.data.filtro[i].valor.end);
                                    this.date01 =
                                        creation_date1.getFullYear() + '-' +
                                            ((creation_date1.getMonth() + 1).toString().length > 1 ? (creation_date1.getMonth() + 1) : '0' + (creation_date1.getMonth() + 1))
                                            + '-' + (creation_date1.getDate().toString().length > 1 ? creation_date1.getDate() : '0' + creation_date1.getDate());
                                    this.date02 =
