SÍ</button>\r\n        </div>\r\n    </div>\r\n\r\n    <div *ngIf=\"question == 'T-002'\" class=\"\">\r\n        <p class=\"text | color-third\">¿Estás seguro que deseas autorizar esta transaccion?</p>\r\n        <div fxLayout=\"row \">\r\n            <button type=\"button\" mat-dialog-close class=\"button-accept | color-white background-accent\">NO</button>\r\n            <button type=\"button\" id=\"button \" class=\" margin__left | button-accept | color-white background-main\"\r\n                (click)=\"authorize()\">SÍ</button>\r\n        </div>\r\n    </div>\r\n\r\n    <div *ngIf=\"question == 'T-003'\" class=\"\">\r\n        <p class=\"text | color-third\">¿Estás seguro que deseas cancelar esta transaccion?</p>\r\n        <div fxLayout=\"row \">\r\n            <button type=\"button\" mat-dialog-close class=\"button-accept | color-white background-accent\">NO</button>\r\n            <button type=\"button\" id=\"button \" class=\" margin__left | button-accept | color-white background-main\"\r\n                (click)=\"cancel()\">SÍ</button>\r\n        </div>\r\n    </div>\r\n\r\n\r\n\r\n    <!-- Reports  R-001-->\r\n\r\n    <!-- GrupoFrecuentes  GF-001/Eliminar-->\r\n    <div *ngIf=\"question == 'GF-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">¿Desea Eliminar el grupo <br>{{name}}?</p>\r\n        <div fxLayout=\"row \">\r\n            <button type=\"button\" mat-dialog-close id=\"button \"\r\n                class=\"button-accept | color-white background-accent  \">NO</button>\r\n            <button type=\"button\" id=\"button \" class=\" margin__left | button-accept | color-white background-main\"\r\n                (click)=\"deleteFrecGroup()\">SÍ</button>\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <!-- Grupo de Permisos  GP-001-->\r\n\r\n    <!-- GrupoFrecuentes  GP-001/Eliminar-->\r\n    <div *ngIf=\"question == 'GP-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">¿Estas seguro de Eliminar al <br>Grupo {{nam