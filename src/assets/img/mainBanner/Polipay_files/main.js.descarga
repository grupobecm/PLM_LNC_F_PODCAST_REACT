            for (let j = 0; j < this.docColaborador.DocumentsPerson.length; j++) {
                if (this.documentospColaborador[i].doc_id == this.docColaborador.DocumentsPerson[j].tipo.id) {
                    //console.log("ok");
                    this.documentospColaborador[i].doc = this.docColaborador.DocumentsPerson[j].file;
                    this.documentospColaborador[i].id = this.docColaborador.DocumentsPerson[j].id;
                }
            }
        }
    }
    submit() {
        //console.log('veces que entra 1');
