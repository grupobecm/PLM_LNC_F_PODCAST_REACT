let DetailsPersonnelExternalUserComponent = class DetailsPersonnelExternalUserComponent {
    constructor(dialog, router, storageClient, storage, service, service2, sanitizer) {
        this.dialog = dialog;
        this.router = router;
        this.storageClient = storageClient;
        this.storage = storage;
        this.service = service;
        this.service2 = service2;
        this.sanitizer = sanitizer;
        this.pdf = "../../../../../assets/INE.pdf";
        this.documentBase64 = "";
        /* Datos del personal externo */
        this.name = "";
        this.lastName = "";
        this.birthday = "";
        this.rfc = "";
        this.mail = "";
        this.description = "";
        this.cuenta = "";
        this.balance = "";
        this.cards = [];
        this.cards2 = [];
        this.showLoad = false;
        this.date2 = "2021-10-12";
        this.cuentaPrueba = "5129121210649009";
        this.card = "";
        this.card2 = "";
        this.id = "";
        this.servicesTP = true;
        if (!this.storageClient.InfoExternalPExist) {
            this.router.navigate([
                "/usuario/dispersiones/peronal-externo/lista-personal-externo",
            ]);
        }
        else {
            this.dato = JSON.parse(this.storageClient.InfoExternalPValue);
            // sessionStorage.removeItem('data_external_p');
        }
        if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length >=
            3) {
            //console.log('tp y t');
            //this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
            ////console.log(this.id);
            if (this.storageClient.InfoCostCenterExist == false) {
                //console.log("bye");
                this.dataService = JSON.parse(this.storage.infoUserValue);
                //Aqui va dialog para crear centros de costos
            }
            else {
                //console.log('si hay centros de costos');
                this.dataService = JSON.parse(this.storageClient.InfoCostCenterValue);
                this.cue_id = this.dataService.persona_cuenta_id;
                this.servicesTP = false;
                //  this.listPersonal2();
            }
        }
        else {
            if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions
                .length == 2) {
                if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0]
                    .producto == "Tarjetas de Prepago") {
                    //console.log('tp');
                    this.dataService = JSON.parse(this.storage.infoUserValue);
                    this.cue_id = this.dataService.cuenta_id;
                    //console.log(this.cue_id);
                    this.servicesTP = true;
                    // this.listPersonal();
                }
                else {
                    if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0]
                        .producto == "Transferencias") {
                        //console.log('t');
                        //console.log(this.storageClient.InfoCostCenterExist );
                        if (this.storageClient.InfoCostCenterExist == false) {
                            //console.log("bye");
                            this.dataService = JSON.parse(this.storage.infoUserValue);
                        }
                        else {
                            //console.log("si hay servicios ");
                            this.dataService = JSON.parse(this.storageClient.InfoCostCenterValue);
                            this.cue_id = this.dataService.persona_cuenta_id;
                            //console.log(this.dataService)
                            //console.log(this.dataService.persona_cuenta_id);
                            this.servicesTP = true;
                            //  this.listPersonal2();
                        }
                    }
                }
            }
        }
        // //console.log("Datos",this.dato);
        this.detailsPersonalStaff();
    }
    detailsPersonalStaff() {
        this.showLoad = true;
        console.log(JSON.parse(this.storage.infoUserValue).cuenta_id, this.dato.person_id);
        this.service
            .detailsExternalStaff(this.cue_id, this.dato.person_id)
            .subscribe((res) => {
            this.personal = res[0];
            console.log(res);
            this.showLoad = false;
            //Beneficiarios de pomelo
            /* this.service
              .listBenfyStaffCCPomelo(res[0].person_id.email)
              .subscribe((res) => {
                console.log(res);
                console.log(res[0].id);
              }); */
            // //console.log( res[0].person_id.rfc);
            //this.pdf = this.personal.Documents[0].documento;
            this.name = res[0].person_id.Nombre;
            this.date1 = res[0].person_id.fechaNacimiento;
            this.lastName = res[0].person_id.apellido;
            this.lastName = this.lastName.replace("*", " ");
            this.rfc = res[0].person_id.rfc;
            if (res[0].person_id.rfc == "BEC161026BX3" ||
                res[0].person_id.rfc == "BECX161026BX3" ||
                res[0].person_id.rfc == "becx161026bx3") {
                this.rfc = "";
            }
            this.mail = res[0].person_id.email;
            this.description = res[0].person_id.descripcionActividades;
            this.cuenta = res[0].cuenta.DatosCuenta;
            this.balance = res[0].cuenta.SaldoCuenta;
            if (this.personal.Documents.length == 0) {
            }
            else {
                this.documentBase64 = this.personal.Documents[0].documento;
            }
            this.cards = this.personal.tarjetas;
            this.cards2 = res[0].tarjetas;
            //console.log(this.date1)
            for (let i = 0; i < res[0].length; i++) {
                this.cards2 = res[0].tarjetas[i].tarjeta;
                // this.personal.tarjetas[i].tarjeta
                // //console.log(this.personal.tarjetas[i].tarjeta);
            }
            //console.log(this.cards2);
        }, (error) => {
            this.showLoad = false;
            // //console.log("Error", error);
        });
    }
    statusChange() {
        // //console.log(this.dato);
        let question = this.dialog.open(_messageUser_questions_user_questions_user_component__WEBPACK_IMPORTED_MODULE_11__["QuestionsUserComponent"], {
            data: {
                question: "D-001",
                username: this.dato.person__name + " " + this.dato.person__last_name,
                id: this.dato.person_id,
                motivo: true,
            },
            disableClose: true,
        });
        question.afterClosed().subscribe((res) => {
            if (res != undefined) {
                if (res.event) {
                    let form = this.dialog.open(_messageUser_form_user_form_user_component__WEBPACK_IMPORTED_MODULE_13__["FormUserComponent"], {
                        width: "500px",
                        data: {
                            form: "D-001",
                            id: this.dato.person_id,
                            username: this.dato.person__name + " " + this.dato.person__last_name,
                        },
                        disableClose: true,
                    });
                    form.afterClosed().subscribe((res) => {
                        if (res != undefined) {
                            if (res.event) {
                                ////console.log(dato.username);
                                let success = this.dialog.open(_messageUser_success_user_success_user_component__WEBPACK_IMPORTED_MODULE_14__["SuccessUserComponent"], {
                                    width: "500px",
                                    data: {
                                        success: "D-003",
                                        username: this.dato.person__name +
                                            " " +
                                            this.dato.person__last_name,
                                    },
                                    disableClose: true,
                                });
                                success.afterClosed().subscribe((res) => {
                                    this.router.navigate([
                                        "/usuario/dispersiones/peronal-externo/lista-personal-externo",
                                    ]);
                                });
                            }
                        }
                    });
                }
            }
        });
    }
    administrar() {
        this.router.navigate([
            "/usuario/dispersiones/peronal-externo/administrar-tarjetas-personal-externo",
        ]);
        this.dialog.closeAll();
    }
    editar() {
        this.storageClient.setInfoExternalP(this.dato);
        this.storageClient.setInfoFullExternalP(this.personal);
        this.router.navigate([
            "/usuario/dispersiones/peronal-externo/edit-personal-externo",
        ]);
    }
    cardsNumber() {
        return this.cards.length == 0 ? true : false;
    }
    censure(card) {
        let cardSplit = card.split("");
        return ("**** **** **** " +
            cardSplit[cardSplit.length - 4] +
            cardSplit[cardSplit.length - 3] +
            cardSplit[cardSplit.length - 2] +
            cardSplit[cardSplit.length - 1]);
    }
    movementsCard(cuentaPrueba) {
        //console.log(cuentaPrueba);
        this.card = cuentaPrueba;
        //console.log(this.card)
        this.storageClient.setAccountBeneficiary(cuentaPrueba);
        let dataBenefy = {
            nombre_beneficiario: this.name,
            lastName_benefy: this.lastName,
            rfc: this.rfc,
            mail: this.mail,
            description: this.description,
            cta_beneficiario: this.cuenta,
            balance_cta: this.balance,
            card: this.card,
            dateBirth: this.date1,
        };
        //console.log(dataBenefy)
        this.storageClient.setDataBeneficiary(dataBenefy);
        this.router.navigate([
            "/usuario/dispersiones/peronal-externo/movements-beneficiary/movements-by-card",
        ]);
    }
    movementsAccounts(account) {
        this.storageClient.setAccountBeneficiary(account);
        let dataBenefy = {
            nombre_beneficiario: this.name,
            lastName_benefy: this.lastName,
            rfc: this.rfc,
            mail: this.mail,
            description: this.description,
            cta_beneficiario: this.cuenta,
            balance_cta: this.balance,
        };
        this.storageClient.setDataBeneficiary(dataBenefy);
        this.router.navigate([
            "/usuario/dispersiones/peronal-externo/movements-beneficiary/movements-by-account",
        ]);
    }
    balanceCard(cuentaPrueba) {
        // //console.log(cuentaPrueba);
        this.card = cuentaPrueba;
        // //console.log(this.card);
        this.storageClient.setAccountBeneficiary(cuentaPrueba);
        this.router.navigate([
            "/usuario/dispersiones/peronal-externo/movements-beneficiary/movements-by-account",
        ]);
    }
};
