    validarEirPaso3() {
        let valido = false;
        if (this.preguntar_rl()) {
            for (let i = 0; i < this.campos_rl.length; i++) {
                document.getElementById(this.campos_rl[i]).focus();
            }
            this.auxFlgColonia2 = 1;
            valido = false;
            // If si los requeridos faltan
        }
        else if (this.algunRequerido() || this.errorCorreoReperito.includes(true)) {
            // FIN del if NO HACE NADA SI ALGUNO FALTA O SU HAY CORREO REPETIDOS
            valido = false;
        }
        else {
            this.form.get('fecha_nacimiento').setValue(new Date(this.form.get('fecha_nacimiento').value).toISOString().split('T')[0]);
            if (this.form.get('no_interior').value == undefined) {
                this.form.get('no_interior').setValue(null);
            }
            if (this.form.get('no_interior_rl').value == undefined) {
                this.form.get('no_interior_rl').setValue(null);
            }
            valido = true;
        }
        ////console.log(valido);
        ///// SECCION PARA EL PERSONAL ADMINISTRATIVO VALIDACION
        let aux = 0;
        if (this.addworker) { // Indica si se tienen que llenar personales administrativos
            ////console.log("Personal Administrativo");
            for (let i = 0; i < this.form.get('legales').value.length; i++) {
                if (this.form.get('legales').value[i].fechanacimientoAdd == "" || this.t.controls[i].get('fechanacimientoAdd').hasError('menorEdad')) {
                    document.querySelectorAll("#fechanacimientoAddId")[i].focus();
                    aux++;
                }
                if (this.form.get('legales').value[i].nombreAdd == "") {
                    document.getElementById('nombreAdd' + i).focus();
                    aux++;
                }
                if (this.form.get('legales').value[i].apellidoPAdd == "") {
                    document.getElementById('apellidoPAdd' + i).focus();
                    aux++;
                }
                if (this.form.get('legales').value[i].apellidoMAdd == "") {
                    document.getElementById('apellidoMAdd' + i).focus();
                    aux++;
                }
                if (this.form.get('legales').value[i].telefonoAdd == "") {
                    document.getElementById('telefonoAdd' + i).focus();
                    aux++;
                }
                if (this.form.get('legales').value[i].correoAdd == "") {
                    document.getElementById('correoAdd' + i).focus();
                    aux++;
                }
                document.getElementById('submit2').focus();
            }
            if (valido && aux == 0) {
                this.arrayJsonPABack = [];
                //AQUI ENVIAR EL FORM PARA PERSONAL ADMINISTRATIVO
                for (let i = 0; i < this.form.get('legales').value.length; i++) {
                    let jsonPA = {
                        name: this.form.get('legales').value[i].nombreAdd,
                        a_paterno: this.form.get('legales').value[i].apellidoPAdd,
                        a_materno: this.form.get('legales').value[i].apellidoMAdd,
                        phone: this.form.get('legales').value[i].telefonoAdd,
                        email: this.form.get('legales').value[i].correoAdd,
                        fecha_nacimiento: new Date(this.form.get('legales').value[i].fechanacimientoAdd).toISOString().split('T')[0],
                    };
                    this.arrayJsonPABack.push(jsonPA);
                }
                ////console.log(this.arrayJsonPABack);
                if (!this.is_admin && this.addworker) {
                    this.numPersonalAdministrativos = this.t.length;
                }
                else {
                    this.numPersonalAdministrativos = this.t.length;
                }
                this.documents_admin.controls = [];
                for (let i = 0; i < this.numPersonalAdministrativos; i++) {
                    this.addDocument_admin();
                }
                if (!(this.errorCorreoReperito.includes(true) || this.errorTelefonoRepetidoo.includes(true))) {
                    this.alPaso3();
                }
            }
        }
        else if (valido) {
            ////console.log("Directo al paso 3");
            this.numPersonalAdministrativos = 1;
            this.documents_admin.controls = [];
            //this.addDocument_admin();
            this.alPaso3();
        }
    }
    personales() {
        (this.numPersonalAdministrativos > 0) ? true : false;
    }
    //Validar que todos esten llenos,  Representante legal Centro de costos
    preguntar_rl() {
        return this.form.get('name').value == "" ||
            this.form.get('a_paterno').value == "" ||
            this.form.get('a_materno').value == "" ||
            this.form.get('fecha_nacimiento').value == "" ||
            // this.form.get('homoclave').value == "" ||
            this.form.get('rfc').value == "" ||
            this.form.get('phone').value == "" ||
            this.form.get('email').value == "" ||
            this.form.get('codigopostal_rl').value == "" ||
            this.form.get('colonia_rl').value == "" ||
            this.form.get('alcaldia_mpio_rl').value == "" ||
            this.form.get('estado_rl').value == "" ||
            this.form.get('calle_rl').value == "" ||
            this.form.get('no_exterior_rl').value == "";
        // this.form.get('pais_rl').value == "";
    }
    algunRequerido() {
        return this.requerido('name') ||
            this.requerido('a_paterno') ||
            this.requerido('a_materno') ||
            this.requerido('fecha_nacimiento') ||
            this.requerido('rfc') ||
            // this.requerido('homoclave') ||
            this.requerido('phone') ||
            this.requerido('codigopostal_rl') ||
            this.requerido('email') ||
            // this.requerido('pais_rl') ||
            this.requerido('codigopostal_rl') ||
            this.requerido('alcaldia_mpio_rl') ||
            this.requerido('estado_rl') ||
            this.requerido('calle_rl') ||
            this.requerido('no_exterior_rl');
    }
    //Validar que todos esten llenos,  Centro de costos
    vacios_rs() {
        return this.form.get('name_cc').value == "" ||
            this.form.get('name_rs').value == "" ||
            this.form.get('rfc_rs').value == "" ||
            // this.form.get('banco_clabe').value == "" ||
            this.form.get('codigopostal').value == "" ||
            this.form.get('calle').value == '' ||
            this.form.get('no_exterior').value == '' ||
            this.form.get('colonia').value == "" ||
            this.form.get('alcaldia_mpio').value == "" ||
            this.form.get('estado').value == "";
    }
    requerido_rs() {
        return this.requerido('name_cc') ||
            this.requerido('name_rs') ||
            this.requerido('rfc_rs') ||
            // this.requeridoBanco() ||
            this.requerido('codigopostal') ||
            this.requeridoColoniaSelect1() ||
            this.requerido('alcaldia_mpio') ||
            this.requerido('estado') ||
            this.requerido('calle') ||
            this.requerido('no_exterior');
    }
