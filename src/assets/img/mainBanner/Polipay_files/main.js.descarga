let SeedetailsCostCentersUComponent = class SeedetailsCostCentersUComponent {
    constructor(formBuilder, router, dialog, service) {
        this.formBuilder = formBuilder;
        this.router = router;
        this.dialog = dialog;
        this.service = service;
        this.pendiente = false;
        this.devueltoDirecion = false;
        this.devueltoClabe = false;
        this.file = "Ningun archivo seleccionado";
        this.file64 = null;
        this.auxAlert = false;
        this.showLoad = false;
        this.error = false;
        this.id = 1761;
        sessionStorage.removeItem('detalle_centro');
        this.form = this.formBuilder.group({
            // PASO 1
            motivoDesactivado: ["", [_angular_forms__WEBPACK_IMPORTED_MODULE_5__["Validators"].required]],
            file_: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_5__["Validators"].required]],
        });
        if (JSON.parse(sessionStorage.getItem("cenCost")).dato_json) {
            this.id = JSON.parse(sessionStorage.getItem("cenCost")).id;
            if (JSON.parse(sessionStorage.getItem("cenCost")).dato_json.CostCenterId) {
                this.cenCostId = JSON.parse(sessionStorage.getItem("cenCost")).dato_json.CostCenterId;
            }
            else {
                this.cenCostId = JSON.parse(sessionStorage.getItem("cenCost")).dato_json.cost_center_id;
            }
        }
        else {
            this.id = undefined;
            this.cenCostId = JSON.parse(sessionStorage.getItem("cenCost")).id;
        }
        //console.log('cenCost',JSON.parse(sessionStorage.getItem("cenCost")));
        if (JSON.parse(sessionStorage.getItem("cenCost")).estado__nombreEdo == 'Pendiente') {
            this.pendiente = true;
        }
        if (JSON.parse(sessionStorage.getItem("cenCost")).estado__nombreEdo == 'Devuelta' && JSON.parse(sessionStorage.getItem("cenCost")).tipoSolicitud_id == '19') {
            this.pendiente = true;
            this.devueltoDirecion = true;
        }
        if (JSON.parse(sessionStorage.getItem("cenCost")).estado__nombreEdo == 'Devuelta' && JSON.parse(sessionStorage.getItem("cenCost")).tipoSolicitud_id == '21') {
            this.pendiente = true;
            this.devueltoClabe = true;
        }
        this.details();
    }
    details() {
        this.showLoad = true;
        this.service.detailsCostCenter(this.cenCostId, this.id).subscribe(res => {
            //console.log(res);
            this.cenCost = res.RazonSocial;
            this.repLegal = res.RepresentanteLegal;
            //console.log('Fo',this.cenCost);
            this.getAddressFormat(this.cenCost.DomicilioFiscal);
            this.showLoad = false;
        }, error => {
            //console.log(error);
        });
    }
    getAddressFormat(data) {
        //console.log(data)
        this.domicilio = data.calle +
            " " + (data.no_interior == null ? '' : data.no_interior) + " " + data.no_exterior +
            ", Col. " + data.colonia + ", " + data.alcaldia_mpio + ", " + data.estado +
            ", C.P. " + data.codigopostal + ", " + data.pais;
    }
    editarDomicilio() {
        sessionStorage.setItem('detalle_centro', 'domicilio');
        this.router.navigate(['/usuario/administration/costcenteruser/editcostcenter']);
    }
    editarTransferencia() {
        sessionStorage.setItem('detalle_centro', 'transferencia');
        this.router.navigate(['/usuario/administration/costcenteruser/editcostcenter']);
    }
    editarRL(dato) {
        this.router.navigate(['/usuario/administration/clientsuser/editrepresentantelclient'], {
            state: {
                dato: dato
            }
        });
    }
    bajacostcenter() {
