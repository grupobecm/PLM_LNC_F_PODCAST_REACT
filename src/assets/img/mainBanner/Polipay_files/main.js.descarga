/* harmony default export */ __webpack_exports__["default"] = ("/*tooltip css personal por tabla*/\r\n\r\n.mrg-position {\r\n    margin-bottom: 70px;\r\n}\r\n\r\n/*fin tooltip*/\r\n\r\n.no-registros {\r\n    font-size: 16px;\r\n    text-align: center;\r\n}\r\n\r\n.button-verification-code {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    width: 206px;\r\n    height: 43px;\r\n    padding: 0 13px;\r\n    border-radius: 24px;\r\n    margin-top: 0px;\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    /* centrar el boton */\r\n    display: block;\r\n    outline: none;\r\n    cursor: pointer;\r\n}\r\n\r\n/* HOVER */\r\n\r\n.button-verification-code:not([disabled]):hover {\r\n    background-color: var(--accent-color);\r\n    box-shadow: none;\r\n    color: var(--white);\r\n}\r\n\r\n.no-registros-container {\r\n    min-height: calc(100vh - 400px);\r\n}\r\n\r\n.botones {\r\n    position: absolute;\r\n    right: 23px;\r\n}\r\n\r\n.hola {\r\n    padding-top: 4.5px;\r\n    padding-bottom: 19.5px;\r\n}\r\n\r\n.label__filasPagina {\r\n    font-size: 16px;\r\n    line-height: 1.65;\r\n    text-align: center;\r\n    margin: 0;\r\n    margin-right: 8px;\r\n}\r\n\r\n.input__finasPagina {\r\n    width: 87px;\r\n    height: 38px;\r\n    padding-left: 23px;\r\n    border-radius: 6px;\r\n    border: solid 1px var(--grey-dark);\r\n    margin-right: 39px;\r\n}\r\n\r\n.label__numeroRegistros {\r\n    margin-right: 37px;\r\n}\r\n\r\n.boton {\r\n    border: none;\r\n    margin: 0px 16px;\r\n}\r\n\r\n.details img {\r\n    margin-right: 8px;\r\n}\r\n\r\n.descargas img {\r\n    cursor: pointer;\r\n}\r\n\r\n.details {\r\n    border: none;\r\n    text-transform: uppercase;\r\n    font-size: 14px;\r\n    padding: 8px 12px 7px 14px;\r\n    border-radius: 24px;\r\n    outline: none;\r\n}\r\n\r\n.overflow {\r\n    overflow: hidden;\r\n}\r\n\r\n.contenedor-tabla {\r\n    max-width: 100% !important;\r\n    overflow-x: scroll !important;\r\n    padding: 5px;\r\n}\r\n\r\n.tabla-div {\r\n    width: 1369px !important;\r\n    margin-right: 10px !important;\r\n}\r\n\r\n.contenedor-tabla__main--blanco {\r\n    background: transparent;\r\n}\r\n\r\n/*ICONOS ASCENDENTES Y DESCENDENTES*/\r\n\r\n.icon-acs {\r\n    background-image: url('pruebaborrarAscDsc.svg');\r\n    background-repeat: no-repeat;\r\n    background-size: 26%;\r\n    padding: 14px 43px;\r\n}\r\n\r\n.btn-acs {\r\n    border: none;\r\n    background: none;\r\n}\r\n\r\n.table{\r\n    overflow: auto;\r\n    overflow-y: auto;\r\n    max-height: 450px;\r\n}\r\n\r\n.mat-cell,\r\n.mat-header-cell {\r\n  word-wrap: initial;\r\n  display: table-cell;\r\n  line-break: unset;\r\n  white-space: nowrap;\r\n  overflow: hidden;\r\n  vertical-align: middle;\r\n  padding: 0 20px;\r\n}\r\n\r\n.mat-row,\r\n.mat-header-row {\r\n  display: table-row;\r\n}\r\n\r\n.mat-footer-cell{\r\n  overflow: hidden;\r\n  vertical-align: middle;\r\n}\r\n\r\n/*# sourceMappingURL=data:application/json;base64, */");

