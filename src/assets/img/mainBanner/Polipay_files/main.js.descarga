        this.dialog = dialog;
        this.serviceClient = serviceClient;
        this.storageClient = storageClient;
        this.cuenta = "";
        this.showLoad = false;
        this.numeroRegistros = 5;
        this.cero = true;
        this.numeroRegistrosaMostrar = 5;
        this.pagina_actual = 1;
        this.next_page = 0;
        this.prev_page = 0;
        this.total = 5;
        this.total_paginas = 1;
        this.actual1 = 1;
        this.final = 5;
        this.numeroRegistrosF = 0;
        this.numeroRegistrosaMostrarF = 5;
        this.pagina_actualF = 1;
        this.next_pageF = 0;
        this.prev_pageF = 0;
        this.totalF = 0;
        this.total_paginasF = 0;
        this.filtradas = true;
        this.observaciones = "";
        this.fecha1 = "null";
        this.fecha2 = "null";
        this.totalAux = 0;
        this.totalAuxF = 0;
        //ordenamiento de datos
