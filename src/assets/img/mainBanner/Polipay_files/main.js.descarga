const hasEqualToken = (control) => {
    const token = control.get("code11").value +
        control.get("code12").value +
        control.get("code13").value +
        control.get("code14").value;
    const confirmartoken = control.get("code21").value +
        control.get("code22").value +
        control.get("code23").value +
        control.get("code24").value;
    return token === confirmartoken ? null : { noSonIgualesToken: true };
};
const hasEqual = (control) => {
