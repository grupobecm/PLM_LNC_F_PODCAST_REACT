    mostrarColonia2() {
        if (this.flg) {
            if (this.guardar) {
                document.getElementById("fondoColonia2").style.display = 'block';
                document.getElementById("listaColonia2").classList.add("mostrar2");
                document.getElementById("selectColonia2").style.zIndex = "11";
                this.flg = false;
            }
        }
        else {
            this.ocultarColonia2();
        }
    }
    ocultarColonia2() {
        document.getElementById("fondoColonia2").style.display = 'none';
        document.getElementById("listaColonia2").classList.remove("mostrar2");
        this.flg = true;
        if (this.colonia_legal == '\u00a0') {
            this.rojoColonia2 = true;
            this.auxFlgColonia2 = 1;
        }
    }
