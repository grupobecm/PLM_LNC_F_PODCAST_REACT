let SaldoTransactionsComponent = class SaldoTransactionsComponent {
    constructor(storageHome, storageClient, dialog) {
        this.storageHome = storageHome;
        this.storageClient = storageClient;
        this.dialog = dialog;
        /* Este componente se usa en Transacciones p a p y polipay a terceros individual */
        this.nombreCompany = "";
        this.saldoInicial = 0;
        this.saldoDisponible = 0;
        this.montoPendientes = 0;
        this.showLoad = false;
        //this.nombreCompany = this.storage.CurrentInfo.nombre;
        // this.nombreCompany = "Compañia";
        if (JSON.parse(this.storageHome.infoUserValue).data_empresa.commissions.length >= 3) {
            // //console.log('tp y t');
            this.id = JSON.parse(this.storageHome.infoUserValue).cuenta_id;
            // //console.log(this.id);
            if (this.storageClient.InfoCostCenterExist == false) {
                this.dato = JSON.parse(this.storageHome.infoUserValue);
                this.nombreCompany = this.dato.data_empresa.cuenta_eje.name;
            }
            else {
                this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
                this.nombreCompany = this.dato.persona_cuenta__name;
            }
        }
        else {
            if (JSON.parse(this.storageHome.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storageHome.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    // //console.log('tp');
                    this.dato = JSON.parse(this.storageHome.infoUserValue);
                    this.nombreCompany = this.dato.data_empresa.cuenta_eje.name;
                }
                else {
                    if (JSON.parse(this.storageHome.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        //  //console.log('t');
                        //console.log(this.storageClient.InfoCostCenterExist );
                        if (this.storageClient.InfoCostCenterExist == false) {
                            //  //console.log("bye");
                            this.dato = JSON.parse(this.storageHome.infoUserValue);
                            this.nombreCompany = this.dato.data_empresa.cuenta_eje.name;
                            //  //console.log("ir a crear centros de costo");
                        }
                        else {
                            //console.log("si hay servicios ");
                            this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
                            //console.log(this.dato)
                            //console.log(this.dato.persona_cuenta_id);
                            this.nombreCompany = this.dato.persona_cuenta__name;
                        }
                    }
                }
            }
        }
        // if (!this.storageClient.INFO_CENTERCOST == false) {
        //   this.nombreCompany = JSON.parse(this.storageHome.infoUserValue).data_empresa.cuenta_eje.name;
        //   //console.log("bye");
        // } else {
        // if(JSON.parse(this.storageHome.infoUserValue).data_empresa.commissions.length >= 2){
        //   this.nombreCompany =  JSON.parse(this.storageClient.InfoCostCenterValue).persona_cuenta__name
        // } else {
