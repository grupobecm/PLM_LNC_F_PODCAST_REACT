'monto').touched) }\"\r\n                        autocomplete=\"off\" id=\"monto\" name=\"monto\" formControlName=\"monto\" required [ngModel]=\"amountB\">\r\n                    <!-- Alertas  -->\r\n                    <div class=\" alertTransfer\"\r\n                        *ngIf=\"form.get('monto').hasError('montoMinimo') && form.get('monto').errors  && form.get('monto').touched\">\r\n                        <span class=\"alert__text | color-red\"> Por favor captura el monto, este dato debe de ser mayor a\r\n                            $1 MXN</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <!-- Campo Concepto -->\r\n            <div class=\"form\" fxFlex=\"100\" fxLayout=\"row wrap\" class=\"selectbox\">\r\n                <span class=\"form__text user | \"\r\n                    [ngClass]=\"{ 'form__text_alert': (required('concepto_pago') && form.get('concepto_pago').touched) }\">Concepto*</span>\r\n                <!--<input type=\"text\">-->\r\n                <textarea rows=\"5\" class=\"formCon__input  user |\"\r\n                    [ngClass]=\"{ 'formCon__input_alert': (required('concepto_pago') && form.get('concepto_pago').touched) }\"\r\n                    name=\"observaciones\" autocomplete=\"off\" id=\"concepto_pago\" formControlName=\"concepto_pago\"\r\n                    [ngModel]=\"concept\"></textarea>\r\n                <!-- Alertas -->\r\n                <div class=\" alertTransfer\" *ngIf=\"required('concepto_pago') && form.get('concepto_pago').touched \">\r\n                    <span class=\"alert__text | color-red\">Por favor captura el concepto</span>\r\n                </div>\r\n            </div>\r\n\r\n\r\n        </div>\r\n\r\n        <!-- Tercera Columna -->\r\n        <!-- <div class=\"ml-3\" fxFlex=\"32\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n            <div class=\"form \" fxFlex=\"100\" fxLayout=\"row wrap\" class=\"selectbox\">\r\n                <mat-checkbox 