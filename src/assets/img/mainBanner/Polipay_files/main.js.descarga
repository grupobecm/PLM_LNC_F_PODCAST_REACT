n    display: block;\r\n    font-size: 16px;\r\n    line-height: 1.31;\r\n    text-align: center;\r\n}\r\n\r\n\r\n.text--intermedio {\r\n    margin-top: 0;\r\n    margin-bottom: 12px;\r\n}\r\n\r\n\r\n.code__input {\r\n    /* Text */\r\n    font-size: 16px;\r\n    text-align: center;\r\n    font-weight: normal;\r\n    font-stretch: normal;\r\n    font-style: normal;\r\n    line-height: 1.5;\r\n    letter-spacing: 0.15px;\r\n    color: var(--opacity-74);\r\n    width: 44px;\r\n    height: 56px;\r\n    border-radius: 4px;\r\n    border: solid 1px var(--opacity-12);\r\n    outline: none;\r\n    margin-bottom: 14px;\r\n}\r\n\r\n\r\n.input--ml {\r\n    margin-left: 15px;\r\n}\r\n\r\n\r\n/* Button confirmar */\r\n\r\n\r\n.confirmar__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width:160px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var(--main-color);\r\n    margin-top: 23.7px;\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    /* centrar el boton */\r\n    display: block;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n    outline: none;\r\n    cursor: pointer;\r\n    box-shadow: 0 1px 3px var(--opacity-12), 0 3px 3px var(--opacity-24);\r\n    transition: 0.3s;\r\n}\r\n\r\n\r\n/* Button cancelar */\r\n\r\n\r\n.regresar__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width: 160px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var( --grey-dark);\r\n    margin-top: 23.7px;\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    /* centrar el boton */\r\n    display: block;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n    outline: none;\r\n    cursor: pointer;\r\n    box-shadow: 0 1px 3px var(--opacity-12), 0 3px 3px var(--opacity-24)