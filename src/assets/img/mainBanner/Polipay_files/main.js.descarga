/* harmony default export */ __webpack_exports__["default"] = ("<div fxFlex=\"100\">\r\n    <!-- MENSJAE DE INACTIVIDAD PRE-PREGUNTA -->\r\n    <div *ngIf=\"success == 0\" class=\"inactivo\" fxLayout=\"row\" fxLayoutAlign=\"space-between center\">\r\n        <div>\r\n            <img src=\"../../../assets/img/icons/sleep-icon.svg\">\r\n        </div>\r\n        <div class=\"margin\">\r\n            <p class=\"text | color-third\">\r\n                ¡Hola <span>{{username}}</span>!\r\n                <br>¿Sigues aquí?\r\n            </p>\r\n            <button *ngIf=\"success == 0\" mat-dialog-close id=\"button\" class=\"button-accept button-accept--top | color-white background-main \" type=\"button\">SÍ</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--CIERRE DE SESIÓN-->\r\n    <div *ngIf=\"success == 1\" class=\"message\">\r\n        <p class=\"text | color-third\">Lo sentimos.</p>\r\n        <p class=\"text mt-4 mb-5 | color-third\">Tu sesión ha expirado</p>\r\n        <button *ngIf=\"success == 1\" mat-dialog-close id=\"button\" (click)=\"logout()\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n    </div>\r\n\r\n    <!--COLABORADOR -PASO1 - CARTA RESPONSIVA TXT-->\r\n    <div *ngIf=\"success == 2\" class=\"message\">\r\n        <p class=\"text | color-third\"> Se esta generando la carta\r\n            <br>responsiva, lo siguiente que\r\n            <br>tiene que hacer es descargarla,\r\n            <br>firmarla, escanearla y subirla en\r\n            <br>el Paso 2\r\n        </p>\r\n        <div class=\"ml-3\" fxLayout=\"column\" fxLayoutAlign=\"end end\">\r\n            <button class=\"regresar__button | \" type=\"button\" (click)=\"descargarCartaRes()\"><img src=\"../../../assets/img/icons/descargar.svg\"><b class=\"ml-2\">Descargar Carta responsiva</b></button>\r\n            <button *ngIf=\"success == 2\" mat-dialog-close id=\"button2\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--COLABORADOR PASO2- CARTA RESPONSIVA TXT-->\r\n    <div *ngIf=\"success == 3\" class=\"message\">\r\n        <p class=\"text | color-third\">Tu solicitud ha sido enviada\r\n            <br>satisfactoriamente y ha\r\n            <br>quedado en proceso de\r\n            <br>verificación.\r\n            <button *ngIf=\"success == 3\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main \" type=\"button\" (click)=\"collabCreado()\">ACEPTAR</button>\r\n\r\n        </p>\r\n    </div>\r\n    <!--GRUPO PERMISOS - CREAR -->\r\n    <div *ngIf=\"success == 4\" class=\"message\">\r\n        <p class=\"text | color-third\">Tu operación se realizó\r\n            <br>satisfactoriamente.\r\n        </p>\r\n        <button *ngIf=\"success == 4\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n    </div>\r\n    <!--Codigo expirado o invalido-->\r\n    <div *ngIf=\"success == 5\" class=\"message\">\r\n        <p class=\"text | color-third\">¿Estas seguro de Eliminar al\r\n            <br>Grupo AUTORIZACIONES ?\r\n        </p>\r\n        <div fxLayout=\"row wrap\">\r\n            <button fxFlex=\"48\" *ngIf=\"success == 5\" mat-dialog-close id=\"button2\" class=\"button-cancelar mr-3 | color-third background-grey-dark  \" type=\"button \">Cancelar</button>\r\n            <button fxFlex=\"48\" *ngIf=\"success==5 \" id=\"button \" class=\"button-accept | color-white background-main  \" type=\"button \">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Sesion en multiples dispositivos -->\r\n    <div *ngIf=\"success == 6\" fxLayout=\"column\" class=\"inactivo\">\r\n        <div fxFlex=\"100\" class=\"textoimg\" fxLayout=\"row\">\r\n            <div fxFlex=\"30\">\r\n                <img src=\"../../../assets/img/icons/alert.svg \">\r\n            </div>\r\n            <div fxFlex=\"70\" class=\"margin\" fxLayoutAlign=\"center center\">\r\n                <p class=\"text text--margin | color-third \">\r\n                    Ya tienes una sesión abierta en<br> otro dispositivo.\r\n                    <br>¿Deseas cerrar esa sesión?\r\n                </p>\r\n            </div>\r\n        </div>\r\n        <div class=\"botonesInactivo\" fxLayoutAlign=\"space-between center\">\r\n            <button *ngIf=\"success == 6\" mat-dialog-close id=\"button\" class=\"button-accept button--margin | color-white background-third  \" type=\"button \">NO</button>\r\n            <button *ngIf=\"success == 6\" mat-dialog-close id=\"button\" class=\"button-accept button--margin | color-white background-main  \" type=\"button \" (click)=\"otherDiviceLogin()\">SÍ</button>\r\n        </div>\r\n    </div>\r\n    <!--CENTRO DE COSTOS -PASO2 - CARTA RESPONSIVA TXT-->\r\n    <div *ngIf=\"success == 7\" class=\"message\">\r\n        <p class=\"text | color-third\"> Se esta generando la carta\r\n            <br>responsiva, lo siguiente que\r\n            <br>tiene que hacer es descargarla,\r\n            <br>firmarla, escanearla y subirla en\r\n            <br>el Paso 3\r\n        </p>\r\n        <div class=\"ml-3\" fxLayout=\"column\" fxLayoutAlign=\"end end\">\r\n            <button *ngIf=\"success == 7\" id=\"button7\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--ocpalo para lo que quieras y cambia el texto-->\r\n    <div *ngIf=\"success == 8\" class=\"message\">\r\n        <p class=\"text | color-third\"> Se esta generando la carta\r\n            <br>responsiva, lo siguiente que\r\n            <br>tiene que hacer es descargarla,\r\n            <br>firmarla, escanearla y subirla en\r\n            <br>el Paso 3\r\n        </p>\r\n        <div class=\"ml-3\" fxLayout=\"column\" fxLayoutAlign=\"end end\">\r\n            <button *ngIf=\"success == 8\" id=\"button7\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <div *ngIf=\"success == 10\" class=\"inactivo\" fxLayout=\"row\" fxLayoutAlign=\"space-between center\">\r\n        <div>\r\n            <img src=\"../../../assets/img/icons/alert.svg\">\r\n        </div>\r\n        <div class=\"margin\" fxLayout=\"column\" fxLayoutAlign=\"center center\">\r\n            <p class=\"text | color-third\">\r\n                Se ha iniciado sesión en<br> otro equipo.<br> ¿Has sido tú?\r\n            </p>\r\n            <div fxLayout=\"row wrap\" fxLayoutAlign=\"space-between center\">\r\n                <button *ngIf=\"success == 10 \" mat-dialog-close id=\"button \" class=\"button-accept | color-white background-third  \" type=\"button \">NO</button>\r\n                <!--<button *ngIf=\"success == 10 \" mat-dialog-close id=\"button \" class=\"button-accept | color-white background-main  \" type=\"button \" (click)=\"logout()\">SÍ</button>-->\r\n            </div>\r\n        </div>\r\n    </div>\r\n\r\n    <div *ngIf=\"success == 11\" fxLayout=\"column\" class=\"inactivo\">\r\n        <div fxFlex=\"100\" class=\"textoimg\" fxLayout=\"row\">\r\n            <div fxFlex=\"30\" fxLayoutAlign=\"center center\">\r\n                <img src=\"../../../assets/img/icons/mail-blue-icon.svg\">\r\n            </div>\r\n            <div fxFlex=\"70\" class=\"margin\" fxLayoutAlign=\"center center\">\r\n                <p class=\"text text--margin | color-third \">\r\n                    Se envío un código a <br> {{ email }} <br> para verificar que eres tú.\r\n                </p>\r\n            </div>\r\n        </div>\r\n        <div class=\"botonesInactivo\" fxLayoutAlign=\"center center\">\r\n            <button *ngIf=\"success == 11\" mat-dialog-close id=\"button\" class=\"button-accept button--margin | color-white background-third  \" type=\"button \">ACEPTAR</button>\r\n            <!--<button *ngIf=\"success == 6\" mat-dialog-close id=\"button\" class=\"button-accept button--margin | color-white background-main  \" type=\"button \" (click)=\"mensajeCorreo()\">SÍ</button>-->\r\n        </div>\r\n    </div>\r\n    <!--Clientes externos - eliminar representante legal-->\r\n    <div *ngIf=\"success == 12\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            ¿Estas seguro de Eliminar al <br>Representante Legal ?\r\n        </p>\r\n        <div fxLayout=\"row wrap\">\r\n            <button *ngIf=\"success == 12\" mat-dialog-close id=\"button\" class=\"button-cancelar | color-third mr-3\" type=\"button\">Cancelar</button>\r\n            <button *ngIf=\"success == 12\" (click)=\"eliminarcrearnweRL()\" id=\"button\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Clientes externos - eliminar representante legal paso2 crear nuevo-->\r\n    <div *ngIf=\"success == 13\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Es necesario que ingreses un <br>Nuevo Representante Legal. <br>¿Deseas continuar con la <br>Petición?\r\n        </p>\r\n        <div fxLayout=\"row wrap\">\r\n            <button *ngIf=\"success == 13\" mat-dialog-close id=\"button\" class=\"button-cancelar | color-third mr-3\" type=\"button\">Cancelar</button>\r\n            <button *ngIf=\"success == 13\" (click)=\"crearnewRL()\" id=\"button\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Clientes externos - nuevo representante legal -->\r\n    <div *ngIf=\"success == 14\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Se esta generando la carta <br>responsiva, lo siguiente que <br>tiene que hacer es descargarla, <br>firmarla, escanearla y subirla en <br>el Paso 2\r\n        </p>\r\n        <div fxLayout=\"row wrap\">\r\n            <button *ngIf=\"success == 14\" (click)=\"newRL()\" id=\"button\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Clientes externos - nuevo representante legal paso final  -->\r\n    <div *ngIf=\"success == 15\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Tu solicitud ha sido enviada <br>satisfactoriamente y ha <br>quedado en proceso de <br>verificación. </p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 15\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Clientes externos - nuevo cliente paso final -->\r\n    <div *ngIf=\"success == 16\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Tu solicitud ha sido enviada satisfactoriamente y ha <br>quedado en proceso de verificación.</p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 16\" [mat-dialog-close]=\"'Aceptar'\" id=\"button\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Cliente externo - dar de baja  -->\r\n    <div *ngIf=\"success == 16.1\" class=\"message\">\r\n        <p class=\"text | color-third\">¿Estas seguro de Dar de baja al <br>Cliente externo ?</p>\r\n        <div fxLayout=\"row wrap\">\r\n            <button *ngIf=\"success == 16.1\" mat-dialog-close id=\"button\" class=\"button-cancelar | color-third mr-3\" type=\"button\">Cancelar</button>\r\n            <button *ngIf=\"success == 16.1\" (click)=\"motivobajaClienteExterno()\" id=\"button\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Centro de costos - dar de baja  -->\r\n    <div *ngIf=\"success == 17\" class=\"message\">\r\n        <p class=\"text | color-third\">¿Estas seguro de Dar de baja el <br>Centro de Costo ?</p>\r\n        <div fxLayout=\"row wrap\">\r\n            <button *ngIf=\"success == 17\" mat-dialog-close id=\"button\" class=\"button-cancelar | color-third mr-3\" type=\"button\">Cancelar</button>\r\n            <button *ngIf=\"success == 17\" (click)=\"motivobaja()\" id=\"button\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Centros de Costos - dar de baja paso final  -->\r\n    <div *ngIf=\"success == 18\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Tu solicitud ha sido enviada satisfactoriamente y ha <br>quedado en proceso de verificación.</p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 18\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Centros de Costos - Eliminar RL  -->\r\n    <div *ngIf=\"success == 19\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Tu solicitud ha sido enviada satisfactoriamente y ha <br>quedado en proceso de verificación.</p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 19\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Centros de Costos - Autorizar centro de costos  -->\r\n    <div *ngIf=\"success == 191\" class=\"message\">\r\n        <p class=\"text | color-third\">{{message}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 191\" (click)=\"listadoCenCos()\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Cliente externo Fisico - CREAR -->\r\n    <div *ngIf=\"success == 20\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Tu solicitud ha sido enviada satisfactoriamente y ha\r\n            <br>quedado en proceso de verificación.\r\n        </p>\r\n        <button *ngIf=\"success == 20\" (click)=\"listadoClienteExterno(1)\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n    </div>\r\n     <!--Cliente externo Moral - CREAR -->\r\n     <div *ngIf=\"success == '20M'\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Tu solicitud ha sido enviada satisfactoriamente y ha\r\n            <br>quedado en proceso de verificación.\r\n        </p>\r\n        <button *ngIf=\"success == '20M'\" (click)=\"listadoClienteExterno(2)\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n    </div>\r\n    <!--Cliente externo - CREAR -->\r\n    <div *ngIf=\"success == 22\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Ocurrió un error durante el proceso de creación de un cliente moral.\r\n        </p>\r\n        <button *ngIf=\"success == 22\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n    </div>\r\n    <!--PErsonal Administrativo - dar de baja  -->\r\n    <div *ngIf=\"success == 24\" class=\"message\">\r\n        <p class=\"text | color-third\">¿Deseas eliminar a {{name}} del Personal Administrativo?</p>\r\n        <div fxLayout=\"row wrap\">\r\n            <button *ngIf=\"success == 24\" mat-dialog-close id=\"button\" class=\"button-no | color-third mr-3\" type=\"button\">NO</button>\r\n            <button *ngIf=\"success == 24\" (click)=\"motivobajaPersonalAdmin()\" id=\"button\" class=\"button-si | color-white background-main \" type=\"button\">SI</button>\r\n        </div>\r\n    </div>\r\n    <!--success eliminar o editar admin cuenta eje -->\r\n    <div *ngIf=\"success == 97\" class=\"message\">\r\n        <p class=\"text | color-third\">Tu operación se realizó <br> satisfactoriamente.</p>\r\n        <div fxLayout=\"row wrap\">\r\n            <button *ngIf=\"success == 97\" (click)=\"detallesAdminEje()\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Personal Administrativo -operacion -->\r\n    <div *ngIf=\"success == 21\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Tu solicitud ha sido enviada satisfactoriamente y ha <br>quedado en proceso de verificación.</p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 21\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Administradores Polipay - eliminar  -->\r\n    <div *ngIf=\"success == 25\" class=\"message\">\r\n        <p class=\"text | color-third\">¿Deseas eliminar a Zeth Alvarez Teams Frontend del Personal Administrativo?</p>\r\n        <div fxLayout=\"row wrap\">\r\n            <button *ngIf=\"success == 25\" mat-dialog-close id=\"button\" class=\"button-no | color-third mr-3\" type=\"button\">NO</button>\r\n            <button *ngIf=\"success == 25\" (click)=\"motivobajaAdminPolipay()\" id=\"button\" class=\"button-si | color-white background-main \" type=\"button\">SI</button>\r\n        </div>\r\n    </div>\r\n    <!--Administradores Polipay -operacion -->\r\n    <div *ngIf=\"success == 26\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Tu solicitud ha sido enviada satisfactoriamente y ha <br>quedado en proceso de verificación.</p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 26\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Tarjetas Prepago -solicitud -->\r\n    <div *ngIf=\"success == 27\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Tu solicitud de tarjetas está<br>en proceso.\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 27\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <!--DISPERSIONES - Perfil Externo -  pregunta -->\r\n    <div *ngIf=\"success == 28\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            ¿Estás seguro de querer desactivar a {{ name | uppercase }}?<br> Esta acción deshabilitará todas las tarjetas que tiene asignadas.</p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 28 \" mat-dialog-close id=\"button \" class=\"button-accept | color-white background-third  \" type=\"button \">NO</button>\r\n            <button *ngIf=\"success == 28 \" id=\"button \" class=\"button-accept | color-white background-main  \" type=\"button \" (click)=\"deactivateExternalPersonnel()\">SÍ</button>\r\n        </div>\r\n    </div>\r\n    <!--DISPERSIONES - Perfil Externo -  respuesta  -->\r\n    <div *ngIf=\"success == 29\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Se ha desactivado a<br>{{ name | uppercase }}.</p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 29\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--DISPERSIONES - Perfil Externo -  alta personal externo -->\r\n    <div *ngIf=\"success == 30\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Se ha creado el nuevo registro satisfactoriamente.</p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 30\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--DISPERSIONES - Perfil Externo -  desactivar una tarjtea -->\r\n    <div *ngIf=\"success == 31\" class=\"message \" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n        <form [formGroup]=\"form\" (ngSubmit)=\"submit()\" class=\"contenedor\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n            <p class=\"text | color-third\"> ¿Desea desactivarla tarjeta 1234 5678 9101 2345?</p>\r\n            <div class=\"form\" fxFlex=\"100\">\r\n                <span class=\"form__text user | font-roboto\">Motivo de desactivación*</span>\r\n                <input class=\"form__input user | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"motivoDesactivación\" formControlName=\"motivoDesactivación\" required>\r\n            </div>\r\n            <div fxLayout=\"row \" fxFlex=\"100\" fxLayoutAlign=\"space-between none\">\r\n                <button *ngIf=\"success == 31 \" mat-dialog-close id=\"button \" class=\"button-accept | color-white background-third  \" type=\"button \">Cancelar</button>\r\n                <button *ngIf=\"success == 31 \" id=\"button \" class=\"button-accept | color-white background-main  ml-3\" type=\"button \" (click)=\"desactivarTarjeta()\">Aceptar</button>\r\n            </div>\r\n        </form>\r\n    </div>\r\n\r\n    <!--DISPERSIONES - Perfil Externo -  desactivar una tarjtea -  exito -->\r\n    <div *ngIf=\"success == 33\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Se ha desactivado la tarjeta 1234 5678 9101 2345</p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 33\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--DISPERSIONES - Saldos -  confirmar ya se puede borra -->\r\n    <div *ngIf=\"success == 32\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Para continuar, descargar<br>ficha de Deposito.\r\n            <br>\r\n            <br> Después de realizarlo,<br>ponte en contacto con tu<br>ejecutivo Polipay.\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 32\" mat-dialog-close id=\"button\" class=\"button-accept boton-descargar | color-white background-main\" type=\"button\">\r\n                <img src=\"../../../assets/img/icons/file_upload-24px.svg\" alt=\"Descargar ficha de deposito\">\r\n                descargar Ficha de Deposito\r\n            </button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--DISPERSIONES - Solicitud de tarjetas en Centros de Costos -   -->\r\n    <div *ngIf=\"success == 34\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Se ha guardado la edición<br>del registro satisfactoriamente.\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 34\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">\r\n                ACEPTAR\r\n            </button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--DISPERSIONES - Solicitud de tarjetas en Centros de Costos - Pregunta -->\r\n    <div *ngIf=\"success == 35\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            ¿Desea cancelar la solicitud de tarjetas<br>de {{name}} con fecha<br>{{business | date:'dd/MM/yyyy' }}?\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 35 \" [mat-dialog-close] id=\"button \" class=\"button-accept | color-white background-accent  \" type=\"button \">NO</button>\r\n            <button *ngIf=\"success == 35 \"  id=\"button \" class=\"button-accept | color-white background-main  \" type=\"button \" (click)=\"deletLegalRep()\">SÍ</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--DISPERSIONES - Solicitud de tarjetas en Centros de Costos -  confirmacion -->\r\n    <div *ngIf=\"success == 36\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            La Solicitud de tarjetas de<br>{{name}},<br> con fecha {{business | date:'dd/MM/yyyy' }},<br> fue cancelada exitosamente\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 36\" [mat-dialog-close]  id=\"button\" class=\"button-accept | color-white background-accent\" type=\"button\">\r\n                ACEPTAR\r\n            </button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--DISPERSIONES - Solicitud de tarjetas en Centros de Costos - Sin stock  -->\r\n    <div *ngIf=\"success == 37\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Lo sentimos.<br> No cuenta con suficientes<br>tarjetas en stock.\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 37\" (click)=\"solicitarTarjetas()\" id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">\r\n                Solicitar tarjetas\r\n            </button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--DISPERSIONES -  Solicitud de tarjetas en Centros de Costos - Asignada correctamente -->\r\n    <div *ngIf=\"success == 38\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Se han asignado las tarjetas<br>al Centro de Costos<br>BecPolimentes SAPI de CV\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 38\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">\r\n                ACEPTAR\r\n            </button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--ALTA CUENTA EJE -->\r\n    <div *ngIf=\"success == 40\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Tu operación se realizó satisfactoriamente.<br> Se enviará un correo electrónico al cliente con sus<br> datos de acceso cuando se agreguen los servicios.\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 40\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">\r\n                ACEPTAR\r\n            </button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- MENSAJES ERROR BACK RAZON SOCIAL Y REPRESENTANTE LEGAL -->\r\n    <div *ngIf=\"success == 41\" class=\"message\">\r\n        <p class=\"text | color-third\">Datos incorrectos.</p>\r\n        <br>\r\n        <p class=\"text | color-third\" *ngIf=\"unico\">{{ messageNormal }}</p>\r\n        <div *ngIf=\"rs\">\r\n            <p class=\"color-red\"><b>RAZÓN SOCIAL</b></p>\r\n            <p *ngFor=\"let item of erroresRS | keyvalue\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ item.value }}</p>\r\n        </div>\r\n\r\n        <div *ngIf=\"rl\">\r\n            <p class=\"color-red\"><b>REPRESENTANTE LEGAL</b></p>\r\n            <p *ngFor=\"let item of erroresRL | keyvalue\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ item.value }}</p>\r\n        </div>\r\n        <p class=\"nota | color-third\"><span class=\"color-red mr-3\"><b>NOTA:</b></span>En caso de haber añadido administrativos deberas de volver<br> a subir su información y cargar todos los documentos requeridos.</p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 41\" mat-dialog-close id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\" type=\"button\">\r\n                ACEPTAR\r\n            </button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- MENSAJES ERROR CENTROS DE COSTO -->\r\n    <div *ngIf=\"success == 48\" class=\"message\">\r\n        <p class=\"text | color-third\">Datos incorrectos.</p>\r\n        <br>\r\n        <p class=\"color-red ta-c\" *ngIf=\"business\">Centro de Costos</p>\r\n        <p class=\"color-red ta-c\" *ngIf=\"representative\">Representante Legal</p>\r\n        <p *ngFor=\"let item of erroresMessageArray | keyvalue\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ item.value.message }}</p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 48\" mat-dialog-close id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\" type=\"button\">\r\n                ACEPTAR\r\n            </button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Sesion en multiples Pestañas -->\r\n    <div *ngIf=\"success == 42\" fxLayout=\"column\" class=\"inactivo\">\r\n        <div fxFlex=\"100\" class=\"textoimg\" fxLayout=\"row\">\r\n            <div fxFlex=\"30\">\r\n                <img src=\"../../../assets/img/icons/alert.svg \">\r\n            </div>\r\n            <div fxFlex=\"70\" class=\"margin\" fxLayoutAlign=\"center center\">\r\n                <p class=\"text text--margin | color-third \">\r\n                    Ya tienes una sesión abierta en<br> otra ventana.\r\n                    <br><span>¿Deseas cerrar esa sesión?</span>\r\n                </p>\r\n            </div>\r\n        </div>\r\n        <div class=\"botonesInactivo\" fxLayoutAlign=\"space-between center\">\r\n            <button *ngIf=\"success == 42\" mat-dialog-close id=\"button\" class=\"button-accept button--margin | color-white background-third  \" type=\"button \" (click)=\"reload()\">NO</button>\r\n            <button *ngIf=\"success == 42\" mat-dialog-close id=\"button\" class=\"button-accept button--margin | color-white background-main  \" type=\"button \" (click)=\"closeSessionOtherTab()\">SÍ</button>\r\n        </div>\r\n    </div>\r\n    <!-- MENSAJES ERROR BACK 500 -->\r\n    <div *ngIf=\"success == 43\" class=\"message\">\r\n        <p class=\"quinientos | color-red\">Error 500</p>\r\n        <div>\r\n            <p class=\"intentar | color-third\"><b>Vuelva a intentarlo más tarde</b></p>\r\n        </div>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 43\" mat-dialog-close id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\" type=\"button\">\r\n                ACEPTAR\r\n            </button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- TOKEN MURIO -->\r\n    <div *ngIf=\"success == 44\" class=\"message\">\r\n        <p class=\"text | color-third\">Sesión expirada\r\n            <br>Tu sesión expiro y se va a cerrar.\r\n        </p>\r\n        <button *ngIf=\"success == 44\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main \" type=\"button\">ACEPTAR</button>\r\n    </div>\r\n\r\n    <!-- MENSAJES ERROR BACK 500 -->\r\n    <div *ngIf=\"success == 45\" class=\"message\">\r\n        <p class=\"quinientos | color-red\">Error al asignar servicio<br>{{ message }}</p>\r\n        <div>\r\n            <p class=\"intentar | color-third\"><b>Vuelva a intentarlo más tarde</b></p>\r\n        </div>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"success == 45\" mat-dialog-close id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\" type=\"button\">\r\n                ACEPTAR\r\n            </button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- MENSAJES ERROR BACK 500 -->\r\n    <div *ngIf=\"success == 46\" class=\"message\" fxLayout=\"row wrap\">\r\n        <div fxFlex=\"100\" fxLayoutAlign=\"center center \">\r\n            <p class=\"center | color-third\">Para poder cambiar tu contraseña,<br> necesitas iniciar sesión por primera vez.<br> Hemos enviado de nuevo la carta de bienvenida<br> a tu correo electrónicocon tus datos de acceso.</p>\r\n        </div>\r\n        <div fxLayout=\"row\" fxFlex=\"100\">\r\n            <button id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\" type=\"button\" (click)=\"reload()\">\r\n                ACEPTAR\r\n            </button>\r\n        </div>\r\n    </div>\r\n\r\n    <div *ngIf=\"success == 47\" class=\"message\">\r\n        <p class=\"text | color-third\">Datos incorrectos.</p>\r\n        <br>\r\n        <p *ngFor=\"let item of message | keyvalue\">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;{{ message }}</p>\r\n   