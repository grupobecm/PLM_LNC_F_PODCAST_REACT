let TransfeOAComponent = class TransfeOAComponent {
    constructor(router, dialog, formBuilder, service, storage, storageClient, serviceClient) {
        this.router = router;
        this.dialog = dialog;
        this.formBuilder = formBuilder;
        this.service = service;
        this.storage = storage;
        this.storageClient = storageClient;
        this.serviceClient = serviceClient;
        this.cuenta = "";
        this.company = [];
        this.showLoad = false;
        this.cuentaO = '\u00a0';
        this.cuentaD = '\u00a0';
        this.flg = true;
        this.auxFlgOrigen = 0;
        this.auxFlgBeneficiaria = 0;
        this.rojobancoO = false;
        this.rojobancoD = false;
        this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
        //console.log(this.id);
        if (!this.storageClient.INFO_CENTERCOST) {
            //console.log("bye");
        }
        else {
            this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
            //console.log(this.dato)
            //console.log(this.dato.persona_cuenta_id);
        }
        this.getEmpresas();
        this.formOA = formBuilder.group({
            nombre: ['',],
            cuenta: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_10__["Validators"].required,]],
            monto: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_10__["Validators"].required, _utils_validator_pass__WEBPACK_IMPORTED_MODULE_17__["montoMinimo"].montoMinimo]],
            concepto: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_10__["Validators"].required]],
            nombrebeneficiario: ['',],
            cuentaBeneficiario: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_10__["Validators"].required,]],
            date_created: ['',],
            alias: ['',],
            is_favorite: ['',],
            company: ['',],
            is_frequent: ['',],
            cliente: ['',],
            id_beneficiario: ['',],
            id_origen: ['',],
        });
    }
    getEmpresas() {
        let user_type = JSON.parse(this.storage.infoUserValue).user_type;
        //console.log( user_type);
        if (user_type == 8) {
            let datoEmpresa = JSON.parse(this.storage.infoUserValue).data_empresa.centro_costos;
            for (let i = 0; i < datoEmpresa.length; i++) {
                const element = datoEmpresa[i];
                this.company[i] = element;
            }
        }
        else {
            // //console.log('Administrativo');
            this.showLoad = true;
            this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
            this.service.activeCostCenter(this.id).subscribe(res => {
                this.showLoad = false;
                this.company = res;
            });
        }
        // this.service.activeCostCenter(this.id).subscribe(res => {
        //   this.company = res;
        //   // this.empresas = [...res.results];
        //   //console.log(res);
        // })
    }
    onOptionsSelected() {
        //console.log(this.selected);
        if (this.selected != undefined) {
            this.nocuentaO = this.selected.cuenta;
            this.nombreOrigen = this.selected.nombre;
        }
    }
    CuentaDestino() {
        //console.log(this.selectedD);
        if (this.selectedD != undefined) {
            this.nocuentaD = this.selectedD.cuenta;
            this.nombreDestino = this.selectedD.nombre;
        }
    }
    submit2() {
        let data = {
            "empresa": this.company,
            "cuenta_emisor": this.formOA.get("cuenta").value,
            "nombre_beneficiario": this.destino,
            "cta_beneficiario": this.formOA.get("cuentaBeneficiario").value,
            "concepto_pago": this.formOA.get("concepto").value,
            "monto": this.formOA.get("monto").value,
        };
        // if(this.company == this.destino){
        //   //console.log("no pueden ser las mismas cuentas");
        //   //console.log(data);
        //   this.dialog.open(ErrorUserComponent,{
        //     data: {
        //       error: 'TOA-001',
        //       messageNormal: "No se pueden realizar transacciones a la misma cuenta.",
        //     }
        //   })
        // } 
        if (this.formOA.valid == true) {
            //console.log(data);
            this.showLoad = true;
            this.storageClient.setInfoTransOA(data);
            this.router.navigate(['usuario/transactions/own-accounts/confirmOA']);
            //this.serviceClient.createTransactionsOwnAccount(data).subscribe((res: any) =>{
            ////console.log(res);
            //this.showLoad = false;
            //this.dialog.open(SuccessUserComponent,{
            // data: {
            // success: 'TOA-002',
            // messageNormal: res.message
            //}
        } //)
        //this.formOA.reset();
        //this.cuentaO = '\u00a0';
        //this.destino = '\u00a0';
        //}) 
        //} 
        else {
            if (this.cuentaO == '\u00a0') {
                this.requeridoOrigen();
            }
            else if (this.destino == '\u00a0') {
                this.requeridoBeneficiario();
            }
            else if (this.formOA.get("monto").value == null) {
                this.requeridoMonto();
            }
            else if (this.formOA.get("concepto").value == null) {
                this.requeridoConcepto();
            }
        }
    }
    submit() {
        //console.log(this.formOA.valid);
        if (this.formOA.get('cuenta').value !== this.formOA.get('cuentaBeneficiario').value) {
            if (this.formOA.valid) {
                let Jsondata = {
                    "empresa": this.cuentaO,
                    "cuenta_emisor": this.formOA.get("cuenta").value,
                    "nombre_beneficiario": this.cuentaD,
                    "cta_beneficiario": this.formOA.get("cuentaBeneficiario").value,
                    "concepto_pago": this.formOA.get("concepto").value,
                    "monto": this.formOA.get("monto").value,
                };
                //console.log(Jsondata);
                this.storageClient.setInfoTransOA(Jsondata);
                this.router.navigate(['usuario/transactions/own-accounts/confirmOA']);
                this.formOA.reset();
                this.cuentaO = '\u00a0';
                this.destino = '\u00a0';
            }
            else {
                this.auxFlgOrigen = 1;
                this.auxFlgBeneficiaria = 1;
                this.rojobancoO = true;
                this.rojobancoD = true;
                document.getElementById('monto').focus();
                document.getElementById('concepto').focus();
                document.getElementById('confirmar').focus();
                this.showLoad = false;
            }
        }
        else if (this.formOA.get('cuenta').value == this.formOA.get('cuentaBeneficiario').value) {
            if (this.formOA.get('cuenta').value == null || this.formOA.get('cuenta').value == undefined || this.formOA.get('cuentaBeneficiario').value == null || this.formOA.get('cuentaBeneficiario').value == undefined || this.formOA.valid == false) {
                this.auxFlgOrigen = 1;
                this.auxFlgBeneficiaria = 1;
                this.rojobancoO = true;
                this.rojobancoD = true;
                document.getElementById('monto').focus();
                document.getElementById('concepto').focus();
                document.getElementById('confirmar').focus();
                this.showLoad = false;
            }
            else {
                //console.log(this.formOA.get('cuenta').value);
                //console.log("no pueden ser las mismas cuentas");
                this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_18__["ErrorUserComponent"], {
                    data: {
                        error: 'TOA-001',
                        messageNormal: "No se pueden realizar transacciones a la misma cuenta.",
                    },
                    disableClose: true
                });
            }
        }
        if (this.cuentaO == '\u00a0') {
            this.auxFlgOrigen = 1;
            this.rojobancoO = true;
            document.getElementById('monto').focus();
            document.getElementById('concepto').focus();
            document.getElementById('confirmar').focus();
        }
        if (this.cuentaD == '\u00a0') {
            this.auxFlgBeneficiaria = 1;
            this.rojobancoD = true;
            document.getElementById('monto').focus();
            document.getElementById('concepto').focus();
            document.getElementById('confirmar').focus();
        }
    }
    //CAMPOS EN ROJO
    requeridoOrigen() {
        if (this.formOA.get('cuenta').errors == null || this.auxFlgOrigen == 0) {
            return false;
        }
        else {
            return true;
        }
    }
    requeridoBeneficiario() {
        if (this.formOA.get('cuentaBeneficiario').errors == null || this.auxFlgBeneficiaria == 0) {
            return false;
        }
        else {
            return true;
        }
    }
    requerido(campo) {
        if (this.formOA.get(campo).errors == null) {
            return false;
        }
        else {
            return true;
        }
    }
    requeridoMonto() {
        if (this.formOA.get('monto').errors == null) {
            return false;
        }
        else {
            return true;
        }
    }
    requeridoConcepto() {
        if (this.formOA.get('concepto').errors == null) {
            return false;
        }
        else {
            return true;
        }
    }
    //FIN CAMPOS EN ROJO
    mostrar() {
        if (this.flg) {
            document.getElementById("fondo").style.display = 'block';
            document.getElementById("lista").classList.add("mostrar");
            document.getElementById("select1").style.zIndex = "11";
            this.flg = false;
        }
        else {
            this.ocultar();
        }
    }
    ocultar() {
        document.getElementById("fondo").style.display = 'none';
        document.getElementById("lista").classList.remove("mostrar");
        this.flg = true;
        if (this.cuentaO == '\u00a0') {
            this.rojobancoO = true;
            this.auxFlgOrigen = 1;
        }
    }
    ocultar2() {
        document.getElementById("fondo2").style.display = 'none';
        document.getElementById("lista2").classList.remove("mostrar2");
        this.flg = true;
        if (this.cuentaD == '\u00a0') {
            this.rojobancoD = true;
            this.auxFlgBeneficiaria = 1;
        }
    }
    mostrar2() {
        if (this.flg) {
            document.getElementById("fondo2").style.display = 'block';
            document.getElementById("lista2").classList.add("mostrar2");
            document.getElementById("select1").style.zIndex = "8";
            /* / */
            this.flg = false;
        }
        else {
            this.ocultar2();
        }
    }
    /* AQUI VA LA LOGICA PARA MOSTRAR FRECUENTES */
    actualizar(value) {
        //console.log(value);
        this.nombreOrigen = value.persona_cuenta__name;
        this.cuentaO = value.persona_cuenta__name;
        this.nocuentaO = value.cuenta;
        this.formOA.value.cuenta = value.cuenta;
        this.formOA.get('id_origen').setValue(value.id);
        this.rojobancoO = false;
        this.auxFlgOrigen = 0;
    }
    actualizar2(value) {
        //console.log(value);
        this.nombreDestino = value.persona_cuenta__name;
        this.cuentaD = value.persona_cuenta__name;
        this.nocuentaD = value.cuenta;
        this.formOA.value.cuentaBeneficiario = value.cuenta;
        this.formOA.get('id_beneficiario').setValue(value.id);
        this.rojobancoD = false;
        this.auxFlgBeneficiaria = 0;
    }
    cancelar() {
        this.formOA.reset();
        this.cuentaO = '\u00a0';
        this.cuentaD = '\u00a0';
        this.rojobancoO = false;
        this.auxFlgOrigen = 0;
        this.rojobancoD = false;
        this.auxFlgBeneficiaria = 0;
        sessionStorage.removeItem('confirmtransinterna');
    }
};
