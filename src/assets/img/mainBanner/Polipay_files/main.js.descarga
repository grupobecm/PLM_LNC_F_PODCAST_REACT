        }, error => {
            //console.log(error);
        });
    }
    getCheckListGroup() {
        for (let j = 0; j < this.dataCollaborator2.PersonInfo.group.length; j++) {
            for (let i = 0; i < this.groupPrm.length; i++) {
                //console.log(this.dataCollaborator2.PersonInfo.group[j].id + '=' + this.groupPrm[i].id);
                if (this.dataCGroupPermi.id == this.groupPrm[i].id) {
                    this.actualizar2(this.dataCGroupPermi);
                    break;
                }
            }
        }
    }
    //centros de costos
    getCentersList() {
        this.showLoad = true;
        this.serviceCC.activeCostCenter(this.user_id).subscribe(res => {
            //console.log(res);
            this.client = res;
            for (let i = 0; i < this.client.length; i++) {
                this.client[i].checked = false;
            }
            //console.log(this.client);
            this.showLoad = false;
            this.getCheckList();
        }, error => {
            //console.log(error);
        });
    }
    addGroup(evento, group) {
        //console.log(group);
        //console.log(evento);
        if (evento.target.checked) {
            this.frecuente_groups.push(group.persona_cuenta_id);
        }
        else {
            for (let i = 0; i < this.frecuente_groups.length; i++) {
                //console.log(this.frecuente_groups[i]);
                if (group.persona_cuenta_id == this.frecuente_groups[i]) {
                    this.frecuente_groups.splice(i, 1);
                }
            }
        }
        //console.log( this.frecuente_groups);
    }
    getCheckList() {
        for (let j = 0; j < this.dataCenterCost.length; j++) {
            for (let i = 0; i < this.client.length; i++) {
                if (this.dataCenterCost[j].empresa_id == this.client[i].persona_cuenta_id) {
                    this.frecuente_groups.push(this.client[i].persona_cuenta_id);
                    this.client[i].checked = true;
                    break;
                }
            }
        }
    }
    //PARA VER PERMISOS
    mostrar2() {
        if (this.flg) {
            if (this.guardar) {
                document.getElementById("fondo2").style.display = 'block';
                document.getElementById("lista2").classList.add("mostrar2");
                document.getElementById("fondo2").style.zIndex = "13";
                document.getElementById("select1").style.zIndex = "13";
                this.flg = false;
            }
        }
        else {
            this.ocultar2();
        }
    }
    ocultar2() {
        document.getElementById("fondo2").style.display = 'none';
        document.getElementById("lista2").classList.remove("mostrar2");
        this.flg = true;
        if (this.permisos == '\u00a0') {
            this.rojobanco = true;
            this.auxFlgBanco = 1;
        }
    }
    actualizar2(value) {
