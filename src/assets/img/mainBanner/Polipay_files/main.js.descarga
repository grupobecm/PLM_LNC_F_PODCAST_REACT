 </div>\r\n            </div>\r\n\r\n            <div class=\"contenedor-botones padding--botones\" fxFlex=\"100\" fxLayout=\"row\" fxLayoutAlign=\"end center\">\r\n                <button type=\"button\" class=\"cancelar__button\" (click)=\"cerrar()\"><b>Cancelar</b></button>\r\n                <button class=\"confirmar__button | color-white\" type=\"submit\" [disabled]=\"!form.valid\"><b>Aceptar</b></button>\r\n            </div>\r\n\r\n        </form>\r\n\r\n    </div>\r\n</div>\r\n<!-- Loading -->\r\n<!-- <app-loading *ngIf=\"showLoad\"></app-loading> -->\r\n\r\n");

