    getAddressFormat(id, data) {
        const address = data.calle +
            " " +
            data.no_exterior +
            " " +
            (data.no_interior == null ? "" : data.no_interior) +
            ", Col. " +
            data.colonia +
            ", " +
            data.alcaldia_mpio +
            ", " +
            data.estado +
            ", C.P. " +
            data.codigopostal +
            ", " +
            data.pais;
        if (id == "CC") {
            this.addressCen = address;
        }
        else {
            this.addressRep = address;
        }
    }
