let DasboardTransactionComponent = class DasboardTransactionComponent {
    constructor() {
        /* Setea en el storage el id de la empresa seleccionada en '/usuario' */
        this.empresas = [];
        this.saldoInicial = 0;
        this.saldoDisponible = 0;
        this.cuenta = "";
        this.nombreSelect = "";
        /* Mostrar y cultar el select */
        this.flg = true;
        /* Loader spinner */
        this.showLoad = false;
        /* Montos */
        this.montoPendientes = 0;
        this.montoEnviadas = 0; // ESTE ES LIBERADAS
        this.montoCanceladas = 0;
        this.montoDevoluciones = 0;
        /* Obtiene todas las empresas del usuario */
        // this.showLoad = true;
    }
    /* Mostrar y ocultar select */
    mostrar() {
        if (this.flg) {
            document.getElementById("fondo-aux").style.display = 'block';
            document.getElementById("lista").classList.add("mostrar");
            this.flg = false;
        }
        else {
            this.ocultar();
        }
    }
    ocultar() {
        document.getElementById("fondo-aux").style.display = 'none';
        document.getElementById("lista").classList.remove("mostrar");
        this.flg = true;
    }
    /* FIN Ocultar y mostrar select */
    /* Seleccionar empresa select */
    actualizar(empresa) {
        this.cuenta = empresa.cuenta;
        /* Muestra el nombre de la empresa en el select como seleccionado */
        this.nombreSelect = empresa.nombre;
        this.getMontos(empresa.id, empresa.monto);
        this.ocultar();
    }
    /* FIN Seleccionar empresa select */
    /* Obtiene los montos de enviadas, pendientes y canceladas de una sola empresa*/
    getMontos(id, monto) {
        this.showLoad = true;
    }
};
