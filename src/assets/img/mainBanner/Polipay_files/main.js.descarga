                },
                disableClose: true,
            });
            this.auxFlgBanco = 1;
            document.getElementById('nombre').focus();
            document.getElementById('tarjeta').focus();
            document.getElementById('alias').focus();
            this.showLoad = false;
            //this.notReceived = false;
        }
    }
    //CAMPOS EN ROJO
    requeridoBanco() {
        if (this.form.get('banco').errors == null || this.auxFlgBanco == 0) {
            return false;
        }
        else {
            return true;
        }
    }
    requeridoNombreB() {
        if (this.form.get('nombrebeneficiario').errors == null) {
            return false;
        }
        else {
            return true;
        }
    }
    requeridoAlias() {
        if (this.form.get('alias').errors == null) {
            return false;
        }
        else {
            return true;
        }
    }
    requeridoCuenta() {
        if (this.form.get('cuenta').errors == null) {
            return false;
        }
        else {
            return true;
        }
    }
    //FIN CAMPOS EN ROJO
    Checked() {
        this.checked = !this.checked;
        // if(!(document.getElementById("check") as HTMLInputElement).checked){
        //   this.form.get('alias').setValue(" ");
        //   this.aliasR = "";
        // }
    }
    mostrar() {
        if (this.flg) {
            document.getElementById("fondo").style.display = 'block';
            document.getElementById("lista").classList.add("mostrar");
            this.buscar = "";
            this.copyCompany = this.company;
            this.total = this.copyCompany.length;
            this.flg = false;
        }
        else {
            this.ocultar();
        }
    }
    ocultar() {
        document.getElementById("fondo").style.display = 'none';
        document.getElementById("lista").classList.remove("mostrar");
        this.flg = true;
    }
    mostrar2() {
        if (this.flg) {
            if (this.guardar) {
                document.getElementById("fondo2").style.display = 'block';
                document.getElementById("lista2").classList.add("mostrar2");
                /* / */
                this.flg = false;
            }
        }
        else {
            this.ocultar2();
        }
    }
    ocultar2() {
        document.getElementById("fondo2").style.display = 'none';
        document.getElementById("lista2").classList.remove("mostrar2");
        this.flg = true;
    }
    actualizar2(value) {
        //console.log(value);
        this.banco = value.institucion;
        //console.log(this.banco);
        this.form.get('banco').setValue(value.id);
        //console.log(value.id)
        this.auxFlgBanco = 0;
        if (this.rojobanco) {
            this.rojobanco = false;
        }
    }
    validacion(event) {
        let theEvent = event || window.event;
        let key;
        if (theEvent.type === 'paste') {
            key = event.clipboardData.getData('text/plain');
        }
        else {
            let reg = /^([0-9])*$/;
            if (!reg.test(this.clabeR)) {
                this.clabeR = this.clabeR.replace(/\D/g, '');
            }
            // if(this.clabeR.length == 18 || this.clabeR.length == 16){
            //   for(let i = 0;i < this.company.length;i++){
            //     if(this.company[i].cuenta == this.clabeR){
            //       this.actualizar(this.company[i],true);
            //     }
            //   }
            // }
        }
    }
    BankList() {
        this.showLoad = true;
        this.ServicesAxisAccountService.BanksAxisAccounts().subscribe((res) => {
            this.showLoad = false;
            this.Bancos = res;
        }, error => {
            //console.log(error);
        });
    }
    getBankId() {
        for (let i = 0; i < this.Bancos.length; i++) {
            if (this.banco == this.Bancos[i].institucion) {
                //console.log("Encontré",this.banco,this.Bancos[1].id);
                this.form.get('banco').setValue(this.Bancos[1].id);
                this.form.get('cliente_id').setValue(this.dato.id);
                this.form.get('company_id').setValue(this.userid);
                //console.log(this.form.value);
                break;
            }
        }
    }
};
