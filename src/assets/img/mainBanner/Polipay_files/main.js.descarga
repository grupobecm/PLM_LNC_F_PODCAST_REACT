        }, error => {
            this.showLoad = false;
            //console.log(error.error)
            //console.log(error)
        });
    }
    clasicaSolicitudMenos() {
        if (this.classic_quantity > 0) {
            this.classic_quantity--;
        }
    }
    clasicaSolicitudMas() {
        this.classic_quantity++;
    }
    platinoSolicitudMenos() {
        if (this.platinum_quantity > 0) {
            this.platinum_quantity--;
        }
    }
    platinoSolicitudMas() {
        this.platinum_quantity++;
    }
    doradaSolicitudMenos() {
        if (this.golden_quantity > 0) {
            this.golden_quantity--;
        }
    }
    doradaSolicitudMas() {
        this.golden_quantity++;
    }
    calc() {
        this.subtotal = (this.classic_price * this.classic_quantity) + (this.platinum_price * this.platinum_quantity) + (this.golden_price * this.golden_quantity);
        this.IVA = ((this.classic_price * this.classic_quantity) + (this.platinum_price * this.platinum_quantity) + (this.golden_price * this.golden_quantity)) * .16;
    }
    // Misa
    getCardsA() {
        this.serviceCards.getAllCardsAv(this.idAccount).subscribe(res => {
            //console.log(res);
            this.cardsDisponibles = res;
        }, error => {
            //console.log(error);
        });
    }
