    /* AVANZAR ENTRE LOS PASOS */
    alPaso1() {
        this.paso1 = true;
        this.paso2 = false;
        this.paso3 = false;
    }
    alPaso2() {
        this.t.controls = [];
        this.addOption();
        this.documents_centro_costos.controls = [];
        for (let i = 0; i < 7; i++) {
            this.addDocument_rs();
        }
        this.documents_representante_legal.controls = [];
        for (let i = 0; i < 3; i++) {
            this.addDocument_rl();
        }
        if (this.vacios_rs()) {
            for (let i = 0; i < this.campos_rs.length; i++) {
                document.getElementById(this.campos_rs[i]).focus();
            }
            this.auxFlgBanco = 1;
            this.auxFlgColonia1 = 1;
        }
        else if (this.requerido_rs()) {
            //console.log("Algo anda mal");
            //console.log(this.form.get("calle").value);
            //console.log(this.form.get("no_exterior").value);
            //console.log(this.form.value)
        }
        else {
            this.paso1 = false;
            this.paso2 = true;
            this.paso3 = false;
        }
    }
    alPaso3() {
        this.paso1 = false;
        this.paso2 = false;
        this.paso3 = true;
