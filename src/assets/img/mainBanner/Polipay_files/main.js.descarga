let DetailsDispersionPendingIComponent = class DetailsDispersionPendingIComponent {
    constructor(data, dialog, serviceDis, storageClient, router) {
        this.data = data;
        this.dialog = dialog;
        this.serviceDis = serviceDis;
        this.storageClient = storageClient;
        this.router = router;
        this.falgLiq = false;
        this.showLoad = false;
        this.dato = data.res;
        this.type = data.type;
        //console.log('dato', this.dato);
        ////console.log(this.storageClient.IdUserValue);
        //this.documentPdf()
    }
    ngOnInit() {
        if (this.router.url.includes('usuario/dispersiones/estado-dispersion/individual-dispersion/liquidate-dispersion')) {
            this.falgLiq = true;
        }
    }
    censorship(data) {
        let cuenta = data.split('');
        return "******" + cuenta[cuenta.length - 4] + cuenta[cuenta.length - 3] + cuenta[cuenta.length - 2] + cuenta[cuenta.length - 1];
    }
    downloadPdf() {
        //console.log(this.dato);
        let data = {
            id: this.dato.id,
            person_id: this.storageClient.IdUserValue
        };
        this.serviceDis.documentPdf(data).subscribe(res => {
            this.document = res.documento;
            const download = document.createElement('a');
            download.href = this.document;
            download.setAttribute('download', 'Comprobante_' + data.id);
            download.target = "_blank";
            document.body.appendChild(download);
            download.click();
        });
    }
};
