/* harmony default export */ __webpack_exports__["default"] = ("<!-- Barra menu lateal (numero de cuenta y clabe) -->\r\n<app-menu fxFlex=\"16.66\" ></app-menu>\r\n<!-- FIN Barra menu lateal (numero de cuenta y clabe) -->\r\n\r\n<!-- POLIPAY A POLIPAY -->\r\n\r\n<div class=\"confirmacion-transfer\" fxFlex=83.33 fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n    <app-saldo-transactions fxFlex=\"100\"></app-saldo-transactions>\r\n\r\n    <div class=\"tablas mt-4 mb-5\" fxFlex=\"98\" fxLayoutAlign=\"center start\">\r\n        <div class=\"tabla__una\" fxFlex=\"48\" fxLayoutAlign=\"center start\">\r\n            <table class=\"tabla tabla-ordenes-enviadas | background-white\">\r\n                <!-- CONTENIDO -->\r\n                <tbody class=\"tablas__tbody\">\r\n                    <tr class=\"tr | color-third\" fxLayoutAlign=\"none center\">\r\n                        <td class=\"th th--ml mr-3  th--content | color-third crw\" fxFlex=\"100\">La clave de rastreo podrá consultarla en el historial dentro de los detalles de sus transferencias enviadas, una vez este sea generado.</td>\r\n                    </tr>\r\n                    <tr class=\"tr | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                        <td class=\"th th--ml  th--content | color-main\" fxFlex=\"100\" translate>User.Confirmations.BeneficiaryCompany</td>\r\n                        <td class=\"th th--align-right th--content | color-third\" fxFlex=\"100\">{{data.nombrebeneficiario}}</td>\r\n                    </tr>\r\n                    <tr class=\"tr | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                        <td class=\"th th--ml  th--content | color-main\" fxFlex=\"100\" translate>User.Confirmations.BeneficiaryAccount</td>\r\n                        <td class=\"th th--align-right th--content | color-third\" fxFlex=\"100\">{{cuentaBeneficiario}}</td>\r\n                    </tr>\r\n                    <tr class=\"tr | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                        <td class=\"th th--ml  th--content | color-main\" fxFlex=\"100\" translate>User.Confirmations.Bank</td>\r\n                        <td class=\"th th--align-right th--content | color-third\" fxFlex=\"100\">Polipay</td>\r\n                    </tr>\r\n                    <tr class=\"tr | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                        <td class=\"th th--ml  th--content | color-main\" fxFlex=\"100\" translate>User.Confirmations.OrderingCompany</td>\r\n                        <td class=\"th th--align-right th--content | color-third\" fxFlex=\"100\">{{empresa}}</td>\r\n                    </tr>\r\n                    <tr class=\"tr | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                        <td class=\"th th--ml  th--content | color-main\" fxFlex=\"100\" translate>User.Confirmations.OriginatorAccount</td>\r\n                        <td class=\"th th--align-right th--content | color-third\" fxFlex=\"100\">{{cuentaordenante}}</td>\r\n                    </tr>\r\n                    <tr class=\"tr | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                        <td class=\"th th--ml  th--content | color-main\" fxFlex=\"100\" translate>User.Confirmations.OrderingName</td>\r\n                        <td class=\"th th--align-right th--content | color-third\" fxFlex=\"100\">{{nameE}}</td>\r\n                    </tr>\r\n                    <tr class=\"tr | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\">\r\n                        <td class=\"th th--ml  th--content | color-main\" fxFlex=\"100\" translate>User.Confirmations.RFCOriginator</td>\r\n                        <td class=\"th th--align-right th--content | color-third\" fxFlex=\"100\">{{data.rfcurp}}</td>\r\n                    </tr>\r\n                    <tr class=\"tr | color-third\" fxLayout=\"row\" fxLayoutAlign=\"none center\