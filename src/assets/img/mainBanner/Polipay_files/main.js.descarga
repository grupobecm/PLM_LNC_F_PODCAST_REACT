let ReceivedTMComponent = class ReceivedTMComponent {
    constructor(dialog) {
        this.dialog = dialog;
        this.numeroRegistros = 0;
        this.cero = false;
        this.numeroRegistrosaMostrar = 5;
        this.showLoad = false;
        this.pagina_actual = 1;
        this.next_page = 0;
        this.prev_page = 0;
        this.total = 0;
        this.total_paginas = 0;
        this.actual1 = 1;
        this.final = 0;
        this.totalAux = 0;
        this.totalAuxF = 0;
        // this.showLoad = true;
        this.ListTransfer();
    }
    ListTransfer() {
        // this.showLoad = true;
        this.pagina_actual = 1;
    }
    next() {
        if (this.next_page != null) {
            this.showLoad = true;
            this.pagina_actual++;
        }
    }
    prev() {
        if (this.prev_page != null) {
            this.showLoad = true;
            this.pagina_actual--;
        }
    }
    inicio() {
        this.ListTransfer();
    }
    fin() {
        if (Number(this.total_paginas.toFixed()) < Number(this.total_paginas)) {
            this.pagina_actual = Number(this.total_paginas.toFixed()) + 1;
        }
        else {
            this.pagina_actual = Number(this.total_paginas.toFixed());
        }
        this.showLoad = true;
    }
    openDialog() {
        this.dialog.open(_filtro_filtro_component__WEBPACK_IMPORTED_MODULE_6__["FiltroComponent"], {
            width: '90%',
            panelClass: 'custom-dialog-container'
        });
    }
    update() {
        ////console.log(this.numeroRegistrosaMostrar);
        if (this.numeroRegistrosaMostrar == 0) {
            this.numeroRegistrosaMostrar = this.total;
        }
        this.ListTransfer();
    }
    detalles(dato) {
        this.dialog.open(_details_details_component__WEBPACK_IMPORTED_MODULE_5__["DetailsComponent"], {
            width: '35%',
            data: {
                dato: dato
            },
            panelClass: 'custom-dialog-container',
            disableClose: true
        });
    }
};
