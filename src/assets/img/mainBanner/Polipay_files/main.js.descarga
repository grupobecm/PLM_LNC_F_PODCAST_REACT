        //   }
        //   if(JSON.parse(this.storageHome.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago'){
        //     this.nombreCompany = JSON.parse(this.storageHome.infoUserValue).data_empresa.cuenta_eje.name;
        //   }
        // }
        //    //console.log(JSON.parse(this.storageHome.infoUserValue));
        // }
        //this.getMontos(this.storage.CurrentInfo.id);
    }
    /* Obtiene los montos de enviadas, pendientes y canceladas de una sola empresa*/
    getMontos(id) {
        this.showLoad = true;
    }
};
