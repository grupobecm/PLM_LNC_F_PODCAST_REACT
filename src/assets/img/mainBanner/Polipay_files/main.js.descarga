            this.numRegister = this.listStaffExternal.data.length;
            //console.log(this.numRegister);
        }, error => {
            this.showLoad = false;
            this.ningunDato = true;
            //console.log(error.error)
        });
    }
    exportarXlsx(id = this.dato.persona_cuenta_id, idtype = 1, name = null, clabe = null, nameBenefy = null, date1 = null, date2 = null, status = 1) {
        this.showLoad = true;
        this.serviceClientE.exportXlsx(id, idtype, name, clabe, nameBenefy, date1, date2, status, null).subscribe(res => {
            //console.log(res.detail[0].data);
            window.open(res.detail[0].data, "_blank");
