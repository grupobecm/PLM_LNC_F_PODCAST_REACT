        this.dialog = dialog;
        this.router = router;
        this.formBuilder = formBuilder;
        this.storageClient = storageClient;
        this.serviceAdmin = serviceAdmin;
        this.cuenta = "";
        //Tablas de Angular Material
        this.displayedColumns = ['empresa', 'nombre_beneficiario', 'monto', "clave_rastreo", 'fecha_creacion', 'button'];
        this.listStaffExternal = [];
        this.ningunDato = false;
        this.noData = false;
        this.numRegister = 0;
        this.latName = "";
        this.showLoad = false;
        this.color = 'primary';
        this.benefi = null;
        this.date1 = null;
        this.date2 = null;
        this.trackingKey = null;
        this.listPersonal();
    }
    listPersonal(size = 9999, id = null, benefi = null, date1 = null, date2 = null, trackingKey = null) {
        this.showLoad = true;
        this.serviceAdmin.listTransactionsPending(size, id, benefi, date1, date2, trackingKey).subscribe(res => {
            //console.log(res);
            this.ningunDato = false;
            let variable = [...res.results];
            this.listStaffExternal = new _angular_material_table__WEBPACK_IMPORTED_MODULE_13__["MatTableDataSource"](variable);
            this.showLoad = false;
            this.listStaffExternal.sort = this.sort;
            this.listStaffExternal.paginator = this.paginator;
            this.listStaffExternal.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listStaffExternal.data.length;
        }, error => {
            this.showLoad = false;
            this.ningunDato = true;
            //console.log(error.error)
        });
    }
    exportExcell(status = 3) {
        this.showLoad = true;
        this.serviceAdmin.excelTransactions(this.benefi, this.trackingKey, this.date1, this.date2, status).subscribe(res => {
            //console.log(res);
            //console.log(res.detail[0].data);
            window.open(res.detail[0].data, "_blank");
            this.showLoad = false;
        }, error => {
            this.showLoad = false;
            this.ningunDato = true;
            //console.log(error.error)
        });
    }
    openFilter() {
        this.benefi = null;
        this.date1 = null;
        this.date2 = null;
        this.trackingKey = null;
        let filtro = this.dialog.open(_slopes_admin_filtro_individual_slopes_admin_filtro_individual_component__WEBPACK_IMPORTED_MODULE_20__["SlopesAdminFiltroIndividualComponent"], {
            width: "90%",
            panelClass: "custom-dialog-container"
        });
        filtro.afterClosed().subscribe(res => {
            let id = null;
            let status = 3;
            //console.log(res);
            if (res == undefined) {
            }
            else {
                if (res != 'Reset filtro') {
                    for (let i = 0; i < res.data.filtro.length; i++) {
                        switch (res.data.filtro[i].campo) {
                            case 'Beneficiario':
                                this.benefi = res.data.filtro[i].valor;
                                break;
                            case 'Fecha de Operación':
                                this.date1 = res.data.filtro[i].valor.begin.toISOString().split("T")[0];
                                this.date2 = res.data.filtro[i].valor.end.toISOString().split("T")[0];
                                break;
                            case 'Clave de Rastreo':
                                this.trackingKey = res.data.filtro[i].valor;
                                break;
                            case 'Folio':
                                id = res.data.filtro[i].valor;
                                break;
                        }
                    }
                    //console.log(id);
                    this.listPersonal(9999, id, this.benefi, this.date1, this.date2, this.trackingKey);
                }
            }
        });
    }
    seeDetails(dato) {
        // //console.log(dato);
        this.router.navigate(['/administrador/pending/details-individual'], {
            state: {
                dato: dato
            }
        });
    }
    requestCards(data) {
        this.storageClient.setInfoExternalP(data);
        this.router.navigate(["/usuario/dispersiones/peronal-externo/asignar-tarjetas-personal-externo"]);
    }
