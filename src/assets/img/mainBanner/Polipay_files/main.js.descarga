-red\" *ngIf=\"form.get('name_stp').errors.required\"> Por favor captura el Alias STP</span>\r\n                            <span class=\"alert__text | color-red\" *ngIf=\"!form.get('name_stp').errors.required && form.get('name_stp').errors.mayorde\"> Tu Alias STP debe contener 1 a 15 caracteres</span>\r\n                            <span class=\"alert__text | color-red\" *ngIf=\"!form.get('name_stp').errors.required && form.get('name_stp').errors.whitespace\"> Tu Alias STP no debe contener espacios</span>\r\n                          </div>\r\n                            <!--<div class=\"form\">\r\n                                <div class=\"fondo-cerrar-select\" id=\"fondo2\" (click)=\"ocultar2()\"></div>\r\n                                <div class=\"select-container \" id=\"select1\" fxFlex=\"100\">\r\n                                    <span class=\"form__text user text--grey | background-white2\" [ngClass]=\"{ 'form__text_alert': requeridoBanco() || rojobanco }\">Banco*</span>\r\n                                    <div class=\"form__input select | font-roboto \" [ngClass]=\"{ 'form__input_alert': requeridoBanco() || rojobanco }\" id=\"banco_clabe\" type=\"text\" name=\"frecuent\" (click)=\"mostrar2()\">\r\n                                        {{ banco }}\r\n                                        <div class=\"flecha\" id=\"flecha\" [ngClass]=\"{ 'flecha--alert': requeridoBanco() || rojobanco }\"></div>\r\n                                        <ul class=\"ul-select all zIndex-10 maxAlturaYScroll elscroll\" id=\"lista2\">\r\n                                            <li *ngFor=\"let banco of Bancos\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\" (click)=\"actualizar2(banco)\">\r\n                                                <span class=\"texto__select\" fxFlex=\"95\">{{banco.institucion}}</span>\r\n                                            </li>\r\n                                        </ul>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"alertTransfer\" *ngIf=\"requeridoBanco()\">\r\n                                <span class=\"alert__text | color-red\">Por favor escoge un banco</span>\r\n                            </div>-->\r\n                        </div>\r\n\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"mt-2\" fxFlex=\"100\">\r\n                <p class=\"Subtitle color-accent remove-fondo\" translate>Domicilio Fiscal</p>\r\n            </div>\r\n            <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div class=\"form_space  form--password-mt\" fxFlex=\"20\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('codigopostal') && form.get('codigopostal').touched) }\" translate>Código Postal*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('codigopostal') && form.get('codigopostal').touched) }\" autocomplete=\"off\" type=\"text\" (keyup)=\"buscar($event);\" name=\"codigopostal\" id=\"codigopostal\" formControlName=\"codigopostal\"\r\n                        required [(ngModel)]=\"CPE\">\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('codigopostal') && form.get('codigopostal').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Código Postal</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"fondo-cerrar-select \" id=\"fondoColonia1\" (click)=\"ocultarColonia1()\"></div>\r\n                <div class=\"form_space  form--password-mt\" fxFlex=\"30\" *ngIf=\"!flagColonia1\">\r\n                    <div class=\"select-container \" id=\"selectColonia1\">\r\n                        <span class=\"form__text user\" [ngClass]=\"{ 'form__text_alert': requeridoColoniaSelect1() || rojoColonia1 }\">Colonia*</span>\r\n                        <div class=\"form__input select | font-roboto \" [ngClass]=\"{ 'form__input_alert': requeridoColoniaSelect1() || rojoColonia1 }\" id=\"colo\" type=\"text\" name=\"frecuent\" (click)=\"mostrarColonia1()\">\r\n                            {{ colonia }}\r\n                            <div class=\"flecha\" id=\"flecha\" [ngClass]=\"{ 'flecha--alert': requeridoColoniaSelect1() || rojoColonia1 }\"></div>\r\n                            <ul class=\"ul-select all zIndex-10 maxAlturaYScroll elscroll\" id=\"listaColonia1\">\r\n\r\n                                <li *ngIf=\"colonias.length == 0\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                                    <span class=\"texto__select\" fxFlex=\"95\">No se encontrarón direcciones</span>\r\n                                </li>\r\n\r\n                                <li *ngFor=\"let col of colonias\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\" (click)=\"actualizarColonia1(col)\">\r\n                                    <span class=\"texto__select\" fxFlex=\"95\">{{col}}</span>\r\n                                </li>\r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"alertTransfer\" *ngIf=\"requeridoColoniaSelect1()\">\r\n                        <span class=\"alert__text | color-red\">Por favor ingresa la Colonia</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space  form--password-mt\" fxFlex=\"30\" *ngIf=\"flagColonia1\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('colonia') && form.get('colonia').touched) }\" translate>Colonia*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('colonia') && form.get('colonia').touched) }\" autocomplete=\"off\" type=\"text\" name=\"colonia\" id=\"colonia\" formControlName=\"colonia\" required>\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('colonia') && form.get('colonia').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura la colonia</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space form--password-mt\" fxFlex=\"30\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('alcaldia_mpio') && form.get('alcaldia_mpio').touched) }\" translate>Municipio/Alcaldía*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('alcaldia_mpio') && form.get('alcaldia_mpio').touched) }\" autocomplete=\"off\" type=\"text\" name=\"alcaldia_mpio\" id=\"alcaldia_mpio\" formControlName=\"alcaldia_mpio\"\r\n                        required [(ngModel)]=\"AlcaldiaE\">\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('alcaldia_mpio') && form.get('alcaldia_mpio').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Municipio/Alcaldía</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space  form--password-mt margin--rigth\" fxFlex=\"20\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('estado') && form.get('estado').touched) }\" translate>Estado*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('estado') && form.get('estado').touched) }\" autocomplete=\"off\" type=\"text\" name=\"Estado\" id=\"estado\" formControlName=\"estado\" required [(ngModel)]=\"EstadoE\">\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('estado') && form.get('estado').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Estado</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div class=\"form_space  form--password-mt\" fxFlex=\"60\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('calle') && form.get('calle').touched) }\" translate>Calle*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('calle') && form.get('calle').touched) }\" autocomplete=\"off\" type=\"text\" name=\"Calle\" id=\"calle\" formControlName=\"calle\" required>\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('calle') && form.get('calle').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura la Calle</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space form--password-mt\" fxFlex=\"20\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('no_exterior') && form.get('no_exterior').touched) }\" translate>No. Exterior*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('no_exterior') && form.get('no_exterior').touched) }\" autocomplete=\"off\" type=\"number\" name=\"no_exterior\" id=\"no_exterior\" formControlName=\"no_exterior\" required>\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('no_exterior') && form.get('no_exterior').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Número Exterior</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space form--password-mt margin--rigth\" fxFlex=\"20\">\r\n                    <span class=\"form__text  pass | font-roboto\" translate>No. Interior</span>\r\n                    <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"number\" name=\"no_interior\" id=\"no_interior\" formControlName=\"no_interior\">\r\n\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"mt-4\" fxFlex=\"100\">\r\n                <div class=\"mt-5\" fxFlex=\"35\" fxFlexOffset=\"65\" fxLayoutAlign=\"end end\">\r\n                    <button class=\"regresar__button mr-3 | color-third\" id=\"btn\" type=\"button\" [routerLink]=\"['/administrador/cuentaeje/cuentas-eje/lista-clientes']\" translate>Regresar</button>\r\n                    <button class=\"confirmar__button  | color-white\" id=\"submit1\" type=\"button\" (click)=\"alPaso2()\" translate>Continuar</button>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div *ngIf=\"paso2\" fxLayout=\"row wrap\">\r\n            <div class=\"\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div class=\"mt-3\" fxFlex=\"100\">\r\n                    <p class=\"mensajeObl\" translate>User.Messages.RequiredFields</p>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div class=\"form_space  form--password-mt\" fxFlex=\"30\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('name') && form.get('name').touched) }\" translate>Nombre(s)*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('name') && form.get('name').touched) }\" autocomplete=\"off\" type=\"text\" name=\"name\" id=\"name\" formControlName=\"name\" required>\r\n\r\n                        <div class=\" alertTransfer\" *ngIf=\"requerido('name') && form.get('name').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el nombre del Representante Legal</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space form--password-mt\" fxFlex=\"20\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('a_paterno') && form.get('a_paterno').touched) }\" translate>Apellido Paterno*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('a_paterno') && form.get('a_paterno').touched) }\" autocomplete=\"off\" type=\"text\" name=\"a_paterno\" id=\"a_paterno\" formControlName=\"a_paterno\" required>\r\n\r\n                        <div class=\" alertTransfer\" *ngIf=\"requerido('a_paterno') && form.get('a_paterno').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el apellido paterno del Representante Legal</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space form--password-mt\" fxFlex=\"20\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('a_materno') && form.get('a_materno').touched) }\" translate>Apellido Materno*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('a_materno') && form.get('a_materno').touched) }\" autocomplete=\"off\" type=\"text\" name=\"a_materno\" id=\"a_materno\" formControlName=\"a_materno\" required>\r\n\r\n                        <div class=\" alertTransfer\" *ngIf=\"requerido('a_materno') && form.get('a_materno').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el apellido materno del Representante Legal</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space form--password-mt\" fxFlex=\"30\" fxLayout=\"row wrap\">\r\n                        <div class=\"fecha\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                            <p class=\"form__date label_fecha pass | font-roboto\" [ngClass]=\"{ 'form__date_alert': (requerido('fecha_nacimiento') && form.get('fecha_nacimiento').touched) }\" translate>Fecha de Nacimiento*</p>\r\n                            <mat-form-field class=\"valor campo_fecha disabled\" id=\"fecha_nacimiento_block\" [ngClass]=\"{ 'mat-form-field_alert': (requerido('fecha_nacimiento') && form.get('fecha_nacimiento').touched) }\" fxFlex=\"100\">\r\n                                <input matInput class=\"date\" [satDatepicker]=\"picker6\" id=\"fecha_nacimiento_rl_id\" autocomplete=\"off\" name=\"fecha_nacimiento\" formControlName=\"fecha_nacimiento\" readonly [max]=\"datenow\" required>\r\n                                <sat-datepicker #picker6 [rangeMode]=\"false\" [selectFirstDateOnClose]=\"true\" [rangeHoverEffect]=\"false\">\r\n                                </sat-datepicker>\r\n                                <sat-datepicker-toggle matSuffix [for]=\"picker6\"></sat-datepicker-toggle>\r\n                            </mat-form-field>\r\n                        </div>\r\n\r\n                        <div class=\" alertTransfer fecha_const_alert\" *ngIf=\"form.get('fecha_nacimiento').touched \">\r\n                            <span class=\"alert__text | color-red\" *ngIf=\"form.get('fecha_nacimiento').hasError('required')\" translate> Por favor captura la Fecha de Nacimiento</span>\r\n                            <span class=\"alert__text | color-red\" *ngIf=\"form.get('fecha_nacimiento').hasError('menorEdad')\" translate>No eres mayor de edad</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space form--password-mt\" fxFlex=\"20\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('rfc') && form.get('rfc').touched) }\" translate>R.F.C.*</span>\r\n                        <input class=\"form__input password rfc | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('rfc') && form.get('rfc').touched) }\" autocomplete=\"off\" type=\"text\" name=\"rfc\" id=\"rfc\" formControlName=\"rfc\" required>\r\n\r\n                        <div class=\" alertTransfer\" *ngIf=\"requerido('rfc') && form.get('rfc').touched \">\r\n                            <span class=\"alert__text | color-red\" *ngIf=\"!form.get('rfc').errors.rfcNoHomoInvalid\" translate> Por favor captura el RFC</span>\r\n                            <span class=\"alert__text | color-red\" *ngIf=\"form.get('rfc').errors.rfcNoHomoInvalid\"> Por favor captura un RFC valido. No debe incluir la homoclave</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space form--password-mt\" fxFlex=\"15\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('homoclave') && form.get('homoclave').touched) }\" translate>Homoclave*</span>\r\n                        <input class=\"form__input password rfc | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('homoclave') && form.get('homoclave').touched) }\" autocomplete=\"off\" type=\"text\" name=\"homoclave\" id=\"homoclave\" formControlName=\"homoclave\" required>\r\n\r\n                        <div class=\" alertTransfer\" *ngIf=\"requerido('homoclave') && form.get('homoclave').touched \">\r\n                            <span class=\"alert__text | color-red\" *ngIf=\"!form.get('homoclave').errors.homoclaveInvalid\" translate> Por favor captura la homoclave del Representante Legal</span>\r\n                            <span class=\"alert__text | color-red\" *ngIf=\"form.get('homoclave').errors.homoclaveInvalid\"> Por favor captura una homoclave válida</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space  form--password-mt\" fxFlex=\"30\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('phone') && form.get('phone').touched) }\" translate>Teléfono*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('phone') && form.get('phone').touched) }\" autocomplete=\"off\" type=\"text\" name=\"phone\" id=\"phone\" formControlName=\"phone\" required [(ngModel)]=\"telefonoModel\">\r\n\r\n                        <div class=\" alertTransfer\" *ngIf=\"requerido('phone') && form.get('phone').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el teléfono del Representante Legal</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space  form--password-mt\" fxFlex=\"34\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('email') && form.get('email').touched) }\" translate>Correo Electrónico*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('email') && form.get('email').touched) }\" autocomplete=\"off\" type=\"text\" name=\"email\" id=\"email\" formControlName=\"email\" required [(ngModel)]=\"emailModel\">\r\n\r\n                        <div class=\" alertTransfer\" *ngIf=\"requerido('email') && form.get('email').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el correo electrónico del Representante Legal</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"mt-5\" fxFlex=\"100\">\r\n                <p class=\"Subtitle color-accent remove-fondo\" translate>Domicilio Fiscal</p>\r\n            </div>\r\n\r\n            <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div class=\"form_space  form--password-mt\" fxFlex=\"20\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('codigopostal_rl') && form.get('codigopostal_rl').touched) }\" translate>Código Postal*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('codigopostal_rl') && form.get('codigopostal_rl').touched) }\" autocomplete=\"off\" type=\"text\" (keyup)=\"buscar2($event);\" name=\"codigopostal_rl\" id=\"codigopostal_rl\"\r\n                        formControlName=\"codigopostal_rl\" required [(ngModel)]=\"CP_legalModel\">\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('codigopostal_rl') && form.get('codigopostal_rl').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Código Postal</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form  form--password-mt padding-15\" fxFlex=\"30\" *ngIf=\"!flagColonia2\">\r\n                    <div class=\"fondo-cerrar-select zIndex10 selectColoniazz\" id=\"fondoColonia2\" (click)=\"ocultarColonia2()\"></div>\r\n                    <div class=\"select-container zIndex10\" id=\"selectColonia2\">\r\n                        <span class=\"form__text user\" [ngClass]=\"{ 'form__text_alert': requeridoColoniaSelect2() || rojoColonia2 }\">Colonia*</span>\r\n                        <div class=\"form__input select | font-roboto \" [ngClass]=\"{ 'form__input_alert': requeridoColoniaSelect2() || rojoColonia2 }\" id=\"colo_rl\" type=\"text\" name=\"frecuent\" (click)=\"mostrarColonia2()\">\r\n                            {{ colonia_legal }}\r\n                            <div class=\"flecha\" id=\"flecha_colo_rl\" [ngClass]=\"{ 'flecha--alert': requeridoColoniaSelect2() || rojoColonia2 }\"></div>\r\n                            <ul class=\"ul-select all zIndex-10 maxAlturaYScroll elscroll\" id=\"listaColonia2\">\r\n\r\n                                <li *ngIf=\"colonias_legal.length == 0\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                                    <span class=\"texto__select\" fxFlex=\"95\">No se encontrarón direcciones</span>\r\n                                </li>\r\n\r\n                                <li *ngFor=\"let col of colonias_legal\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\" (click)=\"actualizarColonia2(col)\">\r\n                                    <span class=\"texto__select\" fxFlex=\"95\">{{col}}</span>\r\n                                </li>\r\n                            </ul>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"alertTransfer\" *ngIf=\"requeridoColoniaSelect2() || rojoColonia2\">\r\n                        <span class=\"alert__text | color-red\">Por favor ingresa la Colonia</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space  form--password-mt\" fxFlex=\"30\" *ngIf=\"flagColonia2\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('colonia_rl') && form.get('colonia_rl').touched) }\" translate>Colonia*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('colonia_rl') && form.get('colonia_rl').touched) }\" autocomplete=\"off\" type=\"text\" name=\"colonia_rl\" id=\"colonia_rl\" formControlName=\"colonia_rl\" required>\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('colonia_rl') && form.get('colonia_rl').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Colonia</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space form--password-mt\" fxFlex=\"30\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('alcaldia_mpio_rl') && form.get('alcaldia_mpio_rl').touched) }\" translate>Municipio/Alcaldía*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('alcaldia_mpio_rl') && form.get('alcaldia_mpio_rl').touched) }\" autocomplete=\"off\" type=\"text\" name=\"alcaldia_mpio_rl\" id=\"alcaldia_mpio_rl\" formControlName=\"alcaldia_mpio_rl\"\r\n                        required [(ngModel)]=\"municipio_legalModel\">\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('alcaldia_mpio_rl') && form.get('alcaldia_mpio_rl').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Municipio/Alcaldía</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space  form--password-mt margin--rigth\" fxFlex=\"20\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('estado_rl') && form.get('estado_rl').touched) }\" translate>Estado*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('estado_rl') && form.get('estado_rl').touched) }\" autocomplete=\"off\" type=\"text\" name=\"estado_rl\" id=\"estado_rl\" formControlName=\"estado_rl\" required [(ngModel)]=\"estado_legalModel\">\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('estado_rl') && form.get('estado_rl').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Estado</span>\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"form_space  form--password-mt\" fxFlex=\"20\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('pais_rl') && form.get('pais_rl').touched) }\" translate>País*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('pais_rl') && form.get('pais_rl').touched) }\" autocomplete=\"off\" type=\"text\" name=\"pais_rl\" id=\"pais_rl\" formControlName=\"pais_rl\" required>\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('pais_rl') && form.get('pais_rl').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el País</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space  form--password-mt\" fxFlex=\"40\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('calle_rl') && form.get('calle_rl').touched) }\" translate>Calle*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('calle_rl') && form.get('calle_rl').touched) }\" autocomplete=\"off\" type=\"text\" name=\"calle_rl\" id=\"calle_rl\" formControlName=\"calle_rl\" required>\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('calle_rl') && form.get('calle_rl').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura la Calle</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space form--password-mt\" fxFlex=\"20\">\r\n                    <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requerido('no_exterior_rl') && form.get('no_exterior_rl').touched) }\" translate>No. Exterior*</span>\r\n                    <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requerido('no_exterior_rl') && form.get('no_exterior_rl').touched) }\" autocomplete=\"off\" type=\"number\" name=\"no_exterior_rl\" id=\"no_exterior_rl\" formControlName=\"no_exterior_rl\"\r\n                        required>\r\n\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('no_exterior_rl') && form.get('no_exterior_rl').touched \">\r\n                        <span class=\"alert__text | color-red\" translate> Por favor captura el Número Exterior</span>\r\n                    </div>\r\n                </div>\r\n                <div class=\"form_space form--password-mt margin--rigth\" fxFlex=\"20\">\r\n                    <span class=\"form__text  pass | font-roboto\" translate>No. Interior</span>\r\n                    <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"number\" name=\"no_interior_rl\" id=\"no_interior_rl\" formControlName=\"no_interior_rl\">\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"checkfrecuent\" fxLayout=\"column\" fxFlex=\"100\">\r\n                <mat-checkbox (change)=\"ValidarCheck1()\" fxFlex=\"100\" class=\"mr-2 check checkbox\" name=\"is_admin\" id=\"is_admin\" formControlName=\"is_admin\" [(ngModel)]=\"is_admin\">El Representante Legal hará funciones administrativas</mat-checkbox>\r\n                <mat-checkbox (change)=\"ValidarCheck2()\" fxFlex=\"100\" class=\"check checkbox\" name=\"addworker\" id=\"addworker\" formControlName=\"addworker\" [(ngModel)]=\"addworker\">Dar de alta Personal Administrativo</mat-checkbox>\r\n            </div>\r\n\r\n            <div *ngIf=\"showPersonal\" class=\"padding\" fxLayout=\"row wrap\" fxFlex=\"100\" fxLayoutAlign=\"start start\">\r\n\r\n                <div class=\"fila\" fxLayout=\"row wrap\" fxFlex=\"100\">\r\n\r\n                    <div *ngFor=\"let test of arregloAxiliar; let i = index\" [formGroup]=\"test\" class=\"nuevo-personal mt-4\" fxFlex=\"100\" fxLayout=\"row\">\r\n                        <div fxFlex=\"85\" fxLayout=\"row wrap\">\r\n                            <div class=\"\" fxFlex=\"100\">\r\n                                <span class=\"tituloDinamico color-accent remove-fondo\">{{ i + 1 }}</span>\r\n                                <span class=\"tituloDinamico color-accent remove-fondo\" *ngIf=\"terminacion(i+1,'ER')\" translate>ER</span>\r\n                                <span class=\"tituloDinamico color-accent remove-fondo\" *ngIf=\"terminacion(i+1,'DO')\" translate>DO</span>\r\n                                <span class=\"tituloDinamico color-accent remove-fondo\" *ngIf=\"terminacion(i+1,'TO')\" translate>TO</span>\r\n                                <span class=\"tituloDinamico color-accent remove-fondo\" *ngIf=\"terminacion(i+1,'VO')\" translate>VO</span>\r\n                                <span class=\"tituloDinamico color-accent remove-fondo\" *ngIf=\"terminacion(i+1,'NO')\" translate>NO</span>\r\n                                <span class=\"tituloDinamico color-accent remove-fondo\" *ngIf=\"terminacion(i+1,'MO')\" translate>MO</span>\r\n                                <span class=\"tituloDinamico color-accent remove-fondo\" *ngIf=\"terminacion(i+1,'AVO')\" translate>AVO</span>\r\n                                <span class=\"tituloDinamico color-accent remove-fondo\" translate> Personal administrativo</span>\r\n                            </div>\r\n                            <div class=\"form_space  form--password-mt\" fxFlex=\"40\">\r\n                                <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': test.get('nombreAdd').touched && test.get('nombreAdd').hasError('required') }\" translate>Nombre(s)*</span>\r\n                                <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': test.get('nombreAdd').touched && test.get('nombreAdd').hasError('required') }\" autocomplete=\"off\" type=\"text\" name=\"nombreAdd\" [attr.id]=\"'nombreAdd'+i\" formControlName=\"nombreAdd\"\r\n                                    required>\r\n\r\n                                <div class=\" alertTransfer\" *ngIf=\"test.get('nombreAdd').touched && test.get('nombreAdd').hasError('required')\">\r\n                                    <span class=\"alert__text | color-red\" translate> Por favor captura el nombre del Personal Administrativo</span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"form_space form--password-mt\" fxFlex=\"30\">\r\n                                <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': test.get('apellidoPAdd').touched && test.get('apellidoPAdd').hasError('required') }\" translate>Apellido Paterno*</span>\r\n                                <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': test.get('apellidoPAdd').touched && test.get('apellidoPAdd').hasError('required') }\" autocomplete=\"off\" type=\"text\" name=\"apellidoPAdd\" [attr.id]=\"'apellidoPAdd'+i\" formControlName=\"apellidoPAdd\"\r\n                                    required>\r\n\r\n                                <div class=\" alertTransfer\" *ngIf=\"test.get('apellidoPAdd').touched && test.get('apellidoPAdd').hasError('required')\">\r\n                                    <span class=\"alert__text | color-red\" translate> Por favor captura el apellido paterno del Personal Administrativo</span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"form_space form--password-mt\" fxFlex=\"30\">\r\n                                <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': test.get('apellidoMAdd').touched && test.get('apellidoMAdd').hasError('required') }\" translate>Apellido Materno*</span>\r\n                                <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': test.get('apellidoMAdd').touched && test.get('apellidoMAdd').hasError('required') }\" autocomplete=\"off\" type=\"text\" name=\"apellidoMAdd\" [attr.id]=\"'apellidoMAdd'+i\" formControlName=\"apellidoMAdd\"\r\n                                    required>\r\n\r\n                                <div class=\" alertTransfer\" *ngIf=\"test.get('apellidoMAdd').touched && test.get('apellidoMAdd').hasError('required')\">\r\n                                    <span class=\"alert__text | color-red\" translate> Por favor captura el apellido materno del Personal Administrativo</span>\r\n                                </div>\r\n                            </div>\r\n                            <!-- telefono personal -->\r\n                            <div class=\"form_space  form--password-mt\" fxFlex=\"40\">\r\n                                <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': test.get('telefonoAdd').touched && (test.get('telefonoAdd').hasError('required') || errorTelefonoRepetidoo[i]) }\" translate>Teléfono*</span>\r\n                                <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': test.get('telefonoAdd').touched && (test.get('telefonoAdd').hasError('required') || errorTelefonoRepetidoo[i]) }\" autocomplete=\"off\" type=\"text\" name=\"telefonoAdd\" [attr.id]=\"'telefonoAdd'+i\"\r\n                                    (keyup)=\"cambios2(i)\" formControlName=\"telefonoAdd\" required>\r\n\r\n                                <div class=\" alertTransfer\" *ngIf=\"test.get('telefonoAdd').touched && test.get('telefonoAdd').hasError('required')\">\r\n                                    <span class=\"alert__text | color-red\" translate> Por favor captura el teléfono del Personal Administrativo</span>\r\n                                </div>\r\n                                <div class=\" alertTransfer\" *ngIf=\"test.get('telefonoAdd').touched && errorTelefonoRepetidoo[i]\">\r\n                                    <span class=\"alert__text | color-red\" translate> No puedes ingresar teléfonos repetidos</span>\r\n                                </div>\r\n                            </div>\r\n                            <!-- correo personal -->\r\n                            <div class=\"form_space  form--password-mt\" fxFlex=\"30\">\r\n                                <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': test.get('correoAdd').touched && (test.get('correoAdd').hasError('required')  || test.get('correoAdd').hasError('email') || errorCorreoReperito[i]) }\" translate>Correo Electrónico*</span>\r\n                                <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': test.get('correoAdd').touched && (test.get('correoAdd').hasError('required') || test.get('correoAdd').hasError('email') || errorCorreoReperito[i]) }\" autocomplete=\"off\"\r\n                                    type=\"email\" name=\"correoAdd\" [attr.id]=\"'correoAdd'+i\" (keyup)=\"cambios(i)\" formControlName=\"correoAdd\" required>\r\n\r\n                                <div class=\" alertTransfer\" *ngIf=\"test.get('correoAdd').touched && test.get('correoAdd').hasError('required')\">\r\n                                    <span class=\"alert__text | color-red\" translate> Por favor captura el correo electrónico del Personal Administrativo</span>\r\n                                </div>\r\n                                <div class=\" alertTransfer\" *ngIf=\"test.get('correoAdd').touched && test.get('correoAdd').hasError('email')\">\r\n                                    <span class=\"alert__text | color-red\" translate> Por favor captura un correo electrónico Valido</span>\r\n                                </div>\r\n                                <div class=\" alertTransfer\" *ngIf=\"test.get('correoAdd').touched && errorCorreoReperito[i]\">\r\n                                    <span class=\"alert__text | color-red\" translate> No puedes ingresar correos repetidos</span>\r\n                                </div>\r\n                            </div>\r\n                            <!-- fecha personal -->\r\n                            <div class=\"form_space form--password-mt\" fxFlex=\"30\" fxLayout=\"row wrap\">\r\n                                <div class=\"fecha\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                                    <p class=\"form__date label_fecha pass | font-roboto\" [ngClass]=\"{ 'form__date_alert': ((test.get('fechanacimientoAdd').hasError('required') || test.get('fechanacimientoAdd').hasError('menorEdad')) && test.get('fechanacimientoAdd').touched) }\" translate>Fecha de Nacimiento*</p>\r\n                                    <mat-form-field class=\"valor campo_fecha disabled\" id=\"fechanacimientoAdd\" [ngClass]=\"{ 'mat-form-field_alert': ((test.get('fechanacimientoAdd').hasError('required') || test.get('fechanacimientoAdd').hasError('menorEdad')) && test.get('fechanacimientoAdd').touched) }\"\r\n                                        fxFlex=\"100\">\r\n                                        <input matInput class=\"date formDatex\" #fechanacimientoHash [attr.id]=\"'fechanacimientoAdd'+i\" id=\"fechanacimientoAddId\" [satDatepicker]=\"picker7\" autocomplete=\"off\" name=\"fechanacimientoAdd\" formControlName=\"fechanacimientoAdd\" readonly [max]=\"datenow\"\r\n                                            required>\r\n                                        <sat-datepicker #picker7 [rangeMode]=\"false\" [selectFirstDateOnClose]=\"true\" [rangeHoverEffect]=\"false\">\r\n                                        </sat-datepicker>\r\n                                        <sat-datepicker-toggle matSuffix [for]=\"picker7\"></sat-datepicker-toggle>\r\n                                    </mat-form-field>\r\n                                </div>\r\n\r\n                                <div class=\"alertTransfer fecha_const_alert\" *ngIf=\"test.get('fechanacimientoAdd').touched\">\r\n                                    <span class=\"alert__text | color-red\" *ngIf=\"test.get('fechanacimientoAdd').hasError('required')\" translate> Por favor captura la Fecha de Nacimiento</span>\r\n                                    <span class=\"alert__text | color-red\" *ngIf=\"test.get('fechanacimientoAdd').hasError('menorEdad')\" translate>No eres mayor de edad</span>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"agregar\" fxFlex=\"15\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                            <button *ngIf=\"aparecer(i) && max()\" type=\"button\" class=\"boton-mas | background-main color-white\" (click)=\"addOption()\"><img src=\"../../../../assets/img/icons/mas.svg\" alt=\"Agregar campo para filtro\"></button>\r\n\r\n                            <button *ngIf=\"i > 0\" type=\"button\" class=\"boton-menos | background-grey-dark color-white\" (click)=\"removeOption(i)\"><img src=\"../../../../assets/img/icons/menos.svg\" alt=\"Eliminar campo para filtro\"></button>\r\n                        </div>\r\n\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"mt-4\" fxFlex=\"100\">\r\n                <button class=\"confirmar__button button-margin | color-white\" id=\"submit2\" type=\"button\" (click)=\"validarEirPaso3()\" translate>Continuar</button>\r\n            </div>\r\n\r\n        </div>\r\n\r\n        <div *ngIf=\"paso3\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n            <div class=\"mt-3\" fxFlex=\"100\">\r\n                <p class=\"mensajeObl\" translate>User.Messages.RequiredFields</p>\r\n            </div>\r\n            <div class=\"mt-2\" fxFlex=\"100\">\r\n                <p class=\"Subtitle color-accent remove-fondo\" translate>Documentos de la Razón Social</p>\r\n            </div>\r\n            <div class=\"margin-row-button\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"50\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"100\">\r\n                        <p class=\"color-60\">Acta Constitutiva*</p>\r\n                    </div>\r\n\r\n                    <div class=\"\" fxFlex=\"100\" fxLayout=\"row\">\r\n                        <input class=\"boton__input\" style=\"display: none\" type=\"file\" (change)=\"fileChange($event,0,'rs')\" #hiddenfileinput accept=\".pdf, application/pdf\">\r\n                        <button type=\"button\" class=\"cargar__button | color-white\" [ngClass]=\"{'boton--alert': arregloErrores_rs[0] }\" routerLinkActive=\"active\" (click)=\"hiddenfileinput.click()\">\r\n                            <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                            <b>Cargar Archivo*</b>\r\n                        </button>\r\n                        <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                            <span fxFlex=\"100\" class=\"color-third mt-2 ml-3\">{{ documents_razon_social.controls[0].get('nombre').value }}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\" alertTransfer\" *ngIf=\"arregloErrores_rs[0]\">\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresVacio_rs[0]\">Por favor carga la Acta Constitutiva</span>\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresFormat_rs[0]\">Formato de archivo incorrecto. Debe ser un archivo PDF</span>\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresSize_rs[0]\">Tamaño máximo de archivo superado</span>\r\n                    </div>\r\n\r\n                </div>\r\n                <div fxFlex=\"50\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"100\">\r\n                        <p class=\"color-60\">Registro Público de Comercio*</p>\r\n                    </div>\r\n                    <div class=\"\" fxFlex=\"100\" fxLayout=\"row\">\r\n                        <input class=\"boton__input\" style=\"display: none\" type=\"file\" (change)=\"fileChange($event, 1,'rs')\" #hiddenfile1input accept=\".pdf, application/pdf\">\r\n                        <button type=\"button\" class=\"cargar__button | color-white\" [ngClass]=\"{'boton--alert': arregloErrores_rs[1] }\" routerLinkActive=\"active\" (click)=\"hiddenfile1input.click()\">\r\n                            <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                            <b>Cargar Archivo*</b>\r\n                        </button>\r\n                        <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                            <span fxFlex=\"100\" class=\"color-third mt-2 ml-3\">{{ documents_razon_social.controls[1].get('nombre').value }}</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\" alertTransfer\" *ngIf=\"arregloErrores_rs[1]\">\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresVacio_rs[1]\">Por favor carga el Registro Público de Comercio</span>\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresFormat_rs[1]\">Formato de archivo incorrecto. Debe ser un archivo PDF</span>\r\n                        <span class=\"alert__text | color-red\" *ngIf=\"arregloErroresSize_rs[1]\">Tamaño máximo de archivo superado</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div class=\"margin-row-button\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                <div fxFlex=\"50\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"100\">\r\n    