er: none;\r\n    text-transform: uppercase;\r\n    font-size: 14px;\r\n    padding: 8px 12px 7px 14px;\r\n    border-radius: 24px;\r\n    outline: none;\r\n}\r\n\r\n.botones_container{\r\n    margin-bottom: 20px !important;\r\n}\r\n\r\n/* Button confirmar */\r\n\r\n.confirmar__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width: 209px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var(--main-color);\r\n    margin-top: 23.7px;\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    /* centrar el boton */\r\n    display: block;\r\n    margin-left: auto;\r\n    margin-right: auto;\r\n    outline: none;\r\n    cursor: pointer;\r\n    box-shadow: 0 1px 3px var(--opacity-12), 0 3px 3px var(--opacity-24);\r\n    transition: 0.3s;\r\n}\r\n\r\n.confirmar__button:hover {\r\n    background-color: var( --grey-dark);\r\n    color: var( --main-color);\r\n}\r\n\r\n/* Button cancelar */\r\n\r\n.cancelar__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width: 209px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var( --grey-dark);\r\n    margin-top: 23.7px;\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    /* centrar el boton */\r\n    display: block;\r\n    margin-left: auto;\r\n    margin-right: 127px;\r\n    outline: none;\r\n    cursor: pointer;\r\n    box-shadow: 0 1px 3px var(--opacity-12), 0 3px 3px var(--opacity-24);\r\n    transition: 0.3s;\r\n}\r\n\r\n.cancelar__button:hover {\r\n    background-color: var( --red);\r\n    color: var(--white);\r\n}\r\n\r\n.margin--left{\r\n    margin-left: 15px;\r\n}\r\n\r\n/* SCROLL */\r\n\r\n/* Estilos para motores Webkit y blink (Chrome, Safari, Opera... )*/\r\n\r\n.allgroups::-webkit-scrollbar {\r\n    -webkit-appearan