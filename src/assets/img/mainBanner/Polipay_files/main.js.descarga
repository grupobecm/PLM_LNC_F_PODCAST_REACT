let DetailIncomeRComponent = class DetailIncomeRComponent {
    constructor(data, router, dialog) {
        this.data = data;
        this.router = router;
        this.dialog = dialog;
        this.showLoad = false;
        this.dato = data.dato;
        //console.log("-------");
        //console.log(this.dato);
