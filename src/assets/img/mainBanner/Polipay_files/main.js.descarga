        this.router.navigate(['/administrador/cuentaeje/centros-costos/alta-centro-costos'], {
            state: {
                data: dato
            }
        });
    }
    consultar(dato) {
        sessionStorage.setItem("CentroCostosSol", JSON.stringify(dato));
        this.router.navigate(['/administrador/cuentaeje/centros-costos/consultar-centro-costos'], {
            state: {
                dato: dato
            }
        });
    }
