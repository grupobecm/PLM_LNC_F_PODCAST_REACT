            for (let i = 0; i < res.results.length; i++) {
                if (res.results[i].tipo_movimiento == "Egreso") {
                    res.results[i].typeMovement = false;
                    res.results[i].remanente = res.results[i].saldo_remanente;
                }
                else if (res.results[i].tipo_movimiento == "Ingreso") {
