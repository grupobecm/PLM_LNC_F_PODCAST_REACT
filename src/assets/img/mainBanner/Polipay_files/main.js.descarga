    mostrar() {
        if (!this.aparecer) {
            document.getElementById("tool-tip").classList.add("mostrar");
            document.getElementById("bolitas").classList.add("azul");
            let bolita = document.getElementsByClassName("bolita");
            for (let i = 0; i < bolita.length; i++) {
                bolita[i].classList.add("blanco");
            }
            this.aparecer = !this.aparecer;
        }
        else {
            document.getElementById("tool-tip").classList.remove("mostrar");
            document.getElementById("bolitas").classList.remove("azul");
            let bolita = document.getElementsByClassName("bolita");
            for (let i = 0; i < bolita.length; i++) {
                bolita[i].classList.remove("blanco");
            }
            this.aparecer = !this.aparecer;
        }
    }
    Themigajas() {
        this.migajas = [...this.camino];
        this.urlsMigajas = [...this.urls];
        if (this.camino.length > 4) {
            this.migajas = [];
            this.urlsMigajas = [];
            this.migajas.push(this.camino[0]);
            this.migajas.push(this.camino[1]);
            this.migajas.push(this.camino[this.camino.length - 2]);
            this.migajas.push(this.camino[this.camino.length - 1]);
            this.urlsMigajas.push(this.urls[0]);
            this.urlsMigajas.push(this.urls[1]);
            this.urlsMigajas.push(this.urls[this.urls.length - 2]);
            this.urlsMigajas.push(this.urls[this.urls.length - 1]);
