t user | font-roboto\" id=\"nombre\" autocomplete=\"off\" type=\"text\" name=\"nombrebeneficiario\" formControlName=\"nombre\" required>\r\n                </div>\r\n\r\n                <!-- Input pa lo que se ofrezca -->\r\n                <div class=\"form form--margin-left\" fxFlex=\"30\">\r\n                    <span class=\"form__text user referencia | font-roboto\">Cuenta ordenante*</span>\r\n                    <!-- Cambio de type=numbe a type=text -->\r\n                    <input class=\"form__input user | font-roboto\" type=\"text\" autocomplete=\"off\" name=\"cuenta\" formControlName=\"cuenta\">\r\n                </div>\r\n\r\n                <!-- Input referencia -->\r\n                <div class=\"form form--margin-left\" fxFlex=\"30\">\r\n                    <span class=\"form__text user referencia | font-roboto\">Referencia*</span>\r\n                    <input class=\"form__input user | font-roboto\" type=\"text\" autocomplete=\"off\" name=\"referencianumerica\" formControlName=\"referencianumerica\" required>\r\n                </div>\r\n\r\n            </div>\r\n\r\n            <div class=\"fila\" fxFlex=\"100\" fxLayout=\"row\" fxLayoutAlign=\"space-between start\">\r\n\r\n                <!-- Concepto -->\r\n                <div fxFlex=\"40\" class=\"margin-rigth\">\r\n                    <div class=\"form\" fxFlex=\"100\">\r\n                        <span class=\"form__text user | font-roboto\">Concepto*</span>\r\n                        <textarea class=\"formCon__input user | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"conceptopago\" formControlName=\"conceptopago\" required></textarea>\r\n                    </div>\r\n                </div>\r\n\r\n                <!-- Fecha  -->\r\n                <div class=\"fila\" fxFlex=\"30\" fxLayout=\"row wrap\">\r\n\r\n                    <div class=\"form_space form--password-mt mb-4\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                        <div class=\"fecha\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                            <p class=\"form__date label_fecha pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (form.get('date_dispersion').hasError('required') && form.get('date_dispersion').touched) }\" translate>Fecha de dispersión*</p>\r\n                            <mat-form-field class=\"valor campo_fecha disabled\" [ngClass]=\"{ 'form__input_alert': (form.get('date_dispersion').hasError('required') && form.get('date_dispersion').touched) }\" fxFlex=\"100\">\r\n                                <input matInput class=\"date\" [satDatepicker]=\"picker7\" autocomplete=\"off\" name=\"date_dispersion\" id=\"date_dispersion\" formControlName=\"date_dispersion\" readonly [max]=\"datenow\" [(ngModel)]=\"date_dispersion\" required>\r\n                                <sat-datepicker #picker7 [rangeMode]=\"false\" [selectFirstDateOnClose]=\"true\" [rangeHoverEffect]=\"false\">\r\n                                </sat-datepicker>\r\n                                <sat-datepicker-toggle matSuffix [for]=\"picker7\"></sat-datepicker-toggle>\r\n                            </mat-form-field>\r\n                        </div>\r\n                        <!-- Alertas -->\r\n                        <div class=\"alertTransfer margen-alert\" *ngIf=\" (form.get('date_dispersion').hasError('required') && form.get('date_dispersion').touched)  \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura la Fecha de dispersión</span>\r\n                        </div>\r\n                    </div>\r\n\r\n                    <div class=\"form\" fxFlex=\"100\">\r\n                        <span class=\"form__text user referencia | font-roboto\">Clave de Rastreo*</span>\r\n                        <input class=\"form__input user | font-roboto\" type=\"text\" autocomplete=\"off\" name=\"claverastreo\" formControlName=\"claverastreo\" required>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n                <!-- hora -->\r\n                <div (click)=\"EscogerHora()\" class=\"form form--margin-left manito\" fxFlex=\"30\">\r\n                    <span class=\"form__text user referencia | font-roboto\">Hora de operación*</span>\r\n                    <input class=\"form__input user manito | font-roboto\" type=\"text\" autocomplete=\"off\" name=\"horaoper\" readonly formControlName=\"hora_operacion\" required [(ngModel)]=\"hora_operacion\">\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"fila2\" fxFlex=\"100\" fxLayout=\"row\" fxLayoutAlign=\"end center\">\r\n                <button class=\"confirmar__button | color-white\" type=\"submit\"><b>Confirmar</b></button>\r\n            </div>\r\n        </form>\r\n    </div>\r\n    <!-- Loading -->\r\n    <app-loading *ngIf=\"showLoad\"></app-loading>\r\n\r\n</div>");

