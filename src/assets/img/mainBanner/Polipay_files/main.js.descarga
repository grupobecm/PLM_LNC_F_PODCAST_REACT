            //console.log("date", res);
            this.cenCost = res;
            this.addressCen = this.getAddressFormat(this.storageAdmin.solicitudCenterCostInfo.dato_json);
            this.addressCenA = this.getAddressFormat(this.cenCost.RazonSocial.DomicilioFiscal);
            this.asignarpdfCenCost();
            this.showLoad = false;
        }, (error) => {
            //console.log(error);
