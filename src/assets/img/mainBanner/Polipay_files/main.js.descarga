        //console.log(this.listStaffExternalRequest.filteredData);
        this.showLoad = false;
    }
    /* AVANZAR ENTRE LOS PASOS */
    alPaso1() {
        this.paso1 = true;
        this.paso2 = false;
        this.listExternalCustomerActive();
    }
    alPaso2() {
        this.paso1 = false;
        this.paso2 = true;
        this.listExternalCustomerRequest();
    }
    filterButton(status) {
        //console.log(status);
        this.moral = status;
        this.morales = status;
        if (status == true) {
            this.moralData = 1;
        }
        else {
            this.moralData = 2;
        }
        this.filtroActivos();
    }
    filterButtonSol(status) {
        //console.log(status);
        this.moral = status;
        this.morales = status;
        if (status == true) {
            this.moralData = 1;
        }
        else {
            this.moralData = 2;
        }
        this.filtroSolicitudes();
    }
    administrar(dato) {
        const data = {
            dato: dato,
            moral: this.morales
        };
        //console.log(data);
        data.dato.referencia = Number(data.dato.referencia);
        sessionStorage.setItem("idsSolCE", JSON.stringify(data));
        if (data.dato.tipoSolicitud__nombreSol == "Apertura") {
            this.router.navigate(['/administrador/cuentaeje/clientes-externos/alta-cliente-externo']);
        }
        else {
            //console.log("Baja",data);
            this.router.navigate(['/administrador/cuentaeje/clientes-externos/baja-cliente-externo']);
        }
    }
    regresar() {
        this.router.navigate(['/administrador/cuentaeje/cuentas-eje/administrar-cliente']);
    }
};
