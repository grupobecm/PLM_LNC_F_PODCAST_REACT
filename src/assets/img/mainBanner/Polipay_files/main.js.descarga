                this.showLoad = false;
                ////console.log(error.error.detail[0].message);
                this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_18__["ErrorUserComponent"], {
                    data: {
                        error: 'G-002',
                        message: error.error.detail[0].message,
                    },
                    disableClose: true
                });
            });
        }
    }
    addAssignCards() {
        this.assignCards = [...this.assignCards, ...this.asignar];
        this.showAssignCards = [...this.assignCards];
        this.asignar = [];
    }
    search() {
        let show = [...this.assignCards];
        this.showAssignCards = show.filter(res => res.person__name.toLowerCase().includes(this.beneficiary));
    }
    censorship(data) {
        let cuenta = data.split('');
        return "******" + cuenta[cuenta.length - 4] + cuenta[cuenta.length - 3] + cuenta[cuenta.length - 2] + cuenta[cuenta.length - 1];
    }
    mostrar2() {
        if (this.flg) {
            if (this.guardar) {
                document.getElementById("fondo2").style.display = 'block';
                document.getElementById("lista2").classList.add("mostrar2");
                document.getElementById("select1").style.zIndex = "8";
                this.flg = false;
            }
        }
        else {
            this.ocultar2();
        }
    }
    ocultar2() {
        document.getElementById("fondo2").style.display = 'none';
        document.getElementById("lista2").classList.remove("mostrar2");
        this.flg = true;
        if (this.banco == '\u00a0') {
            this.rojobanco = true;
            this.auxFlgBanco = 1;
        }
    }
    actualizar2(value) {
        //console.log(value);
        this.banco = value.person__name;
        // this.id__beneficiary = value.person_id;
        this.form.get('razon_social').setValue(value.person__name);
        //console.log(this.banco)
        this.auxFlgBanco = 0;
        if (this.rojobanco) {
            this.rojobanco = false;
        }
        this.addCards(value);
    }
};
