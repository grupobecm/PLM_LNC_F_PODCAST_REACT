let MenuComponent = class MenuComponent {
    constructor(router, storage, storageClient, service) {
        this.router = router;
        this.storage = storage;
        this.storageClient = storageClient;
        this.service = service;
        this.account = '';
        this.clabe = '';
        this.menu_active = false;
        this.aux = false;
        this.url = "";
        this.openP = false;
        this.openT = false;
        this.openF = false;
        this.openC = false;
        this.flagTTP = true;
        this.flagTTPT = true;
        this.flagNegative = true;
        if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length >= 3) {
            this.flagTTPT = true;
            this.flagTTP = false;
            if (this.storageClient.InfoCostCenterExist == false) {
                // //console.log(JSON.parse(this.storage.infoUserValue).data_empresa)
                this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
                // //console.log(this.id);
            }
            else {
                // //console.log('si hay centros de costos');
                this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
                this.account = this.dato.cuenta;
                this.clabe = this.dato.cuentaclave;
            }
        }
        else {
            if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    this.dato = JSON.parse(this.storage.infoUserValue);
                    // //console.log(this.dato);
                    this.account = this.dato.data_empresa.cuenta.cuenta;
                    this.clabe = this.dato.data_empresa.cuenta.cuentaclabe;
                    this.flagTTPT = false;
                    this.flagTTP = true;
                }
                else {
                    if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        if (this.storageClient.InfoCostCenterExist == false) {
                            this.dato = JSON.parse(this.storage.infoUserValue);
                            // //console.log('dato', this.dato)
                            this.account = this.dato.cuenta;
                            this.clabe = this.dato.cuentaclave;
                        }
                        else {
                            // //console.log("si hay servicios ");
                            this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
                            // //console.log('dato', this.dato)
                            //  //console.log(this.dato.persona_cuenta_id);
                            this.account = this.dato.cuenta;
                            this.clabe = this.dato.cuentaclave;
                            this.flagTTPT = false;
                        }
                    }
                }
            }
        }
    }
    ngAfterViewInit() {
        this.abrirDefault();
    }
    abrirDefault() {
        // //console.log('abrir view', this.router.url.includes('/usuario/transactions/polipay'));
        if (this.router.url.includes('/usuario/transactions/polipay-third')) {
            this.mostrar_Submenu_Terceros();
        }
        else if (this.router.url.includes('/usuario/transactions/frequent-accounts')) {
            this.mostrar_Submenu_Frecuentes();
        }
        else if (this.router.url.includes('/usuario/transactions/own-accounts')) {
            this.mostrar_Submenu_cuentas_propias();
        }
        else if (this.router.url.includes('/usuario/transactions/polipay')) {
            this.mostrar_Submenu_Polipay();
        }
    }
    borrar(id) {
        document.getElementById("copiar" + id).classList.add('ocultar');
        document.getElementById("copiado" + id).classList.add('mostrar');
        setTimeout(() => {
            document.getElementById("copiado" + id).classList.remove('mostrar');
        }, 1000);
    }
    ngOnChanges() {
        let data = JSON.parse(this.storage.infoUserValue);
        //this.account = data.cuenta_id;
        //this.clabe =
    }
    rutasmenuG() {
        return this.router.url.includes('/usuario/transactions');
    }
    rutaPolipay() {
        return this.router.url.includes('/usuario/transactions/polipay/dashboard-polipay');
    }
    rutaPolipayThir() {
        return this.router.url.includes('/usuario/transactions/polipay-third');
    }
    rutaPolipayOwnAccounts() {
        return this.router.url.includes('/usuario/transactions/own-accounts');
    }
    rutaFrequentes() {
        return this.router.url.includes('/usuario/transactions/frequent-accounts');
    }
    rutasDispersions() {
        return this.router.url.includes('/usuario/dispersiones');
    }
    rutasReports() {
        return this.router.url.includes('/usuario/reportes/');
    }
    rutasReportsAll() {
        return this.router.url.includes('/usuario/reportes/total');
    }
    rutasIncome() {
        return this.router.url.includes('/usuario/reportes/ingresos');
    }
    rutasExpenses() {
        return this.router.url.includes('/usuario/reportes/egresos');
    }
    CopiedIS() {
        return this.isCopied = true;
    }
    mostrar_Submenu_Polipay() {
        this.menu_polipay = false;
        if (this.openF) {
            this.mostrar_Submenu_Frecuentes();
        }
        if (this.openT) {
            this.mostrar_Submenu_Terceros();
        }
        if (this.openC) {
            this.mostrar_Submenu_cuentas_propias();
        }
        let menuP = document.getElementById("submenu_polipay");
        let menu__polipay = document.getElementById("menu__polipay");
        let seis = document.getElementById("seis");
        let siete = document.getElementById("siete");
        // let tres = document.getElementById("tres");
        let altura_total = seis.offsetHeight + siete.offsetHeight;
        menuP.style.height = (menuP.offsetHeight) + "px";
        if (!this.menu_active) {
            menuP.style.height = (altura_total) + "px";
            menu__polipay.classList.add('active--b');
            this.menu_active = true;
        }
        else {
            menuP.style.height = (menuP.offsetHeight) + "px";
            menuP.style.height = "0px";
            menu__polipay.classList.remove('active--b');
            this.menu_active = false;
        }
        let triangulo = document.getElementById('triangulo_polipay');
        if (triangulo.classList.contains('girar')) {
            triangulo.classList.remove('girar');
        }
        else {
            triangulo.classList.add('girar');
        }
        if (this.router.url.includes('/usuario/transactions/polipay/')) {
            menu__polipay.classList.add('active--b');
            this.menu_polipay = true;
        }
        this.openP = !this.openP;
    }
    mostrar_Submenu_Frecuentes() {
        this.menu_frequent = false;
        if (this.openP) {
            this.mostrar_Submenu_Polipay();
        }
        if (this.openT) {
            this.mostrar_Submenu_Terceros();
        }
        if (this.openC) {
            this.mostrar_Submenu_cuentas_propias();
        }
        let menu = document.getElementById("submenu_frequent");
        let menu_frequents = document.getElementById("menu_frequents");
        let cuatro = document.getElementById("cuatro");
        //let cinco = document.getElementById("cinco");
        let altura_total = cuatro.offsetHeight;
        menu.style.height = (menu.offsetHeight) + "px";
        if (!this.menu_active) {
            menu.style.height = (menu.offsetHeight + altura_total) + "px";
            menu_frequents.classList.add('active--b');
            this.menu_active = true;
        }
        else {
            menu.style.height = (menu.offsetHeight) + "px";
            menu.style.height = "0px";
            menu_frequents.classList.remove('active--b');
            this.menu_active = false;
        }
        let triangulo = document.getElementById('triangulo_frecuentes');
        if (triangulo.classList.contains('girar')) {
            triangulo.classList.remove('girar');
        }
        else {
            triangulo.classList.add('girar');
        }
        if (this.router.url.includes('/usuario/transactions/frequent-accounts')) {
            menu_frequents.classList.add('active--b');
            this.menu_frequent = true;
        }
        this.openF = !this.openF;
    }
    mostrar_Submenu_Terceros() {
        this.menu_terceros = false;
        if (this.openP) {
            this.mostrar_Submenu_Polipay();
        }
        if (this.openF) {
            this.mostrar_Submenu_Frecuentes();
        }
        if (this.openC) {
            this.mostrar_Submenu_cuentas_propias();
        }
        let menu = document.getElementById("submenu_terceros");
        let menu__terceros = document.getElementById("menu__terceros");
        let uno = document.getElementById("uno");
        let dos = document.getElementById("dos");
        //  let tres = document.getElementById("tres");
        let altura_total = uno.offsetHeight + dos.offsetHeight;
        menu.style.height = (menu.offsetHeight) + "px";
        if (!this.menu_active) {
            menu.style.height = (menu.offsetHeight + altura_total) + "px";
            menu__terceros.classList.add('active--b');
            this.menu_active = true;
        }
        else {
            menu.style.height = (menu.offsetHeight) + "px";
            menu.style.height = "0px";
            menu__terceros.classList.remove('active--b');
            this.menu_active = false;
        }
        let triangulo = document.getElementById('triangulo_terceros');
        if (triangulo.classList.contains('girar')) {
            triangulo.classList.remove('girar');
        }
        else {
            triangulo.classList.add('girar');
        }
        if (this.router.url.includes('/usuario/transactions/polipay-third')) {
            menu__terceros.classList.add('active--b');
            this.menu_terceros = true;
        }
        this.openT = !this.openT;
    }
    mostrar_Submenu_cuentas_propias() {
        this.menu_cuentas_p = false;
        if (this.openP) {
            this.mostrar_Submenu_Polipay();
        }
        if (this.openF) {
            this.mostrar_Submenu_Frecuentes();
        }
        if (this.openT) {
            this.mostrar_Submenu_Terceros();
        }
        let menu = document.getElementById("submenu_cuentas-propias");
        let menu__terceros = document.getElementById("menu__cuentas-propias");
        let uno = document.getElementById("nueve");
        // PARA MOSTRAR EL HISTORIAL DESCOMENTAR ESTAS LINEAS QUE DICEN DOS
        let dos = document.getElementById("diez");
        let altura_total = uno.offsetHeight + dos.offsetHeight;
        menu.style.height = (menu.offsetHeight) + "px";
        if (!this.menu_active) {
            menu.style.height = (menu.offsetHeight + altura_total) + "px";
            menu__terceros.classList.add('active--b');
            this.menu_active = true;
        }
        else {
            menu.style.height = (menu.offsetHeight) + "px";
            menu.style.height = "0px";
            menu__terceros.classList.remove('active--b');
            this.menu_active = false;
        }
        let triangulo = document.getElementById('triangulo_cuentas-propias');
        if (triangulo.classList.contains('girar')) {
            triangulo.classList.remove('girar');
        }
        else {
            triangulo.classList.add('girar');
        }
        if (this.router.url.includes('/usuario/transactions/own-accounts/')) {
            menu__terceros.classList.add('active--b');
            this.menu_cuentas_p = true;
        }
        this.openC = !this.openC;
    }
    mostrarSubmenuFA() {
        let menu = document.getElementById("submenu_frequent");
        let menu__frequents = document.getElementById("menu__frequents");
        let cuatro = document.getElementById("cuatro");
        //let cinco = document.getElementById("cinco");
        let altura_total = cuatro.offsetHeight;
        menu.style.height = (menu.offsetHeight) + "px";
        if (!this.menu_active) {
            menu.style.height = (menu.offsetHeight + altura_total) + "px";
            menu__frequents.classList.add('active--b');
            this.menu_active = true;
        }
        else {
            menu.style.height = (menu.offsetHeight) + "px";
            menu.style.height = "0px";
            menu__frequents.classList.remove('active--b');
            this.menu_active = false;
        }
        let triangulo = document.getElementById('triangulo');
        if (triangulo.classList.contains('girar')) {
            triangulo.classList.remove('girar');
        }
        else {
            triangulo.classList.add('girar');
        }
        if (this.router.url.includes('/usuario/transactions/frequent-accounts')) {
            menu__frequents.classList.add('active--b');
        }
    }
