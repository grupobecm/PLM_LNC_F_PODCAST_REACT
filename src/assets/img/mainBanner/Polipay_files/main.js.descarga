let DetailsAllRComponent = class DetailsAllRComponent {
    constructor(data, router, dialog) {
        this.data = data;
        this.router = router;
        this.dialog = dialog;
        this.showLoad = false;
        this.dato = data.dato;
        //console.log("-------");
        //console.log(this.dato);
        //console.log("-------");
        this.cuentadestino = this.dato.cuenta;
        this.cuentaordenante = this.dato.cuenta_ordenante;
        this.referencia = this.dato.referencianumerica;
        this.claverastreo = this.dato.claverastreo;
        //cuenta beneficiaria de back;
        let aux = this.dato.cuentaBeneficiario.toString().split('');
        this.cuentaBeneficiario = '******' + aux[aux.length - 4] + aux[aux.length - 3] + aux[aux.length - 2] + aux[aux.length - 1];
        //cuenta que nosostros sacamos;
        aux = this.cuentaOrigen.toString().split('');
        this.campo_hard = '******' + aux[aux.length - 4] + aux[aux.length - 3] + aux[aux.length - 2] + aux[aux.length - 1];
        //cuenta ordenante de back;
        if (this.cuentaordenante !== undefined) {
            aux = this.cuentaordenante.toString().split('');
            this.cuentaordenante = '******' + aux[aux.length - 4] + aux[aux.length - 3] + aux[aux.length - 2] + aux[aux.length - 1];
        }
    }
    download(id_t) {
        let id = {
            id: id_t
        };
        this.showLoad = true;
    }
};
