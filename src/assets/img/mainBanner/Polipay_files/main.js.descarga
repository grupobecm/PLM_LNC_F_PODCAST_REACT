n \" class=\"button-accept | color-white background-main\"\r\n                (click)=\"cancelDispersionInd()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n       <!-- CANCELAR UNA DISPERISON MASIVA-->\r\n       <div *ngIf=\"question == 'CD-002'\" class=\"message\">\r\n        <p class=\"text2 | color-third\">¿Estás seguro de cancelar la \r\n            <br>dispersión ?</p>\r\n        <div fxLayout=\"row \">\r\n            <button type=\"button\" mat-dialog-close id=\"button \"\r\n                class=\"button-accept | color-white background-third \">Cancelar</button>\r\n            <button type=\"button\" id=\"button \" class=\"button-accept | color-white background-main\"\r\n                (click)=\"cancelDispersionMas()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - Perfil Externo - personal   -->\r\n    <div *ngIf=\"question == 'D-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">¿Estás seguro de querer desactivar a {{ username | uppercase }}?<br> Esta acción\r\n            deshabilitará todas las tarjetas que tiene asignadas.</p>\r\n        <div fxLayout=\"row \">\r\n            <button type=\"button\" mat-dialog-close id=\"button \" class=\"button-accept | color-white background-accent\"\r\n                (click)=\"noDeactivateExternalPersonnel()\">NO</button>\r\n            <button type=\"button\" id=\"button \" class=\"button-accept | color-white background-main\"\r\n                (click)=\"deactivateExternalPersonnel()\">SÍ</button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - Perfil Externo -  grupo  -->\r\n    <div *ngIf=\"question == 'D-002'\" class=\"message\">\r\n        <p class=\"text | color-third\">¿Desea Eliminar el grupo <br>{{ name | uppercase }}?</p>\r\n        <div fxLayout=\"row \">\r\n            <button type=\"button\" mat-dialog-close id=\"button \" class=\"button-accept | color-white background-third  \"\r\n                (click)=\"deactivateExternalPersonnel()\">