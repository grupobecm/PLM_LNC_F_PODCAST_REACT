            //console.log('CC Activas', res.results);
            this.showLoad = false;
            this.cenCost = new _angular_material_table__WEBPACK_IMPORTED_MODULE_6__["MatTableDataSource"](res.results);
            this.cenCost.sort = this.sort;
            this.cenCost.paginator = this.paginator;
            this.cenCost.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.cenCost.data.length;
        }, error => {
            //console.log(error);
            this.showLoad = false;
        });
    }
};
