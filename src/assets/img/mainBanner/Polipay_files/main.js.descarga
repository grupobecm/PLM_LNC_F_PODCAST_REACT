            this.listLiquidate.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listLiquidate.data.length;
        }, error => {
            //console.log(error);
        });
    }
    sumarDias(fecha, dias) {
        fecha.setDate(fecha.getDate() + dias);
        return fecha;
    }
    detailsTransferSlopes() {
