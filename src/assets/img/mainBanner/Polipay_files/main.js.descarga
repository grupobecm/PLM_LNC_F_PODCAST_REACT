    validateAsignacion() {
        /**Revisa si todos los radio tiene un devuelto */
        this.validate = true;
        for (let i = 1; i <= 10; i++) {
            const element = this.form.controls['radioBoton' + i].value;
            //console.log(element);
            if (element == 'D') {
                this.validate = false;
                //console.log(this.validate);
                break;
            }
        }
    }
    validateAsignacionF() {
        /**Revisa si todos los radio tiene un devuelto */
        this.validate = true;
        for (let i = 1; i <= 4; i++) {
            const element = this.form2.controls['radioBoton' + i].value;
            //console.log(element);
            if (element == 'D') {
                this.validate = false;
                //console.log(this.validate);
                break;
            }
        }
    }
    getDetailsCE() {
        if (this.moral == true) {
            this.serviceClient.detailsExternalClientMoral(this.idClients).subscribe(res => {
                //console.log(res);
                this.externalClient = res;
                this.asignarpdfCliExt();
                this.name = res.representante_legal.nombre;
                this.rfc = res.cliente_externo_moral.rfc;
                this.correo = res.representante_legal.email;
                this.getAddressFormat("CE", res.cliente_externo_moral.domicilio[0]);
                this.getAddressFormat("RL", res.cliente_externo_moral.domicilio[0]);
                this.asignarpdfRepLegal();
                const bankid = res.cliente_externo_moral.banco;
                this.getBanco(bankid);
            });
        }
        else {
            //console.log("persona física");
            this.serviceClient.detailsExternalClientFisico(this.idClients).subscribe(res => {
                //console.log(res);
                this.externalClientF = res;
                this.getAddressFormat("CE", res.domicilio[0]);
                this.asignarpdfCliExtF();
            });
        }
    }
    getAddressFormat(id, data) {
        const address = data.calle +
            " " + data.no_exterior + " " + data.no_interior +
            ", Col. " + data.colonia + ", " + data.alcaldia_mpio + ", " + data.estado +
            ", C.P. " + data.codigopostal + ", " + data.pais;
        if (id == "CE") {
            this.addressCen = address;
        }
        else {
            this.addressRep = address;
        }
    }
    asignarpdfCliExt() {
        for (let i = 0; i < this.externalClient.documents_company.length; i++) {
            this.documentosExternalClient[i].doc = this.externalClient.documents_company[i].documento;
            this.documentosExternalClient[i].id = this.externalClient.documents_company[i].id;
        }
        //console.log(this.documentosExternalClient);
    }
    asignarpdfCliExtF() {
        for (let i = 0; i < this.documentosExternalClientFisico.length; i++) {
            this.documentosExternalClientFisico[i].doc = this.externalClientF.documentos[i].documento;
            this.documentosExternalClientFisico[i].id = this.externalClientF.documentos[i].id;
        }
        //console.log(this.documentosExternalClient);
    }
    asignarpdfRepLegal() {
        for (let i = 0; i < this.documentosRepLeg.length; i++) {
            this.documentosRepLeg[i].doc = this.externalClient.documents_representante_legal[i].documento;
            this.documentosRepLeg[i].id = this.externalClient.documents_representante_legal[i].id;
        }
        //console.log(this.documentosRepLeg);
    }
    submit() {
        if (this.form.invalid) {
            return;
        }
        //Revisa si todos los radio tienen un Pendiente
        for (let i = 1; i <= 10; i++) {
            const element = this.form.controls['radioBoton' + i].value;
            if (element == 'P') {
                this.validate = false;
                this.dialog.open(_messageAdmin_error_admin_error_admin_component__WEBPACK_IMPORTED_MODULE_17__["ErrorAdminComponent"], {
                    data: {
                        error: 'CE-001',
                        message: 'EL CLIENTE PUEDE SER ACTIVADO CUANDO TODOS LOS DOCUMENTOS SEAN CORRECTOS.'
                    },
                    disableClose: true,
                });
                break;
            }
        }
        //Carga de los datos de los documentos
        let documentosClienteExterno = [];
        let documentosRL = [];
        for (let i = 1; i <= this.externalClient.documents_company.length; i++) {
            const element = this.form.controls['radioBoton' + i].value;
            const comentario = this.form.controls['motivoDevolucion' + i].value;
            //console.log(this.externalClient.documents_company.length);
            //console.log(this.documentosExternalClient[i-1].id);
            documentosClienteExterno.push({
                'id': this.documentosExternalClient[i - 1].id,
                'status': element,
                'comentario': comentario,
            });
        }
        //console.log(documentosClienteExterno);                                                                                                                                                                                                                                                                                                    
        let j = 0;
        for (let i = 8; i <= 10; i++) {
            const element = this.form.controls['radioBoton' + i].value;
            const comentario = this.form.controls['motivoDevolucion' + i].value;
            documentosRL.push({
                'id': this.documentosRepLeg[j].id,
                'status': element,
                'comentario': comentario
            });
            j++;
        }
        //creamos JSON para el primer endpoint
        let datos = [
            {
                "idSol": this.idSolicitud,
                "userAuth": this.adminID,
                "clienteExternoDetail": {
                    "id": this.externalClient.cliente_externo_moral.id,
                    "name": this.externalClient.cliente_externo_moral.razon_social,
                    "rfc": this.externalClient.cliente_externo_moral.rfc,
                    "clave_traspaso": this.externalClient.cliente_externo_moral.clave_transpaso_final.clabeinterbancaria_uno,
                    "banco_clabe": this.banco,
                    "tipo_persona:": 1,
                },
                "documentos_cliente-externo": documentosClienteExterno,
                "documento_representante": documentosRL
            }
        ];
        //console.log("submit: ", datos);
        if (this.validate == true) {
            this.service.authExternalC(datos).subscribe(res => {
                this.showLoad = false;
                //console.log(res.detail[0].data);
                this.dialog.open(_messageAdmin_success_admin_success_admin_component__WEBPACK_IMPORTED_MODULE_18__["SuccessAdminComponent"], {
                    data: {
                        success: 'CE-001',
                        message: res.detail[0].data
                    },
                    disableClose: true,
                });
            }, error => {
                //console.log(error);
                this.showLoad = false;
                this.dialog.open(_messageAdmin_error_admin_error_admin_component__WEBPACK_IMPORTED_MODULE_17__["ErrorAdminComponent"], {
                    data: {
                        error: 'CE-001',
                        message: 'Ocurrió un error al autorizar cliente externo'
                    },
                    disableClose: true,
                });
            });
            //console.log("Se puede autorizar");
        }
        else {
            this.service.notifyExternalC(datos).subscribe(res => {
                this.showLoad = false;
                //console.log(res.detail[0].data);
                this.dialog.open(_messageAdmin_success_admin_success_admin_component__WEBPACK_IMPORTED_MODULE_18__["SuccessAdminComponent"], {
                    data: {
                        success: 'CE-001',
                        message: "Tu operación se realizó satisfactoriamente."
                    },
                    disableClose: true,
                });
            }, error => {
                //console.log(error);
                this.showLoad = false;
                this.dialog.open(_messageAdmin_error_admin_error_admin_component__WEBPACK_IMPORTED_MODULE_17__["ErrorAdminComponent"], {
                    data: {
                        error: 'CE-001',
                        message: 'Ocurrió un error al autorizar Cliente externo'
                    },
                    disableClose: true,
                });
            });
            //console.log("notificar");
        }
    }
    submitF() {
        this.showLoad = true;
        if (this.form2.invalid) {
