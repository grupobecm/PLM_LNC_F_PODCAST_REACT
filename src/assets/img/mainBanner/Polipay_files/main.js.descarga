let AxisAccountSelectComponent = class AxisAccountSelectComponent {
    constructor(router, service, service2, storage2, storage, dialog) {
        this.router = router;
        this.service = service;
        this.service2 = service2;
        this.storage2 = storage2;
        this.storage = storage;
        this.dialog = dialog;
        this.title = 'app';
        this.active = "";
        this.elements = 0;
        this.step = 2;
        // empresa='BecPolimentes SAPI SA de CV';
        this.relleno = false;
        this.aprobado = false;
        this.showLoad = false;
        this.client = [];
        this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
        sessionStorage.removeItem("center_cost");
        this.services = JSON.parse(this.storage.infoUserValue).data_empresa.commissions;
        this.dataColab = JSON.parse(this.storage.infoUserValue).data_empresa.centro_costos;
        this.rolPerson = JSON.parse(this.storage.infoUserValue).user_type;
        //console.log( this.rolPerson);
        if (this.services.length >= 3) {
            if (this.rolPerson == 8) {
                this.getListaColabordores();
            }
            else {
                this.getListaCuentas();
            }
        }
        else {
            if (this.services.length == 2) {
                if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                    if (this.rolPerson == 8) {
                        this.getListaColabordores();
                    }
                    else {
                        this.getListaCuentas();
                    }
                }
                else {
                    if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                        //console.log('entre a disper');
                        if (this.client.length <= 0) {
                            this.router.navigate(['/usuario/company']);
                        }
                    }
                }
            }
        }
    }
    getListaColabordores() {
        this.showLoad = true;
        for (let i = 0; i < JSON.parse(this.storage.infoUserValue).data_empresa.centro_costos.length; i++) {
            const element = JSON.parse(this.storage.infoUserValue).data_empresa.centro_costos[i];
            this.client.push({ cuenta: element.cuenta, cuentaclave: element.cuentaclave, monto: element.monto, persona_cuenta__name: element.persona_cuenta__name, persona_cuenta_id: element.persona_cuenta_id });
        }
        this.showLoad = false;
        this.obtenerLargo();
        this.obtenerBolitas();
    }
    getListaCuentas() {
        this.showLoad = true;
        this.service.activeCostCenter(this.id).subscribe(res => {
            // //console.log("Prueba", res);
            this.client = res;
            if (this.client.length <= 0) {
                // this.router.navigate(['/usuario/company']);
                this.dialog.open(_messageUser_warning_user_warning_user_component__WEBPACK_IMPORTED_MODULE_10__["WarningUserComponent"], {
                    width: '544px',
                    data: {
                        warning: 'cCC-001',
                    },
                    panelClass: ['custom-dialog-container', 'details'],
                    disableClose: true,
                });
            }
            this.showLoad = false;
            // this.client = [...res.results];
            this.obtenerLargo();
            this.obtenerBolitas();
        });
    }
    /*getLista(){
      this.service2.getCentersList(this.id).subscribe((res:any)=>{
        //console.log(res[0]);
        //console.log(res)
        this.client=res;
  
        //this.obtenerLargo();
        //this.obtenerBolitas();
  
        this.obtenerLargo();
        this.obtenerBolitas();
        if(res.length <= 0){
          this.router.navigate(['/usuario/dispersiones']);
        }
      })
    }*/
    seleccionar(dato) {
        // //console.log(dato);
        this.storage2.setInfoCostCenter(dato);
        this.router.navigate(['/usuario/company']);
    }
    obtenerLargo() {
        for (let empresa of this.client) {
            if (empresa.persona_cuenta__name.length > 16) {
                this.porcentajeCard = 50;
                this.paso = 4;
                break;
            }
            else {
                this.porcentajeCard = 23;
                this.paso = 8;
            }
        }
        this.step = this.paso - 1;
    }
    obtenerBolitas() {
        this.numbol = (this.client.length / this.paso);
        // //console.log("bolas",this.numbol)
        if (this.client.length % this.paso > 0) {
            // //console.log("bolas",this.numbol)
            this.relleno = true;
        }
        if (this.numbol == NaN) {
            // //console.log("centros de costo");
            if (this.storage2.InfoCostCenterExist == false) {
                this.dato = JSON.parse(this.storage.infoUserValue);
                this.router.navigate(['/usuario/company']);
                this.dialog.open(_messageUser_warning_user_warning_user_component__WEBPACK_IMPORTED_MODULE_10__["WarningUserComponent"], {
                    width: '544px',
                    data: {
                        warning: 'cCC-001',
                    },
                    panelClass: ['custom-dialog-container', 'details'],
                    disableClose: true,
                });
            }
            else {
                this.dato = JSON.parse(this.storage2.InfoCostCenterValue);
            }
        }
    }
    carrusel(id) {
        this.carruselnum = id;
        // //console.log("inicio Carrusel",this.carruselnum);
        this.step = (this.paso - 1) + (this.paso * this.carruselnum);
        this.elements = this.step - this.paso + 1;
        // //console.log(this.step)
        // //console.log(this.carruselnum)
    }
};
