/* harmony default export */ __webpack_exports__["default"] = (".dispersions {\r\n    margin-top: 5%;\r\n}\r\n\r\n\r\n/* CARDS */\r\n\r\n\r\n.cards {\r\n    width: 100%;\r\n    /*height: calc(100vh - 245px);*/\r\n    padding: 40px 5px 0px 5px;\r\n    /*overflow-y: scroll;*/\r\n}\r\n\r\n\r\n.card {\r\n    min-width: 190px;\r\n    padding: 27.5px 5px 27.5px 5px;\r\n    box-shadow: 0 3px 13px 0 var(--opacity-48);\r\n    height: 330px;\r\n    margin: 0px 7px 0px 7px;\r\n}\r\n\r\n\r\n.card__title {\r\n    font-size: 20px;\r\n    font-weight: bold;\r\n    line-height: 1.33;\r\n    text-align: center;\r\n    /* overflow: hidden;\r\n  height: 35px; */\r\n    cursor: default;\r\n    text-transform: uppercase;\r\n}\r\n\r\n\r\n.card__title--hasMargin{\r\n    margin-top: 66px;\r\n}\r\n\r\n\r\n/* Button card */\r\n\r\n\r\n.card__button {\r\n    text-transform: uppercase;\r\n    border: none;\r\n    min-width: 128px;\r\n    width: 100%;\r\n    max-width: 206px;\r\n    height: 43px;\r\n    border-radius: 24px;\r\n    background-color: var(--main-color);\r\n    font-size: 14px;\r\n    line-height: 1.14;\r\n    letter-spacing: 1.25px;\r\n    text-align: center;\r\n    /* centrar el boton */\r\n    display: block;\r\n    outline: none;\r\n    cursor: pointer;\r\n    box-shadow: 0 1px 3px var(--opacity-12), 0 3px 3px var(--opacity-24);\r\n    transition: 0.3s;\r\n    margin: 15px;\r\n}\r\n\r\n\r\n/* IMG CARDs */\r\n\r\n\r\n.estados-img{\r\n    transform: scale(1.8) translateY(10px);\r\n}\r\n\r\n\r\n/* HOVER */\r\n\r\n\r\n.card__button:not([disabled]):hover {\r\n    background-color: var(--accent-color);\r\n    box-shadow: none;\r\n    /*color: var(--main-color);*/\r\n    transition: 0.3s;\r\n}\r\n\r\n\r\n/* INVALID DISABLED  */\r\n\r\n\r\n.card__button:disabled {\r\n    background-color: var(--main-color);\r\n    cursor: default;\r\n}\r\n\r\n\r\n/* FIN Button card */\r\n\r\n\r\n/* FIN CARDS */\r\n\r\n\r\n.btn-siguiente {\r\n    background: none;\r\n    border: none;\r\n}\r\n\r\n\r\n@media(min-width: 1024px) and (max-width: 1595px) {\r\n    .card__button {\r\n        font-size: 12px;\r\n    }\r\n    .card__title {\r\n        font-size: 15px;\r\n    }\r\n}\r\n/*# sourceMappingURL=data:application/json;base64, */");

