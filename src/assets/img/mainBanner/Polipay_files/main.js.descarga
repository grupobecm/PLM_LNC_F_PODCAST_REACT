    selectHour() {
        let dataDialog = this.dialog.open(src_app_Views_admin_reloj_reloj_component__WEBPACK_IMPORTED_MODULE_13__["RelojComponent"], {
            panelClass: ["border-none"],
        });
        let formato24Horas = {
            "01": "13",
            "02": "14",
            "03": "15",
            "04": "16",
            "05": "17",
            "06": "18",
            "07": "19",
            "08": "20",
            "09": "21",
            "10": "22",
            "11": "23",
            "12": "12",
        };
        dataDialog.afterClosed().subscribe((res) => {
            if (res == undefined) {
                this.hora_operacion = "";
                this.hourNull = true;
            }
            else {
                if (res[2] == "P.M.") {
                    res[0] = formato24Horas[res[0]];
                }
                if (res[2] == "A.M." && res[0] == "12") {
                    res[0] = "00";
                }
                this.hora_operacion = res[0] + ":" + res[1];
                this.hourNull = false;
            }
        });
    }
    cancel() {
        this.form.reset();
        this.errorFileEmpy = false;
        this.errorFileFormat = false;
        this.errorFileEmpy = false;
        this.errorGroup = false;
        this.file = "Ningun archivo seleccionado";
    }
    ocultar() {
        document.getElementById("fondo").style.display = "none";
        document.getElementById("lista").classList.remove("mostrar");
        document.getElementById("select1").style.zIndex = "0";
        this.flg = true;
    }
    mostrar() {
        if (this.flg) {
            document.getElementById("fondo").style.display = "block";
            document.getElementById("lista").classList.add("mostrar");
            document.getElementById("select1").style.zIndex = "14";
            this.buscar = "";
            this.copydatalist = this.datalist;
            this.total = this.copydatalist.length;
            this.flg = false;
        }
        else {
            this.ocultar();
        }
    }
    filtrarFrecuentes() {
        this.copydatalist = [];
        for (let i = 0; i < this.datalist.length; i++) {
            //console.log(this.buscar);
            if (this.datalist[i].nombre_grupo
                .toLowerCase()
                .includes(this.buscar.toLowerCase())) {
                this.copydatalist.push(this.datalist[i]);
            }
        }
        this.total = this.copydatalist.length;
    }
};
