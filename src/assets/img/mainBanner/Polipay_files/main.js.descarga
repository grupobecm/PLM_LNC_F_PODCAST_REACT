let DetailsSlopesUTComponent = class DetailsSlopesUTComponent {
    constructor(data, router, dialog, serviceTrans) {
        this.data = data;
        this.router = router;
        this.dialog = dialog;
        this.serviceTrans = serviceTrans;
        this.showLoad = false;
        this.authorized = true;
        this.flagAut = false;
        this.dato = data.dato;
        //console.log("-------");
        //console.log(this.dato);
        //console.log("-------");
        this.seeDetails();
        // this.cuentadestino = this.dato.cuenta;
        // this.cuentaordenanteR = this.dato.cuenta_ordenante;
        // this.referencia = this.dato.referencianumerica;
        // this.claverastreo = this.dato.claverastreo;
        // //let aux = this.cuentadestino.toString().split('');
        // let aux = this.dato.cuenta.toString().split('');
        // this.cuentaBeneficiario = '******' + aux[aux.length-4] + aux[aux.length-3] + aux[aux.length-2] + aux[aux.length-1];
        // //aux = this.cuentaOrigen.toString().split('');
        // aux = this.cuentaOrigen.toString().split('');
        // this.cuentaordenante = '******' + aux[aux.length-4] + aux[aux.length-3] + aux[aux.length-2] + aux[aux.length-1];
        //   //aux = cuenta ordenante de recibidas;
        // if(this.cuentaordenanteR !== undefined){aux = this.cuentaordenanteR.toString().split('');
        // this.cuentaordenanteR = '******' + aux[aux.length-4] + aux[aux.length-3] + aux[aux.length-2] + aux[aux.length-1];}
    }
    seeDetails() {
        this.showLoad = true;
        this.serviceTrans.listTransferDetailsMassives(this.dato.id).subscribe(res => {
            //console.log(res);
            if (res.Modificado == null) {
                //console.log(' no se autorizo')
                this.flagAut = false;
            }
            else {
                this.flagAut = true;
            }
            this.showLoad = false;
            this.trackingKey = res.ClaveRastreo;
            this.nameBeneficiary = res.NombreBeneficiario;
            this.accountD = res.CuentaBeneficiario;
            // this.accountD = '******' + res.CuentaBeneficiario.substr(-4);
            this.bankD = res.BancoDestino;
            this.accountO = res.CuentaOrigen;
            // this.accountO = '******' + res.CuentaOrigen.substr(-4);
            this.payer = res.Ordenante;
            this.amount = res.Monto;
            this.concept = res.ConceptoPago;
            this.reference = res.Referencia;
            this.dateTime = res.FechaOperacion;
            this.typeOperation = res.Pago;
            this.email = res.email;
            this.collaborator = res.CreadoNombre;
            //fecha de liberación
            let date1 = new Date(this.dateTime);
            let Y1 = date1.getFullYear();
            let M1 = date1.getMonth();
            let d1 = date1.getDate();
            let H1 = date1.getHours();
            let m1 = date1.getMinutes();
            let s1 = date1.getSeconds();
            let dateLiberation = Y1 + "-" + M1 + "-" + d1 + "T" + H1 + ":" + m1 + ":" + s1;
            //console.log("Fecha de liberación: " + dateLiberation);
            let hora;
            //fecha un dia antes para cancelar
            let date2 = new Date();
            hora = date2.getHours();
            let min = date2.getMinutes();
            let seg = date2.getSeconds();
            let dateCancel = new Date(Y1, M1, d1 - 1, hora, min, seg);
            //console.log(date1);
            ////console.log(date2);
            //console.log(dateCancel);
            let horaLib = date1.getTime();
            let horaCancel = dateCancel.getTime();
            if (date1 < dateCancel && horaLib > horaCancel) {
                //console.log("aun se puede cancelar");
            }
            else {
                //console.log("ya no se puede cancelar");
                let cancelar = document.getElementById("cancelar");
                cancelar.style.visibility = "hidden";
            }
            let date3 = new Date();
            let dia = date3.getDate();
            let horaHoy = date3.getHours();
            let minHoy = date2.getMinutes();
            let segHoy = date2.getSeconds();
            //console.log(dia);
            let dateAuhtorize = new Date(Y1, M1, d1 + 1, horaHoy, minHoy, segHoy);
            //console.log(dateAuhtorize);
            let diaMas = d1 + 1;
            if (d1 < diaMas || d1 == diaMas && diaMas < dia) {
                //console.log(d1 + 1)
                //console.log("Autorizar");
            }
            else if (d1 < dia) {
                //console.log("no")
                let autorizar = document.getElementById("autorizar");
                autorizar.style.visibility = "hidden";
            }
            /* if(horaAut>=horaLib){
               
                 //console.log("aun se puede autorizar");
               
             }
             else {
               //console.log("ya no se puede autorizar");
             }
       */
            let dateCancelation;
            if (d1 != 1) {
                d1 -= 1;
                dateCancelation = Y1 + "-" + M1 + "-" + d1 + "T" + H1 + ":" + m1 + ":" + s1;
                //console.log("Fecha de cancelacion: " + dateCancelation);
            }
            else if (d1 == 1 && M1 == 1) {
                d1 = 31;
                M1 = 12;
                Y1 -= 1;
                dateCancelation = Y1 + "-" + M1 + "-" + d1 + "T" + H1 + ":" + m1 + ":" + s1;
                //console.log("Fecha de cancelacion: " + dateCancelation);
            }
            else if (d1 == 1 && M1 == 2 || M1 == 4 || M1 == 4 || M1 == 6 || M1 == 8 || M1 == 9 || M1 == 11) {
