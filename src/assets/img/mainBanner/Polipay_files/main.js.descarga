lass=\"form__text  pass | \"\r\n                                    [ngClass]=\"{ 'form__text_alert': (requerido('email') && form.get('email').touched) }\"\r\n                                    translate>Correo Electrónico*</span>\r\n                                <input class=\"form__input password | \"\r\n                                    [ngClass]=\"{ 'form__input_alert': (requerido('email') && form.get('email').touched) }\"\r\n                                    autocomplete=\"off\" type=\"text\" name=\"email\" id=\"email\" formControlName=\"email\"\r\n                                    required [(ngModel)]=\"emailModel\">\r\n\r\n                                <div class=\" alertTransfer\" *ngIf=\"requerido('email') && form.get('email').touched \">\r\n                                    <span class=\"alert__text | color-red\" translate> Por favor captura el correo\r\n                                        electrónico del Representante Legal</span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"form_space  form--password-mt\" fxFlex=\"30\">\r\n                                <span class=\"form__text  pass | \"\r\n                                    [ngClass]=\"{ 'form__text_alert': (requerido('phone') && form.get('phone').touched) }\"\r\n                                    translate>Teléfono*</span>\r\n                                <input class=\"form__input password | \"\r\n                                    [ngClass]=\"{ 'form__input_alert': (requerido('phone') && form.get('phone').touched) }\"\r\n                                    autocomplete=\"off\" type=\"text\" name=\"phone\" id=\"phone\" formControlName=\"phone\"\r\n                                    required [(ngModel)]=\"telefonoModel\">\r\n\r\n                                <div class=\" alertTransfer\" *ngIf=\"requerido('phone') && form.get('phone').touched \">\r\n                                    <span class=\