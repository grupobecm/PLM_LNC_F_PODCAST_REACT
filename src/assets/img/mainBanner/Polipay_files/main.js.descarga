ar\"\r\n                  [ngModelOptions]=\"{standalone: true}\" (ngModelChange)=\"filtrarFrecuentes()\">\r\n                <img class=\"icon__search\" src=\"../../../../../../assets/img/icons/search-24px.svg\"\r\n                  alt=\"buscar frecuentes\">\r\n              </div>\r\n              <ul class=\"ul-select frecuentes elscroll\">\r\n                <li *ngIf=\"total == 0\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                  <span class=\"texto__select\" fxFlex=\"95\">No se encontrarón grupo </span>\r\n                </li>\r\n                <li *ngFor=\"let frequent of copydatalist; index as i \" fxLayout=\"row wrap\" (click)=\"mostrar()\"\r\n                  fxLayoutAlign=\"end center\" (click)=\"changeDatalist(frequent)\">\r\n                  <div fxFlex=\"95\" fxLayoutAlign=\"start center\" *ngIf=\"total != 0\">\r\n                    <span class=\"texto__select\" fxFlex=\"95\">{{frequent.nombre_grupo}}</span>\r\n                  </div>\r\n                </li>\r\n              </ul>\r\n            </div>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <!--<span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (required('nombre_beneficiario') && form.get('nombre_beneficiario').touched) }\" translate>Grupo de Beneficiarios</span>\r\n                <input class=\"form__input password | font-roboto\" (change)=\"changeDatalist()\" [ngClass]=\"{ 'form__input_alert': (required('nombre_beneficiario') && form.get('nombre_beneficiario').touched) }\" list=\"browsers\" name=\"browser\" id=\"browser\" autocomplete=\"off\"\r\n                    formControlName=\"nombre_beneficiario\" [(ngModel)]=\"nombre_beneficiario\">\r\n\r\n                <datalist id=\"browsers\">\r\n                    <option *ngFor=\"let item of datalist\" [value]=\"item.nombre_grupo\" >\r\n                </datalist>\r\n\r\n\r\n                <div class=\" alertTransfer\" *ngIf=\"required('nombre_beneficiario') && form.get('nombre_beneficiario').touched \">\r\n                    <span class=\"alert__text | color-red\" translate> Por favor captura el Nombre del Grupo </span>\r\n                </div>-->\r\n      <!-- <button class=\"descarga\" src=\"/assets/img/icon/descargar.svg\" type=\"button\" (click)=\"generateExcel()\">Excel</button> -->\r\n\r\n      <div class=\"form\" fxFlex=\"100\">\r\n        <span class=\"form__text  pass | font-roboto\"\r\n          [ngClass]=\"{ 'form__text_alert': (required('concepto') && form.get('concepto').touched) }\"\r\n          translate>Concepto*</span>\r\n        <input type=\"text\" class=\"form__input password | font-roboto\"\r\n          [ngClass]=\"{ 'form__input_alert': (required('concepto') && form.get('concepto').touched) }\" autocomplete=\"off\"\r\n          id=\"concepto\" formControlName=\"concepto\" required>\r\n        <div class=\" alertTransfer\" *ngIf=\"form.get('concepto').touched && (form.get('concepto').hasError('required'))\">\r\n          <span class=\"alert__text | color-red\" *ngIf=\"form.get('concepto').hasError('required')\" translate> Por favor\r\n            captura el Concepto </span>\r\n        </div>\r\n      </div>\r\n      <div class=\"form ocultarT\" fxFlex=\"100\">\r\n        <span class=\"form__text  pass | font-roboto\" translate>Nombre del Beneficiario*</span>\r\n        <input type=\"text\" class=\"form__input password | font-roboto\" autocomplete=\"off\" name=\"nombre_beneficiario\"\r\n          id=\"nombre_beneficiario\" required>\r\n        <div class=\" alertTransfer\">\r\n          <span class=\"alert__text | color-red\" translate> Por favor captura el Nombre del Beneficiario </span>\r\n        </div>\r\n      </div>\r\n\r\n\r\n    </div>\r\n<!-- \r\n    <div class=\"ml-3\" fxFlex=\"32\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n      <div class=\"form  selectbox\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n        <mat-checkbox fxFlex=\"100\" class=\"mr-2 producto__checkbox form--auxiliar-mt | color-third\"\r\n          formControlName=\"is_schedule\" (change)=\"addDate()\">¿Deseas programar una fecha de<br>dispersión?\r\n        </mat-checkbox>\r\n      </div>\r\n      <div class=\"form\" fxFlex=\"100\" class=\"selectbox\" *ngIf=\"form.get('is_schedule').value\">\r\n        <div class=\"fecha\" fxLayout=\"row wrap\">\r\n          <p class=\"form__date label_fecha form__text user text-date--position | font-roboto\"\r\n            [ngClass]=\"{ 'form__text_alert': (required('fecha') && form.get('fecha').touched) }\" translate>Fecha de\r\n            dispersión*</p>\r\n          <mat-form-field class=\"valor campo_fecha disabled\"\r\n            [ngClass]=\"{ 'form__input_alert': (required('fecha') && form.get('fecha').touched) }\" fxFlex=\"100\">\r\n            <input class=\"borde-fecha\" matInput class=\"date\" [satDatepicker]=\"picker7\" autocomplete=\"off\" name=\"fecha\"\r\n              id=\"fecha\" formControlName=\"fecha\" readonly [min]=\"datenow\" required>\r\n            <sat-datepicker #picker7 [rangeMode]=\"false\" [selectFirstDateOnClose]=\"true\" [rangeHoverEffect]=\"false\">\r\n            </sat-datepicker>\r\n            <sat-datepicker-toggle matSuffix [for]=\"picker7\"></sat-datepicker-toggle>\r\n          </mat-form-field>\r\n          <div fxFlex=\"100\" class=\"alertTransfer alertTransfer--fecha margen-alert\"\r\n            *ngIf=\"(required('fecha') && form.get('fecha').touched)\">\r\n            <span class=\"alert__text | color-red\" translate>Por favor captura una fecha</span>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div> -->\r\n\r\n    <div class=\"ml-3\" fxFlex=\"32\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n      <div class=\"form \" fxFlex=\"100\" fxLayout=\"row wrap\" class=\"selectbox\">\r\n        <mat-checkbox fxFlex=\"100\" class=\"color-third form--auxiliar-mt | ocultarT\">Bloque vacio!<br>&&& &&&!\r\n        </mat-checkbox>\r\n      </div>\r\n      <div class=\"form\" fxFlex=\"100\" *ngIf=\"form.get('is_schedule').value\">\r\n        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': hourNull }\" translate>Hora de\r\n          dispersión*</span>\r\n        <input (click)=\"selectHour()\" type=\"text\" readonly class=\"form__input password | font-roboto\"\r\n          [ngClass]=\"{ 'form__input_alert': hourNull }\" autocomplete=\"off\" formControlName=\"hora_operacion\"\r\n          [ngModel]=\"hora_operacion\" required>\r\n        <div class=\" alertTransfer\" *ngIf=\"hourNull\">\r\n          <span class=\"alert__text | color-red\" translate> Por favor captura la Hora de dispersión </span>\r\n        </div>\r\n      </div>\r\n\r\n    </div>\r\n\r\n    <div fxFlex=\"100\" class=\"mt-3\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\" *ngIf=\"!errorGroup\">\r\n      <div class=\"mt-5\" fxFlex=\"100\">\r\n        <a href=\"https://polipayaux2-osaopa101-bucket-s3-pub-stage.s3.amazonaws.com/fe/dispersa.polipay.mx/templates/v1.0/Layout-Dispersa-Masiva.xlsx\"\r\n          style=\"display: none\" #hiddenDownload></a>\r\n        <button class=\"boton | background-grey-dark\" type=\"button\" (click)=\"hiddenDownload.click()\"\r\n          routerLinkActive=\"active\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n          <svg class=\"mr-2\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"17\" viewBox=\"0 0 14 17\">\r\n            <path fill=\"#3a555b\" d=\"M19 9h-4V3H9v6H5l7 7zM5 18v2h14v-2z\" transform=\"translate(-5 -3)\" />\r\n          </svg>\r\n          <span class=\"color-third\">Descargar Layout</span>\r\n        </button>\r\n      </div>\r\n      <div class=\"mt-4\" fxFlex=\"100\" fxLayout=\"row\">\r\n        <input class=\"boton__input\" name=\"file_\" id=\"file_\" style=\"display: none\" type=\"file\"\r\n          (change)=\"fileChange($event)\" #hiddenfileinput\r\n          accept=\".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel\">\r\n        <!-- -->\r\n        <button class=\"boton | background-accent\" type=\"button\" routerLinkActive=\"active\"\r\n          (click)=\"hiddenfileinput.click()\" fxLayout=\"row\" fxLayoutAlign=\"center center\"\r\n          [ngClass]=\"{'boton--alert': form.get('file').hasError('required') && (errorFileEmpy || errorFileSize || errorFileFormat) }\">\r\n          <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n          <span class=\"color-white\">Cargar Layout*</span>\r\n        </button>\r\n        <div class=\"ml-3\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n          <span fxFlex=\"100\" class=\"color-third\">{{ file }}</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"alertTransfer\"\r\n        *ngIf=\"form.get('file').hasError('required') && (errorFileEmpy || errorFileSize || errorFileFormat)\">\r\n        <span class=\"alert__text | color-red\" *ngIf=\"errorFileEmpy\">Por favor carga tu Layout</span>\r\n        <span class=\"alert__text | color-red\" *ngIf=\"errorFileSize\">El tamaño del archivo excede el permitido</span>\r\n        <span class=\"alert__text | color-red\" *ngIf=\"errorFileFormat\">El formato del archivo no es válido. Tiene que ser\r\n          un archivo xls</span>\r\n      </div>\r\n    </div>\r\n    <div fxFlex=\"100\" class=\"mt-3\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\" *ngIf=\"errorGroup\">\r\n      <div class=\"mt-5\" fxFlex=\"100\">\r\n        <!-- <a href=\"https://mediafiles654.s3.amazonaws.com/media/files/Layout-Dispersa-Masiva.xlsx\" style=\"display: none\" #hiddenDownload></a> -->\r\n        <button class=\"boton | background-grey-dark\" type=\"button\" (click)=\"generateExcel()\" routerLinkActive=\"active\"\r\n          fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n          <svg class=\"mr-2\" xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"17\" viewBox=\"0 0 14 17\">\r\n            <path fill=\"#3a555b\" d=\"M19 9h-4V3H9v6H5l7 7zM5 18v2h14v-2z\" transform=\"translate(-5 -3)\" />\r\n          </svg>\r\n          <span class=\"color-third\">Descargar Layout del Grupo</span>\r\n        </button>\r\n      </div>\r\n      <div class=\"mt-4\" fxFlex=\"100\" fxLayout=\"row\">\r\n        <input class=\"boton__input\" name=\"file_\" id=\"file_\" style=\"display: none\" type=\"file\"\r\n          (change)=\"fileChangeGroup($event)\" #hiddenfileinput\r\n          accept=\".csv, application/vnd.openxmlformats-officedocument.spreadsheetml.sheet, application/vnd.ms-excel\">\r\n        <!-- -->\r\n        <button class=\"boton | background-accent\" type=\"button\" routerLinkActive=\"active\"\r\n          (click)=\"hiddenfileinput.click()\" fxLayout=\"row\" fxLayoutAlign=\"center center\"\r\n          [ngClass]=\"{'boton--alert': form.get('file').hasError('required') && (errorFileEmpy || errorFileSize || errorFileFormat) }\">\r\n          <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n          <span class=\"color-white\">Cargar Layout*</span>\r\n        </button>\r\n        <div class=\"ml-3\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n          <span fxFlex=\"100\" class=\"color-third\">{{ file }}</span>\r\n        </div>\r\n      </div>\r\n      <div class=\"alertTransfer\"\r\n        *ngIf=\"form.get('file').hasError('required') && (errorFileEmpy || errorFileSize || errorFileFormat)\">\r\n        <span class=\"alert__text | color-red\" *ngIf=\"errorFileEmpy\">Por favor carga tu Layout</span>\r\n        <span class=\"alert__text | color-red\" *ngIf=\"errorFileSize\">El tamaño del archivo excede el permitido</span>\r\n        <span class=\"alert__text | color-red\" *ngIf=\"errorFileFormat\">El formato del archivo no es válido. Tiene que ser\r\n          un archivo xls</span>\r\n      </div>\r\n    </div>\r\n\r\n\r\n    <div class=\"form__botones\" fxFlex=\"100\" fxLayoutAlign=\"end end\">\r\n      <div class=\"\" fxLayoutAlign=\"end end\">\r\n        <button type=\"button\" class=\"cancelar__button | \" [routerLink]=\"['/usuario/dispersiones/']\"\r\n          routerLinkActive=\"active\"><b>Cancelar</b></button>\r\n      </div>\r\n      <div class=\"\" fxLayoutAlign=\"end end\">\r\n        <button type=\"submit\" class=\"confirmar__button | color-white\" id=\"confirm\"><b>Confirmar</b></button>\r\n      </div>\r\n    </div>\r\n\r\n  </form>\r\n\r\n</div>\r\n<!-- Loading -->\r\n<app-loading *ngIf=\"showLoad\"></app-loading>");

