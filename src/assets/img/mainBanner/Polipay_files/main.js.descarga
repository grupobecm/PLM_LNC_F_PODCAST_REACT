        this.showLoad = false;
        this.pagina_actual = 1;
        this.next_page = 0;
        this.prev_page = 0;
        this.total = 0;
        this.total_paginas = 0;
        //ordenamiento de datos
        this.noorder = true;
        this.noorderF = true;
        //---
        this.beneficiario = true;
        this.monto = true;
        this.crastreo = true;
        this.fechadis = true;
        this.displayedColumns = ['beneficiario', 'monto', 'claveRastreo', 'fechaOperacion', 'button'];
        this.listStaffExternal = [];
        this.ningunDato = false;
        this.noData = false;
        this.numRegister = 0;
        if (!this.storageClient.INFO_CENTERCOST) {
            //console.log("bye");
        }
        else {
            this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
            //console.log(this.dato)
            //console.log(this.dato.persona_cuenta_id);
        }
        this.showLoad = true;
        this.listSendTransferPtoP(this.dato.personaSolicitud_id, 999, null, null, 1, null);
    }
    listSendTransferPtoP(idCenterCost = this.dato.persona_cuenta_id, size = 9999, startDate = null, endDate = null, status = 1, beneficiario = null) {
        this.showLoad = true;
        this.serviceClientS.listSendTransPtoP(idCenterCost, size, startDate, endDate, status, beneficiario).subscribe((res) => {
            //console.log(res);
            this.ningunDato = false;
            let variable = [...res.results];
