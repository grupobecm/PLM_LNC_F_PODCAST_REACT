/* harmony default export */ __webpack_exports__["default"] = ("<div class=\"container-details\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n    <div class=\"table\" fxFlex=\"100\">\r\n        <table fxFlex=\"100\">\r\n            <tr>\r\n                <td class=\"head | color-main\">Clave de rastreo</td>\r\n                <td class=\" | color-third\"><b>{{ dato.claverastreo }}</b></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"head | color-main\">Empresa beneficiaria</td>\r\n                <td class=\" | color-third\"><b>{{ dato.nombrebeneficiario }}</b></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"head | color-main\">Cuenta beneficiaria</td>\r\n                <td class=\" | color-third\"><b>{{ cuentaBeneficiario }}</b></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"head | color-main\">Banco</td>\r\n                <td class=\" | color-third\"><b>Polipay</b></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"head | color-main\">Empresa ordenante</td>\r\n                <td class=\" | color-third\"><b>{{ dato.nombre}}</b></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"head | color-main\">Cuenta ordenante</td>\r\n                <td class=\" | color-third\"><b>{{cuentaordenante}}</b></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"head | color-main\">Nombre ordenante</td>\r\n                <td class=\" | color-third\"><b>{{ dato.cliente}}</b></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"head | color-main\">Monto</td>\r\n                <td class=\" | color-third\"><b>{{ dato.monto | currency }} MXN</b></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"head | color-main\">Concepto</td>\r\n                <td class=\" | color-third\"><b>{{ dato.conceptopago }}</b></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"head | color-main\">Referencia</td>\r\n                <td class=\" | color-third\"><b>{{ dato.referencianumerica || dato.referencia}}</b></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"head | color-main\">Fecha y hora</td>\r\n                <td class=\" | color-third\"><b>{{ dato.date_created | date: 'd/M/yyyy HH:mm' }} horas</b></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"head | color-main\">Tipo de operación</td>\r\n                <td class=\" | color-third\"><b>{{ dato.tipoPago }}</b></td>\r\n            </tr>\r\n            <tr>\r\n                <td class=\"head | color-main\">Correo electrónico del<br> destinatario\r\n                </td>\r\n                <td class=\" | color-third\"><b>{{ dato.email }}</b></td>\r\n            </tr>\r\n        </table>\r\n    </div>\r\n\r\n\r\n    <div class=\"boton-container\" fxFlex=\"100\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n        <button *ngIf=\"pendientes()\" (click)=\"pendientesCancelar(dato.id)\" class=\"boton boton--margin | background-red color-white\"><span>Cancelar</span></button>\r\n        <button *ngIf=\"enviadas()\" (click)=\"download(dato.id)\" class=\"boton boton--padding boton--margin | background-main color-white\"><img src=\"/../../../../assets/img/icons/comprobante-icon.svg\"><span>comprobante</span></button>\r\n        <button class=\"boton | background-main color-white\" mat-dialog-close>ACEPTAR</button>\r\n    </div>\r\n</div>\r\n<!-- Loading -->\r\n<app-loading *ngIf=\"showLoad\"></app-loading>\r\n");

