let ExternalCustomerListComponent = class ExternalCustomerListComponent {
    constructor(router, serviceAccount, storageAdmin) {
        this.router = router;
        this.serviceAccount = serviceAccount;
        this.storageAdmin = storageAdmin;
        this.displayedColumns = ['cliente', 'cuenta', 'clabe', 'fecha', 'button'];
        this.displayedColumnsRequest = ['cliente', 'tSolicitud', 'fecha', 'intentos', 'estado', 'button'];
