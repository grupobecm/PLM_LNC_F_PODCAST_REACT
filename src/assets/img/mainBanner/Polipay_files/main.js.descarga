derCellDef mat-sort-header>Clabe Receptor</th>\r\n                    <td mat-cell *matCellDef=\"let element\" align=\"center\"> {{ element.clabe_receptor }} </td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"FeOperacion\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Fecha de Operación</th>\r\n                    <td mat-cell *matCellDef=\"let element\" align=\"center\">{{ element.fecha_creacion | date: 'dd/MM/yyyy HH:mm'}} Hrs.</td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"Monto\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Monto</th>\r\n                    <td mat-cell *matCellDef=\"let element\" [ngStyle]=\"element.monto < 0 ? {'color':'#ff0000'}: {'color':'#3a555b'}\"> {{ element.monto | currency:'MXN':'symbol' }} </td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"NumRef\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Núm. Ref.</th>\r\n                    <td mat-cell *matCellDef=\"let element\" align=\"center\">{{ element.referencia_numerica }}</td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"ClaveRas\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Clave de Rastreo</th>\r\n                    <td mat-cell *matCellDef=\"let element\" align=\"center\">{{ element.clave_rastreo }}</td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"FolioTrans\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Folio Transf.</th>\r\n                    <td mat-cell *matCellDef=\"let element\" align=\"center\"> {{ element.id }}</td>\r\n                </ng-container>\r\n                <ng-container matColumnDef=\"Concepto\">\r\n                    <th mat-header-cell *matHeaderCellDef mat-sort-header>Concepto</th>\r\n                    