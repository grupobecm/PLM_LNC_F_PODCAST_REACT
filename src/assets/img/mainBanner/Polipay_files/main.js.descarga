nt\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\" >\r\n            <div fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between center\">\r\n             \r\n                <!-- <div class=\"descargas ocultarT\" fxFlex=\"15\" fxLayoutAlign=\"space-evenly center\">\r\n                    <img src=\"../../../../assets/img/icons/exp-xlsx.svg\" alt=\"Exportar XLSX\" (click)=\"exportExcel('xls')\">\r\n                    <div class=\"label-container\">\r\n                        <label class=\"label__copy | color-white\">Exportar Excel</label>\r\n                    </div>\r\n                    <img src=\"../../../../assets/img/icons/exp-csv.svg\" alt=\"Exportar CSV\" (click)=\"exportExcel('csv')\">\r\n                    <div class=\"label-container\">\r\n                        <label class=\"label__copy | color-white\">Exportar CSV</label>\r\n                    </div>\r\n                </div> -->\r\n    \r\n            </div>\r\n            <div class=\"mat-elevation-z8 margin-cont table\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n                <table mat-table [dataSource]=\"listStaffExternal\" fxFlex=\"100\" matSort [attr.align]=\"'center'\">\r\n                    <ng-container matColumnDef=\"noData\">\r\n                        <td mat-footer-cell *matFooterCellDef [attr.colspan]=\"displayedColumns.length\" [attr.align]=\"'center'\">\r\n                            <span *ngIf=\"noData===true\">No se encontraron registros.</span>\r\n                        </td>\r\n                    </ng-container>\r\n                    <ng-container matColumnDef=\"ID\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>ID</th>\r\n                        <td mat-cell *matCellDef=\"let element\">{{ element.id }}</td>\r\n                    </ng-container>\r\n                    <ng-container matColumnDef=\"FeOperacion\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>Fecha de Operación</th>\r\n                        <td mat-cell *matCellDef=\"let element\">{{ element.creation_date | date: 'dd/MM/yyyy HH:mm'}} Hrs.</td>\r\n                    </ng-container>\r\n                    <ng-container matColumnDef=\"JsonContet\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>Json enviado</th>\r\n                        <td mat-cell *matCellDef=\"let element\" >\r\n                            <button class=\"seemore color-main\" (click)=\"seeJson(element)\">Ver más</button>\r\n                        </td>\r\n                    </ng-container>\r\n                    <ng-container matColumnDef=\"Response\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>Response</th>\r\n                        <td mat-cell *matCellDef=\"let element\" >\r\n                            <button class=\"seemore color-main\" (click)=\"seeResponse(element)\">Ver más</button>\r\n                        </td>\r\n                    </ng-container>\r\n                    <!-- <ng-container matColumnDef=\"JsonContet\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>Json enviado</th>\r\n                        <td mat-cell *matCellDef=\"let element\"> {{ element.json_content }}</td>\r\n                    </ng-container>\r\n                    <ng-container matColumnDef=\"Response\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>Response</th>\r\n                        <td mat-cell *matCellDef=\"let element\">{{ element.response }}</td>\r\n                    </ng-container> -->\r\n                    <ng-container matColumnDef=\"Name\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>Nombre</th>\r\n                        <td mat-cell *matCellDef=\"let element\">{{ element.name }}</td>\r\n                    </ng-container>\r\n                    <ng-container matColumnDef=\"Email\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>Email</th>\r\n                        <td mat-cell *matCellDef=\"let element\">{{ element.email }}</td>\r\n                    </ng-container>        \r\n                    <tr mat-header-row *matHeaderRowDef=\"displayedColumns\"></tr>\r\n                    <tr mat-row *matRowDef=\"let row; columns: displayedColumns\"></tr>\r\n                    <tr mat-footer-row *matFooterRowDef=\"['noData']\" [hidden]=\"numRegister > 0\"></tr>\r\n        \r\n                </table>\r\n                <mat-paginator fxFlex=\"100\" [pageSizeOptions]=\"[100]\" showFirstLastButtons></mat-paginator>\r\n            </div>\r\n        </div>\r\n    </form>\r\n\r\n\r\n</div>\r\n<!-- Loading -->\r\n<app-loading *ngIf=\"showLoad\"></app-loading>\r\n");

