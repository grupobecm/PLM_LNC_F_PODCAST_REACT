-dark);\r\n    box-shadow: none;\r\n    color: var(--main-color);\r\n    transition: 0.3s;\r\n}\r\n\r\n/* INVALID DISABLED  */\r\n\r\n.button-new-pass:disabled {\r\n    background-color: var(--main-color);\r\n    cursor: default;\r\n}\r\n\r\n/* FIN Button Login */\r\n/*# sourceMappingURL=data:application/json;base64, */");

