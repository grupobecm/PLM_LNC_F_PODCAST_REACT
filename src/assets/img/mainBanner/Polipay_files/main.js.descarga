                let file = fileList[0];
                // se verifica que sea la extensión solicitada
                ////console.log("Archivo",file.name);
                if (file.name.split('.')[1] == 'pdf') {
                    //verificamos el tamaño
                    if (file.size / 1024 / 1024 / 1024 < 1) {
                        this.file = file.name;
                        let reader = new FileReader();
                        reader.readAsDataURL(file);
                        //extraemos la información
                        reader.onload = (loadedEvent) => {
                            switch (type) {
                                case 'rs':
                                    ////console.log("rs");
                                    this.documents_centro_costos.controls[archivoId].get('nombre').setValue(file.name);
                                    this.documents_centro_costos.controls[archivoId].get('Documento').setValue(reader.result);
                                    this.documents_centro_costos.controls[archivoId].get('Documento').setValue(this.documents_centro_costos.controls[archivoId].get('Documento').value.split(',')[1]);
                                    ////console.log(this.documents_centro_costos.controls[archivoId].get('Documento').value);
                                    switch (archivoId) {
                                        case 0:
                                            this.documents_centro_costos.controls[archivoId].get('TipoDocumento').setValue(this.id_documents.actaConstitutiva);
                                            break;
                                        case 1:
                                            this.documents_centro_costos.controls[archivoId].get('TipoDocumento').setValue(this.id_documents.registroPublico);
                                            break;
                                        case 2:
                                            this.documents_centro_costos.controls[archivoId].get('TipoDocumento').setValue(this.id_documents.constanciaSat);
                                            break;
                                        case 3:
                                            this.documents_centro_costos.controls[archivoId].get('TipoDocumento').setValue(this.id_documents.comprobanteDomicilio);
                                            break;
                                        case 4:
                                            this.documents_centro_costos.controls[archivoId].get('TipoDocumento').setValue(this.id_documents.estadoCuenta);
                                            break;
                                        case 5:
                                            this.documents_centro_costos.controls[archivoId].get('TipoDocumento').setValue(this.id_documents.pld);
                                            break;
                                        case 6:
                                            this.documents_centro_costos.controls[archivoId].get('TipoDocumento').setValue(this.id_documents.otro);
                                            break;
                                    }
                                    if (archivoId == 6) {
                                        this.flgEspecificar = true;
                                    }
                                    this.arregloErrores_rs[archivoId] = false;
                                    break;
                                case 'rl':
                                    ////console.log("rl");
                                    this.documents_representante_legal.controls[archivoId].get('nombre').setValue(file.name);
                                    this.documents_representante_legal.controls[archivoId].get('Documento').setValue(reader.result);
                                    this.documents_representante_legal.controls[archivoId].get('Documento').setValue(this.documents_representante_legal.controls[archivoId].get('Documento').value.split(',')[1]);
                                    switch (archivoId) {
                                        case 0:
                                            this.documents_representante_legal.controls[archivoId].get('TipoDocumento').setValue(this.id_documents.identificacion);
                                            break;
                                        case 1:
                                            this.documents_representante_legal.controls[archivoId].get('TipoDocumento').setValue(this.id_documents.comprobanteDomicilio);
                                            break;
                                        case 2:
                                            this.documents_representante_legal.controls[archivoId].get('TipoDocumento').setValue(this.id_documents.constanciaSat);
                                            break;
                                    }
                                    this.arregloErrores_rl[archivoId] = false;
                                    break;
                                case 'admin':
                                    ////console.log("admin");
                                    this.documents_admin.controls[archivoId].get('nombre').setValue(file.name);
                                    this.documents_admin.controls[archivoId].get('Documento').setValue(reader.result);
                                    this.documents_admin.controls[archivoId].get('Documento').setValue(this.documents_admin.controls[archivoId].get('Documento').value.split(',')[1]);
                                    this.documents_admin.controls[archivoId].get('TipoDocumento').setValue(this.id_documents.identificacion);
                                    this.arregloErrores_admin[archivoId] = false;
                                    break;
                            }
                            ////console.log(reader.result);
                            /* ERRORES
                              this.errorFileSize = false;
                              this.errorFileFormat = false;
                              this.errorFileEmpy = false;
                            */
                            this.showLoad = false;
                        };
                    }
                    else {
                        //Errores de tamaño
                        // this.exito = false;
                        this.showLoad = false;
                        switch (type) {
                            case 'rs':
                                ////console.log("rs");
                                this.arregloErrores_rs[archivoId] = true;
                                this.arregloErroresSize_rs[archivoId] = true;
                                this.documents_centro_costos.controls[archivoId].get('Documento').setValue('tamano');
                                break;
                            case 'rl':
                                ////console.log("rl");
                                this.arregloErrores_rl[archivoId] = true;
                                this.arregloErroresSize_rl[archivoId] = true;
                                this.documents_representante_legal.controls[archivoId].get('Documento').setValue('tamano');
                                break;
                            case 'admin':
                                ////console.log("admin");
                                this.arregloErrores_admin[archivoId] = true;
                                this.arregloErroresSize_admin[archivoId] = true;
                                this.documents_admin.controls[archivoId].get('Documento').setValue('tamano');
                                break;
                        }
                        ////console.log("tamaño");
                        this.file = "Ningún archivo seleccionado";
                    }
                }
                else {
                    //Errores de formato de archivo
                    this.showLoad = false;
                    switch (type) {
                        case 'rs':
                            ////console.log("rs");
                            this.arregloErrores_rs[archivoId] = true;
                            this.arregloErroresFormat_rs[archivoId] = true;
                            this.documents_centro_costos.controls[archivoId].get('Documento').setValue('formato');
                            this.documents_centro_costos.controls[archivoId].get('nombre').setValue("Ningún archivo seleccionado");
                            break;
                        case 'rl':
                            ////console.log("rl");
                            this.arregloErrores_rl[archivoId] = true;
                            this.arregloErroresFormat_rl[archivoId] = true;
                            this.documents_representante_legal.controls[archivoId].get('Documento').setValue('formato');
                            this.documents_representante_legal.controls[archivoId].get('nombre').setValue("Ningún archivo seleccionado");
                            break;
                        case 'admin':
                            ////console.log("admin");
                            this.arregloErrores_admin[archivoId] = true;
                            this.arregloErroresFormat_admin[archivoId] = true;
                            this.documents_admin.controls[archivoId].get('Documento').setValue('formato');
                            this.documents_admin.controls[archivoId].get('nombre').setValue("Ningún archivo seleccionado");
                            break;
                    }
                    ////console.log("formato");
                    this.file = "Ningún archivo seleccionado";
                }
            }
            else {
                this.showLoad = false;
                switch (type) {
                    case 'rs':
                        ////console.log("rs");
                        this.arregloErrores_rs[archivoId] = true;
                        this.arregloErroresVacio_rs[archivoId] = true;
                        this.documents_centro_costos.controls[archivoId].get('Documento').setValue('vacio');
                        break;
                    case 'rl':
                        ////console.log("rl");
                        this.arregloErrores_rl[archivoId] = true;
                        this.arregloErroresVacio_rl[archivoId] = true;
                        this.documents_representante_legal.controls[archivoId].get('Documento').setValue('vacio');
                        break;
                    case 'admin':
                        ////console.log("admin");
                        this.arregloErrores_admin[archivoId] = true;
                        this.arregloErroresVacio_admin[archivoId] = true;
                        this.documents_admin.controls[archivoId].get('Documento').setValue('vacio');
                        break;
                }
                ////console.log("vacio");
                this.file = "Ningún archivo seleccionado";
            }
        });
    }
    cambios(ind) {
        ////console.log("<---->");
        this.ListMailRepeat = [];
        this.ListMailRepeat.push(this.emailModel);
        for (let i = 0; i < this.t.length; i++) {
            ////console.log(this.t.controls[i].value.correoAdd);
            this.ListMailRepeat.push(this.t.controls[i].value.correoAdd);
        }
        ////console.log("<---->");
        ////console.log(this.ListMailRepeat);
        let duplicados = [];
        const tempArray = [...this.ListMailRepeat].sort();
        for (let i = 0; i < tempArray.length; i++) {
            if (tempArray[i + 1] === tempArray[i]) {
                if (tempArray[i] != "") {
                    duplicados.push(tempArray[i]);
                }
            }
        }
        ////console.log(duplicados);
        for (let i = 0; i < this.t.length; i++) {
            if (duplicados.includes(this.t.controls[i].value.correoAdd)) {
                this.errorCorreoReperito[ind] = true;
            }
            else {
                this.errorCorreoReperito[i] = false;
            }
        }
        ////console.log(this.errorCorreoReperito);
    }
    cambios2(ind) {
        ////console.log("<---->");
        this.ListPhoneRepeat = [];
        this.ListPhoneRepeat.push(this.telefonoModel);
        for (let i = 0; i < this.t.length; i++) {
            ////console.log(this.t.controls[i].value.correoAdd);
            this.ListPhoneRepeat.push(this.t.controls[i].value.telefonoAdd);
        }
        ////console.log("<---->");
        ////console.log(this.ListPhoneRepeat);
        let duplicados = [];
        const tempArray = [...this.ListPhoneRepeat].sort();
        for (let i = 0; i < tempArray.length; i++) {
            if (tempArray[i + 1] === tempArray[i]) {
                if (tempArray[i] != "") {
                    duplicados.push(tempArray[i]);
                }
            }
        }
        ////console.log(duplicados);
        for (let i = 0; i < this.t.length; i++) {
            if (duplicados.includes(this.t.controls[i].value.telefonoAdd)) {
                this.errorTelefonoRepetidoo[ind] = true;
            }
            else {
                this.errorTelefonoRepetidoo[i] = false;
            }
        }
        ////console.log(this.errorTelefonoRepetidoo);
    }
};
