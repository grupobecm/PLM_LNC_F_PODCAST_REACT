            width: "90%",
            panelClass: "custom-dialog-container"
        });
        filtro.afterClosed().subscribe(res => {
            let nameBenefi = null;
            let date1 = null;
            let date2 = null;
            //console.log(res);
            if (res == undefined) {
            }
            else {
                if (res != 'Reset filtro') {
                    for (let i = 0; i < res.data.filtro.length; i++) {
                        switch (res.data.filtro[i].campo) {
                            case 'Fecha de Dispersión':
                                date1 = (res.data.filtro[i].valor.begin).toISOString().split("T")[0] + " 00:00:00";
                                date2 = (res.data.filtro[i].valor.end).toISOString().split("T")[0] + " 23:59:59";
                                break;
                            case 'Nombre de Usuario':
                                nameBenefi = res.data.filtro[i].valor;
                                break;
                        }
                    }
                }
            }
            this.listIndividualDispersionMassive(nameBenefi, date1, date2);
        });
    }
    exportXLSX(id = this.id, idtype = 4, name = null, clabe = null, nameBenefy = null, date1 = null, date2 = null, status = 1) {
        this.showLoad = true;
