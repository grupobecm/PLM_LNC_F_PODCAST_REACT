/* harmony default export */ __webpack_exports__["default"] = ("<!-- Barra menu lateal (numero de cuenta y clabe) -->\r\n<app-menu-admin fxFlex=\"16.66\"></app-menu-admin>\r\n<!-- FIN Barra menu lateal (numero de cuenta y clabe) -->\r\n\r\n<div class=\"dashboard-admin overflow\" fxFlex=\"83.33\" fxLayout=\"row wrap\" fxLayoutAlign=\"center start\">\r\n    <div fxFlex=\"100\" fxLayoutAlign=\"space-between center\">\r\n\r\n        <button class=\"button-verification-code | color-third background-grey-dark \" type=\"button\" (click)=\"openFilter()\">\r\n            FILTRO\r\n        </button>\r\n\r\n        <div class=\"descargas \" fxFlex=\"20\" fxLayoutAlign=\"space-evenly center\" (click)=\"exportExcell()\">\r\n            <img src=\"../../../../assets/img/icons/exp-xlsx.svg\" alt=\"Exportar XLSX\">\r\n            <div class=\"label-container\">\r\n                <label class=\"label__copy | color-white \" translate>User.Tooltip.ExportXLSX</label>\r\n            </div>\r\n            <!-- <img src=\"../../../../assets/img/icons/exp-csv.svg\" alt=\"Exportar CSV\">\r\n          <img src=\"../../../../assets/img/icons/exp-pdf.svg\" alt=\"Exportar PDF\"> -->\r\n        </div>\r\n\r\n    </div>\r\n\r\n    <div class=\"mat-elevation-z8 margin-cont table\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n        <table mat-table [dataSource]=\"listStaffExternal\" fxFlex=\"100\" matSort [attr.align]=\"'center'\">\r\n            <!-- Columna No se encontraron registros -->\r\n            <ng-container matColumnDef=\"noData\">\r\n                <td mat-footer-cell *matFooterCellDef [attr.colspan]=\"displayedColumns.length\" [attr.align]=\"'center'\">\r\n                    <span *ngIf=\"noData===true\">No se encontraron registros.</span>\r\n                </td>\r\n            </ng-container>\r\n            <!-- Columna Cliente -->\r\n            <ng-container matColumnDef=\"empresa\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Cliente</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{ element.empresa }}</td>\r\n            </ng-container>\r\n            <!-- Columna Ordenante -->\r\n            <ng-container matColumnDef=\"nombre_beneficiario\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Beneficiario</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{ element.nombre_beneficiario }}</td>\r\n            </ng-container>\r\n            <!-- Columna Monto -->\r\n            <ng-container matColumnDef=\"monto\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Monto</th>\r\n                <td mat-cell *matCellDef=\"let element\"> {{ element.monto | currency }} MXN</td>\r\n            </ng-container>\r\n            <!-- Columna Clave de rastreo -->\r\n            <ng-container matColumnDef=\"clave_rastreo\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Clave de Rastreo</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{ element.clave_rastreo }}</td>\r\n            </ng-container>\r\n            <!-- Columna Clave de rastreo -->\r\n            <ng-container matColumnDef=\"fecha_creacion\">\r\n                <th mat-header-cell *matHeaderCellDef mat-sort-header>Fecha de Operación</th>\r\n                <td mat-cell *matCellDef=\"let element\">{{ element.fecha_creacion | date:'dd/MM/yyyy HH:mm' }}</td>\r\n            </ng-container>\r\n            <!-- Columna boton asignar servicios -->\r\n            <ng-container matColumnDef=\"button\">\r\n                <th mat-header-cell *matHeaderCellDef></th>\r\n                <td mat-cell *matCellDef=\"let element\">\r\n                        <!-- <button class=\"verdetalles_button quitmrg  | background-main color-white\" (click)=\"seeDetails(element)\" fxLayoutAlign=\"center center\">\r\n                            <span class=\"\">Ver Detalles</span>\r\n                        </button> -->\r\n                   