roRegistros {\r\n    margin-right: 37px;\r\n}\r\n\r\n.boton {\r\n    border: none;\r\n    margin: 0px 16px;\r\n    outline: none;\r\n}\r\n\r\n.txt-left {\r\n    text-align: left;\r\n}\r\n\r\n.th-fav {\r\n    width: 5%;\r\n}\r\n\r\n.th-alias {\r\n    width: 15%;\r\n}\r\n\r\n.nombre {\r\n    width: 30%;\r\n} */\r\n/*# sourceMappingURL=data:application/json;base64, */");

