/* harmony default export */ __webpack_exports__["default"] = ("<!-- Barra menu lateal (numero de cuenta y clabe) -->\r\n<app-menu fxFlex=\"16.66\" ></app-menu>\r\n<!-- FIN Barra menu lateal (numero de cuenta y clabe) -->\r\n<div class=\"dashboard-transaction\" fxFlex=83.33 fxLayout=\"row wrap\" fxLayoutAlign=\"center start\">\r\n    <app-saldo-transactions fxFlex=\"100\"></app-saldo-transactions>\r\n\r\n    <div class=\"tabla-enviadas mt-5\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n        <div fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\">\r\n            <div div fxFlex=\"33\" fxLayoutAlign=\"start start\">\r\n                <p class=\"titleE | color-accent ml-2\">EDITAR FRECUENTE</p>\r\n            </div>\r\n            <div fxFlex=\"65\" fxLayoutAlign=\"end center\">\r\n                <button class=\"button-verification-new  | color-third background-grey-dark font-roboto\" type=\"button\">NUEVA CUENTA FRECUENTE</button>\r\n                <button class=\"button-verification-code ml-4 | color-third background-grey-dark font-roboto\" type=\"button\" [routerLink]=\"['/usuario/transaccion/cuentasfrecuentes/polipayFrequent/groupsfrecuentespolipay']\" routerLinkActive=\"active\">GRUPOS</button>\r\n            </div>\r\n        </div>\r\n        <div fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\">\r\n            <form [formGroup]=\"form\" novalidate (ngSubmit)=\"submit()\" #f=\"ngForm\" class=\"mt-5\" fxFlex=\"98\" fxLayout=\"row wrap\" fxLayoutAlign=\"center start\">\r\n                <div fxFlex=\"100\">\r\n                    <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div fxFlex=\"33\" fxLayout=\"row wrap\" fxLayoutAlign=\"center start\">\r\n                        <!-- Input nombre Beneficiario -->\r\n                        <div class=\"form\" fxFlex=\"95\">\r\n                            <span class=\"form__text user | font-roboto\">Nombre del Beneficiario*</span>\r\n                            <input class=\"form__input user | font-roboto\" type=\"text\" name=\"nombrebeneficiario\" formControlName=\"nombrebeneficiario\" required ngModel>\r\n                        </div>\r\n                        <!-- Email Beneficiario -->\r\n                        <div class=\"form\" fxFlex=\"95\">\r\n                            <span class=\"form__text user | font-roboto\">Correo Electrónico del Beneficiario</span>\r\n                            <input class=\"form__input user | font-roboto\" type=\"email\" name=\"email\" formControlName=\"email\" ngModel>\r\n                        </div>\r\n                        <!-- RFC Destinatario -->\r\n                        <div class=\"form\" fxFlex=\"95\">\r\n                            <span class=\"form__text user | font-roboto\">R.F.C. Destinatario</span>\r\n                            <input class=\"form__input user | font-roboto\" type=\"text\" name=\"rfcurp\" formControlName=\"rfcurp\" ngModel>\r\n                        </div>\r\n                    </div>\r\n                    <div fxFlex=\"33\" fxLayout=\"row wrap\" fxLayoutAlign=\"center start\">\r\n                        <!-- Input no. de cuenta -->\r\n                        <div class=\"form\" fxFlex=\"95\">\r\n                            <span class=\"form__text user | font-roboto\">Número de Cuenta*</span>\r\n                            <input class=\"form__input user | font-roboto\" type=\"number\" name=\"cuentaBeneficiario\" formControlName=\"cuentaBeneficiario\" required ngModel>\r\n                        </div>\r\n                        <!-- Input ID Beneficiario -->\r\n                        <div class=\"form\" fxFlex=\"95\">\r\n                            <span class=\"form__text user | font-roboto\">ID del Beneficiario*</span>\r\n                            <input class=\"form__input user | font-roboto\" type=\"number\" name=\"idbeneficiario\" formControlName=\"idbeneficiario\" required ngModel>\r\n                        </div>\r\n                        <!-- Input Alias -->\r\n                        <div class=\"form\" fxFlex=\"95\">\r\n                            <span class=\"form__text user | font-roboto\">Alias*</span>\r\n                            <input class=\"form__input user | font-roboto\" type=\"number\" name=\"alias\" formControlName=\"alias\" required ngModel>\r\n                        </div>\r\n                    </div>\r\n                    <div fxFlex=\"33\" fxLayout=\"row wrap\" fxLayoutAlign=\"center start\">\r\n                        <div fxFlex=\"100\">\r\n                            <p class=\"mensajegpo\">Selecciona el o los grupos en los que deseas guardar esta cuenta frecuente, en caso de necesitarlo.</p>\r\n                        </div>\r\n                        <!-- Input save en frecuentes -->\r\n                        <div class=\"checkfrecuent\" fxFlex=\"95\" fxLayoutAlign=\"start center\">\r\n                            <input class=\"mr-2 check\" type=\"checkbox\" name=\"isFrecuent\" formControlName=\"isFrecuent\" ngModel><span>Proveedores</span>\r\n                        </div>\r\n                        <div class=\"checkfrecuent\" fxFlex=\"95\" fxLayoutAlign=\"start center\">\r\n                            <input class=\"mr-2 check\" type=\"checkbox\" name=\"isFrecuent\" formControlName=\"isFrecuent\" ngModel><span>Servicios</span>\r\n                        </div>\r\n                        <div class=\"checkfrecuent\" fxFlex=\"95\" fxLayoutAlign=\"start center\">\r\n                            <input class=\"mr-2 check\" type=\"checkbox\" name=\"isFrecuent\" formControlName=\"isFrecuent\" ngModel><span>Honorarios</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"mt-3\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\