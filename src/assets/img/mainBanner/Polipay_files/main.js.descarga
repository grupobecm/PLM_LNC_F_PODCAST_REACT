let BalancesAdminMomentComponent = class BalancesAdminMomentComponent {
    constructor(dialog, router, storageAdmin, serviceAdmin) {
        this.dialog = dialog;
        this.router = router;
        this.storageAdmin = storageAdmin;
        this.serviceAdmin = serviceAdmin;
        this.displayedColumns = ['id', 'saldo_requerido', 'comision', 'total', 'estado', 'fecha', 'button'];
        this.listRequest = [];
        this.solicitudes = [];
        this.noData = false;
        this.numRegister = 0;
        //
        this.showLoad = false;
        this.paso1 = true;
        this.paso2 = false;
        //
        this.TP = "Tarjetas de Prepago";
        this.dataServices = "";
        this.commissionT = 0;
        this.commissionTP = 0;
        this.iva = 16;
    }
    ngOnInit() {
        //console.log(this.storageAdmin.CenterCost);
        this.showLoad = true;
        this.serviceAdmin.requestBalances(this.storageAdmin.CenterCost.id).subscribe(res => {
            //console.log(res);
            this.showLoad = false;
            //this.listRequest = new MatTableDataSource<Balance>(res);
            //console.log([]);
            this.commissions = res[0].comisiones;
            this.dataServices = res[0].comisiones[0].producto;
            //console.log(this.commissions);
            //Nombre de la Cuenta Eje
            this.nameClient = this.storageAdmin.CenterCost.name;
            //En caso de haber 1 Servicio
            this.solicitudes = res[0].solicitudes;
            this.listRequest = new _angular_material_table__WEBPACK_IMPORTED_MODULE_9__["MatTableDataSource"](this.solicitudes);
            this.listRequest.sort = this.sort;
            this.listRequest.paginator = this.paginator;
            // Validacion para hacer operaciones en html
            if (this.dataServices == this.TP) {
                this.commissionTP = this.commissions[0].Porcentaje;
                this.negativa2 = this.commissions[0].Comision;
                //console.log('Comision TP', this.negativa2);
                //console.log('TP', this.commissionTP);
            }
            else {
                // Servicios de Transferencias
                this.commissionT = this.commissions[0].Porcentaje;
                //console.log('T', this.commissionT);
                this.negativa = this.commissions[0].Comision;
                //console.log('Comision T', this.negativa);
                // Servicios de Tarjetas Prepago
                this.commissionTP = this.commissions[1].Porcentaje;
                //console.log('TP', this.commissionTP);
                this.negativa2 = this.commissions[1].Comision;
                //console.log('Comision TP', this.negativa2);
            }
            this.listRequest.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listRequest.data.length;
            //console.log(this.numRegister);
        }, error => {
            this.numRegister = 0;
            this.noData = true;
            this.showLoad = false;
        });
    }
    authorizeBalance(dato) {
        //console.log(dato);
        let respuesta = this.dialog.open(_messageAdmin_questions_admin_questions_admin_component__WEBPACK_IMPORTED_MODULE_13__["QuestionsAdminComponent"], {
            data: {
                question: 'S-001',
                id: this.storageAdmin.CenterCost.id,
                folio: dato.Solicitudes.id
            },
            disableClose: true,
        });
        respuesta.afterClosed().subscribe((res) => {
            //console.log('Mensaje', res);
            if (res.status == "aceptar") {
                this.ngOnInit();
            }
        });
    }
};
