   text-align: center;\r\n}\r\n\r\n.th--align-right {\r\n    text-align: right;\r\n    margin-right: 15px;\r\n}\r\n\r\n.bold {\r\n    font-weight: 600;\r\n}\r\n\r\n.status{\r\n    color: #3a555b;\r\n}\r\n\r\n.status--correct{\r\n    color: #36851a;\r\n}\r\n\r\n.status--fail{\r\n    color: #ff0000;\r\n}\r\n\r\n/* FIN Tabla datos */\r\n\r\n.note{\r\n    font-family: Roboto;\r\n    font-size: 16px;\r\n    font-weight: normal;\r\n    font-stretch: normal;\r\n    font-style: normal;\r\n    line-height: 1.63;\r\n    letter-spacing: 0.53px;\r\n    text-align: left;\r\n    color: #232f34;\r\n}\r\n\r\n.Title {\r\n    font-size: 26px;\r\n    text-transform: uppercase;\r\n}\r\n\r\n.mrg {\r\n    padding: 15px;\r\n}\r\n\r\n.Subtitle {\r\n    text-transform: uppercase;\r\n    position: absolute;\r\n    background-color: var(--white2);\r\n    margin: 0;\r\n    font-weight: 500;\r\n}\r\n\r\n.toggle{\r\n    color: #223e92;\r\n    font-size: 18px;\r\n    margin: 16px 0;\r\n}\r\n\r\n.toggle__title{\r\n    font-weight: 600;\r\n    line-height: 1.47;\r\n}\r\n\r\n.tituloDinamico {\r\n    text-transform: uppercase;\r\n    background-color: var(--white2);\r\n    margin: 0;\r\n    font-weight: 500;\r\n}\r\n\r\n.cointainer-white,\r\n.container-grey {\r\n    padding: 0px 9px 30px 9px;\r\n}\r\n\r\n.cointainer-white {\r\n    padding-left: 0px;\r\n}\r\n\r\n.text--grey {\r\n    background: var(--white2) !important;\r\n}\r\n\r\n.alert--width {\r\n    width: 60%;\r\n}\r\n\r\n.remove-fondo {\r\n    background: none;\r\n}\r\n\r\n.margin--rigth {\r\n    padding-right: 9px !important;\r\n}\r\n\r\n.button-margin {\r\n    margin-right: 9px !important;\r\n}\r\n\r\n.checkbox {\r\n    font-size: 16px !important;\r\n    color: var(--third-color) !important;\r\n}\r\n\r\n.agregar {\r\n    margin-left: 41px;\r\n}\r\n\r\n.boton-mas,\r\n.boton-menos {\r\n    width: 56px;\r\n    height: 56px;\r\n    border-radius: 6px;\r\n    box-shadow: 0 4px 5px 0 var(--opacity-15);\r\n    border: none;\r\n    outline: none;\r\n