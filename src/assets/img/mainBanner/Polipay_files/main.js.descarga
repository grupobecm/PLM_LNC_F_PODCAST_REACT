let DetailsInprocessUtmComponent = class DetailsInprocessUtmComponent {
    constructor(dialog, router, serviceClient, storageClient) {
        this.dialog = dialog;
        this.router = router;
        this.serviceClient = serviceClient;
        this.storageClient = storageClient;
        this.cuenta = "";
        this.displayedColumns = ['id', 'nombre_beneficiario', 'monto', 'fecha_creacion', 'status_trans__nombre', 'button'];
        this.listLiquidate = [];
        this.noData = false;
        this.numRegister = 0;
        this.showLoad = false;
        //fechas - boton cancelar
        this.today = new Date();
        this.fechacancelacion = true;
        this.fechaCancel = new Date();
        this.transfersAux = [];
        const navigation = this.router.getCurrentNavigation();
        const state = navigation.extras.state;
        if (!this.storageClient.INFO_CENTERCOST) {
            //console.log("bye");
        }
        else {
            this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
            //console.log(this.dato)
            //console.log(this.dato.persona_cuenta_id);
        }
        if (state == undefined) {
            this.router.navigate(['/usuario/transactions/polipay-third/transfer-status/status-massives-transfer/pending-transactions/pending-massives']);
        }
        this.example = state.example;
        //console.log(this.example);
        this.listTransferSlopes();
        this.detailsTransferSlopes();
