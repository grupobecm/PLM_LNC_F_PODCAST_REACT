        if (this.numeroRegistrosaMostrar < 100) {
            this.noorder = true;
        }
        else if (this.numeroRegistrosaMostrar > 100) {
            this.noorder = false;
        }
    }
    ListTransfer() {
        this.showLoad = true;
        this.pagina_actual = 1;
    }
    next() {
        if (this.next_page != null) {
            this.showLoad = true;
            this.pagina_actual++;
        }
    }
    prev() {
        if (this.prev_page != null) {
            this.showLoad = true;
            this.pagina_actual--;
        }
    }
    inicio() {
        this.ListTransfer();
    }
    fin() {
        this.pagina_actual = Number(this.total_paginas.toFixed());
        this.showLoad = true;
    }
    openDialog() {
        this.dialog.open(_third_transfer_status_filtro_filtro_component__WEBPACK_IMPORTED_MODULE_8__["FiltroComponent"], {
            width: '90%',
            panelClass: 'custom-dialog-container'
        });
    }
    update() {
        ////console.log(this.numeroRegistrosaMostrar);
        if (this.numeroRegistrosaMostrar == 0) {
            this.numeroRegistrosaMostrar = this.total;
        }
        this.ListTransfer();
    }
    detalles(dato) {
        this.dialog.open(_third_transfer_status_details_details_component__WEBPACK_IMPORTED_MODULE_7__["DetailsComponent"], {
            width: '35%',
            data: {
                dato: dato
            },
            panelClass: 'custom-dialog-container',
            disableClose: true,
        });
    }
    AdministrarF(dato) {
        this.storageClient.setInfoFrequentT(dato);
        this.router.navigate(['/usuario/transactions/frequent-accounts/frequent-third/editfrecuentesterceros']);
        //console.log(dato);
    }
    Favorite(element) {
        let dataJSON = {
            "is_favorite": true
        };
        this.showLoad = true;
        this.serviceClient.favoriteFrecuentAccount(this.id, element, dataJSON).subscribe(res => {
            this.showLoad = false;
            //console.log(res);
            this.listPersonal(9999, this.id, null);
        });
    }
    NoFavorite(element) {
        let dataJSON = {
            "is_favorite": false
        };
        this.showLoad = true;
        this.serviceClient.favoriteFrecuentAccount(this.id, element, dataJSON).subscribe(res => {
            this.showLoad = false;
            //console.log(res);
            this.listPersonal(9999, this.id, null);
        });
    }
};
