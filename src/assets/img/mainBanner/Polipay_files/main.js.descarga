IP de Verificación incorrecto, vuelve a intentar.\r\n           </span>\r\n        </div>\r\n\r\n        <div class=\"space-white\" *ngIf=\"!alert\" fxFlex=\"100\" fxLayoutAlign=\"center center\">\r\n\r\n        </div>\r\n\r\n        <button id=\"submit\" class=\"button-verification-code | color-white background-main font-roboto\" type=\"submit\">\r\n            Enviar\r\n        </button>\r\n        <!-- FIN Verification code -->\r\n\r\n        <!-- Verification code dont nip-->\r\n        <div class=\"container__dont-nip dont-nip\" fxFlex=\"100\" fxLayoutAlign=\"center center\">\r\n            <a class=\"dont-nip__text | color-accent\" (click)=\"show()\">\r\n                ¿No recibiste tu NIP de Verificación?\r\n            </a>\r\n        </div>\r\n\r\n        <div *ngIf=\"!notReceived\" class=\"container__resend resend\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n            <button type=\"button\" class=\"resend__button resend__button--mr | background-accent color-white font-roboto\" (click)=\"notReceivedSMS = true; notReceivedEmail = false; notReceivedCall = false; notReceived = false; resendcodeSMS()\">REENVIAR VÍA SMS </button>\r\n            <button type=\"button\" class=\"resend__button resend__button--ml | background-accent color-white font-roboto\" (click)=\"notReceivedSMS = false; notReceivedEmail = true; notReceivedCall = false; notReceived = false; resendEmail()\"> REENVIAR VÍA EMAIL </button>\r\n            <button type=\"button\" class=\"resend__button resend__button--m resend-text--mb resend__button--mr | background-accent color-white font-roboto\" (click)=\"notReceivedSMS = false; notReceivedEmail = false; notReceivedCall = true; notReceived = false; resendcodePhoneCall()\"> RECIBIR LLAMADA </button>\r\n            <button type=\"button\" class=\"resend__button resend__button--m resend-text--mb resend__button--ml | background-accent color-white font-roboto\" (click)=\"notReceivedSMS = false; notReceivedEmail = false; notReceivedCall = false; notReceived = true; openDialog()\"> Cambie mi Móvil </button>\r\n        </div>\r\n\r\n        <!-- Message email -->\r\n        <div *ngIf=\"notReceivedEmail\" class=\"container__resend-text | color-third\">\r\n            Te enviamos un mensaje a tu cuenta de correo electrónico {{ email }}, con un nuevo NIP. Si no pudieras ver el mensaje en tu bandeja de entrada, es probable que este en la bandeja de SPAM.\r\n        </div>\r\n        <!-- Message sms -->\r\n        <div *ngIf=\"notReceivedSMS\" class=\"container__resend-text | color-third\">\r\n            Te enviamos un mensaje texto al número {{ phone }}, con un nuevo NIP.\r\n        </div>\r\n        <!-- Message call -->\r\n        <div *ngIf=\"notReceivedCall\" class=\"container_resend-text container_resend-text--email | color-third\">\r\n            Realizaremos una llamada al número {{ phone }}, por este medio te daremos un nuevo NIP.\r\n        </div>\r\n        <!-- FIN Verification code dont nip-->\r\n\r\n    </form>\r\n    <!-- FIN Form Verification code -->\r\n\r\n</div>\r\n\r\n<app-loading *ngIf=\"showLoad\"></app-loading>");

