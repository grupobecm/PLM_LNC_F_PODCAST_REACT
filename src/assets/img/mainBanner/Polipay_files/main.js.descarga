upo {{ name }}. no se puede eliminar en este<br> momento. </p>\r\n        <p class=\"text | color-third\">Este grupo tiene una dispersión programada.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!--Dispersiones - Beneficiarios dar de alta RFC invalido -->\r\n    <div *ngIf=\"error == 'DBA-000'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Dispersiones - Perfil Externo - Grupos -  respuesta de eliminarpersona de grupo -->\r\n    <div *ngIf=\"error == 'D-002'\" class=\"message\">\r\n        <p class=\"text | color-third\">No se puede eliminar en este momento. </p>\r\n        <p class=\"text | color-third\">El grupo al que pertenece esta persona tiene una dispersión programada.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Dispersiones - - Perfil Externo - Dar de alta personal externo - Error al registrar-->\r\n    <div *ngIf=\"error == 'D-003'\" class=\"message\">\r\n        <p class=\"text | color-third\">Datos incorrectos.</p>\r\n        <br>\r\n        <p *ngFor=\"let item of errores | keyvalue\">- {{ item.value }}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!-- Dispersiones - - Perfil Externo - r-->\r\n    <div *ngIf=\"error == 'PE-001'\" class=\"message\">\r\n        <p class=\"text2 | color-third\">Estimado usuario:</p>\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!-- Dispersiones - Masivas con montos en 0 -->\r\n    <div *ngIf=\"error == 'PE-002'\" class=\"message\">\r\n        <p class=\"text2 | color-third\">Estimado usuario:</p>\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!-- Dispersiones - Movimientos de Tarjetas -->\r\n    <div *ngIf=\"error == 'DM-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">Error.</p>\r\n        <p class=\"text | color-third\">Tarjeta no encontrada en Polipay</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!-- Dispersiones Masivas , montos no llenados -->\r\n    <div *ngIf=\"error == 'D-004'\" class=\"message\">\r\n        <p class=\"text | color-third\">Datos incorrectos.</p>\r\n        <p class=\"text | color-third\">Por favor introduzca el monto a dispersar</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!-- Dispersiones Masivas , montos no llenados -->\r\n    <div *ngIf=\"error == 'D-005'\" class=\"message\">\r\n        <p class=\"text | color-third\">ERROR</p>\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <p class=\"text | color-third\">{{messageNormal2}}</p>\r\n\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Dispersiones Masivas , montos no llenados -->\r\n    <div *ngIf=\"error == 'D-006'\" class=\"message\">\r\n        <p class=\"text | color-third\">ERROR</p>\r\n        <p class=\"text | color-third\">{{ messageNormal }} ( {{ datas }} )</p>\r\n        <p class=\"text | color-third\">Cuenta: {{ datas }} </p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!-- Dispersiones Masivas , montos no llenados -->\r\n    <div *ngIf=\"error == 'D-007'\" class=\"message\">\r\n        <p class=\"text | color-third\">Datos incorrectos.</p>\r\n        <p class=\"text | color-third\">Por favor de llenar todos los campos</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept button-accept--mt | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- EDITAR USUARIO  E-001 -->\r\n\r\n\r\n    <!-- TRANSACCIONES T-001-->\r\n    <!-- Transferencia Individual-->\r\n    <div *ngIf=\"error == 'T-002'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"listTransferIndividual()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <div *ngIf=\"error == 'TM-003'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"listTransferIndividual()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!-- TRANSACCIONES POLIPAY POLIPAY T-001-->\r\n\r\n    <!-- Transferencia Polipay -->\r\n    <div *ngIf=\"error == 'TP-001'\" class=\"message\">\r\n        <p class=\"text | color-red\">{{messageNormal2}}</p>\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"listTransferPtoP()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <div *ngIf=\"error == 'TP-002'\" class=\"message\">\r\n        <p class=\"text | color-red\">Operación Fallida: {{messageNormalId}}</p>\r\n        <p class=\"text | color-third\">Por favor contacta a tu Ejecutivo Polipay</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"listTransferPtoP()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <div *ngIf=\"error == 'TP-003'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"listTransferPtoP()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Transferencia a cuentas propias -->\r\n    <div *ngIf=\"error == 'TOA-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\"\r\n                (click)=\"closeAll()\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- REPORTES  R-001-->\r\n\r\n\r\n    <!-- SALDOS S-001 -->\r\n\r\n    <!-- Asignar saldo error debes asignar minimo una tarjeta-->\r\n    <div *ngIf=\"error == 'S-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">Datos incorrectos.</p>\r\n        <p class=\"text | color-third\">Le debes asignar mínimo una tarjeta<br>a este personal externo.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Tarjeta ya lista para ser asignada -->\r\n    <div *ngIf=\"error == 'S-002'\" class=\"message\">\r\n        <p class=\"text | color-third\"></p>\r\n        <p class=\"text | color-third\">Tarjeta {{ message }} lista para ser asignada.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Error al querer asignar una tarjeta -->\r\n    <div *ngIf=\"error == 'S-003'\" class=\"message\">\r\n        <p class=\"text | color-third\"></p>\r\n        <p class=\"text | color-third\">Error al internar asignar una tarjeta.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- GRUPOS G-001 -->\r\n\r\n    <!-- Error al querer crear grupo sin personas -->\r\n    <div *ngIf=\"error == 'G-001'\" class=\"message\">\r\n        <p class=\"text | color-third\"></p>\r\n        <p class=\"text | color-third\">Para crear el grupo deberás<br>agregar dos personas como mínimo.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Error al querer crear grupo sin personas -->\r\n    <div *ngIf=\"error == 'G-002'\" class=\"message\">\r\n        <p class=\"text | color-third\">Ocurrió un error.</p>\r\n        <p class=\"text | color-third\">{{ message }}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!-- Error al querer editar grupo sin personas -->\r\n    <div *ngIf=\"error == 'G-003'\" class=\"message\">\r\n        <p class=\"text | color-third\"></p>\r\n        <p class=\"text | color-third\">Para guardar los cambios deberás tener<br>agregadas dos personas como mínimo.</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Error a la hora de checar el saldo de una tarjeta -->\r\n    <div *ngIf=\"error == 'CB-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Error Masivo de Alta Beneficiaros -->\r\n    <div *ngIf=\"error == 'AB-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">Correos electronicos ya registrados:</p>\r\n        <p class=\"text | color-third\" *ngFor=\"let men of messageNormal\">{{men}}</p>\r\n        <p class=\"text | color-third\">Favor de quitar correo(s) de la lista</p>\r\n        <div fxLayout=\"row \">\r\n            <button [mat-dialog-close]=\"'Aceptar'\" id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Error Masivo de Alta Beneficiaros -->\r\n    <div *ngIf=\"error == 'AB-002'\" class=\"message\">\r\n        <p class=\"text | color-third\">Tarjeta no encontrada o registrada:</p>\r\n        <p class=\"text | color-third\" *ngFor=\"let men of messageNormal\">{{men | plainCreditCard}}</p>\r\n        <p class=\"text | color-third\">Favor de verificar las tarjetas</p>\r\n        <div fxLayout=\"row \">\r\n            <button [mat-dialog-close]=\"'Aceptar'\" id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n    <!-- TOKEN DINAMICO -->\r\n    <div *ngIf=\"error == 'TD-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Reportes -->\r\n    <div *ngIf=\"error == 'RPT-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{messageNormal}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button [mat-dialog-close]=\"'Aceptar'\" id=\"button\" class=\"button-accept | color-white background-main\"\r\n                type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n</div>");

