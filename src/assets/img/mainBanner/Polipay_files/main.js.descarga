let LeavingPhysicalClientComponent = class LeavingPhysicalClientComponent {
    constructor(router, formBuilder, dialog, service, storage) {
        this.router = router;
        this.formBuilder = formBuilder;
        this.dialog = dialog;
        this.service = service;
        this.storage = storage;
        this.banco = '\u00a0';
        this.flg = true;
        this.auxFlgBanco = 0;
        this.rojobanco = false;
        this.guardar = true;
        this.showLoad = false;
        this.file = "Ningun archivo seleccionado";
        //Varibales que faltan
        this.auxAlert = false;
        this.form = formBuilder.group({
            banco: ['',],
            motivodescription: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_7__["Validators"].required]],
            file_: ['', [_angular_forms__WEBPACK_IMPORTED_MODULE_7__["Validators"].required]],
        });
        this.id = JSON.parse(sessionStorage.getItem("clienteExterno")).id;
        this.idSol = JSON.parse(sessionStorage.getItem("clienteExterno")).idSol;
        this.idUser = JSON.parse(this.storage.infoUserValue).id;
    }
    //CAMPOS EN ROJO
    requeridoBanco() {
        if (this.form.get('banco').errors == null || this.auxFlgBanco == 0) {
            return false;
        }
        else {
            return true;
        }
    }
    requerido(campo) {
        if (this.form.get(campo).errors == null) {
            return false;
        }
        else {
            return true;
        }
    }
    ocultar() {
        document.getElementById("fondo").style.display = 'none';
        document.getElementById("lista").classList.remove("mostrar");
        this.flg = true;
    }
    cancelar() {
        this.form.reset();
        this.banco = '\u00a0';
        this.guardar = true;
        this.auxFlgBanco = 0;
        this.rojobanco = false;
        if (document.getElementById("banco") != null && document.getElementById("flecha") != null) {
            document.getElementById("banco").style.cursor = "pointer";
            document.getElementById("banco").style.background = "#FFFFFF";
            document.getElementById("flecha").style.cursor = "pointer";
            document.getElementById("flecha").style.borderTop = "8px solid black";
        }
        this.form.get('banco').setValue("");
    }
    //PARA BANCO
    mostrar2() {
        if (this.flg) {
            if (this.guardar) {
                document.getElementById("fondo2").style.display = 'block';
                document.getElementById("lista2").classList.add("mostrar2");
                document.getElementById("fondo2").style.zIndex = "13";
                document.getElementById("select1").style.zIndex = "13";
                this.flg = false;
            }
        }
        else {
            this.ocultar2();
        }
    }
    ocultar2() {
        document.getElementById("fondo2").style.display = 'none';
        document.getElementById("lista2").classList.remove("mostrar2");
        this.flg = true;
        if (this.banco == '\u00a0') {
            this.rojobanco = true;
            this.auxFlgBanco = 1;
        }
    }
    actualizar2(value) {
        this.banco = value;
        this.form.get('banco').setValue(this.banco);
        this.auxFlgBanco = 0;
        if (this.rojobanco) {
            this.rojobanco = false;
        }
    }
