ed) }\">Núm.\r\n                                    Tarjeta / Clabe*</span>\r\n                                <input class=\"form__input user | font-roboto\"\r\n                                    [ngClass]=\"{ 'form__input_alert': (requeridoCuenta() && form.get('cuenta').touched) }\"\r\n                                    id=\"tarjeta\" id=\"tarjeta\" autocomplete=\"off\" type=\"text\" name=\"cuenta\"\r\n                                    (keyup)=\"validacion($event);\" (paste)=\"onPaste($event)\"  onKeyPress=\"if(this.value.length==18) return false;\"\r\n                                    formControlName=\"cuenta\" required [(ngModel)]=\"clabeR\">\r\n                                <!-- Alertas -->\r\n                                <div class=\" alertTransfer\" *ngIf=\"requeridoCuenta() && form.get('cuenta').touched\">\r\n                                    <span class=\"alert__text | color-red\"\r\n                                        *ngIf=\"form.get('cuenta').hasError('menorde')\">El número de tarjeta debe tener\r\n                                        16 caracteres</span>\r\n                                    <span class=\"alert__text | color-red\"\r\n                                        *ngIf=\"form.get('cuenta').hasError('required')\">Este campo es requerido</span>\r\n                                    <span class=\"alert__text | color-red\"\r\n                                        *ngIf=\"form.get('cuenta').hasError('mayorde')\">La Clabe interbancaria es de 18\r\n                                        caracteres</span>\r\n                                </div>\r\n\r\n                            </div>\r\n                        </div>\r\n                        <div fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n                            <!-- Email Beneficiario -->\r\n                            <!-- <div class=\"form_space \" fxFlex=\"49\">\r\n                                <span class=\"form__text user | font-ro