let element\"></td>\r\n                    </ng-container>\r\n\r\n                    <!-- Columna Fecha Solicitud -->\r\n                    <ng-container matColumnDef=\"fechaSolicitud\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>Fecha de Solicitud</th>\r\n                        <td mat-cell *matCellDef=\"let element\"></td>\r\n                    </ng-container>\r\n\r\n                    <!-- Columna Fecha Captura -->\r\n                    <ng-container matColumnDef=\"fechaEntrega\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>Fecha de Entrega</th>\r\n                        <td mat-cell *matCellDef=\"let element\"></td>\r\n                    </ng-container>\r\n\r\n                    <!-- Columna Estado -->\r\n                    <ng-container matColumnDef=\"estado\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>Estado</th>\r\n                        <td mat-cell *matCellDef=\"let element\"></td>\r\n                    </ng-container>\r\n\r\n                    <!-- Columna boton cancelar -->\r\n                    <ng-container matColumnDef=\"buttonCancelar\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header></th>\r\n                        <td mat-cell *matCellDef=\"let element\">\r\n                            <div>\r\n                                <button fxFlex=\"90\" class=\"details | background-red color-white\" (click)=\"adminClient(element)\" fxLayoutAlign=\"center center\">\r\n                                    <span>Cancelar</span>\r\n                                </button>\r\n                            </div>\r\n                        </td>\r\n                    </ng-container>\r\n\r\n                    <!-- Columna boton ver detalles -->\r\n                    <ng-container matColumnDef=\"buttonDetalles\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header></th>\r\n 