let CompanyComponent = class CompanyComponent {
    constructor(service, storageClient, storage, serviceBalance, dialog, dataService) {
        this.service = service;
        this.storageClient = storageClient;
        this.storage = storage;
        this.serviceBalance = serviceBalance;
        this.dialog = dialog;
        this.dataService = dataService;
        this.clabe = null;
        this.cuenta = null;
        this.estado = "";
        this.flagT = true;
        this.flagTP = true;
        this.empresas = [];
        this.empresa = [];
        /* Loader spinner */
        this.showLoad = false;
        /* Mostrar y cultar el select */
        this.flg = true;
        this.auxFlgEmpresa = 0;
        this.rojoempresa = false;
    }
    ngOnInit() {
        //  //console.log(JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto);
        if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length >= 3) {
            this.flagT = true;
            this.flagTP = false;
            this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
            if (this.storageClient.InfoCostCenterExist == false) {
                this.getEmpresasS();
            }
            else {
                //Se asignan los valores almacenados en el sessión storage
                this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
                this.cuenta = this.dato.cuenta;
                this.clabe = this.dato.cuentaclave;
                this.idCenterCost = this.dato.persona_cuenta_id;
                //Funcion que consume el servicio para que me regresa el monto del centro de costos
                this.serviceBalance.checkBalanceAmount(this.idCenterCost).subscribe(res => {
                    //  //console.log( this.idCenterCost, '1');
                    this.sendNewData(res.monto);
                });
                //
                //----Funcione que hace que el servicio se consuma cada 30 seg 
                setInterval(() => {
                    this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
                    this.idCenterCost = this.dato.persona_cuenta_id;
                    this.serviceBalance.checkBalanceAmount(this.idCenterCost).subscribe(res => {
                        // //console.log(res);
                        this.sendNewData(res.monto);
                    });
                }, 5000);
                //-------------
                this.getEmpresas();
            }
            // this.empresa = this.dato.persona_cuenta__name;
        }
        else {
            if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    this.flagTP = true;
                    this.flagT = false;
                    this.dato = JSON.parse(this.storage.infoUserValue);
                    // //console.log(this.dato);
                    this.nombreCompany = this.dato.data_empresa.cuenta_eje.name;
                    this.cuenta = this.dato.data_empresa.cuenta.cuenta;
                    // //console.log(this.cuenta);
                    this.clabe = this.dato.data_empresa.cuenta.cuentaclabe;
                    let id = this.dato.cuenta_id;
                    this.serviceBalance.checkBalanceAmount(id).subscribe(res => {
                        //console.log(id, '3');
                        //  //console.log(res);
                        this.sendNewData(res.monto);
                    });
                    setInterval(() => {
                        // //console.log(this.id);
                        let id = this.dato.cuenta_id;
                        this.serviceBalance.checkBalanceAmount(id).subscribe(res => {
                            //console.log(id, '4');
                            // //console.log(res);
                            this.sendNewData(res.monto);
                        });
                    }, 30000);
                }
                else {
                    if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        if (this.storageClient.InfoCostCenterExist == false) {
                            //  //console.log("bye");
                            this.flagTP = true;
                            this.flagT = false;
                            this.dato = JSON.parse(this.storage.infoUserValue);
                            this.nombreCompany = this.dato.data_empresa.cuenta_eje.name;
                            //Aqui va el dialog para llevar a crear centros de costos
                            this.dialog.open(_messageUser_warning_user_warning_user_component__WEBPACK_IMPORTED_MODULE_12__["WarningUserComponent"], {
                                width: '544px',
                                data: {
                                    warning: 'cCC-001',
                                },
                                panelClass: ['custom-dialog-container', 'details'],
                                disableClose: true,
                            });
                        }
                        else {
                            // //console.log("si hay servicios ");
                            this.flagTP = false;
                            this.flagT = true;
                            this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
                            //  //console.log(this.dato)
                            //  //console.log(this.dato.persona_cuenta_id);
                            this.empresa = this.dato.persona_cuenta__name;
                            this.cuenta = this.dato.cuenta;
                            this.clabe = this.dato.cuentaclave;
                            let id = this.dato.persona_cuenta_id;
                            this.serviceBalance.checkBalanceAmount(id).subscribe(res => {
                                // //console.log(res);
                                //this.saldoDisponible = res.monto;
                                this.sendNewData(res.monto);
                            });
                            this.getEmpresas();
                            this.selectCompany.ngOnInit();
                            setInterval(() => {
                                // //console.log(this.id);
                                this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
                                this.idCenterCost = this.dato.persona_cuenta_id;
                                this.serviceBalance.checkBalanceAmount(this.idCenterCost).subscribe(res => {
                                    // //console.log(res);
                                    this.sendNewData(res.monto);
                                });
                            }, 30000);
                        }
                    }
                }
            }
        }
    }
    sendNewData(data) {
        this.dataService.sendData(data);
    }
    //Obtiene los centros de costos del usuario/
    getEmpresas() {
        let user_type = JSON.parse(this.storage.infoUserValue).user_type;
        // //console.log( user_type);
        if (user_type == 8) {
            let datoEmpresa = JSON.parse(this.storage.infoUserValue).data_empresa.centro_costos;
            // //console.log(datoEmpresa)
            // this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
            this.empresa = this.dato.persona_cuenta__name;
            for (let i = 0; i < datoEmpresa.length; i++) {
                const element = datoEmpresa[i];
                this.empresas[i] = element;
            }
        }
        else {
            // //console.log('Administrativo');
            this.showLoad = true;
            this.service.activeCostCenter(this.id).subscribe(res => {
                this.showLoad = false;
                this.empresas = res;
                if (res.length == 0) {
                    this.flagT = false;
                    this.flagTP = true;
                    this.dato = JSON.parse(this.storage.infoUserValue);
                    this.nombreCompany = this.dato.data_empresa.cuenta_eje.name;
                    this.dialog.open(_messageUser_warning_user_warning_user_component__WEBPACK_IMPORTED_MODULE_12__["WarningUserComponent"], {
                        width: '544px',
                        data: {
                            warning: 'cCC-001',
                        },
                        panelClass: ['custom-dialog-container', 'details'],
                        disableClose: true,
                    });
                }
                else {
                    this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
                    this.empresa = this.dato.persona_cuenta__name;
                    this.cuenta = this.dato.cuenta;
                    this.clabe = this.dato.cuentaclave;
                    this.sendNewData(this.dato.monto);
                    this.id = this.dato.persona_cuenta_id;
                    this.storageClient.setInfoCostCenter(this.dato);
                    this.selectCompany.ngOnInit();
                }
            });
        }
    }
    getEmpresasS() {
        let user_type = JSON.parse(this.storage.infoUserValue).user_type;
        //console.log( user_type);
        if (user_type == 8) {
            let datoEmpresa = JSON.parse(this.storage.infoUserValue).data_empresa.centro_costos;
            for (let i = 0; i < datoEmpresa.length; i++) {
                const element = datoEmpresa[i];
                this.empresas[i] = element;
            }
            //console.log(datoEmpresa);
            this.empresa = datoEmpresa[0].persona_cuenta__name;
            this.cuenta = datoEmpresa[0].cuenta;
            this.clabe = datoEmpresa[0].cuentaclave;
            this.sendNewData(datoEmpresa[0].monto);
            this.id = datoEmpresa[0].persona_cuenta_id;
            this.storageClient.setInfoCostCenter(datoEmpresa[0]);
            this.selectCompany.ngOnInit();
        }
        else {
            // //console.log('Administrativo');
            this.showLoad = true;
            this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
            this.service.activeCostCenter(this.id).subscribe(res => {
                this.showLoad = false;
                this.empresas = res;
                if (res.length == 0) {
                    this.flagT = false;
                    this.flagTP = true;
                    this.dato = JSON.parse(this.storage.infoUserValue);
                    this.nombreCompany = this.dato.data_empresa.cuenta_eje.name;
                    this.dialog.open(_messageUser_warning_user_warning_user_component__WEBPACK_IMPORTED_MODULE_12__["WarningUserComponent"], {
                        width: '544px',
                        data: {
                            warning: 'cCC-001',
                        },
                        panelClass: ['custom-dialog-container', 'details'],
                        disableClose: true,
                    });
                }
                else {
                    this.empresa = res[0].persona_cuenta__name;
                    this.cuenta = res[0].cuenta;
                    this.clabe = res[0].cuentaclave;
                    this.sendNewData(res[0].monto);
                    this.id = res[0].persona_cuenta_id;
                    this.storageClient.setInfoCostCenter(res[0]);
                    this.selectCompany.ngOnInit();
                }
            });
        }
    }
    /* Mostrar y ocultar select */
    mostrar() {
        if (this.flg) {
            document.getElementById("fondo-aux").style.display = 'block';
            document.getElementById("lista").classList.add("mostrar");
            this.flg = false;
        }
        else {
            this.ocultar();
        }
    }
    ocultar() {
        document.getElementById("fondo-aux").style.display = 'none';
        document.getElementById("lista").classList.remove("mostrar");
        this.flg = true;
        if (this.empresa == this.dato) {
            this.rojoempresa = true;
            this.auxFlgEmpresa = 1;
        }
    }
    actualizar(value) {
        sessionStorage.removeItem('center_cost');
        //console.log('datoEmpe',value);
        this.empresa = value.persona_cuenta__name;
        this.cuenta = value.cuenta;
        this.clabe = value.cuentaclave;
        this.sendNewData(value.monto);
        this.id = value.persona_cuenta_id;
        // //console.log(this.empresa);
        // //console.log(value.persona_cuenta_id);
        this.showLoad = true;
        this.storageClient.setInfoCostCenter(value);
        this.selectCompany.ngOnInit();
        //Función para recargar la pagina
        // //console.log('entra función de recargar');
        this.logout();
        this.auxFlgEmpresa = 0;
        if (this.rojoempresa) {
            this.rojoempresa = false;
        }
        /* Muestra el nombre de la empresa en el select como seleccionado */
        //this.empresa = empresa.nombre;
        //this.getMontos2(empresa.id, empresa.monto);
        //this.getMontoRecibidas(empresa.id);
        this.ocultar();
    }
    logout() {
        // location.reload();
        this.showLoad = false;
    }
};
