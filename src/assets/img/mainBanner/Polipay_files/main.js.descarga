        this.paso1 = true;
        this.paso2 = false;
    }
    pasarPaso2() {
        if (!this.form.get('nombre_grupo').hasError('required')) {
            this.paso1 = false;
            this.paso2 = true;
        }
        else {
            document.getElementById('nombre_grupo').focus();
            document.getElementById('siguiente').focus();
        }
    }
    detailsPersonalStaff() {
        this.showLoad = true;
        this.service.detailsExternalStaff(JSON.parse(this.storageHome.infoUserValue).cuenta_id, this.dato.person_id).subscribe(res => {
            this.showLoad = false;
            this.personal = res[0];
