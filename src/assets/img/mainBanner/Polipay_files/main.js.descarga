let ReturnedTComponent = class ReturnedTComponent {
    constructor(dialog, serviceClient, storageClient) {
        this.dialog = dialog;
        this.serviceClient = serviceClient;
        this.storageClient = storageClient;
        this.displayedColumns = ['id', 'nombre_beneficiario', 'monto', 'fecha_creacion', 'button'];
        this.listLiquidate = [];
        this.showLoad = false;
        this.noData = false;
        this.numRegister = 0;
        this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
        this.idCenterC = this.dato.persona_cuenta_id;
        this.showLoad = true;
        //console.log("Devueltas");
        this.listTransferReturned();
    }
    listTransferReturned(size = 9999, id = this.idCenterC, state = 7, beneficiario = null, date1 = null, date2 = null) {
        this.showLoad = true;
        this.serviceClient.TransferDetailsIndividual(size, id, state, beneficiario, date1, date2).subscribe(res => {
            this.listLiquidate = new _angular_material_table__WEBPACK_IMPORTED_MODULE_10__["MatTableDataSource"](res.results);
            //console.log(res)
            this.showLoad = false;
            this.listLiquidate.sort = this.sort;
            this.listLiquidate.paginator = this.paginator;
            this.paginator._intl.itemsPerPageLabel = 'Filas por página';
            this.listLiquidate.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listLiquidate.data.length;
        }, error => {
            //console.log(error);
        });
    }
    openFilter() {
        let filtro = this.dialog.open(_filtro_returned_ut_filtro_returned_ut_component__WEBPACK_IMPORTED_MODULE_14__["FiltroReturnedUTComponent"], {
            width: "90%",
            panelClass: "custom-dialog-container"
        });
        filtro.afterClosed().subscribe(res => {
            let benefy = null;
            let date1 = null;
            let date2 = null;
            //console.log(res);
            if (res == undefined) {
            }
            else {
                if (res != 'Reset filtro') {
                    for (let i = 0; i < res.data.filtro.length; i++) {
                        switch (res.data.filtro[i].campo) {
                            case 'Fecha de Operación':
                                date1 = (res.data.filtro[i].valor.begin).toISOString().split("T")[0];
                                date2 = (res.data.filtro[i].valor.end).toISOString().split("T")[0];
                                break;
                            case 'Beneficiario':
                                benefy = res.data.filtro[i].valor;
                                break;
                        }
                    }
                }
            }
            let size = 9999;
            let id = this.idCenterC;
            let state = 7;
            date1 = date1;
            date2 = date2;
            benefy = benefy;
            this.listTransferReturned(size, id, state, benefy, date1, date2);
        });
    }
    seeDetails(element) {
        // //console.log(element);
        this.dialog.open(_details_returned_ut_details_returned_ut_component__WEBPACK_IMPORTED_MODULE_13__["DetailsReturnedUTComponent"], {
            width: "650px",
            data: {
                dato: element,
                type: 'L'
            },
            panelClass: ['custom-dialog-container'],
            disableClose: true
        });
    } // });
    exportarXlsx(id = this.idCenterC, idtype = 2, name = null, clabe = null, nameBenefy = null, date1 = null, date2 = null, status = 7) {
        this.showLoad = true;
        this.serviceClient.exportXlsx(id, idtype, name, clabe, nameBenefy, date1, date2, status, null).subscribe(res => {
            //console.log(res.detail[0].data);
            window.open(res.detail[0].data, "_blank");
            this.showLoad = false;
        }, error => {
            //console.log(error);
        });
    }
};
