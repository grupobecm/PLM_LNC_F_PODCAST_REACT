on\" class=\"button-accept | color-white background-main font-roboto\" type=\"submit\">ACEPTAR</button>\r\n    <button *ngIf=\"message == 1\" (click)=\"redireccionar2()\" id=\"button\" class=\"button-accept | color-white background-main font-roboto\" type=\"submit\">ACEPTAR</button>\r\n    <button *ngIf=\"message == 2\" (click)=\"redireccionar2()\" id=\"button\" class=\"button-accept | color-white background-main font-roboto\" type=\"submit\">ACEPTAR</button>\r\n    <button *ngIf=\"message == 3\" (click)=\"deskopt()\" id=\"button\" class=\"button-accept | color-white background-main font-roboto\" type=\"button\">ACEPTAR</button>\r\n    <button *ngIf=\"message == 4\" (click)=\"redireccionar2()\" id=\"button\" class=\"button-accept | color-white background-main font-roboto\" type=\"submit\">ACEPTAR</button>\r\n    <button *ngIf=\"message == 5\" (click)=\"redifrequent()\" id=\"button\" class=\"button-accept | color-white background-main font-roboto\" type=\"button\">ACEPTAR</button>\r\n    <button *ngIf=\"message == 6\" (click)=\"redifrequent()\" id=\"button\" class=\"button-accept | color-white background-main font-roboto\" type=\"button\">ACEPTAR</button>\r\n\r\n\r\n</div>\r\n");

