\">\r\n        </div>\r\n        <div class=\"form_space form_space--mt margin--rigth\" fxFlex=\"45\" fxLayout=\"row wrap\" fxLayoutAlign=\"start space-between\">\r\n            <span fxFlex=\"100\" class=\"form__text form__text--ml | font-roboto\" [ngClass]=\"{ 'form__text_alert': error }\" translate>Comprobante de Domicilio*</span>\r\n            <div fxFlex=\"100\" fxLayoutAlign=\"start space-between\">\r\n                <div class=\"boton-texto\" fxFlex=\"100\" fxLayout=\"row\">\r\n                    <input class=\"boton__input\" name=\"file\" formControlName=\"file\" id=\"file\" style=\"display: none\" type=\"file\" (change)=\"fileChange($event)\" #hiddenfileinput accept=\".pdf\">\r\n                    <button type=\"button\" class=\"cargar__button | color-white\" [ngClass]=\"{'boton--alert': error }\" routerLinkActive=\"active\" (click)=\"hiddenfileinput.click()\">\r\n                          <img class=\"mr-2\" src=\"../../../../../../assets/img/icons/cargarBlanco.svg\">\r\n                          <b>Cargar Archivo</b></button>\r\n                    <div fxFlex=\"70\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                        <span fxFlex=\"100\" class=\"color-third mt-4 ml-3\">{{ file }}</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n            <div fxFlex=\"100\" class=\" alertTransfer\" *ngIf=\"error\" fxLayoutAlign=\"center center\">\r\n                <span class=\"alert__text | color-red\">Por favor carga tu Comprobante de Domicilio</span>\r\n            </div>\r\n            <div fxFlex=\"100\" class=\" alertTransfer\" *ngIf=\"!error\" fxLayoutAlign=\"center center\">\r\n                <span class=\"alert__text | \">&nbsp;<br>&nbsp;</span>\r\n            </div>\r\n        </div>\r\n\r\n\r\n        <div fxFlex=\"100\" class=\"form-button\" fxLayoutAlign=\"end end\">\r\n            <button type=\"submit\" id=\"boton\" class=\"confirmar__button confirmar__button--margin | color-white\"><b