let ReturnCostCentersComponent = class ReturnCostCentersComponent {
    constructor(formBuilder, service, dialog, router) {
        this.formBuilder = formBuilder;
        this.service = service;
        this.dialog = dialog;
        this.router = router;
        this.showLoad = false;
        //banderas
        this.paso1 = true;
        this.paso2 = false;
        //banderas doccumentos - info centros de costos
        this.document1 = true;
        this.document2 = false;
        this.bancos = "\u00a0";
        this.flg1 = true;
        this.guardar1 = true;
        this.fileF1 = "Ningun archivo seleccionado";
        this.fileF2 = "Ningun archivo seleccionado";
        this.fileF3 = "Ningun archivo seleccionado";
        this.showLoad = true;
        //console.log('cenCost', JSON.parse(sessionStorage.getItem("cenCost")));
        if (JSON.parse(sessionStorage.getItem("cenCost")).dato_json) {
            this.id = JSON.parse(sessionStorage.getItem("cenCost")).id;
            if (JSON.parse(sessionStorage.getItem("cenCost")).dato_json.CostCenterId) {
                this.cenCostId = JSON.parse(sessionStorage.getItem("cenCost")).dato_json.CostCenterId;
            }
            else {
                this.cenCostId = JSON.parse(sessionStorage.getItem("cenCost")).dato_json.cost_center_id;
            }
