\" fxLayoutAlign=\"center center\">\r\n                                            <span class=\"select_text\">\r\n                                            Fecha de Dispersión \r\n                                        </span>\r\n                                        </li>\r\n                                    </ul>\r\n\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n\r\n                        <input class=\"input valor first\" fxFlex=\"100\" type=\"text\" formControlName=\"valor\" disabled>\r\n\r\n                        <mat-form-field class=\"valor disabled\">\r\n                            <input matInput class=\"date alert\" [satDatepicker]=\"picker6\" autocomplete=\"off\" name=\"date\" id=\"date\" formControlName=\"valor\" readonly [max]=\"datenow\">\r\n                            <sat-datepicker #picker6 [rangeMode]=\"true\" [selectFirstDateOnClose]=\"true\" [rangeHoverEffect]=\"true\">\r\n                            </sat-datepicker>\r\n                            <sat-datepicker-toggle matSuffix [for]=\"picker6\"></sat-datepicker-toggle>\r\n                        </mat-form-field>\r\n\r\n\r\n\r\n                        <div class=\"agregar\" fxFlex=\"15\" fxLayout=\"row\" fxLayoutAlign=\"start start\">\r\n                            <button *ngIf=\"aparecer(i)\" type=\"button\" class=\"boton-mas | background-main color-white\" (click)=\"addOption()\"><img src=\"../../../../assets/img/icons/mas.svg\" alt=\"Agregar campo para filtro\"></button>\r\n\r\n                            <button *ngIf=\"i > 0\" type=\"button\" class=\"boton-menos | background-grey-dark color-white\" (click)=\"removeOption(i)\"><img src=\"../../../../assets/img/icons/menos.svg\" alt=\"Eliminar campo para filtro\"></button>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n\r\n            <div class=\"contenedor-botones padding--botones\" fxFlex=\"100\" fxLayout=\"row\" fxLayoutAlign=\"end center\">\r\n                <button type=\"button\" class=\"cancelar__button\" (click)=\"cerrar()\"><b>Cancelar</b></button>\r\n                <button class=\"confirmar__button | color-white\" type=\"submit\" [disabled]=\"!form.valid\"><b>Aceptar</b></button>\r\n            </div>\r\n\r\n        </form>\r\n\r\n    </div>\r\n</div>\r\n<!-- Loading -->\r\n<!-- <app-loading *ngIf=\"showLoad\"></app-loading> -->");

