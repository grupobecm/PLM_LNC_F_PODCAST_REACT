let AuthGuardsService = class AuthGuardsService {
    constructor(storage, router) {
        this.storage = storage;
        this.router = router;
    }
    canActivate(route) {
        if (!this.storage.tokenSessionExist) {
            this.router.navigate(["/"]);
            return false;
        }
        return true;
    }
    canActivateChild() {
        if (!this.storage.tokenSessionExist) {
            return false;
        }
        return true;
    }
};
