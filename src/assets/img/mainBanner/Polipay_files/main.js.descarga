cial</span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"form_space form--password-mt\" fxFlex=\"30\">\r\n                                <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoRFC() && form.get('RFC').touched) }\" translate>R.F.C.*</span>\r\n                                <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoRFC() && form.get('RFC').touched) }\" autocomplete=\"off\" type=\"text\" name=\"rfc\" id=\"rfc\" formControlName=\"RFC\" [(ngModel)]=\"RFCE\" required>\r\n                                <div class=\" alertTransfer\" *ngIf=\"requeridoRFC() && form.get('RFC').touched \">\r\n                                    <span class=\"alert__text | color-red\" translate> Por favor captura el RFC</span>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                            <div class=\"form_space  form--password-mt\" fxFlex=\"40\">\r\n                                <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoGiro() && form.get('giro').touched) }\" translate>Giro*</span>\r\n                                <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoGiro() && form.get('giro').touched) }\" autocomplete=\"off\" type=\"text\" name=\"giro\" id=\"giro\" formControlName=\"giro\" [(ngModel)]=\"GiroE\" required>\r\n                                <div class=\" alertTransfer\" *ngIf=\"requeridoGiro() && form.get('giro').touched \">\r\n                                    <span class=\"alert__text | color-red\" translate> Por favor captura el Giro</span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"form_space form--password-mt\" fxFlex=\"30\">\r\n                                <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoPais() && form.get('pais').touched) }\" translate>*País*</span>\r\n                                <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoPais() && form.get('pais').touched) }\" autocomplete=\"off\" type=\"text\" name=\"pais\" id=\"pais\" formControlName=\"pais\" [(ngModel)]=\"PaisE\" required>\r\n                                <div class=\" alertTransfer\" *ngIf=\"requeridoPais() && form.get('pais').touched \">\r\n                                    <span class=\"alert__text | color-red\" translate> Por favor captura el País</span>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"form_space form--password-mt\" fxFlex=\"30\" fxLayout=\"row wrap\">\r\n                                <div class=\"fecha\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                                    <p class=\"form__date label_fecha pass | font-roboto\" [ngClass]=\"{ 'form__date_alert': (requeridoDate() && form.get('date_constitucion').touched) }\" translate>Fecha de Constitución*</p>\r\n                                    <mat-form-field class=\"valor campo_fecha disabled\" [ngClass]=\"{ 'mat-form-field_alert': (requeridoDate() && form.get('date_constitucion').touched) }\" fxFlex=\"100\">\r\n                                        <input matInput class=\"date\" [satDatepicker]=\"picker8\" autocomplete=\"off\" name=\"date_constitucion\" id=\"date_constitucion\" formControlName=\"date_constitucion\" readonly [max]=\"datenow\" required>\r\n                                        <sat-datepicker #picker8 [rangeMode]=\"false\" [selectFirstDateOnClose]=\"true\" [rangeHoverEffect]=\"false\">\r\n                                        </sat-datepicker>\r\n                                        <sat-datepicker-toggle matSuffix [for]=\"picker8\"></sat-datepicker-toggle>\r\n                                    </mat-form-field>\r\n                                </div>\r\n                                <div class=\" alertTransfer fecha_const_alert\" *ngIf=\"requeridoDate() && form.get('date_constitucion').touched \">\r\n                                    <span class=\"alert__text | color-red\" translate> Por favor captura la Fecha de Constitución</span>\r\n                                </div>\r\n                            </div>\r\n\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div class=\"container-grey background-white2\" fxFlex=\"30\" fxLayout=\"column\">\r\n                    <div class=\"mt-3\" fxFlex=\"100\">\r\n                        <p class=\"mensajeObl Subtitle | color-accent\" translate>Datos Transferencia Final</p>\r\n                    </div>\r\n                    <div class=\"background-white2 marginTop--15 | \" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                        <div class=\"form  form--password-mt \" fxFlex=\"100\">\r\n                            <span class=\"form__text  pass text--grey | background-white2\" [ngClass]=\"{ 'form__text_alert': (requeridoclabe() && form.get('clabe').touched) }\" translate>Clabe Interbancaria*</span>\r\n                            <input class=\"form__input password | background-white2\" [ngClass]=\"{ 'form__input_alert': (requeridoclabe() && form.get('clabe').touched) }\" autocomplete=\"off\" type=\"text\" name=\"clabe\" id=\"clabe\" formControlName=\"clabe\" [(ngModel)]=\"ClabeE\" required>\r\n                            <div class=\" alertTransfer\" *ngIf=\"requeridoclabe() && form.get('clabe').touched \">\r\n                                <span class=\"alert__text alert--width | color-red\" translate>Por favor captura tu clabe interbancaria STP</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form  form--password-mt margin--left2 margin--rigth2\" fxFlex=\"100\">\r\n                            <div class=\"form\">\r\n                                <div class=\"fondo-cerrar-select\" id=\"fondo2\" (click)=\"ocultar2()\"></div>\r\n                                <div class=\"select-container \" id=\"select1\" fxFlex=\"100\">\r\n                                    <span class=\"form__text user  | background-white2\" [ngClass]=\"{ 'form__text_alert': requeridoBanco() || rojobanco }\">Banco*</span>\r\n                                    <div class=\"form__input select |  \" [ngClass]=\"{ 'form__input_alert': requeridoBanco() || rojobanco }\" id=\"banco_clabe\" type=\"text\" name=\"frecuent\" (click)=\"mostrar2()\">\r\n                                        {{ banco }}\r\n                                        <div class=\"flecha\" id=\"flecha\" [ngClass]=\"{ 'flecha--alert': requeridoBanco() || rojobanco }\"></div>\r\n                                        <ul class=\"ul-select all zIndex-10 maxAlturaYScroll elscroll\" id=\"lista2\">\r\n                                            <li *ngFor=\"let banco of Bancos\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\" (click)=\"actualizar2(banco)\">\r\n                                                <span class=\"texto__select\" fxFlex=\"95\">{{banco.institucion}}</span>\r\n                                            </li>\r\n                                        </ul>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\"alertTransfer\" *ngIf=\"requeridoBanco()\">\r\n                                <span class=\"alert__text | color-red\">Por favor escoge un banco</span>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n                <div class=\"mt-2\" fxFlex=\"100\">\r\n                    <p class=\"Subtitle color-accent remove-fondo\" translate>Domicilio Fiscal</p>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div class=\"form_space  form--password-mt\" fxFlex=\"20\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoCP() && form.get('CP').touched) }\" translate>Código Postal*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoCP() && form.get('CP').touched) }\" autocomplete=\"off\" type=\"text\" (keyup)=\"buscar($event);\" name=\"cp\" id=\"cp\" formControlName=\"CP\" [(ngModel)]=\"CPE\" required>\r\n                        <div class=\" alertTransfer\" *ngIf=\"requeridoCP() && form.get('CP').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el Código Postal</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space  form--password-mt\" fxFlex=\"30\" *ngIf=\"!flagColonia1\">\r\n                        <div class=\"fondo-cerrar-select \" id=\"fondoColonia1\" (click)=\"ocultarColonia1()\"></div>\r\n                        <div class=\"select-container \" id=\"selectColonia1\">\r\n                            <span class=\"form__text user\" [ngClass]=\"{ 'form__text_alert': requeridoColoniaSelect1() || rojoColonia1 }\">Colonia*</span>\r\n                            <div class=\"form__input select | font-roboto \" [ngClass]=\"{ 'form__input_alert': requeridoColoniaSelect1() || rojoColonia1 }\" id=\"colo\" type=\"text\" name=\"frecuent\" (click)=\"mostrarColonia1()\">\r\n                                {{ colonia }}\r\n                                <div class=\"flecha\" id=\"flecha\" [ngClass]=\"{ 'flecha--alert': requeridoColoniaSelect1() || rojoColonia1 }\"></div>\r\n                                <ul class=\"ul-select all zIndex-10 maxAlturaYScroll elscroll\" id=\"listaColonia1\">\r\n\r\n                                    <li *ngIf=\"colonias.length == 0\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                                        <span class=\"texto__select\" fxFlex=\"95\">No se encontrarón direcciones</span>\r\n                                    </li>\r\n\r\n                                    <li *ngFor=\"let col of colonias\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\" (click)=\"actualizarColonia1(col)\">\r\n                                        <span class=\"texto__select\" fxFlex=\"95\">{{col}}</span>\r\n                                    </li>\r\n                                </ul>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"alertTransfer\" *ngIf=\"requeridoColoniaSelect1()\">\r\n                            <span class=\"alert__text | color-red\">Por favor ingresa la Colonia</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form__space  form--password-mt margin--rigth\" fxFlex=\"30\" *ngIf=\"flagColonia1\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoColoniaSelect1() && form.get('colonia').touched) }\" translate>Colonia*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoColoniaSelect1() && form.get('colonia').touched) }\" autocomplete=\"off\" type=\"text\" name=\"colonia\" id=\"colonia\" formControlName=\"colonia\" required>\r\n\r\n                        <div class=\" alertTransfer\" *ngIf=\"requeridoColoniaSelect1() && form.get('colonia').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura la colonia</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space form--password-mt\" fxFlex=\"30\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoAlcaldia() && form.get('alcaldia').touched) }\" translate>Municipio/Alcaldía*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoAlcaldia() && form.get('alcaldia').touched) }\" autocomplete=\"off\" type=\"text\" name=\"alcaldia\" id=\"alcaldia\" formControlName=\"alcaldia\" [(ngModel)]=\"AlcaldiaE\"\r\n                            required>\r\n\r\n                        <div class=\" alertTransfer\" *ngIf=\"requeridoAlcaldia() && form.get('alcaldia').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el Municipio/Alcaldía</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space  form--password-mt margin--rigth\" fxFlex=\"20\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoEstado() && form.get('estado').touched) }\" translate>Estado*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoEstado() && form.get('estado').touched) }\" autocomplete=\"off\" type=\"text\" name=\"Estado\" id=\"Estado\" formControlName=\"estado\" [(ngModel)]=\"EstadoE\" required>\r\n                        <div class=\" alertTransfer\" *ngIf=\"requeridoEstado() && form.get('estado').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el Estado</span>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div class=\"form_space  form--password-mt\" fxFlex=\"60\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoCalle() && form.get('calle').touched) }\" translate>Calle*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoCalle() && form.get('calle').touched) }\" autocomplete=\"off\" type=\"text\" name=\"Calle\" id=\"Calle\" formControlName=\"calle\" [(ngModel)]=\"CalleE\" required>\r\n                        <div class=\" alertTransfer\" *ngIf=\"requeridoCalle() && form.get('calle').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura la Calle</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space form--password-mt\" fxFlex=\"20\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridonoExterior() && form.get('noExterior').touched) }\" translate>No. Exterior*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridonoExterior() && form.get('noExterior').touched) }\" autocomplete=\"off\" type=\"text\" name=\"noexterior\" id=\"noexterior\" formControlName=\"noExterior\" [(ngModel)]=\"noExteriorE\"\r\n                            required>\r\n                        <div class=\" alertTransfer\" *ngIf=\"requeridonoExterior() && form.get('noExterior').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el Número Exterior</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space form--password-mt margin--rigth\" fxFlex=\"20\">\r\n                        <span class=\"form__text  pass | font-roboto\" translate>No. Interior</span>\r\n                        <input class=\"form__input password | font-roboto\" autocomplete=\"off\" type=\"text\" name=\"noInterior\" id=\"noInterior\" formControlName=\"noInterior\" [(ngModel)]=\"noInteriorE\">\r\n\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"mt-4\" fxFlex=\"100\">\r\n                    <button class=\"confirmar__button button-margin | color-white\" id=\"submit1\" type=\"button\" (click)=\"alPaso2()\" translate>Continuar</button>\r\n                </div>\r\n            </div>\r\n\r\n            <div *ngIf=\"paso2\" fxLayout=\"row wrap\">\r\n                <div class=\"\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div class=\"mt-3\" fxFlex=\"100\">\r\n                        <p class=\"mensajeObl\" translate>User.Messages.RequiredFields</p>\r\n                    </div>\r\n                    <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                        <div class=\"form_space  form--password-mt\" fxFlex=\"30\">\r\n                            <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoNombreLegal() && form.get('nombre').touched) }\" translate>Nombre(s)*</span>\r\n                            <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoNombreLegal() && form.get('nombre').touched) }\" autocomplete=\"off\" type=\"text\" name=\"nombre\" id=\"nombre\" formControlName=\"nombre\" [(ngModel)]=\"nombreModel\" required>\r\n                            <div class=\" alertTransfer\" *ngIf=\"requeridoNombreLegal() && form.get('nombre').touched \">\r\n                                <span class=\"alert__text | color-red\" translate> Por favor captura el nombre del Representante Legal</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form_space form--password-mt\" fxFlex=\"20\">\r\n                            <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoApellidoP() && form.get('apellidoP').touched) }\" translate>Apellido Paterno*</span>\r\n                            <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoApellidoP() && form.get('apellidoP').touched) }\" autocomplete=\"off\" type=\"text\" name=\"apellidoP\" id=\"apellidoP\" formControlName=\"apellidoP\" [(ngModel)]=\"apellidoPModel\"\r\n                                required>\r\n                            <div class=\" alertTransfer\" *ngIf=\"requeridoApellidoP() && form.get('apellidoP').touched \">\r\n                                <span class=\"alert__text | color-red\" translate> Por favor captura el apellido paterno del Representante Legal</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form_space form--password-mt\" fxFlex=\"20\">\r\n                            <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoApellidoM() && form.get('apellidoM').touched) }\" translate>Apellido Materno*</span>\r\n                            <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoApellidoM() && form.get('apellidoM').touched) }\" autocomplete=\"off\" type=\"text\" name=\"apellidoM\" id=\"apellidoM\" formControlName=\"apellidoM\" [(ngModel)]=\"apellidoMModel\"\r\n                                required>\r\n                            <div class=\" alertTransfer\" *ngIf=\"requeridoApellidoM() && form.get('apellidoM').touched \">\r\n                                <span class=\"alert__text | color-red\" translate> Por favor captura el apellido materno del Representante Legal</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form_space form--password-mt\" fxFlex=\"30\" fxLayout=\"row wrap\">\r\n                            <div class=\"fecha\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                                <p class=\"form__date label_fecha pass | font-roboto\" [ngClass]=\"{ 'form__date_alert': (form.get('fechanacimientoR').hasError('requerido') && form.get('fechanacimientoR').touched)  || form.get('fechanacimientoR').hasError('menorEdad')}\" translate>Fecha de Nacimiento*</p>\r\n                                <mat-form-field class=\"valor campo_fecha disabled\" [ngClass]=\"{ 'mat-form-field_alert': (form.get('fechanacimientoR').hasError('requerido') && form.get('fechanacimientoR').touched) || form.get('fechanacimientoR').hasError('menorEdad')}\" fxFlex=\"100\">\r\n                                    <input matInput class=\"date\" [satDatepicker]=\"picker6\" autocomplete=\"off\" name=\"fechanacimientoR\" id=\"fechanacimientoR\" formControlName=\"fechanacimientoR\" readonly [max]=\"datenow\" required>\r\n                                    <sat-datepicker #picker6 [rangeMode]=\"false\" [selectFirstDateOnClose]=\"true\" [rangeHoverEffect]=\"false\">\r\n                                    </sat-datepicker>\r\n                                    <sat-datepicker-toggle matSuffix [for]=\"picker6\"></sat-datepicker-toggle>\r\n                                </mat-form-field>\r\n                            </div>\r\n                            <div class=\"alertTransfer margen-alert\" *ngIf=\"( (form.get('fechanacimientoR').hasError('requerido') || form.get('fechanacimientoR').hasError('required')) && form.get('fechanacimientoR').touched) || form.get('fechanacimientoR').hasError('menorEdad')\"\r\n                                [ngClass]=\"{'alert-margin': (requeridoNombreLegal() && form.get('nombre').touched) || (requeridoApellidoP() && form.get('apellidoP').touched) || (requeridoApellidoM() && form.get('apellidoM').touched)}\">\r\n                                <span *ngIf=\"((form.get('fechanacimientoR').hasError('requerido') || form.get('fechanacimientoR').hasError('required')) && form.get('fechanacimientoR').touched)\" class=\"alert__text | color-red\" translate> Por favor captura la Fecha de Nacimiento</span>\r\n                                <span *ngIf=\"((form.get('fechanacimientoR').hasError('menorEdad') || form.get('fechanacimientoR').hasError('required')) && form.get('fechanacimientoR').touched)\" class=\"alert__text | color-red\" translate>Esta persona no puede ser menor de edad</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form_space form--password-mt\" fxFlex=\"20\">\r\n                            <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoRFCLegal() && form.get('RFC_legal').touched) }\" translate>R.F.C.*</span>\r\n                            <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoRFCLegal() && form.get('RFC_legal').touched) }\" autocomplete=\"off\" type=\"text\" name=\"RFC_legal\" id=\"RFC_legal\" formControlName=\"RFC_legal\" [(ngModel)]=\"RFC_legalModel\"\r\n                                required>\r\n                            <div class=\" alertTransfer\" *ngIf=\"requeridoRFCLegal() && form.get('RFC_legal').touched \">\r\n                                <span class=\"alert__text | color-red\" translate> Por favor captura el R.F.C. del Representante Legal</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form_space form--password-mt\" fxFlex=\"15\">\r\n                            <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoHomoclave() && form.get('homoclave').touched) }\" translate>Homoclave*</span>\r\n                            <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoHomoclave() && form.get('homoclave').touched) }\" autocomplete=\"off\" type=\"text\" name=\"homoclave\" id=\"homoclave\" formControlName=\"homoclave\" [(ngModel)]=\"homoclaveModel\"\r\n                                required>\r\n                            <div class=\" alertTransfer\" *ngIf=\"requeridoHomoclave() && form.get('homoclave').touched \">\r\n                                <span class=\"alert__text | color-red\" translate> Por favor captura la homoclave del Representante Legal</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form_space  form--password-mt\" fxFlex=\"30\">\r\n                            <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoTelefono() && form.get('telefono').touched) }\" translate>Teléfono*</span>\r\n                            <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoTelefono() && form.get('telefono').touched) }\" autocomplete=\"off\" type=\"text\" name=\"telefono\" id=\"telefono\" formControlName=\"telefono\" [(ngModel)]=\"telefonoModel\"\r\n                                required>\r\n                            <div class=\" alertTransfer\" *ngIf=\"requeridoTelefono() && form.get('telefono').touched \">\r\n                                <span class=\"alert__text | color-red\" translate> Por favor captura el teléfono del Representante Legal</span>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"form_space  form--password-mt\" fxFlex=\"34\">\r\n                            <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoCorreo() && form.get('correo_legal').touched) }\" translate>Correo Electrónico*</span>\r\n                            <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoCorreo() && form.get('correo_legal').touched) }\" autocomplete=\"off\" type=\"text\" name=\"correo_legal\" id=\"correo_legal\" formControlName=\"correo_legal\" [(ngModel)]=\"correo_legalModel\"\r\n                                required>\r\n                            <div class=\" alertTransfer\" *ngIf=\"requeridoCorreo() && form.get('correo_legal').touched \">\r\n                                <span class=\"alert__text | color-red\" translate> Por favor captura el correo electrónico del Representante Legal</span>\r\n                            </div>\r\n                        </div>\r\n\r\n                    </div>\r\n                </div>\r\n\r\n                <div class=\"mt-5\" fxFlex=\"100\">\r\n                    <p class=\"Subtitle color-accent remove-fondo\" translate>Domicilio Fiscal</p>\r\n                </div>\r\n                <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                    <div class=\"form_space  form--password-mt\" fxFlex=\"20\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoCP_legal() && form.get('CP_legal').touched) }\" translate>Código Postal*</span>\r\n                        <input class=\"form__input password | font-roboto\" [ngClass]=\"{ 'form__input_alert': (requeridoCP_legal() && form.get('CP_legal').touched) }\" autocomplete=\"off\" type=\"text\" (keyup)=\"buscar2($event);\" name=\"CP_legal\" id=\"CP_legal\" formControlName=\"CP_legal\"\r\n                            [(ngModel)]=\"CP_legalModel\" required>\r\n                        <div class=\" alertTransfer\" *ngIf=\"requeridoCP_legal() && form.get('CP_legal').touched \">\r\n                            <span class=\"alert__text | color-red\" translate> Por favor captura el Código Postal</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form_space  form--password-mt\" fxFlex=\"30\" *ngIf=\"!flagColonia2\">\r\n                        <div class=\"fondo-cerrar-select zIndex10\" id=\"fondoColonia2\" (click)=\"ocultarColonia2()\"></div>\r\n                        <div class=\"select-container zIndex10\" id=\"selectColonia2\">\r\n                            <span class=\"form__text user\" [ngClass]=\"{ 'form__text_alert': requeridoColoniaSelect2() || rojoColonia2 }\">Colonia*</span>\r\n                            <div class=\"form__input select | font-roboto \" [ngClass]=\"{ 'form__input_alert': requeridoColoniaSelect2() || rojoColonia2 }\" id=\"colo\" type=\"text\" name=\"frecuent\" (click)=\"mostrarColonia2()\">\r\n                                {{ colonia_legal }}\r\n                                <div class=\"flecha\" id=\"flecha\" [ngClass]=\"{ 'flecha--alert': requeridoColoniaSelect2() || rojoColonia2 }\"></div>\r\n                                <ul class=\"ul-select all zIndex-10 maxAlturaYScroll elscroll\" id=\"listaColonia2\">\r\n\r\n                                    <li *ngIf=\"colonias_legal.length == 0\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                                        <span class=\"texto__select\" fxFlex=\"95\">No se encontrarón direcciones</span>\r\n                                    </li>\r\n\r\n                                    <li *ngFor=\"let col of colonias_legal\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\" (click)=\"actualizarColonia2(col)\">\r\n                                        <span class=\"texto__select\" fxFlex=\"95\">{{col}}</span>\r\n                                    </li>\r\n                                </ul>\r\n                            </div>\r\n                        </div>\r\n                        <div class=\"alertTransfer\" *ngIf=\"requeridoColoniaSelect2()\">\r\n                            <span class=\"alert__text | color-red\">Por favor ingresa la Colonia</span>\r\n                        </div>\r\n                    </div>\r\n                    <div class=\"form__space  form--password-mt\" fxFlex=\"30\" *ngIf=\"flagColonia2\">\r\n                        <span class=\"form__text  pass | font-roboto\" [ngClass]=\"{ 'form__text_alert': (requeridoColoniaSelect2() && form.get('colonia_legal').touched) }\" tr