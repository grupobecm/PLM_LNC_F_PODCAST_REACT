    searchCards() {
        let card = this.form.get('razon_social').value;
        this.showLoad = true;
        this.serviceGroups.searchBeneficiary(card, this.idAccount).subscribe(res => {
            this.showLoad = false;
            //console.log(res);
            if (res.length == 0) {
                //console.log('No hay beneficiarios Crear beneficiairos')
                let error = this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_18__["ErrorUserComponent"], {
                    data: {
                        error: 'PE-001',
                        messageNormal: 'Debe de crear al menos 2 beneficiarios para poder crear un grupo.'
                    },
                    disableClose: true
                });
                error.afterClosed().subscribe(res => {
                    this.showLoad = false;
                    this.router.navigate(['/usuario/dispersiones/groups']);
                });
                // this.dialog.open()
            }
            for (let i = 0; i < res.length; i++) {
                res[i].person__name = res[i].person__name + " " + res[i].person__last_name.replace("*", " ").replace("  ", " ");
                let id = res[i].person_id;
            }
            this.datalist = res;
        });
    }
    addCards(value) {
        let card = this.form.get('razon_social').value;
        let id = value.person_id;
        //console.log(id);
        let auxdatalist = [];
        let auxAssing = [];
        let auxAssingCards = [];
        let auxCard = this.datalist.find(element => element.person_id == id);
        //console.log(auxCard);
        // Dato existe en el datalist
        this.datalist.forEach(element => {
            if (element.person_id == id) {
                auxdatalist.push(true);
            }
            else {
                auxdatalist.push(false);
            }
        });
        // Dato existe en el assing (Boton de agregar)
        this.asignar.forEach(element => {
            if (element.person_id == id) {
                auxAssing.push(true);
            }
            else {
                auxAssing.push(false);
            }
        });
        // Dato existe en el assignCards (Tablita para eliminar)
        this.assignCards.forEach(element => {
            if (element.person_id == id) {
                auxAssingCards.push(true);
            }
            else {
                auxAssingCards.push(false);
            }
        });
        if (auxdatalist.includes(true)) {
            if (!auxAssing.includes(true)) {
                if (!auxAssingCards.includes(true)) {
                    //console.log(card);
                    this.asignar.push(auxCard);
                    this.form.reset();
                }
                else {
                    if (auxAssing.includes(true) || auxAssingCards.includes(true)) {
                        this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_18__["ErrorUserComponent"], {
                            data: {
                                error: 'S-002',
                                message: card
                            },
                            disableClose: true
                        });
                    }
                    this.form.reset();
                }
            }
            else {
                if (auxAssing.includes(true) || auxAssingCards.includes(true)) {
                    this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_18__["ErrorUserComponent"], {
                        data: {
                            error: 'S-002',
                            message: card
                        },
                        disableClose: true
                    });
                }
                this.form.reset();
            }
        }
    }
    requeridoRazonSocial() {
        if (this.form.get('razon_social').errors == null) {
            return false;
        }
        else {
            return true;
        }
    }
    removeCard(numberOfCard) {
        let menssage = this.dialog.open(_messageUser_questions_user_questions_user_component__WEBPACK_IMPORTED_MODULE_19__["QuestionsUserComponent"], {
            data: {
                question: 'G-002',
                username: this.assignCards[numberOfCard].person__name,
                name: this.nameGroup
            },
            disableClose: true
        });
        menssage.afterClosed().subscribe(res => {
            if (res != undefined) {
                if (res.event === false) {
                    //console.log("Hola");
                    let message = this.dialog.open(_messageUser_success_user_success_user_component__WEBPACK_IMPORTED_MODULE_20__["SuccessUserComponent"], {
                        data: {
                            success: 'G-002',
                            username: this.assignCards[numberOfCard].person__name,
                            name: this.nameGroup
                        },
                        disableClose: true
                    });
                    message.afterClosed().subscribe(res => {
                        this.assignCards.splice(numberOfCard, 1);
                        this.showAssignCards.splice(numberOfCard, 1);
                        if ((this.asignar.length + this.assignCards.length) >= this.limite) {
                            document.getElementById("searchCardField").classList.add("disabled");
                            this.form.get('razon_social').setValue("   ");
                        }
                        else {
                            document.getElementById("searchCardField").classList.remove("disabled");
                            this.form.reset();
                        }
                        document.getElementById("confirm").focus();
                        this.showAssignCards = [...this.assignCards];
                    });
                }
            }
        });
    }
    submit() {
        if (this.assignCards.length <= 1) {
            this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_18__["ErrorUserComponent"], {
                data: {
                    error: 'G-001'
                },
                disableClose: true
            });
        }
        else {
            let data = {
                nombre_grupo: this.nameGroup.trim(),
                personal_externo: this.assignCards
            };
            //console.log(data);
            //console.log(this.idAccount);
            this.showLoad = true;
            this.serviceGroup.createGroupBeneficiary(data, this.idAccount).subscribe(res => {
                this.showLoad = false;
                //console.log(res);
                let message = this.dialog.open(_messageUser_success_user_success_user_component__WEBPACK_IMPORTED_MODULE_20__["SuccessUserComponent"], {
                    data: {
                        success: 'GB-003',
                        name: data.nombre_grupo
                    },
                    disableClose: true
                });
                message.afterClosed().subscribe(res => {
                    this.router.navigate(['/usuario/dispersiones/groups']);
                });
