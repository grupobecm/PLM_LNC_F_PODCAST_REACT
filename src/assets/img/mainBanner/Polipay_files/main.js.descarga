let DashboardDComponent = class DashboardDComponent {
    constructor() {
        this.cuenta = "";
        this.cards1 = true;
        this.cards2 = false;
        this.cards3 = false;
        this.showLoad = false;
    }
    changecards() {
        this.cards1 = true;
        this.cards2 = false;
        this.cards3 = false;
    }
    changecards2() {
        this.cards1 = false;
        this.cards2 = true;
        this.cards3 = false;
    }
    changecards3() {
        this.cards1 = false;
        this.cards2 = false;
        this.cards3 = true;
    }
    changeCards() {
        if (this.cards2 = true) {
            this.changecards2();
        }
        else {
            if (this.cards3 = true) {
                this.changecards3();
            }
        }
    }
    ngOnInit() {
    }
};
