        this.noorderF = true;
        //---
        this.Folio = true;
        this.observ = true;
        this.fechadis = true;
        this.creador = true;
        //ordenamiento de datos FILRO
        this.FolioF = true;
        this.observF = true;
        this.fechadisF = true;
        this.creadorF = true;
        this.displayedColumns = ['id', 'cuentaOrigen', 'cuentaDestino', 'monto', 'fechaOperacion', 'button'];
        this.listStaffExternal = [];
        this.ningunDato = false;
        this.noData = false;
        this.numRegister = 0;
        this.cue_id = JSON.parse(this.storageClient.infoUserValue).cuenta_id;
        //console.log(this.cue_id);
        this.showLoad = true;
        this.listTransferOwnAccounts();
    }
    ngOnInit() {
    }
    listTransferOwnAccounts(size = 999999, idCuenta = this.cue_id, accountO = null, date1 = null, date2 = null) {
        this.showLoad = true;
        this.serviceClient.listTransactionReceivedOwnAccount(size, idCuenta, accountO, date1, date2).subscribe((res) => {
