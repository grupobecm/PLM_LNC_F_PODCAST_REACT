        }
        else {
            this.dialog.open(_messageUser_error_user_error_user_component__WEBPACK_IMPORTED_MODULE_15__["ErrorUserComponent"], {
                data: {
                    error: 'RPT-001',
                    messageNormal: 'El documento no se puede generar, no hay registros'
                },
                disableClose: true,
            });
        }
    }
