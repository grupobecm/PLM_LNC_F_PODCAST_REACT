/* harmony default export */ __webpack_exports__["default"] = ("<!-- Barra menu lateal (numero de cuenta y clabe) -->\r\n<app-menu fxFlex=\"16.66\" ></app-menu>\r\n<!-- FIN Barra menu lateal (numero de cuenta y clabe) -->\r\n\r\n<div class=\"dashboard-transaction\" fxLayout=\"row wrap\" fxFlex=\"83.33\" fxLayoutAlign=\"center start\">\r\n    <!-- Empresa y saldos -->\r\n    <app-saldo-transactions fxFlex=\"100\"></app-saldo-transactions>\r\n    <!-- FIN Empresa y saldos -->\r\n\r\n    <div class=\"content_pdd\" fxFlex=\"100\" fxLayoutAlign=\"start center\">\r\n        <p class=\"title | color-accent\">Listado de comisiones</p>\r\n    </div>\r\n    <div class=\"content_pdd2\" fxFlex=\"100\" fxLayoutAlign=\"space-between center\">\r\n        <button class=\"button-verification-code  | color-third background-grey-dark font-roboto\" type=\"button\"\r\n            (click)=\"openFilter()\">\r\n            FILTRO\r\n        </button>\r\n    </div>\r\n    <div class=\"content_pdd\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"space-between start\">\r\n        <div fxFlex=\"68\" fxLayout=\"row wrap\" >\r\n            <div class=\"mat-elevation-z8 \" fxFlex=\"100\" fxLayout=\"row wrap\" >\r\n                <table mat-table [dataSource]=\"listPending\" fxFlex=\"100\" matSort>\r\n                    <ng-container matColumnDef=\"noData\">\r\n                        <td mat-footer-cell *matFooterCellDef [attr.colspan]=\"displayedColumns.length\"\r\n                            [attr.align]=\"'center'\">\r\n                            <span *ngIf=\"noData===true\">No se encontraron registros.</span>\r\n                        </td>\r\n                    </ng-container>\r\n                    <ng-container matColumnDef=\"FechaOperacion\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>Fecha y hora <br> de Operación </th>\r\n                        <td mat-cell *matCellDef=\"let element\">{{ element.FechaOperacion}}Hrs.</td>\r\n                    </ng-container>\r\n                    <ng-container matColumnDef=\"CantidadComision\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>Cantidad de <br>comisión </th>\r\n                        <td mat-cell *matCellDef=\"let element\" class=\"color-red\">{{ element.CantidadComision | currency}} MXN</td>\r\n                    </ng-container>\r\n                    <ng-container matColumnDef=\"PorcentajeComision\">\r\n                        <th mat-header-cell *matHeaderCellDef mat-sort-header>Porcentaje de <br>comisión</th>\r\n                        <td mat-cell *matCellDef=\"let element\" class=\"color-red\">{{ element.PorcentajeComision }}%</td>\r\n                    </ng-container>\r\n                    <ng-container matColumnDef=\"button\">\r\n                        <th mat-header-cell *matHeaderCellDef></th>\r\n                        <td mat-cell *matCellDef=\"let element\">\r\n                            <div>\r\n                                <button class=\"verdetalles_button quitmrg  | background-main color-white\"\r\n                                    (click)=\"seedetails(element)\" fxLayoutAlign=\"center center\">\r\n                                    <span class=\"\"><img src=\"../../../../../../../assets/img/eye-icon.png\" alt=\"\"> Ver\r\n                                        Detalles</span>\r\n                                </button>\r\n                            </div>\r\n                        </td>\r\n                    </ng-container>\r\n                    <tr></tr>\r\n                    <tr mat-header-row *matHeaderRowDef=\"displayedColumns\"></tr>\r\n                    <tr mat-row *matRowDef=\"let row; columns: displayedColumns\"></tr>\r\n                    <tr mat-footer-row *matFooterRowDef=\"['noData']\" [hidden]=\"numRegister > 0\"></tr>\r\n\r\n                </table>\r\n                <div fxFlex=\"100\">\r\n                    <p class=\"title_total | color-main\">Total de comisión: <span class=\"color-red\">{{commissionTotal | currency }} MXN</span> </p>\r\n                </div>\r\n                <mat-paginator fxFlex=\"100\" [pageSizeOptions]=\"[100]\" showFirstLastButtons>\r\n                </mat-paginator>\r\n            </div>\r\n        </div>\r\n        <div fxFlex=\"28\" fxLayout=\"row wrap\" >\r\n            <div class=\"tablita\" fxLayout=\"row wrap\">\r\n                <div class=\"cabecera\" fxLayout=\"row wrap\" fxFlex=\"100\" fxLayoutAlign=\"center center\">\r\n                    <p class=\"title | color-accent\" fxFlex=\"100\">sALDO TOTAL DE COMISIóN</p>\r\n                    <div class=\"mt-3\" fxFlex=\"100\" fxLayout=\"column\" fxLayoutAlign=\"center center\">\r\n                        <p class=\"title2 | color-red\">Debo:</p>\r\n                        <p class=\"text__balance | color-red\" *ngIf=\"commissionTotal!=0\">-{{commissionTotal | currency }}  MXN</p>\r\n                        <p class=\"text__balance |\" *ngIf=\"commissionTotal==0\">{{commissionTotal | currency}}  MXN</p>\r\n                    </div>\r\n                    <hr>\r\n                    <div class=\"mt-3\" fxFlex=\"100\" fxLayout=\"column\" fxLayoutAlign=\"center center\">\r\n                        <p class=\"subtitle_date\">Fecha de corte: </p>\r\n                        <span class=\"text_date\">{{endMonth.day}} de {{endMonth.month}}</span>\r\n                    </div>\r\n                    <div class=\"mt-3\" fxFlex=\"100\" fxLayout=\"column\" fxLayoutAlign=\"center center\">\r\n                        <p class=\"subtitle_date\">Fecha de pago:</p>\r\n                        <span class=\"text_date\">1 de {{startDate}}, tolerancia de {{endDay}} días</span>\r\n                    </div>\r\n\r\n                </div>\r\n\r\n\r\n            </div>\r\n        </div>\r\n\r\n    </div>\r\n\r\n\r\n\r\n\r\n\r\n</div>\r\n<!-- Loading -->\r\n<app-loading *ngIf=\"showLoad\"></app-loading>\r\n");

