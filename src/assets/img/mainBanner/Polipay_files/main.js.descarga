    statusChange(data) {
        [data].forEach((element) => {
            if (data.person__last_name != null ||
                data.person__last_name != undefined) {
                element.person__last_name = element.person__last_name.replace("*", " ");
                this.last_name = data.person__name + " " + element.person__last_name;
            }
            else {
                this.last_name = data.person__name;
            }
        });
        let question = this.dialog.open(_messageUser_questions_user_questions_user_component__WEBPACK_IMPORTED_MODULE_17__["QuestionsUserComponent"], {
            data: {
                question: "D-001",
                // username: data.person__name + " " + data.person__last_name.replace("*", " ").replace("  ", " "),
                username: this.last_name,
                id: data.person_id,
                //Mando true para mandar un motivo en la desactivacion
                motivo: true,
            },
            disableClose: true,
        });
        question.afterClosed().subscribe((res) => {
            if (res != undefined) {
                if (res.event) {
                    let form = this.dialog.open(_messageUser_form_user_form_user_component__WEBPACK_IMPORTED_MODULE_16__["FormUserComponent"], {
                        width: "500px",
                        data: {
                            form: "D-001",
                            id: data.person_id,
                            username: this.last_name,
                        },
                        disableClose: true,
                    });
                    form.afterClosed().subscribe((res) => {
                        if (res != undefined) {
                            if (res.event) {
                                ////console.log(dato.username);
                                let success = this.dialog.open(_messageUser_success_user_success_user_component__WEBPACK_IMPORTED_MODULE_18__["SuccessUserComponent"], {
                                    width: "500px",
                                    data: {
                                        success: "D-003",
                                        username: this.last_name,
                                    },
                                    disableClose: true,
                                });
                                success.afterClosed().subscribe((res) => {
                                    this.listPersonal();
                                });
                            }
                        }
                    });
                }
            }
        });
    }
