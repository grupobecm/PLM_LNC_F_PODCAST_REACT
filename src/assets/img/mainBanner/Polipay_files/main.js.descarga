            return null;
        }
        return { invalidSpecial: true };
    }
}
/* Regresar  */
class minimos {
    static minimos(control) {
        let pass = control.value;
        /* Regresar null */
        if (pass == null) {
            return null;
        }
        else if (pass.length == 16 || pass.length == 18) {
            return null;
        }
        else if (pass.length < 16) {
            return { menorde: true };
        }
        else if (pass.length == 17) {
            return { mayorde: true };
        }
    }
}
class minimos16 {
    static minimos16(control) {
        let pass = control.value;
        /* Regresar null */
        if (pass == null) {
            return null;
        }
        else if (pass.length == 16) {
            return null;
        }
        return { menorde: true };
    }
}
class minimos18 {
    static minimos18(control) {
        let pass = control.value;
        /* Regresar null */
        if (pass == null) {
            return null;
        }
        else if (pass.length == 18) {
            return null;
        }
        return { mayorde: true };
    }
}
class minimos15 {
    static minimos15(control) {
        let pass = control.value;
        /* Regresar null */
        if (pass == null) {
            return null;
        }
        else if (pass.length > 0 || pass.length == 15) {
            return null;
        }
        return { mayorde: true };
    }
}
//cambiar a 16 cuando back la cambie
class minimos13 {
    static minimos13(control) {
        let pass = control.value;
        /* Regresar null */
        if (pass == null) {
            return null;
        }
        else if (pass.length == 13) {
            return null;
        }
        return { mayorde: true };
    }
}
class minimos10 {
    static minimos10(control) {
        const pass = control.value;
        if (pass >= 10000 && pass <= 99999) {
            return null;
        }
        else if (pass >= 1000000000 && pass <= 1000000000) {
            return null;
        }
        return { menordediez: true };
    }
}
class montoMinimo {
    static montoMinimo(control) {
        const pass = control.value;
        if (pass >= 1) {
            return null;
        }
        return { montoMinimo: true };
    }
}
class montoMinimo2 {
    static montoMinimo2(control) {
        let pass = control.value;
        /* Regresar null */
        if (pass == null || pass == undefined) {
            return null;
        }
        else if (pass.length == 0 || pass.length == 7) {
            return null;
        }
        return { menorde: true };
    }
}
class montoMinimoCP {
    static montoMinimoCP(control) {
        let pass = control.value;
        /* Regresar null */
        if (pass == null || pass == undefined) {
            return null;
        }
        else if (pass.length == 0 || pass.length == 10) {
            return null;
        }
        return { menorde: true };
    }
}
class iniciaNueve {
    static iniciaNueve(control) {
        let pass = control.value;
        if (pass != null) {
            pass = pass.toString();
        }
        /* Regresar null */
        if (pass == null) {
            return null;
        }
        else if (pass[0] == "9" || pass == "") {
            return null;
        }
        return { noNueve: true };
    }
}
class lengthTen {
    static lengthTen(control) {
        let pass = control.value;
        if (pass != null) {
            pass = pass.toString();
        }
        /* Regresar null */
        if (pass == null) {
            return null;
        }
        else if (pass.length == 10 || pass.length == 0) {
            return null;
        }
        return { noTen: true };
    }
}
class rfc {
    static rfc(control) {
        let pass = control.value;
        if (pass != null) {
            pass = pass.toUpperCase();
        }
        /* RFC PERSONA  */
        if (/^([A-ZÑ&]{3,4}) ?(?:- ?)?(\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\d|3[01])) ?(?:- ?)?([A-Z\d]{2})([A\d])$/.test(pass) ||
            pass == "") {
            return null;
        }
        return { rfcInvalid: true };
    }
}
class rfcNoHomo {
    static rfcNoHomo(control) {
        let pass = control.value;
        if (pass != null) {
            pass = pass.toUpperCase();
        }
        /* RFC PERSONA  */
        if (/^([A-ZÑ&]{3,4}) ?(?:- ?)?(\d{2}(?:0[1-9]|1[0-2])(?:0[1-9]|[12]\d|3[01]))$/.test(pass) ||
            pass == "") {
            return null;
        }
        return { rfcNoHomoInvalid: true };
    }
}
class homoclave {
    static homoclave(control) {
        let pass = control.value;
        if (pass != null) {
            pass = pass.toUpperCase();
        }
        /* RFC PERSONA  */
        if (/^([A-Z\d]{2})([A\d])$/.test(pass) || pass == "") {
            return null;
        }
        return { homoclaveInvalid: true };
    }
}
class hasMenorEdad {
    static hasMenorEdad(control) {
        let aux = control.value;
        let pass;
        if (aux != "") {
            pass = new Date(control.value).toISOString();
        }
        else {
            pass = new Date("1800-01-01T00:00:00.000Z").toISOString();
        }
        let d = new Date();
        const date = new Date(d.setFullYear(d.getFullYear() - 18)).toISOString();
        if (date < pass) {
            return { menorEdad: true };
        }
        return null;
    }
}
class hasRequerido {
    static hasRequerido(control) {
        let aux = control.value;
        if (aux == "") {
            return { requerido: true };
        }
        return null;
    }
}
class noWhitespaceValidato {
    static noWhitespaceValidato(control) {
        const isWhitespace = (/\s/.test(control.value));
        const isValid = !isWhitespace;
        return isValid ? null : { whitespace: true };
    }
}


