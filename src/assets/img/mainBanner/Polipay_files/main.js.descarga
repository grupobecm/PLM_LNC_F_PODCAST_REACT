oto\"\r\n                        [ngClass]=\"{ 'form__text_alert': (required('fecha') && form.get('fecha').touched) }\" translate>\r\n                        Fecha de\r\n                        dispersión*\r\n                    </p>\r\n                    <mat-form-field class=\"valor campo_fecha disabled\"\r\n                        [ngClass]=\"{ 'form__input_alert': (required('fecha') && form.get('fecha').touched) }\"\r\n                        fxFlex=\"100\">\r\n                        <input class=\"borde-fecha\" matInput class=\"date\" [satDatepicker]=\"picker7\" autocomplete=\"off\"\r\n                            name=\"fecha\" id=\"fecha\" formControlName=\"fecha\" readonly [min]=\"datenow\" required>\r\n                        <sat-datepicker #picker7 [rangeMode]=\"false\" [selectFirstDateOnClose]=\"true\"\r\n                            [rangeHoverEffect]=\"false\">\r\n                        </sat-datepicker>\r\n                        <sat-datepicker-toggle matSuffix [for]=\"picker7\"></sat-datepicker-toggle>\r\n                    </mat-form-field>\r\n                    <div fxFlex=\"100\" class=\"alertTransfer alertTransfer--fecha margen-alert\"\r\n                        *ngIf=\"(required('fecha') && form.get('fecha').touched)\">\r\n                        <span class=\"alert__text | color-red\" translate>Por favor captura una fecha</span>\r\n                    </div>\r\n                </div>\r\n            </div>\r\n        </div>\r\n\r\n        <div class=\"ml-3\" fxFlex=\"32\" fxLayout=\"row wrap\" fxLayoutAlign=\"start start\">\r\n            <div class=\"form \" fxFlex=\"100\" fxLayout=\"row wrap\" class=\"selectbox\">\r\n                <mat-checkbox fxFlex=\"100\" class=\"color-third form--auxiliar-mt | ocultarT\">Bloque vacio!<br>&&& &&&!\r\n                </mat-checkbox>\r\n            </div>\r\n            <div class=\"form\" fxFlex=\"100\" *ngIf=\"form.get('is_schedule').value\">\r\n                <span class=\"form__text  pass | font-r