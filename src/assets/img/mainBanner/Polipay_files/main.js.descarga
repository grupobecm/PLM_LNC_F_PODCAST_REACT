/* harmony default export */ __webpack_exports__["default"] = ("<!-- Barra menu lateal (numero de cuenta y clabe) -->\r\n<app-menu-admin fxFlex=\"16.66\"></app-menu-admin>\r\n<!-- FIN Barra menu lateal (numero de cuenta y clabe) -->\r\n\r\n<div class=\"dashboard-admin mt-4\" fxFlex=\"83.33\" fxLayout=\"row wrap\" fxLayoutAlign=\"center start\">\r\n\r\n    <div class=\"tabla-enviadas\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n\r\n        <div *ngIf=\"!cero\" class=\"no-registros-container\" fxFlex=\"100\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n            <p class=\"no-registros | color-third\">No hay registros por mostrar. <br> Si crees que esto es un error favor de comunicarte con un ejecutivo.</p>\r\n\r\n            <div *ngIf=\"!filtradas\" fxFlex=\"100\" fxLayoutAlign=\"center center\">\r\n                <button class=\"button-verification-code | color-third background-grey-dark font-roboto\" (click)=\"ListTransfer(); filtradas = !filtradas\">RESET FILTRO</button>\r\n            </div>\r\n        </div>\r\n\r\n        <div *ngIf=\"cero\" class=\"registros\" fxLayout=\"row wrap\" fxLayoutAlign=\"start center\">\r\n            <div fxFlex=\"100\" fxLayoutAlign=\"space-between center\">\r\n\r\n                <button class=\"button-verification-code ocultarT | color-third background-grey-dark font-roboto\" type=\"button\">\r\n                    FILTRO\r\n                </button>\r\n\r\n                <div class=\"descargas\" fxFlex=\"20\" fxLayoutAlign=\"space-evenly center\">\r\n                    <!-- <img src=\"../../../../assets/img/icons/exp-xlsx.svg\" (click)=\"exportarXlsx()\" alt=\"Exportar XLSX\">\r\n                    <img src=\"../../../../assets/img/icons/exp-csv.svg\" alt=\"Exportar CSV\">\r\n                  <img src=\"../../../../assets/img/icons/exp-pdf.svg\" alt=\"Exportar PDF\"> -->\r\n                </div>\r\n\r\n            </div>\r\n\r\n            <div class=\"tabla\" fxFlex=\"100\" fxLayoutAlign=\"center center\" fxLayout=\"row wrap\">\r\n                <!-- Tabla enviadas -->\r\n                <div class=\"tabla\" fxFlex=\"100\" fxLayoutAlign=\"center center\" fxLayout=\"row wrap\">\r\n                    <div class=\"tabla-div\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                        <div class=\"tabla__cabecera | color-main\" fxFlex=\"100\" fxLayout=\"row\" fxLayoutAlign=\"center center\">\r\n                            <div class=\" cabecera__text text--align-left\" fxFlex=\"25\" fxLayout=\"row\" fxLayoutAlign=\"start center\">Cliente\r\n                                <div class=\"container-tooltip\" id=\"copyCuenta\" fxLayoutAlign=\"center center\" (click)=\"ordenarClient()\" *ngIf=\"noorder\">\r\n                                    <div class=\"triangulo1 \" [ngClass]=\"{ 'girar': client }\"></div>\r\n                                    <div id=\"copiarCuenta\" class=\"label-container mrg-position\">\r\n                                        <label class=\"label__tooltip | color-white\" *ngIf=\"!client\">Orden descendente</label>\r\n                                        <label class=\"label__tooltip2 | color-white\" *ngIf=\"client\">Orden ascendente</label>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\" cabecera__text text--align-left\" fxFlex=\"38\" fxLayout=\"row\" fxLayoutAlign=\"start center\">Observaciones\r\n                                <div class=\"container-tooltip\" id=\"copyCuenta\" fxLayoutAlign=\"center center\" (click)=\"ordenarObservaciones()\" *ngIf=\"noorder\">\r\n                                    <div class=\"triangulo1 \" [ngClass]=\"{ 'girar': observ }\"></div>\r\n                                    <div id=\"copiarCuenta\" class=\"label-container mrg-position\">\r\n                                        <label class=\"label__tooltip | color-white\" *ngIf=\"!observ\">Orden descendente</label>\r\n                                        <label class=\"label__tooltip2 | color-white\" *ngIf=\"observ\">Orden ascendente</label>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\" cabecera__text\" fxFlex=\"19\" fxLayout=\"row\" fxLayoutAlign=\"center center\">Fecha de<br>Dispersión\r\n                                <div class=\"container-tooltip\" id=\"copyCuenta\" fxLayoutAlign=\"center center\" (click)=\"ordenFecha()\" *ngIf=\"noorder\">\r\n                                    <div class=\"triangulo1 \" [ngClass]=\"{ 'girar': fecha }\"></div>\r\n                                    <div id=\"copiarCuenta\" class=\"label-container mrg-position\">\r\n                                        <label class=\"label__tooltip | color-white\" *ngIf=\"!fecha\">Orden descendente</label>\r\n                                        <label class=\"label__tooltip2 | color-white\" *ngIf=\"fecha\">Orden ascendente</label>\r\n                                    </div>\r\n                                </div>\r\n                            </div>\r\n                            <div class=\" cabecera__text\" fxFlex=\"20\">&nbsp;</div>\r\n                        </div>\r\n\r\n                        <div class=\"tabla__contenido\" fxFlex=\"100\" fxLayout=\"row wrap\">\r\n                            <div class=\"contenido__filas | color-third\" fxFlex=\"100\" *ngFor=\"let dato of registros\" fxLayoutAlign=\"center center\">\r\n                                <div class=\"contenido__element text--align-left\" fxFlex=\"25\">{{ dato.company }}</div>\r\n                                <div class=\"contenido__element text--align-left\" fxFlex=\"38\">{{ dato.observaciones }}</div>\r\n                                <div class=\"contenido__element\" fxFlex=\"19\">{{ dato.date_created | date: 'd/M/yyyy' }}</div>\r\n                                <div class=\"contenido__element\" fxFlex=\"20\" fxLayoutAlign=\"end center\">\r\n                                    <a class=\"descargar | background-main color-white\" fxFlex=\"100\" fxLayoutAlign=\"center center\" href=\"{{dato.file}}\"><img src=\"../../../../assets/img/icons/expblanco-xlsx.svg\" alt=\"\"><span>Descargar</span></a>\r\n                                </div>\r\n                            </div>\r\n                        </div>\r\n\r\n                        <div class=\"tabla__pie\" fxFlex=\"100\">\r\n                            <div class=\"pie__botones\" fxLayout=\"row\" fxLayoutAlign=\"end center\">\r\n                                <label class=\"label__filasPagina | color-third\" for=\"number\">Filas por página</label>\r\n\r\n                                <select [(ngModel)]=\"numeroRegistrosaMostrar\" (change)=\"update()\" class=\"input__finasPagina\" id=\"number\">\r\n                                    <option value=\"5\" selected>5</option>\r\n                                    <option value=\"10\">10</option>\r\n                                    <option value=\"20\">20</option>\r\n                                    <option value=\"50\">50</option>\r\n                                    <option value=\"100\">100</option>\r\n                                    <option value=\"{{total}}\">Todas</option>\r\n                                </select>\r\n\r\n                                <label class=\"label__filasPagina label__numeroRegistros | color-third\">{{ actual1 }} - {{ final }} de {{ total }}</label>\r\n\r\n                                <button class=\"boton first\" (click)=\"inicio()\">\r\n                                    <img src=\"../../../../assets/img/icons/first.svg\" alt=\"Primera página\">\r\n                                </button>\r\n\r\n                                <button class=\"boton prev\" (click)=\"prev()\">\r\n                                    <img src=\"../../../../assets/img/icons/prev.svg\" alt=\"Página ante