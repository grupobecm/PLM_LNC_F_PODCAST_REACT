let SelectCompanyDesktopComponent = class SelectCompanyDesktopComponent {
    constructor(route, serviceD, storageClient, storage) {
        this.route = route;
        this.serviceD = serviceD;
        this.storageClient = storageClient;
        this.storage = storage;
        /* Loader spinner */
        this.showLoad = false;
        this.paso1 = true;
        this.paso2 = false;
        this.transInd = [];
        this.transMas = [];
        this.polipay = [];
        this.dispInd = [];
        this.dispMas = [];
        //----
        this.empresas = [];
        this.flagHide = true;
    }
    ngOnInit() {
        this.cargar();
        this.datosDefault();
        this.deskDispersion();
        this.deskTransaccion();
        this.deskCuentas();
    }
    cargar() {
        if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length >= 3) {
            this.id = JSON.parse(this.storage.infoUserValue).cuenta_id;
            if (this.storageClient.InfoCostCenterExist == false) {
                let user_type = JSON.parse(this.storage.infoUserValue).user_type;
                if (user_type == 8) {
                    let datoEmpresa = JSON.parse(this.storage.infoUserValue).data_empresa.centro_costos;
                    this.id = datoEmpresa[0].persona_cuenta_id;
                    this.storageClient.setInfoCostCenter(datoEmpresa[0]);
                }
                else {
                    this.dato = JSON.parse(this.storage.infoUserValue);
                }
            }
            else {
                this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
                this.id = this.dato.persona_cuenta_id;
            }
        }
        else {
            if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length == 2) {
                if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Tarjetas de Prepago') {
                    this.dato = JSON.parse(this.storage.infoUserValue);
                    this.id = this.dato.cuenta_id;
                }
                else {
                    if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions[0].producto == 'Transferencias') {
                        if (this.storageClient.InfoCostCenterExist == false) {
                            this.dato = JSON.parse(this.storage.infoUserValue);
                        }
                        else {
                            this.dato = JSON.parse(this.storageClient.InfoCostCenterValue);
                            this.id = this.dato.persona_cuenta_id;
                        }
                    }
                }
            }
        }
    }
    /* AVANZAR ENTRE LOS PASOS */
    alPaso1() {
        this.paso1 = true;
        this.paso2 = false;
    }
    alPaso2() {
        this.paso1 = false;
        this.paso2 = true;
    }
    verMas() {
        this.route.navigateByUrl('/usuario/transactions/own-accounts/historyOA');
    }
    deskDispersion() {
        this.showLoad = true;
        if (JSON.parse(this.storage.infoUserValue).data_empresa.commissions.length == 2) {
            this.flagHide = false;
        }
        this.serviceD.chekDispersion(this.id).subscribe(res => {
            this.dispInd = [];
            this.dispMas = [];
            this.dispInd.push({
                nombre: 'Liquidadas',
                url: '/usuario/dispersiones/estado-dispersion/individual-dispersion/liquidate-dispersion',
                ordenes: res.individual[0].count, monto: res.individual[0].total_amount
            }, {
                nombre: 'Pendientes',
                url: '/usuario/dispersiones/estado-dispersion/individual-dispersion/pending-dispersion',
                ordenes: res.individual[2].count, monto: res.individual[2].total_amount
            }, {
                nombre: 'Canceladas',
                url: '/usuario/dispersiones/estado-dispersion/individual-dispersion/canceled-dispersion"',
                ordenes: res.individual[1].count, monto: res.individual[1].total_amount
            });
            this.dispMas.push({
                nombre: 'Pendientes',
                url: '/usuario/dispersiones/estado-dispersion/massive-dispersion/pending-dispersion-massive',
                ordenes: res.massive[1].count, monto: res.massive[1].total_amount
            }, {
                nombre: 'Canceladas',
                url: '/usuario/dispersiones/estado-dispersion/massive-dispersion/canceled-dispersion-massive',
                ordenes: res.massive[2].count, monto: res.massive[2].total_amount
            }, {
                nombre: 'Procesadas',
                url: '/usuario/dispersiones/estado-dispersion/massive-dispersion/processed-dispersion-massive',
                ordenes: res.massive[4].count, monto: res.massive[4].total_amount
            });
        }, error => {
            this.showLoad = false;
        });
    }
    datosDefault() {
        this.transInd = [];
        this.transMas = [];
        this.polipay = [];
        this.dispInd = [];
        this.dispMas = [];
        this.transInd.push({
            nombre: 'Recibidas',
            url: '/usuario/transactions/polipay-third/transfer-status/status-individual-tranfer/received',
            ordenes: 0, monto: 0
        }, {
            nombre: 'Enviadas',
            url: '/usuario/transactions/polipay-third/transfer-status/status-individual-tranfer/sent',
            ordenes: 0, monto: 0
        }, {
            nombre: 'Pendientes',
            url: '/usuario/transactions/polipay-third/transfer-status/status-individual-tranfer/slopes',
            ordenes: 0, monto: 0
        }, {
            nombre: 'Canceladas',
            url: '/usuario/transactions/polipay-third/transfer-status/status-individual-tranfer/canceled',
            ordenes: 0, monto: 0
        }, {
            nombre: 'Devoluciones',
            url: '/usuario/transactions/polipay-third/transfer-status/status-individual-tranfer/returned',
            ordenes: 0, monto: 0
        });
        this.transMas.push({
            nombre: 'Enviadas',
            url: 'usuario/transactions/polipay-third/transfer-status/status-massives-transfer/sent-transactions/sent-massives',
            ordenes: 0, monto: 0
        }, {
            nombre: 'Pendientes',
            url: '/usuario/transactions/polipay-third/transfer-status/status-massives-transfer/pending-transactions/pending-massives',
            ordenes: 0, monto: 0
        }, {
            nombre: 'Canceladas',
            url: '/usuario/transactions/polipay-third/transfer-status/status-massives-transfer/canceled-transactions',
            ordenes: 0, monto: 0
        }, {
            nombre: 'En Proceso',
            url: '/usuario/transactions/polipay-third/transfer-status/status-massives-transfer/in-process-transactions',
            ordenes: 0, monto: 0
        }, {
            nombre: 'Procesadas',
            url: '/usuario/transactions/polipay-third/transfer-status/status-massives-transfer/processed-transactions/processed-massives',
            ordenes: 0, monto: 0
        });
        this.polipay.push({
            nombre: 'Enviadas',
            url: '/usuario/transactions/polipay/record-polipay/menu-record-polipay/send-polipay',
            ordenes: 0, monto: 0
        }, {
            nombre: 'Recibidas',
            url: '/usuario/transactions/polipay/record-polipay/menu-record-polipay/received-polipay',
            ordenes: 0, monto: 0
        });
        this.dispInd.push({
            nombre: 'Liquidadas',
            url: '/usuario/dispersiones/estado-dispersion/individual-dispersion/liquidate-dispersion',
            ordenes: 0, monto: 0
        }, {
            nombre: 'Pendientes',
            url: '/usuario/dispersiones/estado-dispersion/individual-dispersion/pending-dispersion',
            ordenes: 0, monto: 0
        }, {
            nombre: 'Canceladas',
            url: '/usuario/dispersiones/estado-dispersion/individual-dispersion/canceled-dispersion"',
            ordenes: 0, monto: 0
        });
        this.dispMas.push({
            nombre: 'Pendientes',
            url: '/usuario/dispersiones/estado-dispersion/massive-dispersion/pending-dispersion-massive',
            ordenes: 0, monto: 0
        }, {
            nombre: 'Canceladas',
            url: '/usuario/dispersiones/estado-dispersion/massive-dispersion/canceled-dispersion-massive',
            ordenes: 0, monto: 0
        }, {
            nombre: 'Procesadas',
            url: '/usuario/dispersiones/estado-dispersion/massive-dispersion/processed-dispersion-massive',
            ordenes: 0, monto: 0
        });
    }
    deskTransaccion() {
        this.showLoad = true;
        try {
            this.serviceD.chekTransaccion(this.id).subscribe(res => {
                this.transInd = [];
                this.transMas = [];
                this.polipay = [];
                /**Transacciones Individuales */
                this.transInd.push({
                    nombre: 'Recibidas',
                    url: '/usuario/transactions/polipay-third/transfer-status/status-individual-tranfer/received',
                    ordenes: res.Recibidas.count, monto: res.Recibidas.total_amount
                });
                for (let i = 0; i < res.TransactionIndividual.length; i++) {
                    const element = res.TransactionIndividual[i];
                    switch (element.status) {
                        case 'Liquidada':
                            this.transInd.push({
                                nombre: 'Enviadas',
                                url: '/usuario/transactions/polipay-third/transfer-status/status-individual-tranfer/sent',
                                ordenes: element.count, monto: element.total_amount
                            });
                            break;
                        case 'Pendiente':
                            this.transInd.push({
                                nombre: 'Pendientes',
                                url: '/usuario/transactions/polipay-third/transfer-status/status-individual-tranfer/slopes',
                                ordenes: element.count, monto: element.total_amount
                            });
                            break;
                        case 'Cancelada':
                            this.transInd.push({
                                nombre: 'Canceladas',
                                url: '/usuario/transactions/polipay-third/transfer-status/status-individual-tranfer/canceled',
                                ordenes: element.count, monto: element.total_amount
                            });
                            break;
                        case 'Devuelta':
                            this.transInd.push({
                                nombre: 'Devoluciones',
                                url: '/usuario/transactions/polipay-third/transfer-status/status-individual-tranfer/returned',
                                ordenes: element.count, monto: element.total_amount
                            });
                            break;
                    }
                }
                /**Transacciones Masivas */
                for (let i = 0; i < res.TransactionMassive.length; i++) {
                    const element = res.TransactionMassive[i];
                    switch (element.status) {
                        case 'Creadas':
                            this.transMas.push({
                                nombre: 'Enviadas',
                                url: 'usuario/transactions/polipay-third/transfer-status/status-massives-transfer/sent-transactions/sent-massives',
                                ordenes: element.count, monto: element.total_amount
                            });
                            break;
                        case 'Pendientes':
                            this.transMas.push({
                                nombre: 'Pendientes',
                                url: '/usuario/transactions/polipay-third/transfer-status/status-massives-transfer/pending-transactions/pending-massives',
                                ordenes: element.count, monto: element.total_amount
                            });
                            break;
                        case 'Canceladas':
                            this.transMas.push({
                                nombre: 'Canceladas',
                                url: '/usuario/transactions/polipay-third/transfer-status/status-massives-transfer/canceled-transactions',
                                ordenes: element.count, monto: element.total_amount
                            });
                            break;
                        case 'En proceso':
                            this.transMas.push({
                                nombre: 'En Proceso',
                                url: '/usuario/transactions/polipay-third/transfer-status/status-massives-transfer/in-process-transactions',
                                ordenes: element.count, monto: element.total_amount
                            });
                            break;
                        case 'Procesadas':
                            this.transMas.push({
                                nombre: 'Procesadas',
                                url: '/usuario/transactions/polipay-third/transfer-status/status-massives-transfer/processed-transactions/processed-massives',
                                ordenes: element.count, monto: element.total_amount
                            });
                            break;
                    }
                }
                /**Polipay */
                this.polipay.push({
                    nombre: 'Enviadas',
                    url: '/usuario/transactions/polipay/record-polipay/menu-record-polipay/send-polipay',
                    ordenes: res.PolipayToPolipay.enviadas.count, monto: res.PolipayToPolipay.enviadas.total_amount
                });
                this.polipay.push({
