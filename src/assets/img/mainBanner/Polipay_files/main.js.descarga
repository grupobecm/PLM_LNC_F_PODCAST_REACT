izar tu\r\n            <br>operación.\r\n        </p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!-- Error recibidas-->\r\n    <div *ngIf=\"error == 'R-002'\" class=\"message\">\r\n        <p class=\"text | color-third\">\r\n            Error al realizar tu\r\n            <br>operación.\r\n        </p>\r\n        <p class=\"\">{{message}} </p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <!--Clientes Externos CE-000-->\r\n    <!--Error al activar cliente externo-->\r\n    <div *ngIf=\"error == 'CE-001'\" class=\"message\">\r\n        <p class=\"\">{{message}} </p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n\r\n    <!--Colaboradores COL-000    -->\r\n    <!--dialog para el endpoint notificar-->\r\n    <div *ngIf=\"error == 'ECOL-001'\" class=\"message\">\r\n        <p class=\"text | color-third\">{{message}}</p>\r\n        <div fxLayout=\"row \">\r\n            <button *ngIf=\"'ECOL-001'\" (click)=\"listadoColaboradores()\" mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Error al crear colaborador-->\r\n    <div *ngIf=\"error == 'ECOL-002'\" class=\"message\">\r\n        <p class=\"\">{{message}} </p>\r\n        <div fxLayout=\"row \">\r\n            <button mat-dialog-close id=\"button\" class=\"button-accept | color-white background-main\" type=\"button\">ACEPTAR</button>\r\n        </div>\r\n    </div>\r\n\r\n    <!--Error al crear 