            this.listPending.paginator = this.paginator;
            this.paginator._intl.itemsPerPageLabel = 'Filas por página';
            this.listPending.data.length > 0 ? this.noData = false : this.noData = true;
            this.numRegister = this.listPending.data.length;
            //console.log(this.numRegister);
        }, error => {
            this.numRegister = 0;
            this.noData = true;
        });
    }
    openFilter() {
        let filtro = this.dialog.open(_dispersions_dispersion_movements_user_filter_movements_dispersion_u_filter_movements_dispersion_u_component__WEBPACK_IMPORTED_MODULE_14__["FilterMovementsDispersionUComponent"], {
            width: "40%",
            panelClass: "custom-dialog-container"
        });
        filtro.afterClosed().subscribe(res => {
            let date1 = null;
            let date2 = null;
            //console.log(res);
            date1 = res.data.date1F;
            date2 = res.data.date2F;
            //console.log(date1);
            //console.log(date2);
            this.AllRecordsRispersions(9999, date1, date2);
        });
    }
    seedetails(element) {
        //console.log(element);
        this.showLoad = true;
        //  this.serviceClient.detaisIndividualDispersions(JSON.parse(this.storageClient.infoUserValue).cuenta_id ,element.id).subscribe(res=>{
        //    this.showLoad = false;
