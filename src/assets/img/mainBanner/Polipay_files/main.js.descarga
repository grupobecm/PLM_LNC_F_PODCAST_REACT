        };
        if (JSON.parse(this.storageHome.infoUserValue).data_empresa.commissions.length >= 3) {
            //console.log('tp y t');
            this.idAccount = JSON.parse(this.storageHome.infoUserValue).cuenta_id;
            // this.idAccount = this.dataAccountt.persona_cuenta_id;
            // //console.log(this.idAccount);
            if (this.storageClient.InfoCostCenterExist == false) {
                //console.log("bye");
                // this.dataAccountt = JSON.parse(this.storage.infoUserValue);
                //Aqui va dialog para crear centros de costos
            }
            else {
                //console.log('si hay centros de costos');
                this.dataAccountt = JSON.parse(this.storageClient.InfoCostCenterValue);
                this.idCC = this.dataAccountt.persona_cuenta_id;
                //console.log(this.dataAccountt)
                //console.log(this.dataAccountt.persona_cuenta_id);
            }
        }
        else {
            if (JSON.parse(this.storageHome.infoUserValue).data_empresa.commissions.length == 2) {
