let MenuAdminComponent = class MenuAdminComponent {
    constructor(router) {
        this.router = router;
        this.openP = false;
        this.opensF = false;
        this.opensM = false;
    }
    ngAfterViewInit() {
        this.abrirDefault();
    }
    abrirDefault() {
        if (this.router.url.includes('/concentrates/dashboard-concentrates')) {
            this.mostrar_Submenu_Concentrados();
        }
        else if (this.router.url.includes('/moral-people-concentrates')) {
            this.mostrar_Submenu_Moral();
        }
        else if (this.router.url.includes('/physical-people-concentrates')) {
            this.mostrar_Submenu_Fisica();
        }
    }
    showMenuCliente() {
        return this.router.url.includes('/cliente/ListClients') || this.router.url.includes('/cliente/clientList') || this.router.url.includes('/cliente/AltClients') || this.router.url.includes('/cuentaeje') || this.router.url.includes('/balance-wallet/list') || this.router.url.includes('/log-data') || this.router.url.includes('/analytics');
    }
    showMenuCuentaEje() {
        return this.router.url.includes('/administrador/cliente/clientList');
    }
    showMenuPendiente() {
        return this.router.url.includes('/pendientes/individual') || this.router.url.includes('/pendientes/masiva');
    }
    showDetailsPendiente() {
        return this.router.url.includes('/pendientes/detallesindividual');
    }
    showMenuCancelada() {
        return this.router.url.includes('/canceladas');
    }
    showMenuEnviada() {
        return this.router.url.includes('/enviadas');
    }
    showMenuRecibida() {
        return this.router.url.includes('/recibidas');
    }
    showMenuReceivedAxisAccount() {
        return this.router.url.includes('/received/axis-account-received');
    }
    showMenuReceivedIndividualAccount() {
        return this.router.url.includes('/received/individual-account-received');
    }
    detallesMasiva() {
        return this.router.url.includes('/pendientes/detallesmassive') || this.router.url.includes('/pendientes/detallesdetallesm');
    }
    showMenuAdmin() {
        return this.router.url == '/administrador/administraodres-polipay/lista-administradores-polipay' || this.router.url == '/administrador/administraodres-polipay/administrar-administradores-polipay' || this.router.url == '/administrador/administraodres-polipay/edit-administradores-polipay' || this.router.url == '/administrador/administraodres-polipay/eliminar-administradores-polipay' || this.router.url == '/administrador/alta' || this.router.url == '/administrador/administraodres-polipay/nuevo-administradores-polipay';
    }
    showDashboard() {
        // QUITAR LA PRIMERA CUANDO ACOMODEMOS TODAS LAS CARPETAS
        return this.router.url == '/administrador/cliente' || this.router.url == '/administrador/dashboard';
    }
    ///// NUEVO ORDENAMIENTO
    showClient() {
        return this.router.url.includes('/cuentaeje');
    }
    altacuentaeje() {
        this.router.navigate(['/administrador/cuentaeje/cuentas-eje/alta-cliente']);
    }
    showMenuConcentrados() {
        return this.router.url.includes('/concentrates');
    }
    rutaConcentrador() {
        return this.router.url.includes('/concentrates');
    }
    rutaPersonaMoral() {
        return this.router.url.includes('/moral-people-concentrates');
    }
    mostrar_Submenu_Concentrados() {
        this.menu_Concentrados = false;
        this.menu_concent = false;
        let menuP = document.getElementById("submenu_concentrados");
        let menu__polipay = document.getElementById("menu__polipay");
        let uno = document.getElementById("uno");
        let dos = document.getElementById("dos");
        let altura_total = uno.offsetHeight + dos.offsetHeight;
        menuP.style.height = (menuP.offsetHeight) + "px";
        if (!this.menu_active) {
            menuP.style.height = (altura_total) + "px";
            menu__polipay.classList.add('active--b');
            this.menu_active = true;
        }
        else {
            menuP.style.height = (menuP.offsetHeight) + "px";
            menuP.style.height = "0px";
            menu__polipay.classList.remove('active--b');
            this.menu_active = false;
        }
        let triangulo = document.getElementById('triangulo_polipay');
        if (triangulo.classList.contains('girar')) {
            triangulo.classList.remove('girar');
        }
        else {
            triangulo.classList.add('girar');
        }
        if (this.router.url.includes('/concentrates/')) {
            menu__polipay.classList.add('active--b');
            this.menu_Concentrados = true;
            this.menu_concent = true;
        }
        if (this.router.url.includes('dashboard-concentrates')) {
            this.menu_concent = false;
        }
        this.openP = !this.openP;
    }
    mostrar_Submenu_Moral() {
        this.menu_moral = false;
        if (this.opensM) {
            this.mostrar_Submenu_Fisica();
        }
        let menu = document.getElementById("menu__polipay");
        let menu_moral = document.getElementById("submenu_moral");
        let submenu_concentrados = document.getElementById("submenu_concentrados");
        let unoT = document.getElementById("unoT");
        let dosD = document.getElementById("dosD");
        let altura_total = unoT.offsetHeight + dosD.offsetHeight;
        menu_moral.style.height = (altura_total) + "px";
        if (!this.menu_active2) {
            submenu_concentrados.style.height = (94 + altura_total) + "px";
            menu_moral.classList.add("active--b");
            this.menu_active2 = true;
        }
        else {
            submenu_concentrados.style.height = (altura_total) + "px";
            submenu_concentrados.style.height = "94px";
            menu_moral.style.height = "0px";
            menu_moral.classList.remove("active--b");
            this.menu_active2 = false;
        }
        let triangulo = document.getElementById('triangulo_polipay_M');
        if (triangulo.classList.contains('girar')) {
            triangulo.classList.remove('girar');
        }
        else {
            triangulo.classList.add('girar');
        }
        if (this.router.url.includes('moral-people-concentrates')) {
            submenu_concentrados.classList.add('active--b');
            menu_moral.classList.add('active--b');
            this.menu_Concentrados = true;
            this.menu_moral = true;
            this.menu_concent = true;
        }
        this.opensF = !this.opensF;
        this.openP = !this.openP;
    }
    mostrar_Submenu_Fisica() {
        if (this.opensF) {
            this.mostrar_Submenu_Moral();
        }
        let menu = document.getElementById("menu__polipay");
        let menu_fisico = document.getElementById("submenu_fisico");
        let submenu_concentrados = document.getElementById("submenu_concentrados");
        let tresT = document.getElementById("tresT");
        let cuatroD = document.getElementById("cuatroD");
        let altura_total = tresT.offsetHeight + cuatroD.offsetHeight;
        menu_fisico.style.height = (altura_total) + "px";
        if (!this.menu_active2) {
            submenu_concentrados.style.height = (94 + altura_total) + "px";
            menu_fisico.classList.add("active--b");
            this.menu_active2 = true;
        }
        else {
            submenu_concentrados.style.height = (altura_total) + "px";
            submenu_concentrados.style.height = "94px";
            menu_fisico.style.height = "0px";
            menu_fisico.classList.remove("active--b");
            this.menu_active2 = false;
        }
        let triangulo = document.getElementById('triangulo_polipay_F');
        if (triangulo.classList.contains('girar')) {
            triangulo.classList.remove('girar');
        }
        else {
            triangulo.classList.add('girar');
        }
        if (this.router.url.includes('physical-people-concentrates')) {
            submenu_concentrados.classList.add('active--b');
            menu_fisico.classList.add('active--b');
            this.menu_Concentrados = true;
            this.menu_fisico = true;
            this.menu_concent = true;
        }
        this.opensM = !this.opensM;
        this.openP = !this.openP;
    }
};
