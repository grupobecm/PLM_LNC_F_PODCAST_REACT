/* harmony default export */ __webpack_exports__["default"] = ("<!-- Barra menu lateal (numero de cuenta y clabe) -->\r\n<app-menu fxFlex=\"16.66\"></app-menu>\r\n<!-- FIN Barra menu lateal (numero de cuenta y clabe) -->\r\n\r\n<div *appPermission=\"['257', '273']\" class=\"transfer-polipay dashboard-transaction\" fxFlex=\"83.33\" fxLayout=\"row wrap\"\r\n    fxLayoutAlign=\"center start\">\r\n    <app-saldo-transactions fxFlex=\"100\"></app-saldo-transactions>\r\n\r\n    <form [formGroup]=\"form\" novalidate (ngSubmit)=\"submit()\" #f=\"ngForm\" class=\"mt-5\" fxFlex=\"98\" fxLayout=\"row wrap\"\r\n        fxLayoutAlign=\"center start\">\r\n        <div fxFlex=\"100\">\r\n            <p class=\"mensajeObl\">Los campos marcados con * son obligatorios</p>\r\n        </div>\r\n        <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n\r\n            <div fxFlex=\"100\" fxLayout=\"row wrap\">\r\n\r\n                <!-- Input frecuentes -->\r\n                <div fxFlex=\"40\" class=\"form\">\r\n                    <div class=\"fondo-cerrar-select zIndex12\" id=\"fondo\" (click)=\"ocultar()\"></div>\r\n                    <div class=\"select-container zIndex13\" id=\"select1\" fxFlex=\"100\">\r\n                        <span class=\"form__text user | font-roboto\">Frecuentes</span>\r\n                        <div>\r\n                            <div class=\"form__input select | font-roboto\" ng type=\"text\" name=\"frecuent\"\r\n                                (click)=\"mostrar()\">\r\n                                {{ frecuentes }}\r\n                                <div class=\"flecha\"></div>\r\n                            </div>\r\n                            <div class=\"all\" id=\"lista\">\r\n                                <div class=\"search\" fxLayoutAlign=\"center center\">\r\n                                    <input class=\"form__input2 form__input--padding\" type=\"text\" [(ngModel)]=\"buscar\"\r\n                                        (ngModelChange)=\"filtrarFrecuentes()\" [ngModelOptions]=\"{standalone: true}\">\r\n                                    <img class=\"icon__search\" src=\"../../../../../../assets/img/icons/search-24px.svg\"\r\n                                        alt=\"buscar frecuentes\">\r\n                                </div>\r\n                                <ul class=\"ul-select frecuentes elscroll\">\r\n                                    <li *ngIf=\"total == 0\" fxLayout=\"row wrap\" fxLayoutAlign=\"center center\">\r\n                                        <span class=\"texto__select\" fxFlex=\"95\">No se encontrarón frecuentes </span>\r\n                                    </li>\r\n                                    <!-- <li *ngIf=\"total != 0\" fxLayout=\"row wrap\" fxLayoutAlign=\"end center\" (click)=\"cancelar()\">\r\n                                        <span class=\"texto__select\" fxFlex=\"95\">&nbsp;</span>\r\n                                    </li> -->\r\n                                    <li *ngFor=\"let frequent of copyCompany; index as i \" fxLayout=\"row wrap\"\r\n                                        (click)=\"mostrar()\" fxLayoutAlign=\"end center\"\r\n                                        (click)=\"actualizar(frequent, true)\">\r\n                                        <div fxFlex=\"95\" fxLayoutAlign=\"start center\" *ngIf=\"total != 0\">\r\n                                            <img *ngIf=\"frequent.is_favorite\"\r\n                                                src=\"../../../../../../assets/img/icons/favorite-24px.svg\" alt=\"\">\r\n                                            <div class=\"heard-invisible\" *ngIf=\"!frequent.is_favorite\"></div>\r\n                                            <span class=\"texto__select\" fxFlex=\"95\">{{frequent.alias}}</span>\r\n                                        </div>\r\n                                    </li>\r\n                                </ul>\r\n                            </div>\r\n                        </div>\r\n                    </div>\r\n                </div>\r\n                <!-- Input no. de cuenta -->\r\n                <div class=\"form\" fxFlex=\"30\">\r\n                    <!-- Input no. de cuenta, campos normales -->\r\n                    <span class=\"form__text user |\"\r\n                        [ngClass]=\"{ 'form__text_alert': (requerido('cuentabeneficiario') && submitt) }\">Núm.\r\n                        Tarjeta/Clabe*</span>\r\n                    <input class=\"form__input user |\"\r\n                        [ngClass]=\"{ 'form__input_alert': (requerido('cuentabeneficiario') && submitt) }\" id=\"tarjeta\"\r\n                        autocomplete=\"off\" type=\"text\" name=\"cuentabeneficiario\" maxlength=\"18\"\r\n                        (keypress)=\"keyPressNumbers($event)\" (paste)=\"onPaste($event)\" formControlName=\"cuentabeneficiario\" required>\r\n                    <!-- Alertas -->\r\n                    <div class=\" alertTransfer\" *ngIf=\"requerido('cuentabeneficiario') && submitt\">\r\n                        <span class=\"alert__text | color-red\"\r\n                            *ngIf=\"form.get('cuentabeneficiario').hasError('menorde')\">El número de tarjeta debe tener\r\n                            16 caracteres</span>\r\n                        <span class=\"alert__text | color-red\"\r\n                            *ngIf=\"form.get('cuentabeneficiario').hasError('required')\">Este campo es requerido</span>\r\n                        <span class=\"alert__text | color-red\"\r\n                            *ngIf=\"form.get('cuentabeneficiario').hasError('mayorde')\">La Clabe interbancaria es de 18\r\n                            caracteres</span>\r\n                    </div>\r\n                </div>\r\n\r\n\r\n                <!-- Input monto -->\r\n                <div class=\"form form--pl2\" fxFlex=\"30\">\r\n                    <img class=\"imgmonto\" *ngIf=\"!(requerido('monto') && submitt)\" type=\"image\"\r\n   