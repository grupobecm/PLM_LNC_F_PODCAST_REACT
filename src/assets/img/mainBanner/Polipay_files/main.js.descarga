let ExternalCustomerUnsubscribeComponent = class ExternalCustomerUnsubscribeComponent {
    constructor(router, formBuilder, storageAdmin, serviceClient) {
        this.router = router;
        this.formBuilder = formBuilder;
        this.storageAdmin = storageAdmin;
        this.serviceClient = serviceClient;
        this.solData = {
            name: null,
            clabe: null,
            bank: null,
            rfc: null,
            address: null,
        };
        this.client = 'POLIMENTES';
        this.paso1 = true;
        this.paso2 = false;
        this.paso3 = false;
        this.pdf2 = "../../../assets/Abril.pdf";
        this.pdf = "../../../../../assets/INE.pdf";
        this.showLoad = true;
        this.document1 = true;
        this.document2 = false;
        this.asunto_documento = "bancarrota";
        this.documento_motivo = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ac mi pharetra, porta metus sit amet, volutpat lorem. Donec eget scelerisque odio. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ac mi pharetra, porta metus sit amet, volutpat lorem. Donec eget scelerisque odio. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ac mi pharetra, porta metus sit amet, volutpat lorem. Donec eget scelerisque odio. Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ac mi pharetra, porta metus sit amet, volutpat lorem. Donec eget scelerisque odio.";
        //Estado de los documentos
        this.estado = [
            { texto: "CORRECTO", valor: true },
            { texto: "DEVUELTO", valor: false },
        ];
        this.estado_general = [
            { texto: "puede ser autorizado", texto2: ", los documentos  son correctos.", valor: true },
            { texto: "no puede ser autorizado ", texto2: "hasta que los documentos devueltos sean correctos.", valor: false },
        ];
        // 0: ESTAN CORRECTOS
        // 1: ESTAN MAL
        this.documento_evidencia = 0;
        this.motivo_documento_evidencia = "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Praesent ac mi pharetra, porta metus sit amet, volutpat lorem. Donec eget scelerisque odio.";
        this.radioBoton = 'p';
        this.motivoDevolucion = "";
        this.center_cost = this.storageAdmin.CenterCost.data.name;
        this.sol = JSON.parse(sessionStorage.getItem("idsSolCE")).dato;
        this.moral = JSON.parse(sessionStorage.getItem("idsSolCE")).moral;
        this.id = this.sol.id_cliente;
        this.getDetailsCE();
    }
    getDetailsCE() {
        if (this.moral == true) {
            this.nameType = "Razón social";
            this.nameType1 = "Clabe de Traspaso Final";
            this.nameType2 = "Banco";
            this.nameType3 = "Domicilio Fiscal";
            this.serviceClient.detailsExternalClientMoral(this.id).subscribe(res => {
                //console.log(res);
                this.solData = {
                    name: res.cliente_externo_moral.razon_social,
                    clabe: res.cliente_externo_moral.clave_transpaso_final.clabeinterbancaria_uno,
                    bank: res.cliente_externo_moral.banco,
                    rfc: res.cliente_externo_moral.rfc,
                    address: null,
                };
                this.getAddressFormat(res.cliente_externo_moral.domicilio[0]);
            });
        }
        else {
            this.nameType = "Nombre";
            this.nameType1 = "Correo electrónico";
            this.nameType2 = "Teléfono";
            this.nameType3 = "Domicilio";
            this.serviceClient.detailsExternalClientFisico(this.id).subscribe(res => {
                this.solData = {
                    name: res.cliente_externo_fisico[0].person__name + " " + res.cliente_externo_fisico[0].person__last_name,
                    clabe: res.cliente_externo_fisico[0].person__email,
                    bank: res.cliente_externo_fisico[0].person__phone,
                    rfc: res.cliente_externo_fisico[0].person__rfc,
                    address: null,
                };
                this.getAddressFormat(res.domicilio[0]);
                //console.log(this.solData);
            });
        }
    }
    getAddressFormat(data) {
        this.solData.address = data.calle +
            " " + data.no_interior + " " + data.no_exterior +
            ", Col. " + data.colonia + ", " + data.alcaldia_mpio + ", " + data.estado +
            ", C.P. " + data.codigopostal + ", " + data.pais;
    }
    /* AVANZAR ENTRE LOS PASOS */
    alPaso1() {
        this.paso1 = true;
        this.paso2 = false;
    }
    alPaso2() {
        this.paso1 = false;
        this.paso2 = true;
    }
    regresar() {
        this.router.navigate(['/administrador/cuentaeje/clientes-externos/lista-cliente-externo']);
    }
    submit1() {
        //console.log("Hola");
        this.alPaso2();
    }
    /*AVANZAR ENTRE DOCUMENTOS - paso1*/
    Documento1() {
        this.document1 = true;
        this.document2 = false;
    }
    Documento2() {
        this.document1 = false;
        this.document2 = true;
    }
    click() {
        ////console.log(this.form.value.radioBoton);
        if (this.radioBoton == 'd') {
            return true;
        }
        else {
            return false;
        }
    }
};
ExternalCustomerUnsubscribeComponent.ctorParameters = () => [
